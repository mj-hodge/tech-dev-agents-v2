+"""Tests for zero outbound HTTP to production Target API.
+
+Covers: SC-4 (zero production HTTP calls during tests), Gate 2a (external API isolation),
+Gate 10 (error observability), Gate 12 (integration smoke).
+"""
+
+from decimal import Decimal
+from unittest.mock import AsyncMock, MagicMock, patch
+import logging
+
+import httpx
+import pytest
+import respx
+
+from app.pricing.schemas import PriceUpdateResult
+from app.pricing.client import TargetPricingClient, HttpTargetPricingClient
+from app.pricing.queue import enqueue_price_updates
+from app.pricing.worker import PricingWorker
+from tests.pricing.conftest import make_price_item
+
+
+# ---------------------------------------------------------------------------
+# Gate 2a: Zero outbound HTTP to external API domains (BUSINESS CRITICAL)
+# ---------------------------------------------------------------------------
+
+
+class TestNoProductionCalls:
+    """Absolute zero outbound HTTP to api.target.com or stage-api.target.com."""
+
+    @respx.mock
+
+    async def test_no_outbound_calls_to_target_api_production(
+        self, mock_pricing_client: AsyncMock
+    ) -> None:
+        """Full enqueue-process cycle makes zero HTTP calls to api.target.com."""
+        # Block all requests to production Target API
+        target_prod = respx.route(host="api.target.com").mock(
+            side_effect=AssertionError("BLOCKED: outbound call to api.target.com detected!")
+        )
+        target_stage = respx.route(host="stage-api.target.com").mock(
+            side_effect=AssertionError("BLOCKED: outbound call to stage-api.target.com detected!")
+        )
+
+        item = make_price_item(product_id="TCIN-NOPROD")
+        await enqueue_price_updates([item.model_dump()])
+
+        worker = PricingWorker()
+        await worker.process_one()
+
+        # Verify zero calls to either domain
+        assert target_prod.call_count == 0, "Production API was called!"
+        assert target_stage.call_count == 0, "Staging API was called!"
+
+
+    async def test_mock_adapter_injected_in_test_mode(self) -> None:
+        """In test mode, the pricing client is a mock, not HttpTargetPricingClient."""
+        # Phase 8 implements DI; this verifies the worker's client is injected as a mock
+        worker = PricingWorker()
+        # Worker must have a 'client' attribute set via DI
+        assert hasattr(worker, "client"), "Worker must expose a 'client' attribute for DI"
+        assert worker.client is not None, "Worker client must be set in test mode"
+        assert not isinstance(
+            worker.client, HttpTargetPricingClient
+        ), "Worker is using the real HTTP client in tests!"
+
+
+    async def test_endpoint_reports_failure_when_client_returns_error(
+        self, mock_pricing_client: AsyncMock
+    ) -> None:
+        """When the mock client returns an error, the endpoint doesn't return 'success'."""
+        mock_pricing_client.update_price.return_value = PriceUpdateResult(
+            success=False, http_status=500, error_detail="Internal Server Error"
+        )
+        item = make_price_item(product_id="TCIN-ERR-REPORT")
+        await enqueue_price_updates([item.model_dump()])
+
+        worker = PricingWorker()
+        await worker.process_one()
+
+        from app.pricing.queue import get_product_status
+        status = await get_product_status("TCIN-ERR-REPORT")
+        # Must NOT have a success entry — failure must be reflected
+        assert status["last_success"] is None
+        assert status["queue"][0]["status"] in ("failed", "dead_letter")
+
+
+# ---------------------------------------------------------------------------
+# Gate 10: Error observability — logging on exceptions
+# ---------------------------------------------------------------------------
+
+
+class TestErrorObservability:
+    """Broad exception handlers log before returning/continuing."""
+
+
+    async def test_worker_logs_on_target_api_error(
+        self, mock_pricing_client: AsyncMock, caplog: pytest.LogCaptureFixture
+    ) -> None:
+        """Worker logs error with product_id, seller_id, http_status on Target 500."""
+        mock_pricing_client.update_price.return_value = PriceUpdateResult(
+            success=False, http_status=500, error_detail="Internal Server Error"
+        )
+        item = make_price_item(product_id="TCIN-LOG-500", seller_id="SELLER_LOG")
+        await enqueue_price_updates([item.model_dump()])
+
+        with caplog.at_level(logging.ERROR):
+            worker = PricingWorker()
+            await worker.process_one()
+
+        # Verify structured logging includes relevant context
+        assert any("TCIN-LOG-500" in record.message for record in caplog.records), \
+            "Error log must include product_id"
+        assert any("500" in record.message or getattr(record, "http_status", None) == 500
+                    for record in caplog.records), \
+            "Error log must include HTTP status"
+
+
+    async def test_worker_logs_on_connection_error(
+        self, mock_pricing_client: AsyncMock, caplog: pytest.LogCaptureFixture
+    ) -> None:
+        """Worker logs connection error with operation context."""
+        mock_pricing_client.update_price.side_effect = httpx.ConnectError("Connection refused")
+        item = make_price_item(product_id="TCIN-LOG-CONN")
+        await enqueue_price_updates([item.model_dump()])
+
+        with caplog.at_level(logging.ERROR):
+            worker = PricingWorker()
+            await worker.process_one()
+
+        assert any("TCIN-LOG-CONN" in record.message for record in caplog.records), \
+            "Connection error log must include product_id"
+
+
+    async def test_worker_logs_on_dead_letter(
+        self, mock_pricing_client: AsyncMock, caplog: pytest.LogCaptureFixture
+    ) -> None:
+        """Dead-lettering an item logs a warning with the error detail."""
+        mock_pricing_client.update_price.return_value = PriceUpdateResult(
+            success=False, http_status=400, error_detail="Malformed request body"
+        )
+        item = make_price_item(product_id="TCIN-LOG-DL")
+        await enqueue_price_updates([item.model_dump()])
+
+        with caplog.at_level(logging.WARNING):
+            worker = PricingWorker()
+            await worker.process_one()
+
+        assert any("TCIN-LOG-DL" in record.message for record in caplog.records), \
+            "Dead-letter log must include product_id"
+        assert any("dead" in record.message.lower() or "dead_letter" in record.message.lower()
+                    for record in caplog.records), \
+            "Dead-letter log must mention dead-letter status"
+
+
+# ---------------------------------------------------------------------------
+# Gate 12: Integration smoke — real adapter code path (not mocked adapter)
+# ---------------------------------------------------------------------------
+
+
+class TestHttpClientSmoke:
+    """HttpTargetPricingClient instantiates and handles errors without calling real API."""
+
+    @respx.mock
+
+    async def test_http_client_sends_put_to_correct_url(self) -> None:
+        """HttpTargetPricingClient constructs the correct PUT URL pattern."""
+        # Mock the Target API URL — never actually called
+        route = respx.put(
+            url__regex=r".*/sellers/v1/sellers/SELLER_001/prices/TCIN-HTTP.*"
+        ).mock(return_value=httpx.Response(200, json={}))
+
+        client = HttpTargetPricingClient()
+        result = await client.update_price(
+            seller_id="SELLER_001",
+            product_id="TCIN-HTTP",
+            list_price=Decimal("19.99"),
+            offer_price=Decimal("17.99"),
+            map_price=Decimal("15.00"),
+        )
+        assert route.called
+        assert result.success is True
+
+    @respx.mock
+
+    async def test_http_client_handles_connection_error(self) -> None:
+        """HttpTargetPricingClient wraps connection errors into PriceUpdateResult."""
+        respx.put(url__regex=r".*").mock(side_effect=httpx.ConnectError("refused"))
+
+        client = HttpTargetPricingClient()
+        result = await client.update_price(
+            seller_id="SELLER_001",
+            product_id="TCIN-CONN",
+            list_price=Decimal("19.99"),
+            offer_price=None,
+            map_price=None,
+        )
+        assert result.success is False
+        assert result.error_detail is not None
