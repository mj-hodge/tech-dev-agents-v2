+"""TargetPricingClient protocol + HTTP implementation + DI helpers."""
+
+from __future__ import annotations
+
+from decimal import Decimal
+from typing import Protocol
+
+import httpx
+
+from app.pricing.schemas import PriceUpdateResult
+
+
+class TargetPricingClient(Protocol):
+    """Interface for Target pricing API calls. DI'd for testability."""
+
+    async def update_price(
+        self,
+        seller_id: str,
+        product_id: str,
+        list_price: Decimal,
+        offer_price: Decimal | None,
+        map_price: Decimal | None,
+    ) -> PriceUpdateResult: ...
+
+
+class HttpTargetPricingClient:
+    """Real HTTP client for Target API — sends PUT to per-item pricing endpoint."""
+
+    def __init__(
+        self,
+        base_url: str = "https://stage-api.target.com",
+        timeout: float = 30.0,
+    ) -> None:
+        self._base_url = base_url.rstrip("/")
+        self._timeout = timeout
+
+    async def update_price(
+        self,
+        seller_id: str,
+        product_id: str,
+        list_price: Decimal,
+        offer_price: Decimal | None,
+        map_price: Decimal | None,
+    ) -> PriceUpdateResult:
+        url = (
+            f"{self._base_url}/sellers/v1/sellers/{seller_id}/prices/{product_id}"
+        )
+        body: dict = {"list_price": str(list_price)}
+        if offer_price is not None:
+            body["offer_price"] = str(offer_price)
+        if map_price is not None:
+            body["map_price"] = str(map_price)
+
+        try:
+            async with httpx.AsyncClient(timeout=self._timeout) as client:
+                resp = await client.put(url, json=body)
+
+            if 200 <= resp.status_code < 300:
+                return PriceUpdateResult(
+                    success=True, http_status=resp.status_code, error_detail=None
+                )
+            return PriceUpdateResult(
+                success=False,
+                http_status=resp.status_code,
+                error_detail=resp.text or f"HTTP {resp.status_code}",
+            )
+        except httpx.TimeoutException as exc:
+            return PriceUpdateResult(
+                success=False, http_status=None, error_detail=f"Timeout: {exc}"
+            )
+        except httpx.ConnectError as exc:
+            return PriceUpdateResult(
+                success=False, http_status=None, error_detail=f"Connection error: {exc}"
+            )
+        except httpx.HTTPError as exc:
+            return PriceUpdateResult(
+                success=False, http_status=None, error_detail=f"HTTP error: {exc}"
+            )
+
+
+# ---------------------------------------------------------------------------
+# Simple DI: module-level client override for testing
+# ---------------------------------------------------------------------------
+
+_client_override: TargetPricingClient | None = None
+
+
+def _set_client(client: TargetPricingClient | None) -> None:
+    """Override the global pricing client (used by test fixtures)."""
+    global _client_override
+    _client_override = client
+
+
+def get_client() -> TargetPricingClient:
+    """Return the current pricing client (override or real HTTP)."""
+    if _client_override is not None:
+        return _client_override
+    return HttpTargetPricingClient()
