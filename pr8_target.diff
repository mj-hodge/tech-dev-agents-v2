+"""Background pricing worker — rate-limited, single-threaded queue processor."""
+
+from __future__ import annotations
+
+import asyncio
+import logging
+import time
+from decimal import Decimal
+
+from app.pricing.client import get_client
+from app.pricing.queue import (
+    dequeue_next,
+    mark_complete,
+    mark_dead_letter,
+    mark_failed,
+    record_history,
+)
+from app.pricing.schemas import PriceUpdateResult
+
+logger = logging.getLogger(__name__)
+
+# HTTP status codes that are permanent failures (dead-letter immediately)
+_PERMANENT_FAILURE_CODES = frozenset({400, 401, 403, 404, 422})
+
+# Max backoff cap in seconds
+_MAX_BACKOFF_SECONDS = 300
+
+
+def _calculate_backoff(retry_count: int, base: float = 2.0) -> float:
+    """Exponential backoff: base * 2^retry_count, capped at _MAX_BACKOFF_SECONDS."""
+    delay = base * (2 ** retry_count)
+    return min(delay, _MAX_BACKOFF_SECONDS)
+
+
+class PricingWorker:
+    """Single-threaded rate-limited worker that drains the price queue."""
+
+    def __init__(
+        self,
+        rate_limit_rps: float = 1.0,
+        poll_interval: int = 5,
+        max_retries: int = 5,
+    ) -> None:
+        self.rate_limit_rps = rate_limit_rps
+        self.poll_interval = poll_interval
+        self.max_retries = max_retries
+        self.running = False
+        self.client = get_client()
+        self._last_request_time: float | None = None
+
+    async def start(self) -> None:
+        """Start the worker loop — runs until stop() is called."""
+        self.running = True
+        while self.running:
+            processed = await self.process_one()
+            if not processed:
+                await asyncio.sleep(self.poll_interval)
+
+    async def stop(self) -> None:
+        """Gracefully stop the worker."""
+        self.running = False
+
+    async def _rate_limit_sleep(self) -> None:
+        """Enforce rate limit by sleeping between requests."""
+        if self._last_request_time is not None:
+            interval = 1.0 / self.rate_limit_rps
+            elapsed = time.monotonic() - self._last_request_time
+            remaining = interval - elapsed
+            if remaining > 0:
+                await asyncio.sleep(remaining)
+        self._last_request_time = time.monotonic()
+
+    async def process_one(self) -> bool:
+        """Process a single queue item. Returns True if item was processed."""
+        row = await dequeue_next()
+        if row is None:
+            return False
+
+        queue_id: int = row["id"]
+        product_id: str = row["product_id"]
+        seller_id: str = row["seller_id"]
+        list_price: Decimal = row["list_price"]
+        offer_price: Decimal | None = row["offer_price"]
+        map_price: Decimal | None = row["map_price"]
+        map_price_source: str = row["map_price_source"]
+        retry_count: int = row["retry_count"]
+
+        # Enforce rate limit before making the API call
+        await self._rate_limit_sleep()
+
+        start_ms = time.monotonic()
+        result: PriceUpdateResult | None = None
+        error_from_exception: str | None = None
+
+        try:
+            result = await self.client.update_price(
+                seller_id=seller_id,
+                product_id=product_id,
+                list_price=list_price,
+                offer_price=offer_price,
+                map_price=map_price,
+            )
+        except Exception as exc:
+            # Safety net: TargetPricingClient implementations should return
+            # PriceUpdateResult rather than raising, but catch any unexpected
+            # exception (e.g., protocol violation, bug in a test mock) so the
+            # worker loop can dead-letter rather than crash.
+            error_from_exception = f"{type(exc).__name__}: {exc}"
+            logger.error(
+                "Unexpected error from pricing client for product_id=%s seller_id=%s: %s",
+                product_id,
+                seller_id,
+                error_from_exception,
+            )
+
+        duration_ms = int((time.monotonic() - start_ms) * 1000)
+
+        # --- Handle exception (network-level failure) ---
+        if result is None:
+            new_retry = retry_count + 1
+            if new_retry >= self.max_retries:
+                await mark_dead_letter(queue_id, error_from_exception or "Max retries exceeded")
+                await record_history(
+                    product_id=product_id,
+                    seller_id=seller_id,
+                    list_price=list_price,
+                    offer_price=offer_price,
+                    map_price=map_price,
+                    map_price_source=map_price_source,
+                    http_status=None,
+                    response_body=None,
+                    error_detail=error_from_exception,
+                    outcome="server_error",
+                    duration_ms=duration_ms,
+                )
+                logger.warning(
+                    "Dead-lettered product_id=%s seller_id=%s after %d retries: %s",
+                    product_id,
+                    seller_id,
+                    new_retry,
+                    error_from_exception,
+                )
+            else:
+                backoff = _calculate_backoff(new_retry)
+                await record_history(
+                    product_id=product_id,
+                    seller_id=seller_id,
+                    list_price=list_price,
+                    offer_price=offer_price,
+                    map_price=map_price,
+                    map_price_source=map_price_source,
+                    http_status=None,
+                    response_body=None,
+                    error_detail=error_from_exception,
+                    outcome="transient_error",
+                    duration_ms=duration_ms,
+                )
+                await mark_failed(queue_id, new_retry, error_from_exception or "Unknown error", backoff)
+            return True
+
+        # --- Handle successful API response ---
+        if result.success:
+            await record_history(
+                product_id=product_id,
+                seller_id=seller_id,
+                list_price=list_price,
+                offer_price=offer_price,
+                map_price=map_price,
+                map_price_source=map_price_source,
+                http_status=result.http_status,
+                response_body=None,
+                error_detail=None,
+                outcome="success",
+                duration_ms=duration_ms,
+            )
+            await mark_complete(queue_id)
+            return True
+
+        # --- Handle error responses ---
+        http_status = result.http_status or 0
+        error_detail = result.error_detail or f"HTTP {http_status}"
+
+        # Permanent failure — dead-letter immediately
+        if http_status in _PERMANENT_FAILURE_CODES:
+            await mark_dead_letter(queue_id, error_detail)
+            await record_history(
+                product_id=product_id,
+                seller_id=seller_id,
+                list_price=list_price,
+                offer_price=offer_price,
+                map_price=map_price,
+                map_price_source=map_price_source,
+                http_status=http_status,
+                response_body=None,
+                error_detail=error_detail,
+                outcome="client_error",
+                duration_ms=duration_ms,
+            )
+            logger.warning(
+                "Dead-lettered product_id=%s seller_id=%s: HTTP %d — %s",
+                product_id,
+                seller_id,
+                http_status,
+                error_detail,
+            )
+            return True
+
+        # Retryable failure (429, 5xx)
+        new_retry = retry_count + 1
+        if new_retry >= self.max_retries:
+            await mark_dead_letter(queue_id, error_detail)
+            await record_history(
+                product_id=product_id,
+                seller_id=seller_id,
+                list_price=list_price,
+                offer_price=offer_price,
+                map_price=map_price,
+                map_price_source=map_price_source,
+                http_status=http_status,
+                response_body=None,
+                error_detail=error_detail,
+                outcome="server_error",
+                duration_ms=duration_ms,
+            )
+            logger.warning(
+                "Dead-lettered product_id=%s seller_id=%s after %d retries: HTTP %d",
+                product_id,
+                seller_id,
+                new_retry,
+                http_status,
+            )
+        else:
+            backoff = _calculate_backoff(new_retry)
+            await record_history(
+                product_id=product_id,
+                seller_id=seller_id,
+                list_price=list_price,
+                offer_price=offer_price,
+                map_price=map_price,
+                map_price_source=map_price_source,
+                http_status=http_status,
+                response_body=None,
+                error_detail=error_detail,
+                outcome="transient_error",
+                duration_ms=duration_ms,
+            )
+            await mark_failed(queue_id, new_retry, error_detail, backoff)
+            logger.error(
+                "Retryable failure for product_id=%s seller_id=%s: HTTP %d — %s (retry %d, backoff %.1fs)",
+                product_id,
+                seller_id,
+                http_status,
+                error_detail,
+                new_retry,
+                backoff,
+            )
+
+        return True
