+"""Seller context enforcement."""
+
+from app.core.exceptions import AuthorizationError
+
+
+async def enforce_seller_context(seller_id: str, current_user: dict | None) -> None:
+    """Validate current_user has access to seller_id.
+
+    Raises AuthorizationError if mismatch or missing user context.
+    """
+    if current_user is None:
+        raise AuthorizationError("Authentication required")
+
+    user_seller_id = current_user.get("seller_id")
+    if user_seller_id is None:
+        raise AuthorizationError("User has no seller context")
+
+    if user_seller_id != seller_id:
+        raise AuthorizationError(
+            f"User seller {user_seller_id} cannot access seller {seller_id}"
+        )
