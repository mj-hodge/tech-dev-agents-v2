+"""Shared fixtures for pricing tests."""
+
+from decimal import Decimal
+from unittest.mock import AsyncMock
+
+import pytest
+
+from app.pricing.schemas import PriceItem, PriceUpdateResult
+
+
+# ---------------------------------------------------------------------------
+# Fixture factories
+# ---------------------------------------------------------------------------
+
+def make_price_item(
+    product_id: str = "TCIN-001",
+    seller_id: str = "SELLER_001",
+    list_price: Decimal = Decimal("19.99"),
+    offer_price: Decimal | None = Decimal("17.99"),
+    map_price: Decimal | None = Decimal("15.00"),
+    map_price_source: str = "manual",
+) -> PriceItem:
+    """Build a valid PriceItem for tests. Override any field as needed."""
+    return PriceItem(
+        product_id=product_id,
+        seller_id=seller_id,
+        list_price=list_price,
+        offer_price=offer_price,
+        map_price=map_price,
+        map_price_source=map_price_source,
+    )
+
+
+@pytest.fixture()
+def price_item() -> PriceItem:
+    """A default valid price item."""
+    return make_price_item()
+
+
+@pytest.fixture()
+def mock_pricing_client() -> AsyncMock:
+    """Mock TargetPricingClient that returns a success result by default.
+
+    Also wires the mock into the DI layer so PricingWorker picks it up.
+    """
+    client = AsyncMock()
+    client.update_price.return_value = PriceUpdateResult(
+        success=True, http_status=200, error_detail=None
+    )
+    from app.pricing.client import _set_client
+    _set_client(client)
+    return client
+
+
+@pytest.fixture()
+def price_item_b() -> PriceItem:
+    """A second valid price item with different values (for output-variance tests)."""
+    return make_price_item(
+        product_id="TCIN-002",
+        list_price=Decimal("49.99"),
+        offer_price=Decimal("39.99"),
+        map_price=Decimal("35.00"),
+    )
+
+
+# ---------------------------------------------------------------------------
+# Auto-use: reset in-memory state + default mock between every test
+# ---------------------------------------------------------------------------
+
+@pytest.fixture(autouse=True)
+def _pricing_test_isolation():
+    """Reset queue/history storage and client override before each test."""
+    from app.pricing.client import _set_client
+    from app.pricing.queue import _reset_state
+
+    _reset_state()
+    # Set a default mock so PricingWorker never uses the real HTTP client in tests
+    default_mock = AsyncMock()
+    default_mock.update_price.return_value = PriceUpdateResult(
+        success=True, http_status=200, error_detail=None
+    )
+    _set_client(default_mock)
+
+    yield
+
+    _reset_state()
+    _set_client(None)
