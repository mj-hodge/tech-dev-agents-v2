+"""Tests for rate-limit enforcement in the pricing worker.
+
+Covers: SC-1 (honored rate limit), burst load verification,
+exponential backoff, 429 handling.
+"""
+
+import asyncio
+import time
+from decimal import Decimal
+from unittest.mock import AsyncMock, patch
+
+import pytest
+
+from app.pricing.schemas import PriceUpdateResult
+from app.pricing.queue import enqueue_price_updates, _force_retry_eligible
+from app.pricing.worker import PricingWorker
+from tests.pricing.conftest import make_price_item
+
+
+# ---------------------------------------------------------------------------
+# Rate-limit enforcement: worker respects configured RPS
+# ---------------------------------------------------------------------------
+
+
+class TestRateLimitEnforcement:
+    """Worker sleeps between PUTs to stay under the configured rate limit."""
+
+
+    async def test_two_puts_respect_rate_interval(self, mock_pricing_client: AsyncMock) -> None:
+        """At 1 req/s, two consecutive PUTs take >= 1 second apart."""
+        # Arrange: enqueue two items
+        item_a = make_price_item(product_id="TCIN-RATE-A")
+        item_b = make_price_item(product_id="TCIN-RATE-B", list_price=Decimal("29.99"))
+        await enqueue_price_updates([item_a.model_dump()])
+        await enqueue_price_updates([item_b.model_dump()])
+
+        worker = PricingWorker(rate_limit_rps=1.0)
+        start = time.monotonic()
+        await worker.process_one()
+        await worker.process_one()
+        elapsed = time.monotonic() - start
+
+        # Two items at 1 req/s → should take at least 1 second
+        assert elapsed >= 1.0
+        assert mock_pricing_client.update_price.call_count == 2
+
+
+    async def test_rate_limit_configurable_via_constructor(self, mock_pricing_client: AsyncMock) -> None:
+        """rate_limit_rps=10 → puts happen ~10x faster than rps=1."""
+        item_a = make_price_item(product_id="TCIN-FAST-A")
+        item_b = make_price_item(product_id="TCIN-FAST-B", list_price=Decimal("29.99"))
+        await enqueue_price_updates([item_a.model_dump()])
+        await enqueue_price_updates([item_b.model_dump()])
+
+        worker = PricingWorker(rate_limit_rps=10.0)
+        start = time.monotonic()
+        await worker.process_one()
+        await worker.process_one()
+        elapsed = time.monotonic() - start
+
+        # At 10 req/s, gap is 0.1s → total should be well under 1s
+        assert elapsed < 1.0
+        assert mock_pricing_client.update_price.call_count == 2
+
+
+    async def test_burst_of_five_items_paced_correctly(self, mock_pricing_client: AsyncMock) -> None:
+        """5 items at 2 req/s → takes at least 2 seconds (4 gaps × 0.5s)."""
+        for i in range(5):
+            # Use offer_price=None to avoid list_price < offer_price validation error
+            # (offer_price default is 17.99 which exceeds list_prices below 18.00)
+            item = make_price_item(
+                product_id=f"TCIN-BURST-{i}",
+                list_price=Decimal(f"{20 + i}.99"),
+                offer_price=Decimal(f"{18 + i}.99"),
+            )
+            await enqueue_price_updates([item.model_dump()])
+
+        worker = PricingWorker(rate_limit_rps=2.0)
+        start = time.monotonic()
+        for _ in range(5):
+            await worker.process_one()
+        elapsed = time.monotonic() - start
+
+        assert elapsed >= 2.0  # 4 gaps × 0.5s = 2.0s minimum
+        assert mock_pricing_client.update_price.call_count == 5
+
