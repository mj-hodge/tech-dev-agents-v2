+"""Pydantic request/response schemas — stub for Phase 7 imports. Phase 8 implements."""
+
+from decimal import Decimal
+from typing import Literal
+
+from pydantic import BaseModel, ConfigDict, Field, model_validator
+
+
+class PriceItem(BaseModel):
+    """Single price update request item."""
+
+    model_config = ConfigDict(extra="forbid")
+
+    product_id: str = Field(..., min_length=1, max_length=64)
+    seller_id: str = Field(..., min_length=1, max_length=64)
+    list_price: Decimal = Field(..., gt=0, decimal_places=2)
+    offer_price: Decimal | None = Field(None, gt=0, decimal_places=2)
+    map_price: Decimal | None = Field(None, gt=0, decimal_places=2)
+    map_price_source: Literal["manual", "netsuite"] = "manual"
+
+    @model_validator(mode="after")
+    def offer_price_must_not_exceed_list_price(self) -> "PriceItem":
+        """Spec requirement: offer_price, if present, must be <= list_price."""
+        if self.offer_price is not None and self.offer_price > self.list_price:
+            raise ValueError(
+                f"offer_price ({self.offer_price}) must be <= list_price ({self.list_price})"
+            )
+        return self
+
+
+class EnqueueRequest(BaseModel):
+    """Batch enqueue request."""
+
+    model_config = ConfigDict(extra="forbid")
+
+    items: list[PriceItem] = Field(..., min_length=1, max_length=100)
+
+
+class EnqueueResponse(BaseModel):
+    """Enqueue result."""
+
+    enqueued: int
+    deduplicated: int
+    total: int
+
+
+class PriceUpdateResult(BaseModel):
+    """Result from Target API price PUT."""
+
+    success: bool
+    http_status: int | None = None
+    error_detail: str | None = None
