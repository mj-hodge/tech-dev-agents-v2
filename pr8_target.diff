+# ---------------------------------------------------------------------------
+# 429 Rate-limited: honor Retry-After header
+# ---------------------------------------------------------------------------
+
+
+class TestRetryAfterHandling:
+    """Worker honors Retry-After from Target 429 responses."""
+
+
+    async def test_429_increments_retry_count(self, mock_pricing_client: AsyncMock) -> None:
+        """429 response → queue row retry_count increases by 1."""
+        mock_pricing_client.update_price.return_value = PriceUpdateResult(
+            success=False, http_status=429, error_detail="Rate limited"
+        )
+        item = make_price_item(product_id="TCIN-429")
+        await enqueue_price_updates([item.model_dump()])
+
+        worker = PricingWorker()
+        await worker.process_one()
+
+        from app.pricing.queue import get_product_status
+        status = await get_product_status("TCIN-429")
+        assert status["queue"][0]["retry_count"] == 1
+        assert status["queue"][0]["status"] == "failed"
+
+
+    async def test_429_sets_next_retry_at_in_future(self, mock_pricing_client: AsyncMock) -> None:
+        """After 429, next_retry_at is set to a future timestamp (backoff)."""
+        mock_pricing_client.update_price.return_value = PriceUpdateResult(
+            success=False, http_status=429, error_detail="Rate limited"
+        )
+        item = make_price_item(product_id="TCIN-BACKOFF")
+        await enqueue_price_updates([item.model_dump()])
+
+        worker = PricingWorker()
+        await worker.process_one()
+
+        from app.pricing.queue import get_product_status
+        status = await get_product_status("TCIN-BACKOFF")
+        assert status["queue"][0]["next_retry_at"] is not None
+
+
+# ---------------------------------------------------------------------------
+# Exponential backoff: delay increases with retry count
+# ---------------------------------------------------------------------------
+
+
+class TestExponentialBackoff:
+    """Backoff delay grows exponentially: base * 2^retry_count."""
+
+
+    async def test_backoff_increases_with_retry_count(self, mock_pricing_client: AsyncMock) -> None:
+        """Retry 0 → ~4s delay; retry 1 → ~8s delay (exponential growth verified)."""
+        mock_pricing_client.update_price.return_value = PriceUpdateResult(
+            success=False, http_status=500, error_detail="Server Error"
+        )
+        item = make_price_item(product_id="TCIN-EXPBACK")
+        await enqueue_price_updates([item.model_dump()])
+
+        from app.pricing.queue import get_product_status
+
+        worker = PricingWorker()
+
+        # First failure — captures next_retry_at
+        await worker.process_one()
+        status1 = await get_product_status("TCIN-EXPBACK")
+        retry_at_1 = status1["queue"][0]["next_retry_at"]
+        assert retry_at_1 is not None
+
+        # Simulate clock advancing past next_retry_at so the row is eligible again
+        _force_retry_eligible(status1["queue"][0]["id"])
+
+        # Second failure — backoff should be longer than first
+        await worker.process_one()
+        status2 = await get_product_status("TCIN-EXPBACK")
+        retry_at_2 = status2["queue"][0]["next_retry_at"]
+        assert retry_at_2 is not None
+
+        # Second next_retry_at is further in the future than the first
+        assert retry_at_2 > retry_at_1
+
+
+    async def test_backoff_capped_at_300_seconds(self, mock_pricing_client: AsyncMock) -> None:
+        """Max backoff delay is 300 seconds (5 minutes), per spec."""
+        from datetime import timezone as tz
+        import datetime as dt
+
+        mock_pricing_client.update_price.return_value = PriceUpdateResult(
+            success=False, http_status=500, error_detail="Server Error"
+        )
+        item = make_price_item(product_id="TCIN-CAP")
+        await enqueue_price_updates([item.model_dump()])
+
+        from app.pricing.queue import get_product_status
+
+        worker = PricingWorker()
+        # Drive through multiple retries, advancing time between each
+        for _ in range(4):
+            await worker.process_one()
+            status = await get_product_status("TCIN-CAP")
+            if not status["queue"]:
+                break
+            _force_retry_eligible(status["queue"][0]["id"])
+
+        # Final check: next_retry_at must exist and backoff must be <= 300s
+        status = await get_product_status("TCIN-CAP")
+        queue_row = status["queue"][0] if status and status["queue"] else None
+        if queue_row and queue_row["next_retry_at"] is not None:
+            now = dt.datetime.now(tz.utc)
+            backoff_seconds = (queue_row["next_retry_at"] - now).total_seconds()
+            assert backoff_seconds <= 302, f"Backoff {backoff_seconds}s exceeds 300s cap"
