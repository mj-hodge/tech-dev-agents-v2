+"""Tests for MAP-price-only update — preserving list_price and offer_price.
+
+Covers: MAP price source handling, map_price_source enum, partial update safety.
+"""
+
+from decimal import Decimal
+from unittest.mock import AsyncMock
+
+import pytest
+
+from app.pricing.schemas import PriceUpdateResult
+from app.pricing.queue import enqueue_price_updates, get_product_status
+from app.pricing.worker import PricingWorker
+from tests.pricing.conftest import make_price_item
+
+
+# ---------------------------------------------------------------------------
+# MAP-only update: map_price changes while list/offer stay the same
+# ---------------------------------------------------------------------------
+
+
+class TestMapOnlyUpdate:
+    """Updating only map_price preserves existing list_price and offer_price."""
+
+
+    async def test_map_only_update_preserves_list_and_offer(
+        self, mock_pricing_client: AsyncMock
+    ) -> None:
+        """Enqueue with new map_price but same list/offer → PUT sends all three."""
+        # First PUT: full price set
+        item_v1 = make_price_item(
+            product_id="TCIN-MAP-1",
+            list_price=Decimal("29.99"),
+            offer_price=Decimal("24.99"),
+            map_price=Decimal("20.00"),
+        )
+        await enqueue_price_updates([item_v1.model_dump()])
+        worker = PricingWorker()
+        await worker.process_one()
+
+        # Second PUT: only map_price changed
+        item_v2 = make_price_item(
+            product_id="TCIN-MAP-1",
+            list_price=Decimal("29.99"),
+            offer_price=Decimal("24.99"),
+            map_price=Decimal("22.00"),  # changed
+        )
+        await enqueue_price_updates([item_v2.model_dump()])
+        await worker.process_one()
+
+        # Verify the PUT sent correct values
+        last_call = mock_pricing_client.update_price.call_args
+        assert last_call.kwargs["list_price"] == Decimal("29.99")
+        assert last_call.kwargs["offer_price"] == Decimal("24.99")
+        assert last_call.kwargs["map_price"] == Decimal("22.00")
+
+
+    async def test_map_price_with_manual_source(self, mock_pricing_client: AsyncMock) -> None:
+        """map_price_source='manual' is recorded in queue and history."""
+        item = make_price_item(
+            product_id="TCIN-MAP-MANUAL",
+            map_price=Decimal("18.00"),
+            map_price_source="manual",
+        )
+        await enqueue_price_updates([item.model_dump()])
+        worker = PricingWorker()
+        await worker.process_one()
+
+        status = await get_product_status("TCIN-MAP-MANUAL")
+        assert status is not None
+        assert status["last_success"]["map_price_source"] == "manual"
+
+
+    async def test_map_price_with_netsuite_source(self, mock_pricing_client: AsyncMock) -> None:
+        """map_price_source='netsuite' is valid and recorded."""
+        item = make_price_item(
+            product_id="TCIN-MAP-NS",
+            map_price=Decimal("18.00"),
+            map_price_source="netsuite",
+        )
+        await enqueue_price_updates([item.model_dump()])
+        worker = PricingWorker()
+        await worker.process_one()
+
+        status = await get_product_status("TCIN-MAP-NS")
+        assert status is not None
+        assert status["last_success"]["map_price_source"] == "netsuite"
+
+
+    async def test_map_price_none_update(self, mock_pricing_client: AsyncMock) -> None:
+        """Enqueue with map_price=None → PUT sends None for map_price."""
+        item = make_price_item(
+            product_id="TCIN-MAP-NONE",
+            list_price=Decimal("29.99"),
+            offer_price=Decimal("24.99"),
+            map_price=None,
+        )
+        await enqueue_price_updates([item.model_dump()])
+        worker = PricingWorker()
+        await worker.process_one()
+
+        last_call = mock_pricing_client.update_price.call_args
+        assert last_call.kwargs["map_price"] is None
+
+
+# ---------------------------------------------------------------------------
+# Output-variance: different map_price → different history entries
+# ---------------------------------------------------------------------------
+
+
+class TestMapPriceOutputVariance:
+    """Two MAP updates with different values produce different history records."""
+
+
+    async def test_different_map_prices_produce_different_history(
+        self, mock_pricing_client: AsyncMock
+    ) -> None:
+        """map_price $20 vs $25 → two distinct history entries."""
+        item_a = make_price_item(
+            product_id="TCIN-MAPVAR-A",
+            map_price=Decimal("20.00"),
+        )
+        item_b = make_price_item(
+            product_id="TCIN-MAPVAR-B",
+            map_price=Decimal("25.00"),
+        )
+        await enqueue_price_updates([item_a.model_dump()])
+        await enqueue_price_updates([item_b.model_dump()])
+
+        worker = PricingWorker()
+        await worker.process_one()
+        await worker.process_one()
+
+        status_a = await get_product_status("TCIN-MAPVAR-A")
+        status_b = await get_product_status("TCIN-MAPVAR-B")
+        assert status_a["last_success"]["map_price"] != status_b["last_success"]["map_price"]
