+"""RFC 7807 AppException hierarchy — stub for Phase 7 imports. Phase 8 implements."""
+
+
+class AppException(Exception):
+    """Base application exception using RFC 7807 Problem Details."""
+
+    def __init__(
+        self,
+        status: int,
+        title: str,
+        detail: str,
+        error_type: str = "/problems/internal-error",
+        field_errors: list[dict] | None = None,
+    ) -> None:
+        self.status = status
+        self.title = title
+        self.detail = detail
+        self.error_type = error_type
+        self.field_errors = field_errors or []
+        super().__init__(detail)
+
+
+class ValidationError(AppException):
+    """422 — request validation failure."""
+
+    def __init__(self, detail: str, field_errors: list[dict] | None = None) -> None:
+        super().__init__(
+            status=422,
+            title="Validation Error",
+            detail=detail,
+            error_type="/problems/validation-error",
+            field_errors=field_errors,
+        )
+
+
+class AuthorizationError(AppException):
+    """403 — seller context mismatch or insufficient permissions."""
+
+    def __init__(self, detail: str = "Forbidden") -> None:
+        super().__init__(
+            status=403,
+            title="Forbidden",
+            detail=detail,
+            error_type="/problems/authorization-error",
+        )
+
+
+class NotFoundError(AppException):
+    """404 — resource not found."""
+
+    def __init__(self, detail: str = "Not found") -> None:
+        super().__init__(
+            status=404,
+            title="Not Found",
+            detail=detail,
+            error_type="/problems/not-found",
+        )
