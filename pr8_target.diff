+++ b/tests/pricing/test_idempotency_under_retry.py
@@ -0,0 +1,196 @@
+"""Tests for idempotent behavior under retry — duplicate (product_id, list, offer, map) deduplication.
+
+Covers: SC-2 (idempotent pricing proven under retry), Gate 3 (DB constraint alignment),
+Gate 9 (failure recovery), output-variance.
+"""
+
+from decimal import Decimal
+from unittest.mock import AsyncMock
+
+import pytest
+
+from app.pricing.schemas import PriceItem, PriceUpdateResult
+from app.pricing.queue import (
+    enqueue_price_updates,
+    get_product_status,
+    mark_dead_letter,
+    retry_dead_letter,
+    _force_retry_eligible,
+)
+from app.pricing.worker import PricingWorker
+from app.core.exceptions import AppException
+from tests.pricing.conftest import make_price_item
+
+
+# ---------------------------------------------------------------------------
+# SC-2: Idempotency — same price tuple → single queue entry, single PUT
+# ---------------------------------------------------------------------------
+
+
+class TestIdempotencyDedup:
+    """Duplicate (product_id, list, offer, map) tuples are deduplicated on enqueue."""
+
+
+    async def test_duplicate_tuple_counted_as_deduplicated(self) -> None:
+        """Enqueue same item twice → enqueued=1 first time, deduplicated=1 second time."""
+        item = make_price_item(product_id="TCIN-DUP")
+        result1 = await enqueue_price_updates([item.model_dump()])
+        assert result1["enqueued"] == 1
+        assert result1["deduplicated"] == 0
+
+        result2 = await enqueue_price_updates([item.model_dump()])
+        assert result2["enqueued"] == 0
+        assert result2["deduplicated"] == 1
+
+
+    async def test_duplicate_tuple_produces_single_http_call(
+        self, mock_pricing_client: AsyncMock
+    ) -> None:
+        """Identical tuple enqueued twice → worker sends exactly one PUT."""
+        item = make_price_item(product_id="TCIN-ONCE")
+        await enqueue_price_updates([item.model_dump()])
+        await enqueue_price_updates([item.model_dump()])  # deduplicated
+
+        worker = PricingWorker()
+        await worker.process_one()
+        # Second process_one should find nothing
+        found_second = await worker.process_one()
+
+        mock_pricing_client.update_price.assert_called_once()
+        assert found_second is False
+
+
+    async def test_same_product_different_price_not_deduplicated(self) -> None:
+        """Same product_id but different list_price → two separate queue entries."""
+        item_a = make_price_item(product_id="TCIN-DIFF", list_price=Decimal("19.99"))
+        item_b = make_price_item(product_id="TCIN-DIFF", list_price=Decimal("24.99"))
+
+        result_a = await enqueue_price_updates([item_a.model_dump()])
+        result_b = await enqueue_price_updates([item_b.model_dump()])
+
+        assert result_a["enqueued"] == 1
+        assert result_b["enqueued"] == 1  # different price → not a duplicate
+
+
+    async def test_batch_with_internal_duplicates(self) -> None:
+        """Batch of 3 items where 2 are identical → enqueued=2, deduplicated=1."""
+        item_a = make_price_item(product_id="TCIN-BATCH-1")
+        item_b = make_price_item(product_id="TCIN-BATCH-2")
+        # item_c is duplicate of item_a
+        item_c = make_price_item(product_id="TCIN-BATCH-1")
+
+        result = await enqueue_price_updates([
+            item_a.model_dump(), item_b.model_dump(), item_c.model_dump()
+        ])
+        assert result["enqueued"] == 2
+        assert result["deduplicated"] == 1
+        assert result["total"] == 3
+
+
+# ---------------------------------------------------------------------------
+# Gate 3: DB constraint alignment — NOT NULL columns
+# ---------------------------------------------------------------------------
+
+
+class TestDBConstraints:
+    """Queue table enforces NOT NULL constraints on required fields."""
+
+
+    async def test_queue_row_always_has_status(self) -> None:
+        """Every enqueued row has status='pending' (NOT NULL default)."""
+        item = make_price_item(product_id="TCIN-STATUS")
+        await enqueue_price_updates([item.model_dump()])
+        status = await get_product_status("TCIN-STATUS")
+        assert status is not None
+        assert status["queue"][0]["status"] == "pending"
+
+
+    async def test_queue_row_always_has_retry_count_zero(self) -> None:
+        """Fresh queue row starts with retry_count=0 (NOT NULL default)."""
+        item = make_price_item(product_id="TCIN-RETRY0")
+        await enqueue_price_updates([item.model_dump()])
+        status = await get_product_status("TCIN-RETRY0")
+        assert status["queue"][0]["retry_count"] == 0
+
+
+    async def test_queue_row_always_has_map_price_source_default(self) -> None:
+        """map_price_source defaults to 'manual' when not specified."""
+        item = make_price_item(product_id="TCIN-MAPSRC")
+        await enqueue_price_updates([item.model_dump()])
+        status = await get_product_status("TCIN-MAPSRC")
+        assert status["queue"][0]["map_price_source"] == "manual"
+
+
+# ---------------------------------------------------------------------------
+# Gate 9: Failure recovery — good data preserved on failure
+# ---------------------------------------------------------------------------
+
+
+class TestFailureRecovery:
+    """Failures don't destroy existing good data in queue or history."""
+
+
+    async def test_server_error_preserves_queue_row(self, mock_pricing_client: AsyncMock) -> None:
+        """5xx failure leaves the queue row intact (status=failed), not deleted."""
+        mock_pricing_client.update_price.return_value = PriceUpdateResult(
+            success=False, http_status=503, error_detail="Service Unavailable"
+        )
+        item = make_price_item(product_id="TCIN-PRESERVE")
+        await enqueue_price_updates([item.model_dump()])
+
+        worker = PricingWorker()
+        await worker.process_one()
+
+        status = await get_product_status("TCIN-PRESERVE")
+        assert status is not None
+        assert len(status["queue"]) == 1  # row still exists
+        assert status["queue"][0]["status"] == "failed"
+
+
+    async def test_retry_exhaustion_dead_letters_not_deletes(self, mock_pricing_client: AsyncMock) -> None:
+        """After max retries on 5xx, row moves to dead_letter (not deleted)."""
+        mock_pricing_client.update_price.return_value = PriceUpdateResult(
+            success=False, http_status=500, error_detail="Internal Server Error"
+        )
+        item = make_price_item(product_id="TCIN-EXHAUST")
+        await enqueue_price_updates([item.model_dump()])
+
+        worker = PricingWorker()
+        # Drive through max_retries exhaustion, advancing time between each
+        # so next_retry_at backoff is respected. Default max_retries=5 means
+        # 5 retries before dead-letter (6th call finds the dead_letter row).
+        for _ in range(6):
+            status = await get_product_status("TCIN-EXHAUST")
+            if status and status["queue"]:
+                _force_retry_eligible(status["queue"][0]["id"])
+            processed = await worker.process_one()
+            if not processed:
+                break
+
+        status = await get_product_status("TCIN-EXHAUST")
+        assert status is not None
+        assert status["queue"][0]["status"] == "dead_letter"
+
+
+    async def test_dead_letter_retry_resets_status_to_pending(self) -> None:
+        """Re-enqueuing a dead-lettered item sets status back to 'pending'."""
+        item = make_price_item(product_id="TCIN-REATTEMPT")
+        await enqueue_price_updates([item.model_dump()])
+        # Simulate dead-lettering
+        await mark_dead_letter(queue_id=1, error_detail="test failure")
+
+        result = await retry_dead_letter(dead_letter_id=1)
+        assert result["status"] == "re-enqueued"
+
+
+    async def test_dead_letter_retry_already_reenqueued_returns_409(self) -> None:
+        """Re-enqueuing an already re-enqueued dead letter → 409 Conflict."""
+        item = make_price_item(product_id="TCIN-DUP-RETRY")
+        await enqueue_price_updates([item.model_dump()])
+        await mark_dead_letter(queue_id=1, error_detail="test failure")
+        await retry_dead_letter(dead_letter_id=1)  # first retry
+
+        # Second retry should raise conflict
+        with pytest.raises(AppException) as exc_info:
+            await retry_dead_letter(dead_letter_id=1)
+        assert exc_info.value.status == 409
