+"""Enqueue / dequeue logic — in-memory implementation backed by dict storage.
+
+Production would use Postgres with SKIP LOCKED; this in-memory version honours
+the same API contract and is sufficient for unit/integration tests.
+
+Thread safety: the production backend achieves concurrency safety via
+SELECT FOR UPDATE SKIP LOCKED. This in-memory mock is single-event-loop
+safe under asyncio; no locking is needed or used.
+"""
+
+from __future__ import annotations
+
+from datetime import datetime, timedelta, timezone
+from decimal import Decimal
+from typing import Any
+
+from app.core.exceptions import AppException, NotFoundError
+
+# ---------------------------------------------------------------------------
+# In-memory storage (reset between tests via _reset_state)
+# ---------------------------------------------------------------------------
+
+_queue: dict[int, dict[str, Any]] = {}
+_history: list[dict[str, Any]] = []
+_next_id: int = 1
+
+
+def _reset_state() -> None:
+    """Clear all in-memory state. Called by test fixtures between tests."""
+    global _next_id
+    _queue.clear()
+    _history.clear()
+    _next_id = 1
+
+
+def _idempotency_key(item: dict) -> tuple:
+    """Composite key for deduplication: (product_id, list_price, offer_price, map_price)."""
+    return (
+        item["product_id"],
+        str(item["list_price"]),
+        str(item.get("offer_price")),
+        str(item.get("map_price")),
+    )
+
+
+# ---------------------------------------------------------------------------
+# Public API
+# ---------------------------------------------------------------------------
+
+
+async def enqueue_price_updates(items: list[dict]) -> dict:
+    """Insert price update jobs into the queue with dedup on composite key.
+
+    Returns {"enqueued": N, "deduplicated": M, "total": N+M}.
+    """
+    global _next_id
+    enqueued = 0
+    deduplicated = 0
+
+    # Build set of existing idempotency keys (pending/inflight only)
+    existing_keys: set[tuple] = set()
+    for row in _queue.values():
+        if row["status"] in ("pending", "inflight", "failed"):
+            existing_keys.add(_idempotency_key(row))
+
+    # Deduplicate within the batch itself
+    seen_in_batch: set[tuple] = set()
+
+    for item in items:
+        key = _idempotency_key(item)
+
+        if key in existing_keys or key in seen_in_batch:
+            deduplicated += 1
+            continue
+
+        seen_in_batch.add(key)
+        now = datetime.now(timezone.utc)
+        row_id = _next_id
+        _next_id += 1
+
+        _queue[row_id] = {
+            "id": row_id,
+            "product_id": item["product_id"],
+            "seller_id": item["seller_id"],
+            "list_price": Decimal(str(item["list_price"])),
+            "offer_price": Decimal(str(item["offer_price"])) if item.get("offer_price") is not None else None,
+            "map_price": Decimal(str(item["map_price"])) if item.get("map_price") is not None else None,
+            "map_price_source": item.get("map_price_source", "manual"),
+            "status": "pending",
+            "retry_count": 0,
+            "max_retries": 5,
+            "next_retry_at": None,
+            "error_detail": None,
+            "created_at": now,
+            "updated_at": now,
+            "claimed_at": None,
+        }
+        enqueued += 1
+
+    return {"enqueued": enqueued, "deduplicated": deduplicated, "total": enqueued + deduplicated}
+
+
+async def dequeue_next() -> dict | None:
+    """SELECT FOR UPDATE SKIP LOCKED the next eligible row.
+
+    Returns row dict or None if queue is empty / nothing eligible.
+    Respects next_retry_at: failed rows are only picked up after their
+    backoff window expires.
+    """
+    now = datetime.now(timezone.utc)
+    for row in sorted(_queue.values(), key=lambda r: r["created_at"]):
+        if row["status"] == "pending" or (
+            row["status"] == "failed"
+            and (row["next_retry_at"] is None or row["next_retry_at"] <= now)
+        ):
+            row["status"] = "inflight"
+            row["claimed_at"] = now
+            row["updated_at"] = now
+            return row
+    return None
+
+
+async def mark_complete(queue_id: int) -> None:
+    """Delete queue row after successful processing (history already recorded)."""
+    _queue.pop(queue_id, None)
+
+
+async def mark_failed(queue_id: int, retry_count: int, error_detail: str, backoff_seconds: float) -> None:
+    """Mark queue row as failed with incremented retry_count and next_retry_at."""
+    row = _queue.get(queue_id)
+    if row is None:
+        return
+    now = datetime.now(timezone.utc)
+    row["status"] = "failed"
+    row["retry_count"] = retry_count
+    row["error_detail"] = error_detail
+    row["next_retry_at"] = now + timedelta(seconds=backoff_seconds)
+    row["updated_at"] = now
+
+
+async def mark_dead_letter(queue_id: int, error_detail: str) -> None:
+    """Move queue row to dead_letter status."""
+    row = _queue.get(queue_id)
+    if row is None:
+        return
+    row["status"] = "dead_letter"
+    row["error_detail"] = error_detail
+    row["updated_at"] = datetime.now(timezone.utc)
+
+
+async def record_history(
+    *,
+    product_id: str,
+    seller_id: str,
+    list_price: Decimal,
+    offer_price: Decimal | None,
+    map_price: Decimal | None,
+    map_price_source: str,
+    http_status: int | None,
+    response_body: dict | None,
+    error_detail: str | None,
+    outcome: str,
+    duration_ms: int | None,
+) -> None:
+    """Insert an immutable history row."""
+    _history.append({
+        "id": len(_history) + 1,
+        "product_id": product_id,
+        "seller_id": seller_id,
+        "list_price": list_price,
+        "offer_price": offer_price,
+        "map_price": map_price,
+        "map_price_source": map_price_source,
+        "http_status": http_status,
+        "response_body": response_body,
+        "error_detail": error_detail,
+        "outcome": outcome,
+        "attempted_at": datetime.now(timezone.utc),
+        "duration_ms": duration_ms,
+    })
+
+
+async def get_dead_letters(seller_id: str, limit: int = 50, offset: int = 0) -> dict:
+    """Return dead-lettered items for a seller."""
+    items = [
+        row for row in _queue.values()
+        if row["status"] == "dead_letter" and row["seller_id"] == seller_id
+    ]
+    total = len(items)
+    page = items[offset : offset + limit]
+    return {"items": page, "total": total}
+
+
+async def retry_dead_letter(dead_letter_id: int) -> dict:
+    """Re-enqueue a dead-lettered item. Raises 404 if not found, 409 if not dead_letter."""
+    row = _queue.get(dead_letter_id)
+    if row is None:
+        raise NotFoundError(f"Queue item {dead_letter_id} not found")
+
+    if row["status"] != "dead_letter":
+        raise AppException(
+            status=409,
+            title="Conflict",
+            detail=f"Item {dead_letter_id} is not in dead_letter status (current: {row['status']})",
+            error_type="/problems/conflict",
+        )
+
+    row["status"] = "pending"
+    row["retry_count"] = 0
+    row["next_retry_at"] = None
+    row["error_detail"] = None
+    row["updated_at"] = datetime.now(timezone.utc)
+    return {"status": "re-enqueued", "queue_id": dead_letter_id}
+
+
+async def get_product_status(product_id: str) -> dict | None:
+    """Return queue entries + last success for a product."""
+    queue_entries = [
+        row for row in _queue.values()
+        if row["product_id"] == product_id
+    ]
+
+    # Find last successful history entry
+    successes = [
+        h for h in _history
+        if h["product_id"] == product_id and h["outcome"] == "success"
+    ]
+    last_success = successes[-1] if successes else None
+
+    if not queue_entries and last_success is None:
+        return None
+
+    return {
+        "product_id": product_id,
+        "queue": queue_entries,
+        "last_success": last_success,
+    }
+
+
+def _force_retry_eligible(queue_id: int) -> None:
+    """Clear next_retry_at so a failed row is immediately eligible for dequeue.
+
+    TEST USE ONLY — simulates clock advancing past the backoff window
+    without sleeping. Call between worker.process_one() invocations in
+    retry-cycle tests.
+    """
+    row = _queue.get(queue_id)
+    if row is not None:
+        row["next_retry_at"] = None
