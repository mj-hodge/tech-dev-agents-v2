+define the canonical schema for the Alembic migration and future Postgres backend.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from datetime import datetime, timezone
+from decimal import Decimal
+
+
+@dataclass
+class TargetPriceQueue:
+    """Pricing job queue row — maps to target_price_queue table."""
+
+    id: int = 0
+    product_id: str = ""
+    seller_id: str = ""
+    list_price: Decimal = Decimal("0")
+    offer_price: Decimal | None = None
+    map_price: Decimal | None = None
+    map_price_source: str = "manual"
+    status: str = "pending"  # pending | inflight | complete | failed | dead_letter
+    retry_count: int = 0
+    max_retries: int = 5
+    next_retry_at: datetime | None = None
+    error_detail: str | None = None
+    created_at: datetime = field(default_factory=lambda: datetime.now(timezone.utc))
+    updated_at: datetime = field(default_factory=lambda: datetime.now(timezone.utc))
+    claimed_at: datetime | None = None
+
+
+@dataclass
+class TargetPriceHistory:
+    """Immutable audit trail row — maps to target_price_history table."""
+
+    id: int = 0
+    product_id: str = ""
+    seller_id: str = ""
+    list_price: Decimal = Decimal("0")
+    offer_price: Decimal | None = None
+    map_price: Decimal | None = None
+    map_price_source: str = "manual"
+    http_status: int | None = None
+    response_body: dict | None = None
+    error_detail: str | None = None
+    outcome: str = ""  # success | client_error | server_error | dead_letter
+    attempted_at: datetime = field(default_factory=lambda: datetime.now(timezone.utc))
+    duration_ms: int | None = None
