+"""FastAPI router for pricing endpoints."""
+
+from datetime import datetime
+from decimal import Decimal
+
+from fastapi import APIRouter, Depends, HTTPException, Query
+from fastapi.responses import JSONResponse
+
+from app.core.config import Settings
+from app.pricing.queue import (
+    enqueue_price_updates,
+    get_dead_letters,
+    get_product_status,
+    retry_dead_letter,
+)
+from app.pricing.schemas import EnqueueRequest, EnqueueResponse
+
+router = APIRouter(prefix="/api/v1/pricing", tags=["pricing"])
+
+# ---------------------------------------------------------------------------
+# Feature-flag guard — write endpoints disabled until go-live story
+# Set ENABLE_PRICING_WRITES=true in environment to enable.
+# ---------------------------------------------------------------------------
+
+_RFC7807_NOT_FOUND = {
+    "type": "/problems/not-found",
+    "title": "Not Found",
+    "status": 404,
+}
+
+
+def _require_writes_enabled() -> None:
+    """FastAPI dependency — raises 503 if ENABLE_PRICING_WRITES is not set."""
+    if not Settings().enable_pricing_writes:
+        raise HTTPException(
+            status_code=503,
+            detail=(
+                "Pricing write endpoints are disabled. "
+                "Set ENABLE_PRICING_WRITES=true to enable (go-live story required)."
+            ),
+        )
+
+
+@router.post(
+    "/enqueue",
+    response_model=EnqueueResponse,
+    status_code=202,
+    dependencies=[Depends(_require_writes_enabled)],
+)
+async def enqueue(request: EnqueueRequest) -> EnqueueResponse:
+    """Enqueue a batch of price updates for background processing.
+
+    Disabled until ENABLE_PRICING_WRITES=true (gated by go-live story).
+    TODO(pre-staging): wire enforce_seller_context via get_current_user Depends.
+    """
+    result = await enqueue_price_updates([item.model_dump() for item in request.items])
+    return EnqueueResponse(**result)
+
+
+@router.get("/status/{product_id}")
+async def status(product_id: str) -> JSONResponse:
+    """Get queue + history status for a product.
+
+    TODO(pre-staging): wire enforce_seller_context via get_current_user Depends.
+    """
+    data = await get_product_status(product_id)
+    if data is None:
+        return JSONResponse(
+            status_code=404,
+            media_type="application/problem+json",
+            content={
+                **_RFC7807_NOT_FOUND,
+                "detail": f"No pricing records for product_id: {product_id}",
+            },
+        )
+    return JSONResponse(status_code=200, content=_serialize(data))
+
+
+@router.get("/dead-letters")
+async def dead_letters(
+    seller_id: str = Query(...),
+    limit: int = Query(50, ge=1, le=100),
+    offset: int = Query(0, ge=0),
+) -> JSONResponse:
+    """List dead-lettered items for a seller.
+
+    TODO(pre-staging): wire enforce_seller_context via get_current_user Depends.
+    """
+    data = await get_dead_letters(seller_id=seller_id, limit=limit, offset=offset)
+    return JSONResponse(status_code=200, content=_serialize(data))
+
+
+@router.post(
+    "/dead-letters/{item_id}/retry",
+    dependencies=[Depends(_require_writes_enabled)],
+)
+async def retry(item_id: int) -> JSONResponse:
+    """Re-enqueue a dead-lettered item.
+
+    Disabled until ENABLE_PRICING_WRITES=true (gated by go-live story).
+    TODO(pre-staging): wire enforce_seller_context via get_current_user Depends.
+    """
+    result = await retry_dead_letter(dead_letter_id=item_id)
+    return JSONResponse(status_code=200, content=result)
+
+
+def _serialize(obj: object) -> object:
+    """Recursively convert Decimal/datetime to JSON-safe types.
+
+    Note: this helper exists because queue.py stores raw Python objects.
+    If the queue migrates to serialization-safe types, this helper
+    can be removed.
+    """
+    if isinstance(obj, dict):
+        return {k: _serialize(v) for k, v in obj.items()}
+    if isinstance(obj, list):
+        return [_serialize(v) for v in obj]
+    if isinstance(obj, Decimal):
+        return str(obj)
+    if isinstance(obj, datetime):
+        return obj.isoformat()
+    return obj
