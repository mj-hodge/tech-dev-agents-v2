+/**
+ * STORY-322: LoadersPage — Loader Health Dashboard (EPIC-006 Phase C).
+ *
+ * Renders one card per registered loader from /healthz loaders_registry.
+ * Polls every 30 seconds for live updates.
+ * "Reset Circuit" opens a modal requiring a non-empty reason before POSTing.
+ * Admin-only — gated via PermissionGuard in App.tsx.
+ */
+import { useState, useEffect, useCallback } from "react";
+import { LoaderHealthCard } from "../components/LoaderHealthCard";
+import { ResetCircuitModal } from "../components/ResetCircuitModal";
+import { fetchLoadersHealth, resetLoaderCircuit } from "../api/client";
+import type { LoaderHealthEntry } from "../api/client";
+
+const POLL_INTERVAL_MS = 30000;
+
+export function LoadersPage() {
+  const [loaders, setLoaders] = useState<LoaderHealthEntry[]>([]);
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState<string | null>(null);
+
+  // Reset circuit modal state
+  const [resetTarget, setResetTarget] = useState<string | null>(null);
+
+  const loadData = useCallback(async () => {
+    try {
+      const data = await fetchLoadersHealth();
+      const registry = data.loaders_registry ?? {};
+      setLoaders(Object.values(registry));
+      setError(null);
+    } catch (e) {
+      setError(e instanceof Error ? e.message : "Failed to load loaders");
+    } finally {
+      setLoading(false);
+    }
+  }, []);
+
+  useEffect(() => {
+    loadData();
+    const interval = setInterval(loadData, POLL_INTERVAL_MS);
+    return () => clearInterval(interval);
+  }, [loadData]);
+
+  async function handleResetConfirm(reason: string) {
+    if (!resetTarget) return;
+    await resetLoaderCircuit(resetTarget, reason);
+    setResetTarget(null);
+    // Refresh data after reset
+    await loadData();
+  }
+
+  if (loading) {
+    return (
+      <div className="p-6">
+        <p className="text-sm text-gray-500">Loading loaders…</p>
+      </div>
+    );
+  }
+
+  if (error) {
+    return (
+      <div className="p-6">
+        <p className="text-sm text-red-600">Error: {error}</p>
+      </div>
+    );
+  }
+
+  return (
+    <div className="p-6">
+      <div className="mb-6">
+        <h1 className="text-2xl font-bold text-gray-900">Loader Health</h1>
+        <p className="text-sm text-gray-500 mt-1">
+          Live status of all registered loaders. Refreshes every 30 seconds.
+        </p>
+      </div>
+
+      {loaders.length === 0 ? (
+        <div className="text-center py-16 text-gray-500">
+          <p className="text-lg font-medium">No loaders registered</p>
+          <p className="text-sm mt-1">
+            Loaders appear here once the framework reports them via{" "}
+            <code className="font-mono text-xs bg-gray-100 px-1 py-0.5 rounded">/healthz</code>.
+          </p>
+        </div>
+      ) : (
+        <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
+          {loaders.map((loader) => (
+            <LoaderHealthCard
+              key={loader.loader_name}
+              loader={loader}
+              onResetCircuit={(name) => setResetTarget(name)}
+            />
+          ))}
+        </div>
+      )}
+
+      {resetTarget && (
+        <ResetCircuitModal
+          loaderName={resetTarget}
+          onConfirm={handleResetConfirm}
+          onCancel={() => setResetTarget(null)}
+        />
+      )}
+    </div>
+  );
+}
