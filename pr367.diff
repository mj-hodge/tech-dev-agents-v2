+/**
+ * STORY-322: LoaderHealthCard — displays one loader's health snapshot.
+ *
+ * Shows: name, color-coded health badge (green/yellow/red), last_success_at
+ * (relative on card, absolute UTC on hover), staleness_seconds, circuit_state,
+ * consecutive_failures, rows_loaded_today, and a "Reset Circuit" button when
+ * circuit_state is "open".
+ */
+import type { LoaderHealthEntry } from "../api/client";
+
+interface LoaderHealthCardProps {
+  loader: LoaderHealthEntry;
+  onResetCircuit: (name: string) => void;
+}
+
+const BADGE_CLASSES: Record<string, string> = {
+  green: "bg-green-100 text-green-800 border-green-200",
+  yellow: "bg-yellow-100 text-yellow-800 border-yellow-200",
+  red: "bg-red-100 text-red-800 border-red-200",
+};
+
+const BORDER_CLASSES: Record<string, string> = {
+  green: "border-l-green-400",
+  yellow: "border-l-yellow-400",
+  red: "border-l-red-400",
+};
+
+function formatRelativeTime(unixTs: number | null): string {
+  if (unixTs === null) return "never";
+  const diffMs = Date.now() - unixTs * 1000;
+  const diffSecs = Math.floor(diffMs / 1000);
+  if (diffSecs < 60) return `${diffSecs}s ago`;
+  const diffMins = Math.floor(diffSecs / 60);
+  if (diffMins < 60) return `${diffMins}m ago`;
+  const diffHours = Math.floor(diffMins / 60);
+  if (diffHours < 24) return `${diffHours}h ${diffMins % 60}m ago`;
+  return `${Math.floor(diffHours / 24)}d ago`;
+}
+
+function formatAbsoluteUtc(unixTs: number | null): string {
+  if (unixTs === null) return "never";
+  return new Date(unixTs * 1000).toUTCString();
+}
+
+function formatStaleness(staleness_seconds: number | null): string {
+  if (staleness_seconds === null) return "N/A";
+  if (staleness_seconds < 60) return `${staleness_seconds}s`;
+  const mins = Math.floor(staleness_seconds / 60);
+  if (mins < 60) return `${mins}m ${staleness_seconds % 60}s`;
+  return `${Math.floor(mins / 60)}h ${mins % 60}m`;
+}
+
+export function LoaderHealthCard({ loader, onResetCircuit }: LoaderHealthCardProps) {
+  const health_color = loader.health_color ?? "red";
+  const circuit_state = loader.circuit_state ?? "closed";
+  const consecutive_failures = loader.consecutive_failures ?? 0;
+  const last_success_at = loader.last_success_at ?? null;
+  const staleness_seconds = loader.staleness_seconds ?? null;
+  const rows_loaded_today = loader.rows_loaded_today ?? 0;
+  const name = loader.loader_name;
+
+  return (
+    <div
+      data-testid="loader-health-card"
+      className={`bg-white rounded-lg border-l-4 shadow-sm p-4 flex flex-col gap-2 ${BORDER_CLASSES[health_color] ?? "border-l-gray-300"}`}
+    >
+      {/* Header row: name + health badge */}
+      <div className="flex items-center justify-between gap-2">
+        <h3 className="text-sm font-semibold text-gray-900 truncate">{name}</h3>
+        <span
+          className={`inline-flex items-center px-2 py-0.5 rounded border text-xs font-medium ${BADGE_CLASSES[health_color] ?? "bg-gray-100 text-gray-800 border-gray-200"}`}
+        >
+          {health_color}
+        </span>
+      </div>
+
+      {/* Circuit state */}
+      <div className="text-xs text-gray-600">
+        <span className="font-medium">Circuit:</span>{" "}
+        <span className={circuit_state === "open" ? "text-red-600 font-semibold" : "text-gray-700"}>
+          {circuit_state}
+        </span>
+      </div>
+
+      {/* Consecutive failures */}
+      <div className="text-xs text-gray-600">
+        <span className="font-medium">Consecutive failures:</span>{" "}
+        <span className={consecutive_failures > 0 ? "text-red-600 font-semibold" : "text-gray-700"}>
+          {consecutive_failures}
+        </span>
+      </div>
+
+      {/* Staleness */}
+      <div className="text-xs text-gray-600">
+        <span className="font-medium">Staleness:</span>{" "}
+        <span>{formatStaleness(staleness_seconds)}</span>
+      </div>
+
+      {/* Last success */}
+      <div className="text-xs text-gray-600">
+        <span className="font-medium">Last success:</span>{" "}
+        <span
+          title={formatAbsoluteUtc(last_success_at)}
+          className="cursor-help border-b border-dashed border-gray-400"
+        >
+          {formatRelativeTime(last_success_at)}
+        </span>
+      </div>
+
+      {/* Rows loaded today */}
+      <div className="text-xs text-gray-600">
+        <span className="font-medium">Rows loaded today:</span>{" "}
+        <span>{rows_loaded_today.toLocaleString()}</span>
+      </div>
+
+      {/* Reset Circuit button — only when circuit is open */}
+      {circuit_state === "open" && (
+        <button
+          type="button"
+          onClick={() => onResetCircuit(name)}
+          className="mt-1 w-full text-xs px-3 py-1.5 bg-red-600 text-white rounded hover:bg-red-700 transition-colors font-medium"
+        >
+          Reset Circuit
+        </button>
+      )}
+    </div>
+  );
+}
