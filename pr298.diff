diff --git a/e2e/dashboard.spec.ts b/e2e/dashboard.spec.ts
new file mode 100644
index 00000000..a7363789
--- /dev/null
+++ b/e2e/dashboard.spec.ts
@@ -0,0 +1,219 @@
+/**
+ * STORY-857: Dashboard cleanup — failed stories belong in History, not Queue.
+ *
+ * Asserts:
+ *   - Failed/attention stories do NOT appear in the queue panel
+ *   - Failed/attention stories DO appear in the history panel
+ *   - Attention callout badge links to history
+ *   - History panel has a default 7d filter
+ *
+ * @smoke
+ */
+
+import { test, expect, type Page } from '@playwright/test';
+
+const mkItem = (
+  story_id: string,
+  status: string,
+  overrides: Record<string, unknown> = {},
+) => ({
+  story_id,
+  title: `${story_id} title`,
+  status,
+  repo: 'tech-dev-agents',
+  scope: 'small',
+  prompt: 'test prompt',
+  enqueued_by: 'test',
+  enqueued_at: new Date().toISOString(),
+  claimed_by: status !== 'pending' ? 'dan' : null,
+  claimed_at: status !== 'pending' ? new Date().toISOString() : null,
+  completed_at: status === 'completed' ? new Date().toISOString() : null,
+  cancelled_at: status === 'cancelled' ? new Date().toISOString() : null,
+  failed_at: null,
+  commit_sha: null,
+  pr_number: null,
+  review_started_at: null,
+  paused_at: null,
+  current_phase: null,
+  phase_started_at: null,
+  needs_info_path: null,
+  priority: 0,
+  target_role: 'developer',
+  ...overrides,
+});
+
+// V2 queue response with actionable + attention items
+const MOCK_QUEUE = {
+  pending: [mkItem('STORY-100', 'pending')],
+  in_progress: [mkItem('STORY-101', 'in_progress')],
+  in_review: [],
+  paused: [],
+  needs_info: [],
+  // These are terminal/failed — should NOT appear in queue panel
+  attention: [
+    mkItem('STORY-900', 'failed'),
+    mkItem('STORY-901', 'failed'),
+  ],
+};
+
+// History API response
+const MOCK_HISTORY = {
+  items: [
+    mkItem('STORY-800', 'completed'),
+    mkItem('STORY-801', 'cancelled'),
+  ],
+  total: 2,
+  limit: 20,
+  offset: 0,
+  fetched_at: new Date().toISOString(),
+};
+
+async function installMocks(page: Page) {
+  await page.route('**/api/dispatch/v2/queue*', async (route) => {
+    await route.fulfill({
+      status: 200,
+      contentType: 'application/json',
+      body: JSON.stringify(MOCK_QUEUE),
+    });
+  });
+  await page.route('**/api/dispatch/queue*', async (route) => {
+    // Catch the old endpoint pattern too
+    if (route.request().url().includes('/v2/')) return route.fallback();
+    await route.fulfill({
+      status: 200,
+      contentType: 'application/json',
+      body: JSON.stringify(MOCK_QUEUE),
+    });
+  });
+  await page.route('**/api/dispatch/history*', async (route) => {
+    await route.fulfill({
+      status: 200,
+      contentType: 'application/json',
+      body: JSON.stringify(MOCK_HISTORY),
+    });
+  });
+  await page.route('**/api/agents*', async (route) => {
+    await route.fulfill({
+      status: 200,
+      contentType: 'application/json',
+      body: JSON.stringify({ agents: [] }),
+    });
+  });
+  await page.route('**/api/fleet*', async (route) => {
+    await route.fulfill({
+      status: 200,
+      contentType: 'application/json',
+      body: JSON.stringify({ agents: [], counts: {}, costs: {} }),
+    });
+  });
+  await page.route('**/api/dispatch/metrics*', async (route) => {
+    await route.fulfill({
+      status: 200,
+      contentType: 'application/json',
+      body: JSON.stringify({
+        claim_409_per_story_5m_max: 0,
+        head_of_line_age_seconds: null,
+        failure_reason_null_rate: 0,
+        claim_conflict_rate_5m: 0,
+        fetched_at: new Date().toISOString(),
+      }),
+    });
+  });
+}
+
+test.describe('STORY-857: Dashboard queue/history split', () => {
+  test('AC-1: failed stories do NOT appear in queue panel @smoke', async ({ page }) => {
+    await installMocks(page);
+    await page.goto('/');
+    await page.waitForSelector('text=Dispatch Queue', { timeout: 10000 });
+
+    // Active stories should be visible in the queue
+    await expect(page.locator('text=STORY-100')).toBeVisible();
+    await expect(page.locator('text=STORY-101')).toBeVisible();
+
+    // Failed/attention stories must NOT appear in the queue tab
+    await expect(page.locator('text=STORY-900')).not.toBeVisible();
+    await expect(page.locator('text=STORY-901')).not.toBeVisible();
+  });
+
+  test('AC-2: failed stories appear in history panel with 7d filter @smoke', async ({ page }) => {
+    await installMocks(page);
+    await page.goto('/');
+    await page.waitForSelector('text=Dispatch Queue', { timeout: 10000 });
+
+    // Switch to history tab
+    await page.click('button:has-text("History")');
+
+    // History should show the attention/failed items
+    await expect(page.locator('text=STORY-900')).toBeVisible();
+    await expect(page.locator('text=STORY-901')).toBeVisible();
+
+    // Also shows completed/cancelled from the history API
+    await expect(page.locator('text=STORY-800')).toBeVisible();
+    await expect(page.locator('text=STORY-801')).toBeVisible();
+
+    // 7d filter is the default
+    const filter = page.getByTestId('history-filter');
+    await expect(filter).toBeVisible();
+    // The 7d button should have the active styling
+    await expect(filter.locator('button:has-text("7d")')).toHaveClass(/blue/);
+  });
+
+  test('AC-3: attention callout shows count and links to history @smoke', async ({ page }) => {
+    await installMocks(page);
+    await page.goto('/');
+    await page.waitForSelector('text=Dispatch Queue', { timeout: 10000 });
+
+    // Attention callout badge should be visible
+    const callout = page.getByTestId('attention-callout');
+    await expect(callout).toBeVisible();
+    await expect(callout).toContainText('2 in attention');
+    await expect(callout).toHaveAttribute('aria-label', /2 stories in attention/);
+
+    // Clicking the callout should switch to history tab
+    await callout.click();
+
+    // Now failed stories should be visible (history tab)
+    await expect(page.locator('text=STORY-900')).toBeVisible();
+  });
+
+  test('AC-1 (no attention): callout is hidden when no failed items', async ({ page }) => {
+    // Override with a queue that has no attention items
+    await page.route('**/api/dispatch/v2/queue*', async (route) => {
+      await route.fulfill({
+        status: 200,
+        contentType: 'application/json',
+        body: JSON.stringify({
+          ...MOCK_QUEUE,
+          attention: [],
+        }),
+      });
+    });
+    await page.route('**/api/dispatch/queue*', async (route) => {
+      if (route.request().url().includes('/v2/')) return route.fallback();
+      await route.fulfill({
+        status: 200,
+        contentType: 'application/json',
+        body: JSON.stringify({ ...MOCK_QUEUE, attention: [] }),
+      });
+    });
+    await page.route('**/api/agents*', async (route) => {
+      await route.fulfill({ status: 200, contentType: 'application/json', body: JSON.stringify({ agents: [] }) });
+    });
+    await page.route('**/api/fleet*', async (route) => {
+      await route.fulfill({ status: 200, contentType: 'application/json', body: JSON.stringify({ agents: [], counts: {}, costs: {} }) });
+    });
+    await page.route('**/api/dispatch/history*', async (route) => {
+      await route.fulfill({ status: 200, contentType: 'application/json', body: JSON.stringify(MOCK_HISTORY) });
+    });
+    await page.route('**/api/dispatch/metrics*', async (route) => {
+      await route.fulfill({ status: 200, contentType: 'application/json', body: JSON.stringify({ claim_409_per_story_5m_max: 0, head_of_line_age_seconds: null, failure_reason_null_rate: 0, claim_conflict_rate_5m: 0, fetched_at: new Date().toISOString() }) });
+    });
+
+    await page.goto('/');
+    await page.waitForSelector('text=Dispatch Queue', { timeout: 10000 });
+
+    const callout = page.getByTestId('attention-callout');
+    await expect(callout).toHaveCount(0);
+  });
+});
