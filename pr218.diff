+# ---------------------------------------------------------------------------
+# _report_fail: transient patterns still retry
+# ---------------------------------------------------------------------------
+
+class TestTransientPatternsStillRetry:
+    """Transient failure patterns must still trigger auto-retry (regression guard)."""
+
+    def test_timeout_still_retries(self):
