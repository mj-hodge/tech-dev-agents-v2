{
  "dashboard": {
    "id": null,
    "uid": "agent-ops-dashboard",
    "title": "Agent Operations Dashboard",
    "tags": ["agents", "cost", "health"],
    "timezone": "utc",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "30s",
    "time": {
      "from": "now-24h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Cost per Agent per Day",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "sum by (agent) (\n  sum_over_time(\n    {job=\"claude-code\"} |~ \"COST_SUMMARY\" | regexp \"sdk_cost=\\\\$(?P<cost>[\\\\d.]+)\" | unwrap cost [24h]\n  )\n)",
            "refId": "A",
            "datasource": { "type": "loki", "uid": "loki" }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "displayName": "${__field.labels.agent}"
          }
        }
      },
      {
        "id": 2,
        "title": "Sessions per Agent",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "targets": [
          {
            "expr": "sum by (agent) (\n  count_over_time(\n    {job=\"claude-code\"} |~ \"COST_SUMMARY\" | regexp \"sdk_sessions=(?P<sessions>\\\\d+)\" [24h]\n  )\n)",
            "refId": "A",
            "datasource": { "type": "loki", "uid": "loki" }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "displayName": "${__field.labels.agent}"
          }
        }
      },
      {
        "id": 3,
        "title": "Agent Status",
        "type": "stat",
        "gridPos": { "h": 4, "w": 24, "x": 0, "y": 8 },
        "targets": [
          {
            "expr": "",
            "refId": "A",
            "datasource": { "type": "json", "uid": "agent-health" }
          }
        ],
        "description": "Live agent status from /api/health endpoints",
        "fieldConfig": {
          "defaults": {
            "mappings": [
              { "type": "value", "options": { "online": { "text": "Online", "color": "green" } } },
              { "type": "value", "options": { "idle": { "text": "Idle", "color": "yellow" } } },
              { "type": "value", "options": { "stuck": { "text": "Stuck", "color": "orange" } } },
              { "type": "value", "options": { "offline": { "text": "Offline", "color": "red" } } }
            ]
          }
        }
      },
      {
        "id": 5,
        "title": "needs_info loop guards (24h)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
        "description": "STORY-803: 24h count of the three needs_info loop failure-mode events. Goal: zero of all three after fleet rollout. Alert fires when > 5 directive_bypass_attempted/h or > 3 phase8_no_commits/h.",
        "targets": [
          {
            "refId": "A",
            "expr": "sum by (story_id) (count_over_time({app=\"ops-console\"} |= \"directive_bypass_attempted\" [24h]) + count_over_time({job=~\"agent-.*\"} |= \"directive_bypass_attempted\" [24h]))",
            "legendFormat": "directive_bypass_attempted",
            "datasource": { "type": "loki", "uid": "loki" }
          },
          {
            "refId": "B",
            "expr": "sum by (stage) (count_over_time({job=~\"agent-.*\"} |= \"question_commit_failed\" [24h]))",
            "legendFormat": "question_commit_failed",
            "datasource": { "type": "loki", "uid": "loki" }
          },
          {
            "refId": "C",
            "expr": "sum by (attempt) (count_over_time({job=~\"agent-.*\"} |= \"phase8_no_commits\" [24h]))",
            "legendFormat": "phase8_no_commits",
            "datasource": { "type": "loki", "uid": "loki" }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": 0 },
                { "color": "yellow", "value": 1 },
                { "color": "red", "value": 4 }
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "Agent Restart",
        "type": "text",
        "gridPos": { "h": 4, "w": 24, "x": 0, "y": 12 },
        "options": {
          "mode": "markdown",
          "content": "### Restart Agents\n\n| Agent | Action |\n|-------|--------|\n| Dan | [Restart]({{restart_base_url}}/api/restart?agent=dan) |\n| Derrick | [Restart]({{restart_base_url}}/api/restart?agent=derrick) |"
        },
        "description": "Links to restart endpoints for each agent VM",
        "links": [
          {
            "title": "Restart Dan",
            "url": "{{restart_base_url}}/api/restart?agent=dan",
            "targetBlank": true
          },
          {
            "title": "Restart Derrick",
            "url": "{{restart_base_url}}/api/restart?agent=derrick",
            "targetBlank": true
          }
        ]
      }
    ],
    "templating": {
      "list": [
        {
          "name": "restart_base_url",
          "type": "constant",
          "current": { "value": "http://localhost:8642" },
          "hide": 2,
          "label": "Restart Base URL"
        }
      ]
    }
  },
  "overwrite": true
}
