+"""
+DB model for Target catalog status records.
+
+Maps to table: target_catalog_status
+Mirrors rep.dim_sku columns: tcin, external_id, version, listing_status, validation_status.
+
+Phase 8: implement as SQLAlchemy ORM model or dataclass with alembic migration.
+"""
+
+from dataclasses import dataclass, field
+from datetime import datetime, timezone
+from typing import Optional
+
+
+def _utcnow() -> datetime:
+    return datetime.now(timezone.utc)
+
+
+# Known listing_status values per target-openapi.yaml §ProductStatus
+LISTING_STATUS_APPROVED = "APPROVED"
+LISTING_STATUS_REJECTED = "REJECTED"
+LISTING_STATUS_SUSPENDED = "SUSPENDED"
+LISTING_STATUS_PENDING = "PENDING"
+LISTING_STATUS_UNLISTED = "UNLISTED"
+
+KNOWN_LISTING_STATUSES = frozenset([
+    LISTING_STATUS_APPROVED,
+    LISTING_STATUS_REJECTED,
+    LISTING_STATUS_SUSPENDED,
+    LISTING_STATUS_PENDING,
+    LISTING_STATUS_UNLISTED,
+])
+
+# Known validation_status values (only INITIATED documented — OQ-2)
+VALIDATION_STATUS_INITIATED = "INITIATED"
+KNOWN_VALIDATION_STATUSES = frozenset([VALIDATION_STATUS_INITIATED])
+
+
+@dataclass
+class TargetCatalogStatus:
+    """A single version record for a Target product's listing and validation status.
+
+    One row per (tcin, product_status_id) combination. Multiple rows per tcin
+    when expand=product_statuses returns full version history.
+
+    Phase 8: convert to SQLAlchemy mapped class with target_catalog_status table.
+    """
+
+    # rep.dim_sku-equivalent columns (required)
+    tcin: str
+    external_id: str
+    listing_status: Optional[str] = None
+
+    # Status record identity
+    product_status_id: Optional[str] = None
+    version: Optional[int] = None
+    is_current: bool = False
+
+    # Validation status — raw always stored; normalised set only if known enum
+    validation_status: Optional[str] = None       # None when value is unknown
+    validation_status_raw: Optional[str] = None   # always set from API value
+
+    # Detail
+    errors_json: Optional[str] = None
+    status_created_at: Optional[datetime] = None
+    status_last_modified_at: Optional[datetime] = None
+
+    synced_at: datetime = field(default_factory=_utcnow)
