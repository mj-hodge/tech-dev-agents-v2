+def test_unknown_validation_status_logs_warning(caplog):
+    """When validation_status is not in KNOWN_VALIDATION_STATUSES, a warning is logged.
+
+    Why (Gate 10): Broad exception handlers and fallback paths must emit observable
+    signals. An unknown enum value silently stored without a log entry makes it
+    invisible to operators.
+
+    RED: map_product_status raises NotImplementedError — test errors until Phase 8.
+    Phase 8 note: Use logger.warning() with the unknown value and tcin context.
+    """
+    import logging
+
+    with caplog.at_level(logging.WARNING, logger="app.catalog_sync.mapping"):
+        raw = make_status_response(validation_status="NEVER_SEEN_BEFORE")
+        map_product_status(raw, tcin=TCIN, external_id=EXTERNAL_ID)
+
+    # At least one warning log about the unknown validation_status
+    warning_messages = [r.message for r in caplog.records if r.levelno >= logging.WARNING]
+    assert any("NEVER_SEEN_BEFORE" in msg for msg in warning_messages), (
+        f"Expected a warning log mentioning 'NEVER_SEEN_BEFORE', got: {warning_messages}"
+    )
