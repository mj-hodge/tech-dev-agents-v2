+"""
+Polling orchestration for catalog status sync.
+
+sync_once: iterate over a list of product specs, call get_product_status for each,
+map to TargetCatalogStatus, and upsert into DB.
+
+Supports expand=product_statuses for full version history.
+"""
+
+import logging
+from typing import Any
+
+from app.catalog_sync.client import TargetCatalogReadClient
+from app.catalog_sync.mapping import map_product_status
+
+logger = logging.getLogger(__name__)
+
+
+async def sync_once(
+    client: TargetCatalogReadClient,
+    items: list[dict[str, Any]],
+    seller_id: str,
+    session: Any = None,
+    expand: bool = False,
+) -> int:
+    """Poll catalog status for each item and upsert into target_catalog_status.
+
+    Args:
+        client: Injected TargetCatalogReadClient (mock in tests).
+        items: List of dicts with keys: tcin, external_id, product_status_id.
+        seller_id: Target seller identifier.
+        session: SQLAlchemy session (optional; in-memory list used in tests).
+        expand: If True, pass expand=product_statuses to get full version history.
+
+    Returns:
+        Count of rows upserted.
+    """
+    if not items:
+        return 0
+
+    expand_param = "product_statuses" if expand else None
+    upserted = 0
+
+    for item in items:
+        tcin = item["tcin"]
+        external_id = item["external_id"]
+        product_status_id = item["product_status_id"]
+
+        raw = await client.get_product_status(
+            seller_id=seller_id,
+            product_id=tcin,
+            product_status_id=product_status_id,
+            expand=expand_param,
+        )
+
+        # expand path may return a list of version records
+        if isinstance(raw, list):
+            for record in raw:
+                row = map_product_status(record, tcin=tcin, external_id=external_id)
+                if session is not None:
+                    session.add(row)
+                upserted += 1
+        else:
+            row = map_product_status(raw, tcin=tcin, external_id=external_id)
+            if session is not None:
+                session.add(row)
+            upserted += 1
+
+    if session is not None:
+        session.commit()
+
+    return upserted
