+"""
+Tests for catalog status sync — core poll cycle.
+
+RED state: All tests fail until Phase 8 implements sync_once in
+app/catalog_sync/poll.py (currently raises NotImplementedError).
+
+Covers:
+- SC-1: Catalog status sync works (rows persisted with listing_status populated)
+- SC-2: rep.dim_sku-equivalent columns populated after sync
+- Seed test criteria #1: fresh DB + run sync + observe rows
+"""
+
+import pytest
+from unittest.mock import AsyncMock
+
+from app.catalog_sync.client import TargetCatalogReadClient
+from app.catalog_sync.poll import sync_once
+from tests.catalog_sync.conftest import SELLER_ID, SAMPLE_ITEMS, make_status_response
+
+
+# ---------------------------------------------------------------------------
+# Happy path — SC-1: rows persisted after sync_once
+# ---------------------------------------------------------------------------
+
+
+@pytest.mark.asyncio
+async def test_sync_once_persists_rows_for_each_item(approved_status):
+    """sync_once persists one TargetCatalogStatus row per input item.
+
+    Arrange: mock client returns APPROVED status for each product.
+    Act: call sync_once with 2 items.
+    Assert: 2 rows returned / upserted; each has listing_status populated.
+
+    RED: sync_once raises NotImplementedError — test errors until Phase 8.
+    """
+    client = AsyncMock(spec=TargetCatalogReadClient)
+    client.get_product_status.return_value = approved_status
+
+    rows = await sync_once(client, SAMPLE_ITEMS, SELLER_ID)
+
+    assert rows == 2
+
+
+@pytest.mark.asyncio
+async def test_sync_once_returns_zero_for_empty_items():
+    """sync_once with an empty items list returns 0 without calling the client.
+
+    Arrange: empty items list.
+    Act: call sync_once.
+    Assert: 0 rows, client never called.
+
+    RED: sync_once raises NotImplementedError — test errors until Phase 8.
+    """
+    client = AsyncMock(spec=TargetCatalogReadClient)
+
+    rows = await sync_once(client, [], SELLER_ID)
+
+    assert rows == 0
+    client.get_product_status.assert_not_called()
+
+
+@pytest.mark.asyncio
+async def test_sync_once_calls_get_product_status_per_item(approved_status):
+    """sync_once calls get_product_status once per input item.
+
+    Arrange: 2 items.
+    Act: sync_once.
+    Assert: client called exactly twice with correct seller_id.
+
+    RED: sync_once raises NotImplementedError — test errors until Phase 8.
+    """
+    client = AsyncMock(spec=TargetCatalogReadClient)
+    client.get_product_status.return_value = approved_status
+
+    await sync_once(client, SAMPLE_ITEMS, SELLER_ID)
+
+    assert client.get_product_status.call_count == 2
+
+    # Each call must include the correct seller_id
+    for call in client.get_product_status.call_args_list:
+        args, kwargs = call
+        assert SELLER_ID in args or kwargs.get("seller_id") == SELLER_ID
+
+
+# ---------------------------------------------------------------------------
+# All listing_status enum values — SC-1 completeness
+# ---------------------------------------------------------------------------
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("status_value", [
+    "APPROVED", "REJECTED", "SUSPENDED", "PENDING", "UNLISTED"
+])
+async def test_sync_once_handles_all_listing_status_enum_values(status_value):
+    """sync_once persists rows for all five documented listing_status values.
+
+    Each enum value from target-openapi.yaml §ProductStatus must round-trip
+    through sync_once without error.
+
+    RED: sync_once raises NotImplementedError — test errors until Phase 8.
+    """
+    client = AsyncMock(spec=TargetCatalogReadClient)
+    client.get_product_status.return_value = make_status_response(
+        listing_status=status_value
+    )
+
+    items = [SAMPLE_ITEMS[0]]
+    rows = await sync_once(client, items, SELLER_ID)
+
+    assert rows == 1
+
+
+# ---------------------------------------------------------------------------
+# Client error propagation — Gate 9
+# ---------------------------------------------------------------------------
+
+
+@pytest.mark.asyncio
+async def test_sync_once_propagates_client_error():
+    """When the client raises RuntimeError, sync_once does not swallow it.
+
+    Why: Silent failures would leave rows un-synced with no observable signal.
+
+    RED: sync_once raises NotImplementedError — test errors until Phase 8.
+    Phase 8 note: once implemented, the RuntimeError from the mock client
+    must propagate (not be silently caught).
+    """
+    client = AsyncMock(spec=TargetCatalogReadClient)
+    client.get_product_status.side_effect = RuntimeError("Target API unavailable")
+
+    with pytest.raises(RuntimeError, match="Target API unavailable"):
+        await sync_once(client, SAMPLE_ITEMS[:1], SELLER_ID)
+
+
+# ---------------------------------------------------------------------------
+# Gate 9: Failure Recovery — existing data preserved on sync failure
+# ---------------------------------------------------------------------------
+
+
+@pytest.mark.asyncio
+async def test_sync_once_partial_failure_preserves_prior_rows():
+    """When client fails on the second item, the first item's row is still persisted.
+
+    Why (Gate 9): sync overwrites persistent state; failures must not destroy
+    existing good data.
+
+    Arrange: 2 items; client returns APPROVED for item 1, then raises for item 2.
+    Act: sync_once with 2 items.
+    Assert: At least 1 row persisted (first item survived).
+
+    RED: sync_once raises NotImplementedError — test errors until Phase 8.
+    Phase 8 note: implement per-item error handling; do not rollback all on
+    partial failure.
+    """
+    call_count = 0
+
+    async def side_effect(*args, **kwargs):
+        nonlocal call_count
+        call_count += 1
+        if call_count == 1:
+            return make_status_response(listing_status="APPROVED")
+        raise RuntimeError("API rate limit on second call")
+
+    client = AsyncMock(spec=TargetCatalogReadClient)
+    client.get_product_status.side_effect = side_effect
+
+    # sync_once should persist the first item and report partial success
+    # or raise after persisting what it can. Either is acceptable.
+    try:
+        rows = await sync_once(client, SAMPLE_ITEMS, SELLER_ID)
+        # If it returns successfully, it must report at least 1 row
+        assert rows >= 1
+    except RuntimeError:
+        # If it raises, that's also acceptable — but it must have attempted
+        # the first item's persist before failing on the second.
+        assert call_count >= 1
+
+
+# ---------------------------------------------------------------------------
+# Output-variance — sync_once level (REQUIRED Stub Detection Gate)
+# ---------------------------------------------------------------------------
+
+
+@pytest.mark.asyncio
+async def test_sync_once_output_varies_with_different_items():
+    """Two items with different statuses produce different row counts/data.
+
+    Why: A stub that always returns the same count regardless of items MUST fail.
+
+    RED: sync_once raises NotImplementedError — test errors until Phase 8.
+    """
+    client = AsyncMock(spec=TargetCatalogReadClient)
+
+    # Single item → 1 row
+    client.get_product_status.return_value = make_status_response()
+    rows_one = await sync_once(client, SAMPLE_ITEMS[:1], SELLER_ID)
+
+    # Two items → 2 rows
+    rows_two = await sync_once(client, SAMPLE_ITEMS, SELLER_ID)
+
+    assert rows_one == 1
+    assert rows_two == 2
+    assert rows_one != rows_two
