+
+# ---------------------------------------------------------------------------
+# Gate 2a: DI mechanism — client accepts base_url + auth_token
+# ---------------------------------------------------------------------------
+
+
+def test_client_accepts_dependency_injection():
+    """TargetCatalogReadClient can be constructed with custom base_url and token.
+
+    Why: DI is the mechanism that prevents production calls in tests.
+    If the client doesn't accept these params, we can't safely mock it.
+
+    GREEN in RED state: __init__ stores params (not raised).
+    """
+    client = TargetCatalogReadClient(
+        base_url="https://mock.test.local",
+        auth_token="test_token_123",
+    )
+
+    assert client.base_url == "https://mock.test.local"
+    assert client.auth_token == "test_token_123"
+
+
+def test_client_defaults_to_target_production_url():
+    """Default base_url is the production Target API domain.
+
+    Why: Verify the default so tests know exactly what they are overriding.
+
+    GREEN in RED state: __init__ stores params.
+    """
+    client = TargetCatalogReadClient()
+
+    assert "api.target.com" in client.base_url
+
+
+# ---------------------------------------------------------------------------
+# Gate 2a: Zero outbound HTTP during sync_once (DI mock path)
+# ---------------------------------------------------------------------------
+
+
+@respx.mock
+@pytest.mark.asyncio
+async def test_no_outbound_calls_to_target_api_during_sync_once():
+    """sync_once makes ZERO real HTTP calls to api.target.com.
+
+    Why: BUSINESS CRITICAL. On 2026-03-26, a local test reached a real external API.
+    This test enforces DI isolation.
+
+    Arrange: respx catches any call to api.target.com (should never be hit).
+    Act: Run sync_once with a mock client (DI pattern — no real httpx calls).
+    Assert: respx shows zero calls to api.target.com.
+
+    RED: sync_once raises NotImplementedError — test errors until Phase 8.
+    Phase 8 note: keep AsyncMock for client; the mock correctly demonstrates DI.
+    """
+    target_route = respx.route(host="api.target.com").respond(500)
+
+    client = AsyncMock(spec=TargetCatalogReadClient)
+    client.get_product_status.return_value = make_status_response()
+
+    await sync_once(client, SAMPLE_ITEMS[:1], SELLER_ID)
+
+    assert target_route.call_count == 0, (
+        f"Expected zero calls to api.target.com, got {target_route.call_count}. "
+        "sync_once is making real HTTP calls — fix DI."
+    )
+
+
+@respx.mock
+@pytest.mark.asyncio
+async def test_no_outbound_calls_to_any_external_host_during_sync_once():
+    """No HTTP calls to ANY external host during sync_once.
+
+    Belt-and-suspenders catch for misconfigured base_url or hardcoded endpoints.
+
+    RED: sync_once raises NotImplementedError — test errors until Phase 8.
+    """
+    catch_all = respx.route().respond(500)
+
+    client = AsyncMock(spec=TargetCatalogReadClient)
+    client.get_product_status.return_value = make_status_response()
+
+    await sync_once(client, SAMPLE_ITEMS[:1], SELLER_ID)
+
+    assert catch_all.call_count == 0, (
+        f"Expected zero outbound HTTP calls, got {catch_all.call_count}. "
+        "sync_once should use the injected client, not raw HTTP."
+    )
+
+
+# ---------------------------------------------------------------------------
+# Gate 2a: sync_once reports failure when client raises
+# ---------------------------------------------------------------------------
+
+
+@pytest.mark.asyncio
+async def test_sync_once_reports_failure_when_client_raises():
+    """When the client raises RuntimeError, sync_once does NOT report success.
+
+    Why: On 2026-03-26 incident, endpoint returned status: "success" even when
+    the tool layer failed. This test prevents that class of silent-success bug.
+
+    RED: sync_once raises NotImplementedError — test errors until Phase 8.
+    Phase 8 note: once implemented, the RuntimeError from the mock client
+    must propagate (not return a success count).
+    """
+    client = AsyncMock(spec=TargetCatalogReadClient)
+    client.get_product_status.side_effect = RuntimeError("API unavailable")
+
+    with pytest.raises(RuntimeError, match="API unavailable"):
+        await sync_once(client, SAMPLE_ITEMS[:1], SELLER_ID)
+
+
+# ---------------------------------------------------------------------------
+# Gate 12: Integration smoke — real client code path (no mock on adapter)
+# ---------------------------------------------------------------------------
+
+
+@respx.mock
+@pytest.mark.asyncio
+async def test_client_get_product_status_hits_correct_endpoint():
+    """Real client code path: get_product_status calls the expected URL.
+
+    Arrange: respx mocks the expected endpoint URL.
+    Act: Call client.get_product_status() directly.
+    Assert: The correct URL was requested.
+
+    RED: get_product_status raises NotImplementedError — test errors until Phase 8.
+    """
+    seller_id = "SELLER_TEST_001"
+    product_id = "TCIN_ABC123"
+    status_id = "PSR-001"
+
+    expected_url = (
+        f"https://api.target.com/sellers/v1/sellers/{seller_id}"
+        f"/products/{product_id}/statuses/{status_id}"
+    )
+
+    status_route = respx.get(expected_url).respond(200, json=make_status_response())
+
+    client = TargetCatalogReadClient(
+        base_url="https://api.target.com",
+        auth_token="test_token",
+    )
+
+    result = await client.get_product_status(seller_id, product_id, status_id)
+
+    assert status_route.called
+    assert result["listing_status"] == "APPROVED"
+
+
+@respx.mock
+@pytest.mark.asyncio
+async def test_client_get_product_status_with_expand_includes_query_param():
+    """Real client: expand=product_statuses appears as query param in request URL.
+
+    Source: target-openapi.yaml §getProductStatus ?expand parameter (PDF p. 13).
+
+    RED: get_product_status raises NotImplementedError — test errors until Phase 8.
+    """
+    seller_id = "SELLER_TEST_001"
+    product_id = "TCIN_ABC123"
+    status_id = "PSR-001"
+
+    base_url = (
+        f"https://api.target.com/sellers/v1/sellers/{seller_id}"
+        f"/products/{product_id}/statuses/{status_id}"
+    )
+
+    expanded_route = respx.get(base_url).respond(
+        200, json=[make_status_response(), make_status_response(version=2, current=True)]
+    )
+
+    client = TargetCatalogReadClient(
+        base_url="https://api.target.com",
+        auth_token="test_token",
+    )
+
+    await client.get_product_status(seller_id, product_id, status_id, expand="product_statuses")
+
+    assert expanded_route.called
+    # Verify expand param present in the request
+    request = expanded_route.calls.last.request
+    assert "expand=product_statuses" in str(request.url)
+
+
+# ---------------------------------------------------------------------------
+# Client connection error — propagates cleanly
+# ---------------------------------------------------------------------------
+
+
+@respx.mock
+@pytest.mark.asyncio
+async def test_client_handles_connection_refused():
+    """Client raises a clean error when the target host is unreachable.
+
+    RED: get_product_status raises NotImplementedError — test errors until Phase 8.
+    """
+    seller_id = "SELLER_TEST_001"
+    product_id = "TCIN_ABC123"
+    status_id = "PSR-001"
+
+    respx.get(
+        f"https://api.target.com/sellers/v1/sellers/{seller_id}"
+        f"/products/{product_id}/statuses/{status_id}"
+    ).mock(side_effect=httpx.ConnectError("Connection refused"))
+
+    client = TargetCatalogReadClient(
+        base_url="https://api.target.com",
+        auth_token="test_token",
+    )
+
+    with pytest.raises((httpx.ConnectError, ConnectionError)):
+        await client.get_product_status(seller_id, product_id, status_id)
