+"""
+Mapping logic: Target API ProductStatus dict → TargetCatalogStatus model.
+
+Implements the mapping table from feature-spec.md § 4.
+"""
+
+import json
+import logging
+from datetime import datetime
+from typing import Any
+
+from app.catalog_sync.models import (
+    TargetCatalogStatus,
+    KNOWN_VALIDATION_STATUSES,
+)
+
+logger = logging.getLogger(__name__)
+
+
+def _parse_iso_datetime(value: str | None) -> datetime | None:
+    """Parse an ISO 8601 datetime string, returning None on failure or missing input."""
+    if not value:
+        return None
+    try:
+        return datetime.fromisoformat(value.replace("Z", "+00:00"))
+    except (ValueError, AttributeError):
+        return None
+
+
+def _serialize_errors(errors: list | None) -> str | None:
+    """Serialize ProductStatus.errors array to JSON string, or None if empty."""
+    if not errors:
+        return None
+    return json.dumps(errors)
+
+
+def map_product_status(
+    raw: dict[str, Any],
+    tcin: str,
+    external_id: str,
+) -> TargetCatalogStatus:
+    """Map a raw ProductStatus API response dict to a TargetCatalogStatus row.
+
+    Args:
+        raw: ProductStatus dict from TargetCatalogReadClient.get_product_status().
+        tcin: Target Catalog Item Number (caller-supplied; not in ProductStatus body).
+        external_id: Seller SKU (caller-supplied; not in ProductStatus body).
+
+    Returns:
+        TargetCatalogStatus dataclass ready for DB upsert.
+    """
+    # Extract raw validation_status; may be missing or unknown
+    raw_validation = raw.get("validation_status")
+
+    # Normalised validation_status: only set if value is in the known enum
+    if raw_validation is not None and raw_validation not in KNOWN_VALIDATION_STATUSES:
+        logger.warning(
+            "Unknown validation_status '%s' for tcin=%s; storing in raw field only",
+            raw_validation,
+            tcin,
+        )
+        normalised_validation = None
+    else:
+        normalised_validation = raw_validation
+
+    return TargetCatalogStatus(
+        tcin=tcin,
+        external_id=external_id,
+        product_status_id=raw.get("id"),
+        version=raw.get("version"),
+        is_current=raw.get("current", False),
+        listing_status=raw.get("listing_status"),
+        validation_status=normalised_validation,
+        validation_status_raw=raw_validation,
+        errors_json=_serialize_errors(raw.get("errors")),
+        status_created_at=_parse_iso_datetime(raw.get("created")),
+        status_last_modified_at=_parse_iso_datetime(raw.get("last_modified")),
+    )
