+# ---------------------------------------------------------------------------
+
+
+def test_unknown_validation_status_stored_in_raw_field():
+    """Unknown validation_status value is stored in validation_status_raw.
+
+    Only INITIATED is documented (target-openapi.yaml §ProductStatus).
+    Any other value must be captured in validation_status_raw so it is
+    not silently dropped.
+
+    RED: map_product_status raises NotImplementedError — test errors until Phase 8.
