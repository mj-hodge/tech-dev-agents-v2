+"""
+HTTP client for Target catalog status endpoint.
+
+Read-only. Uses httpx with dependency injection for test mocking.
+
+Endpoint:
+  GET /sellers/v1/sellers/{seller_id}/products/{product_id}/statuses/{product_status_id}
+  ?expand=product_statuses  — full version history
+
+Source: target-openapi.yaml §getProductStatus (PDF p. 12–13)
+"""
+
+from typing import Any
+
+import httpx
+
+
+class TargetCatalogReadClient:
+    """Fetches product status records from Target API (read-only)."""
+
+    def __init__(
+        self,
+        base_url: str = "https://api.target.com",
+        auth_token: str = "",
+    ) -> None:
+        self.base_url = base_url.rstrip("/")
+        self.auth_token = auth_token
+
+    async def get_product_status(
+        self,
+        seller_id: str,
+        product_id: str,
+        product_status_id: str,
+        expand: str | None = None,
+    ) -> dict[str, Any] | list[dict[str, Any]]:
+        """GET /sellers/v1/sellers/{seller_id}/products/{product_id}/statuses/{product_status_id}
+
+        Args:
+            seller_id: Target seller identifier.
+            product_id: Product identifier (tcin or external_id — see OQ-1 in feature-spec).
+            product_status_id: Specific status record ID.
+            expand: Pass "product_statuses" to return full version history.
+
+        Returns:
+            ProductStatus dict (or list of dicts when expand is set).
+        """
+        url = (
+            f"{self.base_url}/sellers/v1/sellers/{seller_id}"
+            f"/products/{product_id}/statuses/{product_status_id}"
+        )
+
+        params: dict[str, str] = {}
+        if expand:
+            params["expand"] = expand
+
+        headers = {"Authorization": f"Bearer {self.auth_token}"}
+
+        async with httpx.AsyncClient() as http:
+            response = await http.get(url, params=params, headers=headers)
+            response.raise_for_status()
+            return response.json()
