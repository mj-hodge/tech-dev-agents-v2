+"""
+Shared fixtures for catalog_sync tests.
+
+Provides:
+  - SELLER_ID constant
+  - sample_items: minimal product registry entries for sync_once
+  - mock_status_response_*: ProductStatus API response fixtures for each enum value
+"""
+
+import pytest
+
+SELLER_ID = "SELLER_TEST_001"
+
+# Minimal product registry entries (caller-supplied to sync_once)
+SAMPLE_ITEMS = [
+    {
+        "tcin": "TCIN_ABC123",
+        "external_id": "SKU-001",
+        "product_status_id": "PSR-001",
+    },
+    {
+        "tcin": "TCIN_DEF456",
+        "external_id": "SKU-002",
+        "product_status_id": "PSR-002",
+    },
+]
+
+# ProductStatus API response fixtures — one per listing_status enum value
+# (per target-openapi.yaml §ProductStatus and seed test criteria)
+
+def make_status_response(
+    product_status_id: str = "PSR-001",
+    listing_status: str = "APPROVED",
+    validation_status: str = "INITIATED",
+    version: int = 1,
+    current: bool = True,
+    errors: list | None = None,
+) -> dict:
+    return {
+        "id": product_status_id,
+        "listing_status": listing_status,
+        "validation_status": validation_status,
+        "version": version,
+        "current": current,
+        "errors": errors or [],
+        "created": "2026-04-01T10:00:00Z",
+        "last_modified": "2026-04-15T12:00:00Z",
+    }
+
+
+@pytest.fixture
+def approved_status():
+    return make_status_response(listing_status="APPROVED")
+
+
+@pytest.fixture
+def rejected_status():
+    return make_status_response(
+        listing_status="REJECTED",
+        errors=[{"code": "INVALID_IMAGE", "message": "Image resolution too low"}],
+    )
+
+
+@pytest.fixture
+def suspended_status():
+    return make_status_response(listing_status="SUSPENDED")
+
+
+@pytest.fixture
+def pending_status():
+    return make_status_response(listing_status="PENDING")
+
+
+@pytest.fixture
+def unlisted_status():
+    return make_status_response(listing_status="UNLISTED")
+
+
+@pytest.fixture
+def version_history_statuses():
+    """Two version records for the same product — returned with expand=product_statuses."""
+    return [
+        make_status_response(
+            product_status_id="PSR-001-v1",
+            listing_status="PENDING",
+            version=1,
+            current=False,
+        ),
+        make_status_response(
+            product_status_id="PSR-001-v2",
+            listing_status="APPROVED",
+            version=2,
+            current=True,
+        ),
+    ]
