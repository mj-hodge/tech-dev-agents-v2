+    load_registry,
+    get_registry,
+    list_types,
+    get_type_config,
+    register_type,
+    ReportTypeConfig,
+    ReportRegistry,
+)
+
+
+VALID_YAML = """
+report_types:
+  - type: ALLOWED_ITEM_TYPES
+    format: JSON
+    description: "Test type"
+    poll_interval_seconds: 10
+    poll_timeout_seconds: 300
+  - type: ANOTHER_TYPE
+    format: JSON
+    description: "Another type"
+"""
+
+
+@pytest.fixture(autouse=True)
+def reset_registry():
+    """Reset global registry between tests."""
+    import app.reports.registry as reg_module
+    original = reg_module._REGISTRY
+    yield
+    reg_module._REGISTRY = original
+
+
+@pytest.fixture
+def yaml_file():
+    """Write a temp registry YAML file."""
+    with tempfile.NamedTemporaryFile(mode="w", suffix=".yaml", delete=False) as f:
+        f.write(VALID_YAML)
+        return Path(f.name)
+
+
+class TestLoadRegistry:
+    def test_load_from_yaml_file(self, yaml_file):
+        """load_registry reads YAML and returns ReportRegistry."""
+        reg = load_registry(yaml_file)
+        assert isinstance(reg, ReportRegistry)
+        assert len(reg.report_types) == 2
+
+    def test_loaded_types_are_pydantic_models(self, yaml_file):
+        """Each report_type entry is a ReportTypeConfig model."""
+        reg = load_registry(yaml_file)
+        for rt in reg.report_types:
+            assert isinstance(rt, ReportTypeConfig)
+
+    def test_default_values_populated(self, yaml_file):
+        """Optional fields receive their defaults when absent."""
+        reg = load_registry(yaml_file)
+        item = next(rt for rt in reg.report_types if rt.type == "ANOTHER_TYPE")
+        assert item.start_date_required is False
+        assert item.end_date_required is False
+        assert item.poll_interval_seconds == 10
+        assert item.poll_timeout_seconds == 300
+
+    def test_load_production_registry(self):
+        """Default path (registry.yaml) loads without error."""
+        from app.reports.registry import _REGISTRY_PATH
+        reg = load_registry(_REGISTRY_PATH)
+        assert len(reg.report_types) >= 1
+        types = [rt.type for rt in reg.report_types]
+        assert "ALLOWED_ITEM_TYPES" in types
+
+    def test_missing_file_raises(self):
+        """load_registry raises on nonexistent file."""
+        with pytest.raises((FileNotFoundError, OSError)):
+            load_registry(Path("/nonexistent/registry.yaml"))
+
+    def test_invalid_yaml_raises(self):
+        """load_registry raises on malformed YAML."""
+        with tempfile.NamedTemporaryFile(mode="w", suffix=".yaml", delete=False) as f:
+            f.write("not: valid: yaml: [\n")
+            bad_path = Path(f.name)
+        with pytest.raises(Exception):
+            load_registry(bad_path)
+
+
+class TestGetRegistry:
+    def test_raises_if_not_loaded(self):
+        """get_registry raises RuntimeError when registry not loaded."""
+        import app.reports.registry as reg_module
+        reg_module._REGISTRY = None
+        with pytest.raises(RuntimeError, match="not loaded"):
+            get_registry()
+
+    def test_returns_registry_after_load(self, yaml_file):
+        """get_registry returns the loaded registry."""
