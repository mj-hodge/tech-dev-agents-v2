+
+
+class TestListTypes:
+    def test_returns_type_names(self, yaml_file):
+        """list_types returns all registered type name strings."""
+        load_registry(yaml_file)
+        types = list_types()
+        assert "ALLOWED_ITEM_TYPES" in types
+        assert "ANOTHER_TYPE" in types
+
+    def test_returns_list_of_strings(self, yaml_file):
+        """All items returned by list_types are strings."""
+        load_registry(yaml_file)
+        for t in list_types():
+            assert isinstance(t, str)
+
+
+class TestGetTypeConfig:
+    def test_known_type_returns_config(self, yaml_file):
+        """get_type_config returns ReportTypeConfig for a known type."""
+        load_registry(yaml_file)
+        config = get_type_config("ALLOWED_ITEM_TYPES")
+        assert isinstance(config, ReportTypeConfig)
+        assert config.type == "ALLOWED_ITEM_TYPES"
+        assert config.format == "JSON"
+
+    def test_unknown_type_raises_value_error(self, yaml_file):
+        """get_type_config raises ValueError for an unknown type."""
+        load_registry(yaml_file)
+        with pytest.raises(ValueError, match="Unknown report type"):
+            get_type_config("DOES_NOT_EXIST")
+
+    def test_error_message_lists_available_types(self, yaml_file):
+        """ValueError message includes the list of registered types."""
+        load_registry(yaml_file)
+        with pytest.raises(ValueError) as exc_info:
+            get_type_config("BOGUS")
+        assert "ALLOWED_ITEM_TYPES" in str(exc_info.value)
+
+
+class TestRegisterType:
+    def test_register_new_type(self, yaml_file):
+        """register_type adds a new type to the in-memory registry."""
+        load_registry(yaml_file)
+        register_type("DYNAMIC_TYPE", format="JSON", description="Test dynamic type")
+        assert "DYNAMIC_TYPE" in list_types()
+
+    def test_register_duplicate_is_idempotent(self, yaml_file):
+        """Registering an existing type does not create a duplicate."""
+        load_registry(yaml_file)
+        before_count = len(list_types())
+        register_type("ALLOWED_ITEM_TYPES")
+        assert len(list_types()) == before_count
+
+    def test_registered_type_is_retrievable(self, yaml_file):
+        """A type added via register_type is retrievable by get_type_config."""
+        load_registry(yaml_file)
+        register_type("EPHEMERAL", format="JSON", description="Ephemeral test type")
+        config = get_type_config("EPHEMERAL")
+        assert config.type == "EPHEMERAL"
