+"""
+Gate 2a: tgtrt credential MUST NEVER appear in logs (R-A-3 — SC-2 — MANDATORY).
+
+These tests assert that the TargetReportsClient's event hook strips auth headers
+before any debug logging. A failing test here means a credential leak risk.
+"""
+import logging
+import pytest
+import respx
+import httpx
+
+from app.reports.client import TargetReportsClient
+
+
+SELLER_ID = "test-seller-001"
+BASE_URL = "https://api.target.com"
+REAL_TGTRT = "REAL-TGTRT-VALUE-MUST-NOT-APPEAR-IN-LOGS"
+REAL_AUTH_TOKEN = "Bearer REAL-AUTH-TOKEN-MUST-NOT-APPEAR-IN-LOGS"
+
+
+@pytest.fixture
+async def client_with_hook():
+    """Client with _redact_auth_on_log event hook registered."""
+    http_client = httpx.AsyncClient(
+        event_hooks={"request": [TargetReportsClient._redact_auth_on_log]},
+        timeout=10.0,
+    )
+    client = TargetReportsClient(
+        base_url=BASE_URL,
+        seller_id=SELLER_ID,
+        auth_headers={"Authorization": REAL_AUTH_TOKEN, "x-seller-id": SELLER_ID},
+        tgtrt_value=REAL_TGTRT,
+        http_client=http_client,
+    )
+    yield client
+    await client.close()
+
+
+class TestTgtrtRedactedInLogs:
+    @pytest.mark.asyncio
+    @respx.mock
+    async def test_tgtrt_absent_from_logged_request_headers(
+        self, client_with_hook, caplog
+    ):
+        """After a download call, tgtrt value MUST NOT appear in captured log output."""
+        download_url = "https://reports.target.com/downloads/test"
+        respx.get(download_url).mock(return_value=httpx.Response(200, content=b"{}"))
+
+        with caplog.at_level(logging.DEBUG):
+            await client_with_hook.download_report(download_url)
+
+        # The literal tgtrt value must not appear anywhere in logs
+        assert REAL_TGTRT not in caplog.text
+
+    @pytest.mark.asyncio
+    @respx.mock
+    async def test_authorization_token_absent_from_logged_request_headers(
+        self, client_with_hook, caplog
+    ):
+        """After any API call, Authorization token MUST NOT appear in captured log output."""
+        url = f"{BASE_URL}/sellers/v1/sellers/{SELLER_ID}/report_requests/tgt-001"
+        respx.get(url).mock(return_value=httpx.Response(200, json={"status": "PENDING"}))
+
+        with caplog.at_level(logging.DEBUG):
+            await client_with_hook.get_report_request("tgt-001")
+
+        assert "REAL-AUTH-TOKEN-MUST-NOT-APPEAR-IN-LOGS" not in caplog.text
+
+    @pytest.mark.asyncio
+    async def test_redact_hook_modifies_headers_in_place(self):
+        """_redact_auth_on_log replaces auth header values with ***REDACTED***."""
+        request = httpx.Request(
+            "POST",
+            f"{BASE_URL}/sellers/v1/sellers/{SELLER_ID}/report_requests",
+            headers={
+                "Authorization": REAL_AUTH_TOKEN,
+                "tgtrt": REAL_TGTRT,
+                "x-api-key": "real-api-key",
+                "Content-Type": "application/json",
+            },
+        )
+        await TargetReportsClient._redact_auth_on_log(request)
+
+        assert request.headers["authorization"] == "***REDACTED***"
+        assert request.headers["tgtrt"] == "***REDACTED***"
+        assert request.headers["x-api-key"] == "***REDACTED***"
+        # Non-sensitive header preserved
+        assert request.headers["content-type"] == "application/json"
+
+    @pytest.mark.asyncio
+    @respx.mock
+    async def test_tgtrt_sent_on_wire_but_not_in_logs(self, caplog):
+        """
+        The tgtrt header IS sent on the wire (download works) but does NOT appear in logs.
+        This distinguishes 'header stripped from logs' from 'header not sent at all'.
+        """
+        download_url = "https://reports.target.com/downloads/wire-test"
+        captured_headers = {}
+
+        def capture_request(request: httpx.Request):
+            captured_headers.update(dict(request.headers))
+            return httpx.Response(200, content=b'{"items":[]}')
+
+        respx.get(download_url).mock(side_effect=capture_request)
+
+        http_client = httpx.AsyncClient(timeout=10.0)
+        client = TargetReportsClient(
+            base_url=BASE_URL,
+            seller_id=SELLER_ID,
+            auth_headers={"Authorization": REAL_AUTH_TOKEN},
+            tgtrt_value=REAL_TGTRT,
+            http_client=http_client,
+        )
+
+        with caplog.at_level(logging.DEBUG):
+            await client.download_report(download_url)
+        await client.close()
+
+        # tgtrt IS present on the wire
+        assert "tgtrt" in captured_headers
+        # But NOT in logs
+        assert REAL_TGTRT not in caplog.text
