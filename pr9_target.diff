+"""HTTP client for Target's async report API. Injected via DI; mock in test/local."""
+import httpx
+from typing import Any
+
+
+class TargetReportsClient:
+    """Communicates with Target's report_requests endpoints."""
+
+    def __init__(
+        self,
+        base_url: str,
+        seller_id: str,
+        auth_headers: dict[str, str],
+        tgtrt_value: str,
+        http_client: httpx.AsyncClient | None = None,
+    ):
+        self._base_url = base_url.rstrip("/")
+        self._seller_id = seller_id
+        self._auth_headers = auth_headers
+        self._tgtrt_value = tgtrt_value
+        self._client = http_client or httpx.AsyncClient(
+            event_hooks={"request": [self._redact_auth_on_log]},
+            timeout=30.0,
+        )
+
+    @staticmethod
+    async def _redact_auth_on_log(request: httpx.Request) -> None:
+        """Event hook: strips auth headers from request before any debug logging.
+        R-A-3 mitigation: tgtrt and Authorization never appear in httpx debug output."""
+        sensitive = {"authorization", "tgtrt", "x-api-key"}
+        for header in sensitive:
+            if header in request.headers:
+                request.headers[header] = "***REDACTED***"
+
+    async def create_report_request(
+        self,
+        report_type: str,
+        report_format: str = "JSON",
+        start_date: str | None = None,
+        end_date: str | None = None,
+    ) -> dict[str, Any]:
+        """POST /sellers/v1/sellers/{seller_id}/report_requests"""
+        url = f"{self._base_url}/sellers/v1/sellers/{self._seller_id}/report_requests"
+        body: dict[str, Any] = {"type": report_type, "format": report_format}
+        if start_date:
+            body["start_date"] = start_date
+        if end_date:
+            body["end_date"] = end_date
+        resp = await self._client.post(url, json=body, headers=self._auth_headers)
+        resp.raise_for_status()
+        return resp.json()
+
+    async def get_report_request(self, target_request_id: str) -> dict[str, Any]:
+        """GET /sellers/v1/sellers/{seller_id}/report_requests/{report_request_id}"""
+        url = (
+            f"{self._base_url}/sellers/v1/sellers/{self._seller_id}"
+            f"/report_requests/{target_request_id}"
+        )
+        resp = await self._client.get(url, headers=self._auth_headers)
+        resp.raise_for_status()
+        return resp.json()
+
+    async def download_report(self, download_url: str) -> bytes:
+        """GET <download_url> with tgtrt header. Returns raw bytes."""
+        headers = {**self._auth_headers, "tgtrt": self._tgtrt_value}
+        resp = await self._client.get(download_url, headers=headers)
+        resp.raise_for_status()
+        return resp.content
+
+    async def close(self) -> None:
+        await self._client.aclose()
