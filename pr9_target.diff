+"""Report-type registry — loaded from registry.yaml at startup."""
+from pathlib import Path
+from pydantic import BaseModel
+import yaml
+
+
+class ReportTypeConfig(BaseModel):
+    type: str
+    format: str  # "JSON" is the only documented value
+    description: str
+    start_date_required: bool = False
+    end_date_required: bool = False
+    poll_interval_seconds: int = 10
+    poll_timeout_seconds: int = 300
+
+
+class ReportRegistry(BaseModel):
+    report_types: list[ReportTypeConfig]
+
+
+_REGISTRY: ReportRegistry | None = None
+_REGISTRY_PATH = Path(__file__).parent / "registry.yaml"
+
+
+def load_registry(path: Path | None = None) -> ReportRegistry:
+    """Load and validate registry from YAML. Called once at startup."""
+    global _REGISTRY
+    p = path or _REGISTRY_PATH
+    with open(p) as f:
+        data = yaml.safe_load(f)
+    _REGISTRY = ReportRegistry(**data)
+    return _REGISTRY
+
+
+def get_registry() -> ReportRegistry:
+    """Return loaded registry. Raises if not loaded."""
+    if _REGISTRY is None:
+        raise RuntimeError("Registry not loaded — call load_registry() at startup")
+    return _REGISTRY
+
+
+def list_types() -> list[str]:
+    """Return all registered report type names."""
+    return [rt.type for rt in get_registry().report_types]
+
+
+def get_type_config(report_type: str) -> ReportTypeConfig:
+    """Return config for a specific report type. Raises ValueError if unknown."""
+    for rt in get_registry().report_types:
+        if rt.type == report_type:
+            return rt
+    raise ValueError(
+        f"Unknown report type: {report_type}. Registered: {list_types()}"
+    )
+
+
+def register_type(
+    type_name: str, format: str = "JSON", description: str = ""
+) -> None:
+    """Programmatic registration (testing convenience). Does NOT persist to YAML."""
+    reg = get_registry()
+    if type_name not in [rt.type for rt in reg.report_types]:
+        reg.report_types.append(
+            ReportTypeConfig(
+                type=type_name,
+                format=format,
+                description=description or f"Dynamically registered: {type_name}",
+            )
+        )
