@@ -0,0 +1,198 @@
+"""Orchestrates the report request lifecycle: create → poll → download → persist."""
+
+import asyncio
+import json
+import logging
+
+from app.reports.client import TargetReportsClient
+from app.reports.registry import get_type_config
+from app.reports.storage import ReportStorage
+
+logger = logging.getLogger(__name__)
+
+PENDING = "PENDING"
+DOWNLOADING = "DOWNLOADING"
+DONE = "DONE"
+FAILED = "FAILED"
+DOCUMENT_TOO_LARGE = "DOCUMENT_TOO_LARGE"
+UNRECOGNIZED_STATUS = "UNRECOGNIZED_STATUS"
+
+TERMINAL_STATES = {DONE, FAILED, DOCUMENT_TOO_LARGE, UNRECOGNIZED_STATUS}
+
+# Known Target success/failure statuses (OQ-011: refine after STORY-007)
+TARGET_SUCCESS_STATUSES = {"COMPLETE", "DONE", "COMPLETED"}
+TARGET_FAILURE_STATUSES = {"FAILED", "ERROR", "CANCELLED"}
+
+MAX_DOCUMENT_BYTES = 10 * 1024 * 1024  # 10 MB — R-A-10 guard
+
+
+class ReportLifecycleService:
+    def __init__(self, client: TargetReportsClient, storage: ReportStorage):
+        self._client = client
+        self._storage = storage
+
+    async def request_report(
+        self,
+        report_type: str,
+        start_date: str | None = None,
+        end_date: str | None = None,
+    ) -> str:
+        """Create a new report request. Returns internal report_request ID (UUID string)."""
+        config = get_type_config(report_type)  # validates type is registered
+        target_response = await self._client.create_report_request(
+            report_type=config.type,
+            report_format=config.format,
+            start_date=start_date,
+            end_date=end_date,
+        )
+        request_id = await self._storage.create_request(
+            target_request_id=target_response["id"],
+            seller_id=target_response.get("seller_id", ""),
+            report_type=config.type,
+            report_format=config.format,
+        )
+        logger.info(
+            "Report request created",
+            extra={
+                "report_request_id": str(request_id),
+                "target_request_id": target_response["id"],
+                "report_type": config.type,
+            },
+        )
+        return str(request_id)
+
+    async def poll_and_complete(self, report_request_id: str) -> str:
+        """Poll Target until terminal state. Returns final status string."""
+        request = await self._storage.get_request(report_request_id)
+        config = get_type_config(request["report_type"])
+
+        max_attempts = (
+            config.poll_timeout_seconds // config.poll_interval_seconds
+            if config.poll_interval_seconds > 0
+            else config.poll_timeout_seconds
+        )
+        for attempt in range(1, max_attempts + 1):
+            await asyncio.sleep(config.poll_interval_seconds)
+            target_response = await self._client.get_report_request(
+                request["target_request_id"]
+            )
+
+            status_raw = target_response.get("status", "")
+            await self._storage.update_poll(
+                report_request_id, status_raw=status_raw, attempts=attempt
+            )
+
+            status_upper = status_raw.upper()
+
+            if status_upper in TARGET_SUCCESS_STATUSES:
+                return await self._handle_download(
+                    report_request_id,
+                    target_response.get("download_url", ""),
+                    config.type,
+                )
+            elif status_upper in TARGET_FAILURE_STATUSES:
+                await self._storage.update_status(
+                    report_request_id,
+                    FAILED,
+                    error_message=f"Target returned: {status_raw}",
+                )
+                return FAILED
+            elif status_upper == "PENDING":
+                continue  # keep polling
+            else:
+                # R-A-4: unknown status — store raw, halt polling, don't guess
+                await self._storage.update_status(
+                    report_request_id,
+                    UNRECOGNIZED_STATUS,
+                    error_message=f"Unknown Target status: {status_raw}",
+                )
+                logger.warning(
+                    "Unrecognized Target report status",
+                    extra={
+                        "report_request_id": report_request_id,
+                        "status_raw": status_raw,
+                    },
+                )
+                return UNRECOGNIZED_STATUS
+
+        # Timeout: exceeded max attempts
+        await self._storage.update_status(
+            report_request_id,
+            FAILED,
+            error_message=f"Poll timeout after {config.poll_timeout_seconds}s",
+        )
+        return FAILED
+
+    async def _handle_download(
+        self, report_request_id: str, download_url: str, report_type: str
+    ) -> str:
+        """Download report document and persist. Returns terminal status."""
+        await self._storage.update_status(report_request_id, DOWNLOADING)
+
+        if not download_url:
+            await self._storage.update_status(
+                report_request_id,
+                FAILED,
+                error_message="No download_url in Target response",
+            )
+            return FAILED
+
+        try:
+            content_bytes = await self._client.download_report(download_url)
+        except Exception as e:
+            await self._storage.update_status(
+                report_request_id,
+                FAILED,
+                error_message=f"Download failed: {e}",
+            )
+            return FAILED
+
+        content_size = len(content_bytes)
+
+        if content_size > MAX_DOCUMENT_BYTES:
+            # R-A-10: payload exceeds storage limit
+            await self._storage.store_document(
+                report_request_id=report_request_id,
+                report_type=report_type,
+                content=None,
+                content_size_bytes=content_size,
+                storage_status=DOCUMENT_TOO_LARGE,
+            )
+            await self._storage.update_status(
+                report_request_id,
+                DOCUMENT_TOO_LARGE,
+                error_message=(
+                    f"Document {content_size} bytes exceeds {MAX_DOCUMENT_BYTES} limit"
+                ),
+            )
+            return DOCUMENT_TOO_LARGE
+
+        content_json = json.loads(content_bytes)
+
+        await self._storage.store_document(
+            report_request_id=report_request_id,
+            report_type=report_type,
+            content=content_json,
+            content_size_bytes=content_size,
+            storage_status="STORED",
+        )
+        await self._storage.update_status(report_request_id, DONE)
+        return DONE
+
+    async def startup_sweep(self) -> int:
+        """R-A-2: Re-enqueue stale PENDING/DOWNLOADING requests on startup. Returns count."""
+        stale = await self._storage.get_stale_requests(stale_threshold_seconds=60)
+        count = 0
+        for req in stale:
+            logger.info(
+                "Startup sweep: re-enqueuing stale request",
+                extra={
+                    "report_request_id": str(req["id"]),
+                    "status": req["status"],
+                    "last_polled_at": str(req.get("last_polled_at")),
+                },
+            )
+            asyncio.create_task(self.poll_and_complete(str(req["id"])))
+            count += 1
+        logger.info(f"Startup sweep: re-enqueued {count} stale report requests")
+        return count
