+"""Tests for unknown/unrecognized report status handling — Phase 7 acceptance (R-A-4).
+
+This test file verifies that the lifecycle poller handles unknown Target status
+values gracefully: stores status_raw, marks UNRECOGNIZED_STATUS, and does not crash.
+"""
+import pytest
+from unittest.mock import AsyncMock, patch
+from uuid import uuid4
+
+from app.reports.lifecycle import (
+    ReportLifecycleService,
+    UNRECOGNIZED_STATUS,
+)
+
+
+pytestmark = pytest.mark.asyncio
+
+
+def _make_type_config(type_name: str, poll_interval: int = 10, poll_timeout: int = 300):
+    from app.reports.registry import ReportTypeConfig
+    return ReportTypeConfig(
+        type=type_name,
+        format="JSON",
+        description=f"Test config for {type_name}",
+        poll_interval_seconds=poll_interval,
+        poll_timeout_seconds=poll_timeout,
+    )
+
+
+class TestUnknownStatus:
+    """R-A-4: Unknown Target status values must be stored in status_raw and
+    the lifecycle must transition to UNRECOGNIZED_STATUS without crashing."""
+
+    async def test_unknown_status_returns_unrecognized(
+        self, lifecycle, mock_client, mock_storage, sample_request_id, sample_report_row
+    ):
+        """poll_and_complete returns UNRECOGNIZED_STATUS for an unknown status value."""
+        mock_storage.get_request.return_value = sample_report_row
+        mock_client.get_report_request.return_value = {"status": "MYSTERY_STATUS_42"}
+
+        with patch("app.reports.lifecycle.get_type_config") as mock_config, \
+             patch("asyncio.sleep"):
+            mock_config.return_value = _make_type_config("ALLOWED_ITEM_TYPES", poll_interval=0, poll_timeout=10)
+            result = await lifecycle.poll_and_complete(sample_request_id)
+
+        assert result == UNRECOGNIZED_STATUS
+
+    async def test_status_raw_stored_on_unrecognized(
+        self, lifecycle, mock_client, mock_storage, sample_request_id, sample_report_row
+    ):
+        """When Target returns an unknown status, status_raw is stored via update_poll."""
+        mock_storage.get_request.return_value = sample_report_row
+        mock_client.get_report_request.return_value = {"status": "SOMETHING_UNEXPECTED"}
+
+        with patch("app.reports.lifecycle.get_type_config") as mock_config, \
+             patch("asyncio.sleep"):
+            mock_config.return_value = _make_type_config("ALLOWED_ITEM_TYPES", poll_interval=0, poll_timeout=10)
+            await lifecycle.poll_and_complete(sample_request_id)
+
+        # update_poll must have been called with the raw status value
+        mock_storage.update_poll.assert_called()
+        poll_call = mock_storage.update_poll.call_args
+        assert poll_call.kwargs.get("status_raw") == "SOMETHING_UNEXPECTED" or \
+               poll_call[1].get("status_raw") == "SOMETHING_UNEXPECTED" or \
+               "SOMETHING_UNEXPECTED" in str(poll_call)
+
+    async def test_update_status_called_with_unrecognized(
+        self, lifecycle, mock_client, mock_storage, sample_request_id, sample_report_row
+    ):
+        """update_status is called with UNRECOGNIZED_STATUS on unknown value."""
+        mock_storage.get_request.return_value = sample_report_row
+        mock_client.get_report_request.return_value = {"status": "BRAND_NEW_STATUS"}
+
+        with patch("app.reports.lifecycle.get_type_config") as mock_config, \
+             patch("asyncio.sleep"):
+            mock_config.return_value = _make_type_config("ALLOWED_ITEM_TYPES", poll_interval=0, poll_timeout=10)
+            await lifecycle.poll_and_complete(sample_request_id)
+
+        update_calls = mock_storage.update_status.call_args_list
+        statuses_set = [c.args[1] for c in update_calls]
+        assert UNRECOGNIZED_STATUS in statuses_set
+
+    async def test_does_not_crash_on_empty_status(
+        self, lifecycle, mock_client, mock_storage, sample_request_id, sample_report_row
+    ):
+        """An empty string status does not crash the poller — stored in status_raw."""
+        mock_storage.get_request.return_value = sample_report_row
+        mock_client.get_report_request.return_value = {"status": ""}
+
+        with patch("app.reports.lifecycle.get_type_config") as mock_config, \
+             patch("asyncio.sleep"):
+            mock_config.return_value = _make_type_config("ALLOWED_ITEM_TYPES", poll_interval=0, poll_timeout=10)
+            result = await lifecycle.poll_and_complete(sample_request_id)
+
+        # Empty string is not in known sets, so should be UNRECOGNIZED_STATUS
+        assert result == UNRECOGNIZED_STATUS
