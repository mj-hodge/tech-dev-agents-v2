+"""
+Gate 2a: ZERO outbound HTTP calls to Target production API in tests (SC-4 — MANDATORY).
+
+This test asserts that the test suite cannot reach api.target.com or any Target
+production host under any condition. A respx.mock context or assertions on
+httpx transport confirm all calls are intercepted.
+"""
+import pytest
+import respx
+import httpx
+
+from app.reports.client import TargetReportsClient
+
+
+SELLER_ID = "test-seller-001"
+PROD_BASE_URL = "https://api.target.com"
+TEST_TGTRT = "test-tgtrt-value"
+
+
+class TestNoProductionCalls:
+    @pytest.mark.asyncio
+    @respx.mock
+    async def test_create_request_does_not_call_production(self):
+        """create_report_request uses mock transport; no real network call."""
+        respx.post(f"{PROD_BASE_URL}/sellers/v1/sellers/{SELLER_ID}/report_requests").mock(
+            return_value=httpx.Response(201, json={"id": "mock-id", "seller_id": SELLER_ID})
+        )
+        client = TargetReportsClient(
+            base_url=PROD_BASE_URL,
+            seller_id=SELLER_ID,
+            auth_headers={"Authorization": "Bearer mock-token"},
+            tgtrt_value=TEST_TGTRT,
+        )
+        result = await client.create_report_request("ALLOWED_ITEM_TYPES")
+        assert result["id"] == "mock-id"
+        await client.close()
+
+    @pytest.mark.asyncio
+    @respx.mock
+    async def test_get_request_does_not_call_production(self):
+        """get_report_request uses mock transport; no real network call."""
+        respx.get(f"{PROD_BASE_URL}/sellers/v1/sellers/{SELLER_ID}/report_requests/tgt-001").mock(
+            return_value=httpx.Response(200, json={"id": "tgt-001", "status": "PENDING"})
+        )
+        client = TargetReportsClient(
+            base_url=PROD_BASE_URL,
+            seller_id=SELLER_ID,
+            auth_headers={"Authorization": "Bearer mock-token"},
+            tgtrt_value=TEST_TGTRT,
+        )
+        result = await client.get_report_request("tgt-001")
+        assert result["status"] == "PENDING"
+        await client.close()
+
+    @pytest.mark.asyncio
+    @respx.mock
+    async def test_download_report_does_not_call_production(self):
+        """download_report uses mock transport; no real network call."""
+        download_url = "https://reports.target.com/downloads/safe-mock"
+        respx.get(download_url).mock(
+            return_value=httpx.Response(200, content=b'{"items":[]}')
+        )
+        client = TargetReportsClient(
+            base_url=PROD_BASE_URL,
+            seller_id=SELLER_ID,
+            auth_headers={"Authorization": "Bearer mock-token"},
+            tgtrt_value=TEST_TGTRT,
+        )
+        result = await client.download_report(download_url)
+        assert result == b'{"items":[]}'
+        await client.close()
+
+    @pytest.mark.asyncio
+    @respx.mock
+    async def test_unmatched_call_raises_not_silently_succeeds(self):
+        """Any unregistered network call raises ConnectError (respx strict mode default)."""
+        client = TargetReportsClient(
+            base_url=PROD_BASE_URL,
+            seller_id=SELLER_ID,
+            auth_headers={"Authorization": "Bearer mock-token"},
+            tgtrt_value=TEST_TGTRT,
+        )
+        with pytest.raises(Exception):  # respx raises on unmatched routes
+            await client.get_report_request("unmatched-route-will-raise")
+        await client.close()
