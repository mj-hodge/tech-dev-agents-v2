+"""FastAPI router for reports API — Approach A: asyncio poller + YAML registry."""
+
+import httpx
+from fastapi import APIRouter, HTTPException
+
+from app.reports.models import ReportRequestCreate
+
+router = APIRouter(prefix="/api/v1/reports", tags=["reports"])
+
+
+# ── DI Providers ─────────────────────────────────────────────────────────────
+# These are plain functions (not Depends) so unit tests can patch them via
+# patch("app.reports.router.get_lifecycle_service") etc.  Production wiring
+# will be done in main.py lifespan or via FastAPI dependency_overrides once
+# STORY-007 provides staging credentials.
+
+def get_lifecycle_service():
+    """Return the configured ReportLifecycleService. Override in tests via patch."""
+    raise NotImplementedError(
+        "ReportLifecycleService not configured — set up at startup or override in tests"
+    )
+
+
+def get_storage():
+    """Return the configured ReportStorage. Override in tests via patch."""
+    raise NotImplementedError(
+        "ReportStorage not configured — set up at startup or override in tests"
+    )
+
+
+def get_registry():
+    """Return list of registered ReportTypeConfig entries. Override in tests via patch."""
+    from app.reports.registry import get_registry as _get_registry
+    return _get_registry().report_types
+
+
+# ── Endpoints ─────────────────────────────────────────────────────────────────
+
+@router.post("/requests", status_code=201)
+async def create_report_request(body: ReportRequestCreate):
+    """Submit a new report request to Target. Returns 201 with internal request ID."""
+    lifecycle = get_lifecycle_service()
+    try:
+        request_id = await lifecycle.request_report(
+            report_type=body.report_type,
+            start_date=body.start_date,
+            end_date=body.end_date,
+        )
+        return {"id": request_id}
+    except ValueError as exc:
+        raise HTTPException(
+            status_code=422,
+            detail={
+                "type": "/problems/report-type-unknown",
+                "title": "Unknown Report Type",
+                "status": 422,
+                "detail": str(exc),
+                "instance": "/api/v1/reports/requests",
+            },
+        )
+    except httpx.HTTPStatusError as exc:
+        raise HTTPException(
+            status_code=502,
+            detail={
+                "type": "/problems/target-api-error",
+                "title": "Target API Error",
+                "status": 502,
+                "detail": str(exc),
+                "instance": "/api/v1/reports/requests",
+            },
+        )
+
+
+@router.get("/requests/{request_id}")
+async def get_report_request(request_id: str):
+    """Get status of a report request by internal UUID."""
+    storage = get_storage()
+    try:
+        row = await storage.get_request(request_id)
+        return row
+    except KeyError as exc:
+        raise HTTPException(
+            status_code=404,
+            detail={
+                "type": "/problems/report-not-found",
+                "title": "Report Not Found",
+                "status": 404,
+                "detail": str(exc),
+                "instance": f"/api/v1/reports/requests/{request_id}",
+            },
+        )
+
+
+@router.get("/requests/{request_id}/document")
+async def get_report_document(request_id: str):
+    """Get downloaded report document content for a completed request."""
+    storage = get_storage()
+    try:
+        doc = await storage.get_document(request_id)
+    except KeyError as exc:
+        raise HTTPException(
+            status_code=404,
+            detail={
+                "type": "/problems/document-not-found",
+                "title": "Document Not Found",
+                "status": 404,
+                "detail": str(exc),
+                "instance": f"/api/v1/reports/requests/{request_id}/document",
+            },
+        )
+
+    if doc.get("storage_status") == "DOCUMENT_TOO_LARGE":
+        raise HTTPException(
+            status_code=410,
+            detail={
+                "type": "/problems/document-too-large",
+                "title": "Document Too Large",
+                "status": 410,
+                "detail": (
+                    f"Document was not stored — payload exceeded "
+                    f"{doc.get('content_size_bytes', '?')} bytes"
+                ),
+                "instance": f"/api/v1/reports/requests/{request_id}/document",
+            },
+        )
+
+    return doc
+
+
+@router.get("/types")
+async def list_report_types():
+    """List all registered report types from the YAML registry."""
+    types = get_registry()
+    return types
