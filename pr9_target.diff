+"""
+Full lifecycle integration test: POST → poll → download → persist (SC-1).
+
+This test exercises the complete async report lifecycle through
+ReportLifecycleService, from creating a report request through polling
+until COMPLETE, downloading the report document, and verifying persistence.
+
+All external dependencies (Target HTTP API, Postgres storage) are mocked.
+"""
+import json
+import pytest
+from unittest.mock import AsyncMock, patch
+from uuid import uuid4
+
+from app.reports.lifecycle import (
+    ReportLifecycleService,
+    DONE,
+    FAILED,
+    PENDING,
+)
+
+
+pytestmark = pytest.mark.asyncio
+
+
+async def test_full_lifecycle_post_poll_download(
+    lifecycle, mock_client, mock_storage, sample_target_request_id
+):
+    """POST request → poll (PENDING × 2, then COMPLETE) → download → persist → DONE."""
+    internal_id = uuid4()
+    report_content = {"items": [{"tcin": "12345"}, {"tcin": "67890"}]}
+    download_url = "https://reports.target.com/downloads/lifecycle-test"
+
+    # 1. create_report_request returns Target ID
+    mock_client.create_report_request.return_value = {
+        "id": sample_target_request_id,
+        "seller_id": "test-seller-001",
+    }
+    mock_storage.create_request.return_value = internal_id
+
+    # 2. Poll: first two return PENDING, third returns COMPLETE with download URL
+    mock_client.get_report_request.side_effect = [
+        {"status": "PENDING"},
+        {"status": "PENDING"},
+        {"status": "COMPLETE", "download_url": download_url},
+    ]
+
+    # 3. Download returns report content
+    mock_client.download_report.return_value = json.dumps(report_content).encode()
+
+    # 4. Storage get_request returns the stored row
+    mock_storage.get_request.return_value = {
+        "id": str(internal_id),
+        "target_request_id": sample_target_request_id,
+        "seller_id": "test-seller-001",
+        "report_type": "ALLOWED_ITEM_TYPES",
+        "report_format": "JSON",
+        "status": PENDING,
+        "status_raw": None,
+        "download_url": None,
+        "attempts": 0,
+    }
+
+    with patch("app.reports.lifecycle.get_type_config") as mock_config, \
+         patch("asyncio.sleep"):
+        from app.reports.registry import ReportTypeConfig
+        mock_config.return_value = ReportTypeConfig(
+            type="ALLOWED_ITEM_TYPES",
+            format="JSON",
+            description="Test",
+            poll_interval_seconds=0,
+            poll_timeout_seconds=60,
+        )
+
+        # Step 1: Request
+        request_id = await lifecycle.request_report("ALLOWED_ITEM_TYPES")
+        assert request_id == str(internal_id)
+
+        # Step 2+3: Poll and complete (includes download)
+        result = await lifecycle.poll_and_complete(request_id)
+
+    # Final state is DONE
+    assert result == DONE
+
+    # Verify download was called with correct URL
+    mock_client.download_report.assert_called_once_with(download_url)
+
+    # Verify document was stored with correct content
+    store_calls = mock_storage.store_document.call_args_list
+    assert len(store_calls) == 1
+    stored = store_calls[0]
+    assert stored.kwargs["content"] == report_content
+    assert stored.kwargs["storage_status"] == "STORED"
+    assert stored.kwargs["report_type"] == "ALLOWED_ITEM_TYPES"
+
+    # Verify final status update to DONE
+    status_calls = mock_storage.update_status.call_args_list
+    final_status = status_calls[-1]
+    assert final_status.args[1] == DONE
