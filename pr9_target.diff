+"""Postgres persistence interface for report requests and documents.
+
+Concrete implementation is deferred until STORY-007 provides staging credentials.
+Tests use AsyncMock(spec=ReportStorage) — the interface here drives the spec.
+
+Includes retention policy support: report_documents rows have a
+retention_expires_at column (nullable). When set, a cleanup job
+can delete expired documents. Default: NULL (no auto-delete).
+"""
+
+from typing import Any
+from uuid import UUID
+
+# Default retention period for stored report documents (days).
+# NULL / None means no automatic expiry.
+DEFAULT_RETENTION_DAYS: int | None = None
+
+
+class ReportStorage:
+    """Data access for report_requests and report_documents tables.
+
+    Retention: store_document accepts an optional retention_expires_at;
+    if not provided, defaults to DEFAULT_RETENTION_DAYS from now (or NULL).
+    """
+
+    async def create_request(
+        self,
+        target_request_id: str,
+        seller_id: str,
+        report_type: str,
+        report_format: str,
+    ) -> UUID:
+        """Insert new report_requests row. Returns internal UUID."""
+        raise NotImplementedError("create_request not implemented")
+
+    async def get_request(self, request_id: str) -> dict[str, Any]:
+        """Fetch report_requests row by internal UUID. Raises KeyError if not found."""
+        raise NotImplementedError("get_request not implemented")
+
+    async def update_status(
+        self,
+        request_id: str,
+        status: str,
+        error_message: str | None = None,
+    ) -> None:
+        """Update status + timestamps. Sets completed_at on DONE, failed_at on FAILED."""
+        raise NotImplementedError("update_status not implemented")
+
+    async def update_poll(
+        self,
+        request_id: str,
+        status_raw: str,
+        attempts: int,
+    ) -> None:
+        """Update status_raw, attempts, last_polled_at after a poll cycle."""
+        raise NotImplementedError("update_poll not implemented")
+
+    async def store_document(
+        self,
+        report_request_id: str,
+        report_type: str,
+        content: dict | None,
+        content_size_bytes: int,
+        storage_status: str,
+    ) -> UUID:
+        """Insert report_documents row. Returns document UUID."""
+        raise NotImplementedError("store_document not implemented")
+
+    async def get_document(self, report_request_id: str) -> dict[str, Any]:
+        """Fetch report_documents row by report_request_id. Raises KeyError if not found."""
+        raise NotImplementedError("get_document not implemented")
+
+    async def get_stale_requests(
+        self, stale_threshold_seconds: int = 60
+    ) -> list[dict[str, Any]]:
+        """Return PENDING/DOWNLOADING requests older than threshold. For startup sweep."""
+        raise NotImplementedError("get_stale_requests not implemented")
