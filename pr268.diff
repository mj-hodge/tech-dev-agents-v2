+async def test_cron_scoped_bypass_does_not_affect_concurrent_requests():
+    """AC-6: During cron bypass, concurrent writes from unrelated tasks still get READ_ONLY_MODE."""
+    from src.tools._write_guard import (
+        acquire_cron_write_bypass,
+        check_write_allowed,
+        release_cron_write_bypass,
+    )
+    import src.tools._write_guard as wg
+
+    orig_ro = wg._read_only_override
+    wg._read_only_override = True
+    try:
+        user_result: list = []
+
+        async def concurrent_user_write():
+            """Simulated concurrent request — no bypass token in its context."""
+            r = await check_write_allowed("portfolio_update_budget")
+            user_result.append(r)
+
+        # Create user task BEFORE acquiring bypass — captures context WITHOUT bypass token
+        user_task = asyncio.create_task(concurrent_user_write())
+
+        # Acquire bypass in the current (cron) context
+        token = acquire_cron_write_bypass("profile_abc", "session_xyz")
+        try:
+            # Yield control so the user task can run (its context has no bypass token)
+            await asyncio.sleep(0)
+            await user_task
+
+            # Cron's own write — should be ALLOWED (bypass token in current context)
+            cron_result = await check_write_allowed("portfolio_update_budget")
+            assert cron_result is None, (
+                f"Cron's own write should be allowed with bypass token, got: {cron_result}"
+            )
+
+            # Concurrent user write — should be BLOCKED
+            assert len(user_result) == 1, "user_task should have completed"
+            assert user_result[0] is not None, (
+                "Concurrent user write should be blocked (returned error dict, not None)"
+            )
+            # problem_dict puts the code in extensions AND as error_code at the top level
+            blocked = user_result[0]
+            code = (
+                blocked.get("code")
+                or blocked.get("error_code")
+                or (blocked.get("extensions") or {}).get("code")
+            )
+            assert code == "READ_ONLY_MODE", (
+                f"Expected READ_ONLY_MODE, got: {blocked}"
+            )
+        finally:
+            release_cron_write_bypass(
+                token, profile_id="profile_abc", session_id="session_xyz"
+            )
+    finally:
+        wg._read_only_override = orig_ro
