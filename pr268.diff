@@ -0,0 +1,349 @@
+"""
+tests/test_story094/test_sp_keywords_cache.py — RED tests for STORY-094.
+
+Tests that sp_list_keywords uses @cache_first caching and that sync_cycle
+includes keyword fetching.
+
+State: RED — sp_list_keywords lacks @cache_first; sync_cycle lacks keyword fetch.
+Zero outbound HTTP calls — all Amazon API interactions mocked.
+"""
+
+from __future__ import annotations
+
+from unittest.mock import AsyncMock, MagicMock, patch
+
+import pytest
+
+from src.cache.ttl_cache import TtlCache
+
+pytestmark = pytest.mark.asyncio
+
+# ---------------------------------------------------------------------------
+# Helpers
+# ---------------------------------------------------------------------------
+
+PROFILE_ID = "test_profile_094"
+USER_ID = 1
+
+
+def _make_api_cache() -> TtlCache:
+    """Fresh in-memory cache for each test."""
+    return TtlCache(default_ttl=1800.0)
+
+
+def _make_keywords(profile_id: str = PROFILE_ID, count: int = 6) -> list[dict]:
+    """Keywords using Amazon API camelCase format."""
+    return [
+        {
+            "keywordId": f"kw_{i:03d}",
+            "keywordText": f"keyword {i}",
+            "matchType": ["EXACT", "PHRASE", "BROAD"][i % 3],
+            "bid": round(0.50 + i * 0.10, 2),
+            "state": "ENABLED",
+            "adGroupId": f"ag_{i % 3:03d}",
+            "campaignId": f"camp_{i % 2:03d}",
+        }
+        for i in range(1, count + 1)
+    ]
+
+
+def _make_mock_client(keywords: list[dict] | None = None) -> AsyncMock:
+    """Return a mock AdsApiClient with list_sp_keywords wired up."""
+    client = AsyncMock()
+    client.list_sp_keywords = AsyncMock(return_value=keywords or _make_keywords())
+    return client
+
+
+# ---------------------------------------------------------------------------
+# TC-1: Cache hit — no API call (AC-2)
+# ---------------------------------------------------------------------------
+
+
+async def test_cache_hit_returns_cached_keywords():
+    """Pre-populated cache: list_sp_keywords must NOT call the live API."""
+    from src.tools.sp_tools import sp_list_keywords
+
+    api_cache = _make_api_cache()
+    cached_keywords = _make_keywords(count=4)
+    # Pre-populate the in-memory cache
+    await api_cache.async_set(USER_ID, PROFILE_ID, "sp_list_keywords", cached_keywords)
+
+    mock_client = _make_mock_client()
+
+    with patch("src.cache.cache_first._get_user_id_safe", return_value=USER_ID), \
+         patch("src.cache.ttl_cache.api_cache", api_cache), \
+         patch("src.cache.cache_first.db", None), \
+         patch("src.tools.sp_tools.ads_client", mock_client):
+        result = await sp_list_keywords(profile_id=PROFILE_ID)
+
+    # Must NOT hit the live API on cache hit
+    mock_client.list_sp_keywords.assert_not_called()
+    # Source must reflect cache (not live_api)
+    assert result.get("source") != "live_api", (
+        f"Expected cached source, got {result.get('source')!r}"
+    )
+    assert "cache_age_seconds" in result, "Response must include cache_age_seconds"
+    assert isinstance(result["cache_age_seconds"], (int, float))
+
+
+# ---------------------------------------------------------------------------
+# TC-2: Cache miss — live API called, result cached (AC-3)
+# ---------------------------------------------------------------------------
+
+
+async def test_cache_miss_calls_live_api_and_caches():
+    """Empty cache: live API called, result cached; second call skips the API."""
+    from src.tools.sp_tools import sp_list_keywords
+
+    api_cache = _make_api_cache()
+    keywords = _make_keywords(count=6)
+    mock_client = _make_mock_client(keywords)
+
+    with patch("src.cache.cache_first._get_user_id_safe", return_value=USER_ID), \
+         patch("src.cache.ttl_cache.api_cache", api_cache), \
+         patch("src.cache.cache_first.db", None), \
+         patch("src.tools.sp_tools.ads_client", mock_client):
+
+        # First call — cache miss → live API
+        result1 = await sp_list_keywords(profile_id=PROFILE_ID)
+        assert result1.get("source") == "live_api", (
+            f"Expected live_api on first call, got {result1.get('source')!r}"
+        )
+        mock_client.list_sp_keywords.assert_called_once()
+        # Must be called with only profile_id — no filter args (full list caching)
+        call_args = mock_client.list_sp_keywords.call_args
+        assert call_args.args == (PROFILE_ID,) or call_args == ((PROFILE_ID,), {}), (
+            f"list_sp_keywords must be called with only profile_id, got {call_args}"
+        )
+
+        # Second call — cache hit → API not called again
+        result2 = await sp_list_keywords(profile_id=PROFILE_ID)
+        assert mock_client.list_sp_keywords.call_count == 1, (
+            "Second call must use cache, not call live API again"
+        )
+        assert result2.get("source") != "live_api", (
+            f"Second call should come from cache, got source={result2.get('source')!r}"
+        )
+
+
+# ---------------------------------------------------------------------------
+# TC-3: Filter by ad_group_id — client-side from cache (AC-4)
+# ---------------------------------------------------------------------------
+
+
+async def test_filter_by_ad_group_id_uses_cache_not_api():
+    """Cached keywords: filtering by ad_group_id must NOT call the live API."""
+    from src.tools.sp_tools import sp_list_keywords
+
+    api_cache = _make_api_cache()
+    all_keywords = _make_keywords(count=6)  # ag_000, ag_001, ag_002 rotation
+    # Pre-populate cache
+    await api_cache.async_set(USER_ID, PROFILE_ID, "sp_list_keywords", all_keywords)
+
+    mock_client = _make_mock_client()
+
+    with patch("src.cache.cache_first._get_user_id_safe", return_value=USER_ID), \
+         patch("src.cache.ttl_cache.api_cache", api_cache), \
+         patch("src.cache.cache_first.db", None), \
+         patch("src.tools.sp_tools.ads_client", mock_client):
+        result = await sp_list_keywords(profile_id=PROFILE_ID, ad_group_id="ag_000")
+
+    # No API call on cache hit
+    mock_client.list_sp_keywords.assert_not_called()
+
+    # All returned keywords must belong to ag_000
+    returned_keywords = result.get("keywords", [])
+    assert len(returned_keywords) > 0, "Expected at least one keyword for ag_000"
+    for kw in returned_keywords:
+        assert kw["adGroupId"] == "ag_000", (
