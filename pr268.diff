+async def test_bypass_released_when_cron_raises_mid_run():
+    """AC-7: If cron crashes, bypass is released and read-only posture restored."""
+    from src.tools._write_guard import (
+        _active_bypass_tokens,
+        _cron_bypass_ctx,
+        acquire_cron_write_bypass,
+        get_read_only_mode,
+        release_cron_write_bypass,
+    )
+    import src.tools._write_guard as wg
+
+    orig_ro = wg._read_only_override
+    wg._read_only_override = True  # ensure server is in read-only mode
+    token = None
+    try:
+        token = acquire_cron_write_bypass("crash_profile", "crash_session")
+        assert token in _active_bypass_tokens, "Token should be active after acquire"
+        raise RuntimeError("Simulated cron crash")
+    except RuntimeError:
+        pass  # expected
+    finally:
+        if token is not None:
+            release_cron_write_bypass(
+                token, profile_id="crash_profile", session_id="crash_session"
+            )
+        # Check invariants while _read_only_override is still True (we set it above).
+        # The bypass mechanism must NOT have changed it — only _active_bypass_tokens and
+        # _cron_bypass_ctx are modified by acquire/release.
+        assert token not in _active_bypass_tokens, (
+            "Token should be removed from _active_bypass_tokens after release"
+        )
+        assert get_read_only_mode() is True, (
+            "Server read-only mode must be True after cron crash — "
+            "bypass must not permanently lower guard"
+        )
+        assert _cron_bypass_ctx.get() is None, (
+            "ContextVar should be None after release_cron_write_bypass"
+        )
+        # Restore original state for test isolation
+        wg._read_only_override = orig_ro
+
