@@ -0,0 +1,214 @@
+"""
+tests/test_sp/test_sp_keyword_cache.py — STORY-094: keyword cache-first tests (RED).
+
+Tests the cache-first behavior for sp_list_keywords:
+  AC-1: sync_cycle fetches keywords and stores in api_cache
+  AC-2: cache hit returns cached data (zero outbound API calls)
+  AC-3: cache miss fetches from live API and caches result
+  AC-4: ad_group_id/campaign_id filters are applied client-side from cache
+  AC-5: response includes source and cache_age_seconds
+  AC-6: zero outbound HTTP calls in test suite
+  AC-7: >= 6 test cases (we have 9)
+"""
+
+from __future__ import annotations
+
+import os
+import pytest
+from unittest.mock import AsyncMock, MagicMock, patch
+
+import src.tools.sp_tools as sp_tools
+from src.cache.ttl_cache import api_cache
+
+PROFILE_ID = "profile_test_094"
+
+FULL_KEYWORD_LIST = [
+    {
+        "keywordId": f"kw_ag1_{i:03d}",
+        "keywordText": f"brand keyword {i}",
+        "matchType": "EXACT",
+        "bid": 0.50 + i * 0.10,
+        "state": "ENABLED",
+        "adGroupId": "ag_001",
+        "campaignId": "camp_001",
+    }
+    for i in range(1, 6)
+] + [
+    {
+        "keywordId": f"kw_ag2_{i:03d}",
+        "keywordText": f"generic keyword {i}",
+        "matchType": "PHRASE",
+        "bid": 0.30 + i * 0.05,
+        "state": "PAUSED",
+        "adGroupId": "ag_002",
+        "campaignId": "camp_002",
+    }
+    for i in range(1, 6)
+]
+
+
+@pytest.fixture()
+def mock_ads_api_client():
+    client = AsyncMock()
+    client.list_sp_keywords = AsyncMock(return_value=FULL_KEYWORD_LIST)
+    return client
+
+
+@pytest.fixture(autouse=True)
+def inject_sp_tools_client(mock_ads_api_client):
+    """Inject mock AdsApiClient into sp_tools; restore after test."""
+    original = sp_tools.ads_client
+    sp_tools.ads_client = mock_ads_api_client
+    yield mock_ads_api_client
+    sp_tools.ads_client = original
+
+
+# TC-01: AC-2 — Cache hit returns cached data, zero API calls
+@pytest.mark.asyncio
+async def test_cache_hit_returns_data_no_api_call(inject_sp_tools_client):
+    """Pre-populate cache -> call sp_list_keywords -> API must NOT be called."""
+    api_cache.set(None, PROFILE_ID, "sp_list_keywords", FULL_KEYWORD_LIST)
+    result = await sp_tools.sp_list_keywords(profile_id=PROFILE_ID)
+    inject_sp_tools_client.list_sp_keywords.assert_not_called()
+    assert "keywords" in result
+    assert result["total_count"] == len(FULL_KEYWORD_LIST)
+
+
+# TC-02: AC-3 — Cache miss calls API and caches result
+@pytest.mark.asyncio
+async def test_cache_miss_calls_api_and_caches_result(inject_sp_tools_client):
+    """Empty cache -> call sp_list_keywords -> API called once -> next call uses cache."""
+    result = await sp_tools.sp_list_keywords(profile_id=PROFILE_ID)
+    inject_sp_tools_client.list_sp_keywords.assert_called_once()
+    assert result.get("source") == "live_api"
+
+    inject_sp_tools_client.list_sp_keywords.reset_mock()
+    result2 = await sp_tools.sp_list_keywords(profile_id=PROFILE_ID)
+    inject_sp_tools_client.list_sp_keywords.assert_not_called()
+    assert result2["total_count"] == len(FULL_KEYWORD_LIST)
+
+
+# TC-03: AC-4 — Client-side filter by ad_group_id from cache
+@pytest.mark.asyncio
+async def test_ad_group_filter_client_side_from_cache(inject_sp_tools_client):
+    """Cache hit with ad_group_id filter -> only matching keywords returned, API not called."""
+    api_cache.set(None, PROFILE_ID, "sp_list_keywords", FULL_KEYWORD_LIST)
+    result = await sp_tools.sp_list_keywords(profile_id=PROFILE_ID, ad_group_id="ag_001")
+    inject_sp_tools_client.list_sp_keywords.assert_not_called()
+    assert all(kw["adGroupId"] == "ag_001" for kw in result["keywords"])
+    expected_count = sum(1 for kw in FULL_KEYWORD_LIST if kw["adGroupId"] == "ag_001")
+    assert result["total_count"] == expected_count
+
+
+# TC-04: AC-4 — Client-side filter by campaign_id from cache
+@pytest.mark.asyncio
+async def test_campaign_filter_client_side_from_cache(inject_sp_tools_client):
+    """Cache hit with campaign_id filter -> only matching keywords returned, API not called."""
+    api_cache.set(None, PROFILE_ID, "sp_list_keywords", FULL_KEYWORD_LIST)
+    result = await sp_tools.sp_list_keywords(profile_id=PROFILE_ID, campaign_id="camp_001")
+    inject_sp_tools_client.list_sp_keywords.assert_not_called()
+    assert all(kw["campaignId"] == "camp_001" for kw in result["keywords"])
+    expected_count = sum(1 for kw in FULL_KEYWORD_LIST if kw["campaignId"] == "camp_001")
+    assert result["total_count"] == expected_count
+
+
+# TC-05: AC-5 — Response includes source and cache_age_seconds
+@pytest.mark.asyncio
+async def test_response_includes_source_and_cache_age_seconds():
+    """Both cache-hit and cache-miss responses must include source and cache_age_seconds."""
+    # cache miss path
+    result = await sp_tools.sp_list_keywords(profile_id=PROFILE_ID)
+    assert "source" in result, "source field missing from live_api response"
+    assert "cache_age_seconds" in result, "cache_age_seconds field missing"
+
+
+# TC-06: AC-1 — Cache key correctness (operation="sp_list_keywords")
+@pytest.mark.asyncio
+async def test_cache_key_operation_is_sp_list_keywords(inject_sp_tools_client):
+    """After a live fetch, api_cache must store data under operation 'sp_list_keywords'."""
+    await sp_tools.sp_list_keywords(profile_id=PROFILE_ID)
+    hit, data = api_cache.get(None, PROFILE_ID, "sp_list_keywords")
+    assert hit, "Expected a cache entry under operation 'sp_list_keywords'"
+    assert isinstance(data, list)
+    assert len(data) == len(FULL_KEYWORD_LIST)
+
+
+# TC-07: AC-1 — sync_cycle fetches keywords and stores in api_cache
+@pytest.mark.asyncio
+async def test_sync_cycle_fetches_keywords_and_stores_in_cache():
+    """sync_cycle must call sp_list_keywords and store result with operation='sp_list_keywords'."""
+    from src.ingestion import ads_data_sync
+
+    mock_api_cache = AsyncMock()
+    mock_api_cache.async_set = AsyncMock()
+
+    patches = {
+        "_fetch_portfolios": AsyncMock(return_value=[]),
+        "_fetch_campaigns": AsyncMock(return_value=[]),
+        "_fetch_sp_ad_groups": AsyncMock(return_value=[]),
+        "_fetch_sb_campaigns": AsyncMock(return_value=[]),
+        "_fetch_sd_campaigns": AsyncMock(return_value=[]),
+        "_fetch_sp_keywords": AsyncMock(return_value=FULL_KEYWORD_LIST),
+    }
+
+    ctx_managers = [
+        patch.object(ads_data_sync, name, mock, create=(name == "_fetch_sp_keywords"))
+        for name, mock in patches.items()
+    ]
+    ctx_managers.append(
+        patch.object(ads_data_sync, "_get_access_token", AsyncMock(return_value="test_token"))
+    )
+
+    with patch.dict(os.environ, {"LWA_CLIENT_ID": "test_client_id"}):
+        for cm in ctx_managers:
+            cm.__enter__()
+        try:
+            result = await ads_data_sync.sync_cycle(
+                db_factory=AsyncMock(),
+                api_cache=mock_api_cache,
+                profiles=[{"profile_id": PROFILE_ID, "user_id": 1}],
+            )
+        finally:
+            for cm in reversed(ctx_managers):
+                cm.__exit__(None, None, None)
+
+    set_operations = [
+        c.kwargs.get("operation")
+        for c in mock_api_cache.async_set.call_args_list
+    ]
+    assert "sp_list_keywords" in set_operations, (
+        f"Expected async_set with operation='sp_list_keywords'. Got: {set_operations}"
+    )
+
+
+# TC-08: AC-6 — Zero outbound HTTP calls
+@pytest.mark.asyncio
+async def test_no_outbound_http_calls(inject_sp_tools_client):
+    """With cache populated, no real HTTP calls should occur."""
+    import httpx
+
+    def _block_http(*args, **kwargs):
+        raise RuntimeError("BLOCKED: outbound HTTP is forbidden in tests")
+
+    api_cache.set(None, PROFILE_ID, "sp_list_keywords", FULL_KEYWORD_LIST)
+
+    with patch.object(httpx.AsyncClient, "request", side_effect=_block_http):
+        result = await sp_tools.sp_list_keywords(profile_id=PROFILE_ID)
+        assert "keywords" in result
+
+
+# TC-09: @cache_first decorator applied to sp_list_keywords
+def test_sp_list_keywords_has_cache_first_decorator():
+    """sp_list_keywords must have _is_cache_first=True (from @cache_first)."""
+    from src.tools.sp_tools import sp_list_keywords
+    from src.cache.cache_first import _cache_first_registry
+
+    assert hasattr(sp_list_keywords, "_is_cache_first"), (
+        "sp_list_keywords missing _is_cache_first — @cache_first not applied"
+    )
+    assert sp_list_keywords._is_cache_first is True
+
+    fn_path = "src.tools.sp_tools.sp_list_keywords"
+    assert fn_path in _cache_first_registry, (
+        f"{fn_path} not in _cache_first_registry"
+    )
