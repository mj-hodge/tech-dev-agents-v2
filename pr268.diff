+async def test_no_outbound_http_to_amazon():
+    """MANDATORY: No test in this suite may reach advertising-api.amazon.com.
+
+    Verifies that acquire/release bypass functions are purely in-process
+    (ContextVar + set) and make zero outbound HTTP calls.
+    """
+    import httpx
+
+    from src.tools._write_guard import acquire_cron_write_bypass, release_cron_write_bypass
+    import src.tools._write_guard as wg
+
+    orig_ro = wg._read_only_override
+    wg._read_only_override = True
+
+    call_log: list[str] = []
+
+    async def mock_send(self, request, *args, **kwargs):  # type: ignore[override]
+        url = str(request.url)
+        call_log.append(url)
+        assert "advertising-api.amazon.com" not in url, (
+            f"SAFETY VIOLATION: outbound HTTP call to Amazon: {url}"
+        )
+        raise httpx.ConnectError(f"Test blocked outbound call to {url}")
+
+    try:
+        with patch.object(httpx.AsyncClient, "send", mock_send):
+            token = acquire_cron_write_bypass("test_profile", "test_session")
+            release_cron_write_bypass(
+                token, profile_id="test_profile", session_id="test_session"
+            )
+    finally:
+        wg._read_only_override = orig_ro
+
+    # acquire_cron_write_bypass must be a plain (sync) function — no HTTP in bypass path
+    assert not asyncio.iscoroutinefunction(acquire_cron_write_bypass), (
+        "acquire_cron_write_bypass should be a plain function, not async "
+        "(no HTTP calls allowed in the bypass path)"
+    )
