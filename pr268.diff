+    """Release a scoped bypass token. Must be called in a finally block."""
+    _active_bypass_tokens.discard(token)
+    _cron_bypass_ctx.set(None)
+    _bypass_logger.info(
+        "cron_write_bypass_released profile_id=%s session_id=%s", profile_id, session_id
+    )
