+def render_fallback(skill_name: str, **params: str) -> dict | None:
+    """Produce an operator-facing block with rendered SQL.
+
+    Returns a dict with keys: skill_name, sql, runbook_url, description,
+    params_used.  SQL template placeholders ($1, $2, …) are replaced with
+    the corresponding positional param value based on ``required_params``
+    ordering.  Missing params leave the placeholder intact.
+
+    Returns ``None`` if the skill is not registered.
+    """
+    fb = get_fallback(skill_name)
