+    # Runbook URL must be present (guides operator to full procedure)
+    assert result.get("runbook_url"), "Missing runbook_url — operator has no escalation path"
+
+    # Description must be present (operator must understand what this does)
+    assert result.get("description"), "Missing description — operator cannot verify action"
+
