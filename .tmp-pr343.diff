+"""Canon-backport helpers: draft PR content and detect existing PRs.
+
+Used by the Morris-side ``canon-backport`` skill to open (or update)
+a PR against ``gc-data-v2`` or ``tech-gc-knowledgebase`` when a
+completed story flags a canon gap.
+"""
+
+from __future__ import annotations
+
+import json
+import subprocess
+from dataclasses import dataclass
+
+# ── Target classification ───────────────────────────────────────────
+
+TARGET_PLATFORM = "gc-data-v2/platform"
+TARGET_RUNBOOKS = "gc-data-v2/platform/runbooks"  # post-STORY-1015
+TARGET_KNOWLEDGEBASE = "tech-gc-knowledgebase/wiki"
+
+# Keywords that indicate business-context gaps (route to knowledgebase).
+_BUSINESS_KEYWORDS: frozenset[str] = frozenset(
+    "business context customer pricing schedule policy recipient "
+    "stakeholder sla agreement contract vendor".split()
+)
+
+# Keywords that indicate operational runbook gaps.
+_RUNBOOK_KEYWORDS: frozenset[str] = frozenset(
+    "runbook playbook incident alert escalation on-call pager "
+    "recovery restart rollback failover".split()
+)
+
+
+@dataclass(frozen=True)
+class BackportDraft:
+    """A drafted canon-backport PR."""
+
+    target_repo: str          # e.g. "hpi-gorillacommerce/gc-data-v2"
+    target_path: str          # e.g. "platform/pipeline-standard.md"
+    branch_name: str          # e.g. "morris/canon-backport-STORY-871"
+    title: str
+    body: str
+    source_story_id: str
+
+
+def classify_target(gap_text: str) -> str:
+    """Classify which target directory a canon gap belongs to.
+
+    Returns one of TARGET_PLATFORM, TARGET_RUNBOOKS, or
+    TARGET_KNOWLEDGEBASE.
+    """
+    gap_lower = gap_text.lower()
+    gap_words = set(gap_lower.split())
+
+    if gap_words & _BUSINESS_KEYWORDS:
+        return TARGET_KNOWLEDGEBASE
+    if gap_words & _RUNBOOK_KEYWORDS:
+        return TARGET_RUNBOOKS
+    return TARGET_PLATFORM
+
+
+def _branch_name_for_story(source_story_id: str) -> str:
+    """Canonical branch name for a canon-backport PR."""
+    return f"morris/canon-backport-{source_story_id}"
+
+
+def find_existing_backport_pr(
+    source_story_id: str,
+    target_repo: str = "hpi-gorillacommerce/gc-data-v2",
+) -> str | None:
+    """Check if a canon-backport PR already exists for *source_story_id*.
+
+    Returns the PR URL if found, else None.
+    Uses ``gh pr list`` to search by branch name.
+    """
+    branch = _branch_name_for_story(source_story_id)
+    try:
+        result = subprocess.run(
+            [
+                "gh", "pr", "list",
+                "--repo", target_repo,
+                "--head", branch,
+                "--state", "open",
+                "--json", "url",
+            ],
+            capture_output=True,
+            text=True,
+            timeout=30,
+        )
+        if result.returncode != 0:
+            return None
+        prs = json.loads(result.stdout)
+        if prs:
+            return prs[0]["url"]
+        return None
+    except (subprocess.TimeoutExpired, json.JSONDecodeError, OSError):
+        return None
+
+
+def draft_backport_pr(
+    gap_text: str,
+    target_repo: str,
+    source_story_id: str,
+) -> BackportDraft:
+    """Draft a canon-backport PR for a canon gap.
+
+    Parameters
+    ----------
+    gap_text:
+        Free-text description of the canon gap from refinement-report or
+        PR description.
+    target_repo:
+        Full repo path, e.g. ``"hpi-gorillacommerce/gc-data-v2"``.
+    source_story_id:
+        The story that surfaced the gap, e.g. ``"STORY-871"``.
+
+    Returns
+    -------
+    BackportDraft with PR metadata ready for ``gh pr create``.
+    """
+    target = classify_target(gap_text)
+    branch = _branch_name_for_story(source_story_id)
+
+    # Determine the target file path within the repo.
+    # Default to the general platform doc; specific routing can be refined.
+    if target == TARGET_KNOWLEDGEBASE:
+        target_path = "wiki/systems/data-platform-specs.md"
+    elif target == TARGET_RUNBOOKS:
+        target_path = "platform/runbooks/new-runbook-entry.md"
+    else:
+        target_path = "platform/pipeline-standard.md"
+
+    title = f"Canon-backport for {source_story_id}: {_summarize(gap_text)}"
+    body = (
+        f"## Canon Gap\n\n"
+        f"Identified during completion of {source_story_id}.\n\n"
+        f"### Gap Description\n\n"
+        f"{gap_text}\n\n"
+        f"### Proposed Addition\n\n"
+        f"<!-- Review and refine the section below before merging -->\n\n"
+        f"> {gap_text}\n\n"
+        f"---\n"
+        f"*Auto-drafted by Morris canon-backport skill. "
+        f"Source: {source_story_id}.*\n"
+    )
+
+    return BackportDraft(
+        target_repo=target_repo,
+        target_path=target_path,
+        branch_name=branch,
+        title=title[:70],  # keep under 70 chars
+        body=body,
+        source_story_id=source_story_id,
+    )
+
+
+def _summarize(text: str, max_len: int = 40) -> str:
+    """Truncate gap text to a short summary for the PR title."""
+    text = text.strip().replace("\n", " ")
+    if len(text) <= max_len:
+        return text
+    return text[: max_len - 3] + "..."
