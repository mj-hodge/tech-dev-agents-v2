+"""STORY-1000 Epic — Incident replay tests.
+
+Verifies that the gates introduced in STORY-1010 would have caught or resolved
+the incidents that occurred in the 2026-05-04..05-18 audit window.
+
+REPLAY-3 (2026-05-14 stall):
+  Simulate /requeue-failed skill being unavailable → ops-skill fallback registry
+  produces a documented SQL-direct path within 60 seconds.
+
+STORY-919 class replay:
+  A new dispatch attempting transition to in_review without pr_number is
+  rejected with 422 (when gate is active for new dispatches).
+"""
+
+from __future__ import annotations
+
+import time
+import uuid
+from datetime import datetime, timezone
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+
+from tech_dev_agents.ops_console.ops_skill_fallback_registry import (
+    REGISTRY,
+    render_fallback,
+)
+from tech_dev_agents.ops_console.services.dispatch_v2_service import (
+    DispatchV2Service,
+    InvalidEventDataError,
+)
+
+
+# ---------------------------------------------------------------------------
+# Helpers shared across replays
+# ---------------------------------------------------------------------------
+
+_ROLLOUT_TS = "2026-05-18T00:00:00Z"
+_NEW_CREATED_AT = datetime(2026, 5, 19, 0, 0, 0, tzinfo=timezone.utc)
+
+
+def _make_lease_row(token: str = "tok") -> MagicMock:
+    data = {"lease_token": token}
+    r = MagicMock()
+    r.__getitem__ = lambda self, k: data[k]
+    r.get = lambda k, d=None: data.get(k, d)
+    return r
+
+
+def _make_state_row(state: str = "leased") -> MagicMock:
+    data = {"state": state}
+    r = MagicMock()
+    r.__getitem__ = lambda self, k: data[k]
+    r.get = lambda k, d=None: data.get(k, d)
+    return r
+
+
+def _make_job_row(pr_number=None, repo="tech-dev-agents", created_at=None) -> MagicMock:
+    data = {"repo": repo, "pr_number": pr_number, "created_at": created_at or _NEW_CREATED_AT}
+    r = MagicMock()
+    r.__getitem__ = lambda self, k: data[k]
+    r.get = lambda k, d=None: data.get(k, d)
+    return r
+
+
+class _FakeTransaction:
