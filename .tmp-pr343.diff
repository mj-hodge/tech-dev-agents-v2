+name: SDLC Framework Drift Check
+
+# STORY-1011: Detect when the local .sdlc/ submodule content drifts from the
+# pinned sdlc-framework version. Fails CI if any tracked file differs from the
+# tagged baseline. This prevents silent framework drift — the root cause of the
+# 2026-04-20 and 2026-05-03 phase-runner breakages.
+#
+# How it works:
+#   1. Read .sdlc-pinned-version → extract tag (e.g., v1.0.0)
+#   2. Clone sdlc-framework at that tag into a temp directory
+#   3. Byte-diff .sdlc/ (excluding .git/, PINNED_VERSION, CLAUDE.md.local)
+#      against the pinned checkout
+#   4. Fail if any diff is non-empty; print drifted file list
+
+on:
+  pull_request:
+    branches: [main]
+    paths:
+      - '.sdlc/**'
+      - '.sdlc-pinned-version'
+      - '.github/workflows/sdlc-drift-check.yml'
+      - 'tools/sdlc_drift_check.py'
+  push:
+    branches: [main]
+    paths:
+      - '.sdlc/**'
+      - '.sdlc-pinned-version'
+      - '.github/workflows/sdlc-drift-check.yml'
+      - 'tools/sdlc_drift_check.py'
+  workflow_dispatch:
+
+concurrency:
+  group: sdlc-drift-${{ github.ref }}
+  cancel-in-progress: true
+
+permissions:
+  contents: read
+
+jobs:
+  sdlc-drift-check:
+    name: SDLC framework drift check
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    steps:
+      - name: Checkout repo with submodule
+        uses: actions/checkout@v4
+        with:
+          submodules: true
+          # Need the submodule content to diff against pinned version
+          token: ${{ secrets.SDLC_FRAMEWORK_PAT || secrets.GITHUB_TOKEN }}
+
+      - name: Read pinned version
+        id: pin
+        run: |
+          if [ ! -f .sdlc-pinned-version ]; then
+            echo "::error::.sdlc-pinned-version file not found at repo root"
+            exit 1
+          fi
+          PINNED_VERSION=$(cat .sdlc-pinned-version | tr -d '[:space:]')
+          echo "version=${PINNED_VERSION}" >> "$GITHUB_OUTPUT"
+          echo "Pinned version: ${PINNED_VERSION}"
+
+      - name: Read actual .sdlc/VERSION
+        id: actual
+        run: |
+          if [ ! -f .sdlc/VERSION ]; then
+            echo "::error::.sdlc/VERSION not found — submodule may not be checked out"
+            exit 1
+          fi
+          ACTUAL_VERSION=$(cat .sdlc/VERSION | tr -d '[:space:]')
+          echo "version=${ACTUAL_VERSION}" >> "$GITHUB_OUTPUT"
+          echo "Actual .sdlc/VERSION: ${ACTUAL_VERSION}"
+
+      - name: Compare versions
+        run: |
+          PINNED="${{ steps.pin.outputs.version }}"
+          ACTUAL="${{ steps.actual.outputs.version }}"
+
+          # Strip 'v' prefix from pinned for comparison
+          PINNED_BARE="${PINNED#v}"
+
+          if [ "${PINNED_BARE}" != "${ACTUAL}" ]; then
+            echo "::error::Version mismatch: .sdlc-pinned-version=${PINNED} but .sdlc/VERSION=${ACTUAL}"
+            echo ""
+            echo "ERROR: .sdlc submodule version does not match pinned version"
+            echo "  pinned:  ${PINNED} (from .sdlc-pinned-version)"
+            echo "  actual:  ${ACTUAL} (from .sdlc/VERSION)"
+            echo ""
+            echo "hint: update the submodule pointer to match the pinned tag,"
+            echo "      or bump .sdlc-pinned-version to match the current submodule"
+            exit 1
+          fi
+
+          echo "Version check passed: ${PINNED} matches .sdlc/VERSION=${ACTUAL}"
+
+      - name: Clone pinned framework for byte-diff
+        run: |
+          PINNED="${{ steps.pin.outputs.version }}"
+
+          git clone --depth 1 --branch "${PINNED}" \
+            https://github.com/hpi-gorillacommerce/sdlc-framework.git \
+            /tmp/sdlc-framework-pinned 2>&1 || {
+            echo "::error::Failed to clone sdlc-framework at tag ${PINNED} — check tag exists upstream"
+            echo "error: pinned version ${PINNED} not found in sdlc-framework — check tag exists upstream"
+            exit 1
+          }
+          echo "Cloned sdlc-framework@${PINNED} to /tmp/sdlc-framework-pinned"
+
+      - name: Set up Python
+        uses: actions/setup-python@v5
+        with:
+          python-version: '3.12'
+
+      - name: Run drift check
+        env:
+          PYTHONPATH: ${{ github.workspace }}
+        run: |
+          python3 -m tools.sdlc_drift_check \
+            .sdlc \
+            /tmp/sdlc-framework-pinned
