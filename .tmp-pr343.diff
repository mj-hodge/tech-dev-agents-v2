+    # STORY-1010: set_pr_number — atomic idempotent PR number stamp
+    # -------------------------------------------------------------------------
+
+    async def set_pr_number(
+        self,
+        *,
+        job_id: str,
+        pr_number: int,
+    ) -> dict[str, Any]:
+        """Atomically stamp pr_number on a dispatch_jobs row before transition.
+
+        Allows agents to set pr_number in a separate call before calling
+        ``transition(event_type='submitted', ...)``, avoiding the inline
+        event_data path.
+
+        Contract:
+        - pr_number IS NULL on row → stamp it; also set correlation_key if unset.
+          Returns {"job_id": ..., "pr_number": ..., "updated": True}.
+        - pr_number already == supplied value → idempotent, no-op.
+          Returns {"job_id": ..., "pr_number": ..., "updated": False}.
+        - pr_number already != supplied value → raises PrNumberConflictError (→ 409).
+        - pr_number < 1 → raises ValueError (→ 422).
+        - job not found → raises JobNotFoundError (→ 404).
+
+        Raises:
+            ValueError            — pr_number < 1
+            JobNotFoundError      — job_id not found
+            PrNumberConflictError — conflicting pr_number already set
+        """
+        if pr_number < 1:
+            raise ValueError(f"pr_number must be >= 1, got {pr_number}")
+
+        async with self._acquire() as conn:
+            async with conn.transaction():
+                row = await conn.fetchrow(
+                    "SELECT pr_number, repo FROM dispatch_jobs WHERE job_id = $1::uuid",
+                    job_id,
+                )
+                if row is None:
+                    raise JobNotFoundError(f"job_id={job_id} not found in dispatch_jobs")
+
+                existing_pr = row["pr_number"]
+                repo = row["repo"] or ""
+
+                if existing_pr is not None:
+                    if existing_pr == pr_number:
+                        # Idempotent: already set to the same value
+                        logger.debug(
+                            "set_pr_number: idempotent job_id=%s pr_number=%s",
+                            job_id, pr_number,
+                        )
+                        return {"job_id": job_id, "pr_number": pr_number, "updated": False}
+                    else:
+                        raise PrNumberConflictError(
+                            f"pr_number conflict: job {job_id} already has "
+                            f"pr_number={existing_pr}, refusing to overwrite with {pr_number}",
+                            existing_pr_number=existing_pr,
+                        )
+
+                # Stamp the pr_number (and correlation_key if not already set)
+                correlation_key = f"repo:{repo}|pr:{pr_number}"
+                try:
+                    await conn.execute(
+                        """UPDATE dispatch_jobs
+                           SET pr_number = $2,
+                               correlation_key = COALESCE(correlation_key, $3)
+                           WHERE job_id = $1::uuid""",
+                        job_id,
+                        pr_number,
+                        correlation_key,
