+"""
+
+from __future__ import annotations
+
+import time
+from unittest.mock import MagicMock
+
+import pytest
+
+from tech_dev_agents.ops_console.ops_skill_fallback_registry import (
+    REGISTRY,
+    Fallback,
+    get_fallback,
+    render_fallback,
+)
+
+
+# ---------------------------------------------------------------------------
+# Unit tests — registry module
+# ---------------------------------------------------------------------------
+
+
+class TestFallbackRegistry:
+    """Unit tests for the fallback registry data model and lookup."""
+
+    def test_requeue_failed_fallback_renders(self):
+        """SC-1: render_fallback('requeue-failed') returns runnable SQL within 60s."""
+        start = time.monotonic()
+        result = render_fallback("requeue-failed", repo="tech-dev-agents", hours="24")
+        elapsed = time.monotonic() - start
+
+        assert result is not None
+        assert elapsed < 60.0, f"Render took {elapsed:.2f}s, exceeds 60s SLA"
+        assert "UPDATE dispatch_state_current" in result["sql"]
+        assert "state = 'enqueued'" in result["sql"]
+        assert "tech-dev-agents" in result["sql"]
+        assert "24 hours" in result["sql"]
+        assert result["runbook_url"].startswith("https://")
+        assert result["description"]
+        assert result["params_used"] == {"repo": "tech-dev-agents", "hours": "24"}
+
+    def test_all_five_skills_registered(self):
+        """SC-2: All 5 highest-leverage operator skills are in the registry."""
+        expected = sorted([
+            "dead-letter-purge",
+            "dispatch-recovery",
+            "force-claim",
+            "release-stale-claim",
+            "requeue-failed",
+        ])
+        assert sorted(REGISTRY.keys()) == expected
+
+    def test_render_fallback_unknown_skill_returns_none(self):
+        """Unknown skill → render_fallback returns None."""
+        assert render_fallback("nonexistent-skill") is None
+
+    def test_render_with_params_substitutes_placeholders(self):
+        """When all required params are provided, placeholders are substituted."""
+        result = render_fallback(
+            "dispatch-recovery",
+            repo="gc-data-v2",
+            story_id="STORY-999",
+        )
+        assert result is not None
+        assert "gc-data-v2" in result["sql"]
+        assert "STORY-999" in result["sql"]
+        assert "$1" not in result["sql"]
+        assert "$2" not in result["sql"]
+
+    def test_render_without_params_leaves_placeholders(self):
+        """When no params provided, SQL still has $N placeholders."""
+        result = render_fallback("requeue-failed")
+        assert result is not None
+        assert "$1" in result["sql"]
+        assert "$2" in result["sql"]
+        assert result["params_used"] == {}
+
+    def test_get_fallback_returns_none_for_unknown(self):
+        """get_fallback() returns None for unregistered skill."""
+        assert get_fallback("no-such-skill") is None
+
+    def test_get_fallback_returns_dataclass(self):
+        """get_fallback() returns a Fallback dataclass for registered skill."""
+        fb = get_fallback("requeue-failed")
+        assert fb is not None
+        assert isinstance(fb, Fallback)
+        assert fb.skill_name == "requeue-failed"
+        assert len(fb.required_params) == 2
+
+    def test_each_fallback_has_required_fields(self):
+        """Every registered fallback has non-empty sql_template, runbook_url, description."""
+        for name, fb in REGISTRY.items():
+            assert fb.sql_template, f"{name}: empty sql_template"
+            assert fb.runbook_url, f"{name}: empty runbook_url"
+            assert fb.description, f"{name}: empty description"
+            assert fb.skill_name == name, f"{name}: skill_name mismatch"
+
