+"""Tests for keyword_matcher.py — SC-5, SC-6."""
+
+from __future__ import annotations
+
+from pathlib import Path
+from textwrap import dedent
+
+import pytest
+
+from tech_dev_agents.morris.canon_loader.keyword_matcher import (
+    CanonMatch,
+    _extract_sections,
+    _tokenize,
+    find_canon_answer,
+)
+
+# ── Fixtures ────────────────────────────────────────────────────────
+
+CANON_PIPELINE_STANDARD = dedent("""\
+    # Pipeline Standard
+
+    ## Retry Policy
+
+    Upstream timeouts MUST be retried with exponential backoff capped at 5 attempts.
+    The base delay is 2 seconds. Jitter should be applied to avoid thundering herd.
+
+    ## Naming Conventions
+
+    All pipeline modules must use snake_case for file and function names.
+    Class names use PascalCase.
+
+    ## Failure-Recovery Invariants
+
+    When a pipeline stage fails, the recovery process must:
+    1. Log the failure with structured metadata.
+    2. Notify the alert channel within 30 seconds.
+    3. Attempt automatic retry before escalating to manual intervention.
+""")
+
+CANON_FAILURE_MODES = dedent("""\
+    # Failure Modes
+
+    ## Upstream Timeout
+
+    When an upstream API returns 504, the pipeline should retry with backoff.
+    Maximum retry count is 5. After exhaustion, raise a PipelineStageError.
+
+    ## Data Validation Failure
+
+    If incoming data fails schema validation, quarantine the batch and notify.
+    Do not proceed with partial data — the entire batch must be valid.
+""")
+
+
+@pytest.fixture()
+def canon_dir(tmp_path: Path) -> list[Path]:
+    """Write sample canon files and return paths."""
+    p1 = tmp_path / "platform" / "pipeline-standard.md"
+    p1.parent.mkdir(parents=True)
+    p1.write_text(CANON_PIPELINE_STANDARD)
+
+    p2 = tmp_path / "platform" / "failure-modes.md"
+    p2.write_text(CANON_FAILURE_MODES)
+
+    return [p1, p2]
+
+
+# ── Tests ───────────────────────────────────────────────────────────
+
+
+class TestTokenize:
+    def test_basic(self) -> None:
+        tokens = _tokenize("What is the retry policy for upstream timeouts?")
+        assert "retry" in tokens
+        assert "policy" in tokens
+        assert "upstream" in tokens
+        assert "timeouts" in tokens
+        # Stopwords removed
+        assert "is" not in tokens
+        assert "the" not in tokens
+        assert "for" not in tokens
+
+    def test_empty(self) -> None:
+        assert _tokenize("") == []
+
+    def test_hyphenated(self) -> None:
+        tokens = _tokenize("snake_case and exponential-backoff")
+        assert "snake_case" in tokens
+        assert "exponential-backoff" in tokens
+
+
+class TestExtractSections:
+    def test_extracts_headings(self) -> None:
+        sections = _extract_sections(CANON_PIPELINE_STANDARD)
+        headings = [h for h, _ in sections]
+        assert "Pipeline Standard" in headings
+        assert "Retry Policy" in headings
+        assert "Naming Conventions" in headings
+
+    def test_section_bodies(self) -> None:
+        sections = _extract_sections(CANON_PIPELINE_STANDARD)
+        for heading, body in sections:
+            if heading == "Retry Policy":
+                assert "exponential backoff" in body
+                assert "5 attempts" in body
+                break
+        else:
+            pytest.fail("Retry Policy section not found")
+
+
+class TestFindCanonAnswer:
+    def test_verbatim_question_matches(self, canon_dir: list[Path]) -> None:
+        """SC-5: question whose answer is verbatim in canon doc matches."""
+        question = "What is the retry policy for upstream timeouts?"
+        match = find_canon_answer(question, canon_dir)
+        assert match is not None
+        assert isinstance(match, CanonMatch)
+        assert match.overlap_ratio >= 0.35
+        assert "retry" in match.matched_text.lower() or "backoff" in match.matched_text.lower()
+
+    def test_paraphrased_question_matches(self, canon_dir: list[Path]) -> None:
+        """A paraphrased question about retry/backoff still matches."""
+        question = "How should we handle exponential backoff retry attempts for pipeline timeouts?"
+        match = find_canon_answer(question, canon_dir)
+        assert match is not None
+        assert match.overlap_ratio >= 0.35
+
+    def test_unrelated_question_no_match(self, canon_dir: list[Path]) -> None:
+        """SC-6: unrelated question returns None (precision > recall)."""
+        question = "What color should the dashboard button be?"
+        match = find_canon_answer(question, canon_dir)
+        assert match is None
+
+    def test_data_validation_question_matches(self, canon_dir: list[Path]) -> None:
+        """Question about data validation finds the right section."""
+        question = "What happens when incoming data fails schema validation in the pipeline?"
+        match = find_canon_answer(question, canon_dir)
+        assert match is not None
+        assert "validation" in match.matched_text.lower()
+
+    def test_very_short_question_no_match(self, canon_dir: list[Path]) -> None:
+        """Single-word question should not match (too ambiguous)."""
+        match = find_canon_answer("retry", canon_dir)
+        assert match is None  # < 2 tokens after stopword removal... actually "retry" is 1 token
+
+    def test_empty_canon_files(self, tmp_path: Path) -> None:
+        """No canon files -> None."""
+        match = find_canon_answer("some question about pipelines", [])
+        assert match is None
+
+    def test_nonexistent_file_skipped(self, tmp_path: Path) -> None:
+        """Missing file doesn't crash, just gets skipped."""
+        fake = tmp_path / "nonexistent.md"
+        match = find_canon_answer("retry policy upstream timeouts backoff", [fake])
+        assert match is None
