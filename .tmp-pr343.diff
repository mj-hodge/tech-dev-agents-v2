+"""Tests for loader.py — SC-2.
+
+All HTTP calls are mocked; no real network access.
+"""
+
+from __future__ import annotations
+
+import urllib.error
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+from tech_dev_agents.morris.canon_loader.loader import (
+    CanonBundle,
+    CanonFile,
+    _extract_platform_refs,
+    load_canon_for_source,
+)
+
+# ── Fixtures ────────────────────────────────────────────────────────
+
+SAMPLE_SOURCE_README = """\
+# spapi-reports
+
+Source documentation for the SP-API Reports pipeline.
+
+## References
+
+This pipeline follows the conventions in platform/pipeline-standard.md
+and uses the failure handling from platform/failure-modes.md.
+
+## Schema
+
+Fields are defined per the schema spec.
+"""
+
+SAMPLE_PLATFORM_STANDARD = """\
+# Pipeline Standard
+
+## Retry Policy
+
+Upstream timeouts MUST be retried with exponential backoff capped at 5 attempts.
+
+## Naming Conventions
+
+All pipeline modules must use snake_case.
+"""
+
+SAMPLE_PLATFORM_FAILURE = """\
+# Failure Modes
+
+## Upstream Timeout
+
+When an upstream API returns 504, the pipeline should retry.
+"""
+
+
+def _mock_urlopen(url_map: dict[str, str]):
+    """Create a mock for urllib.request.urlopen that returns content by URL."""
+
+    def _urlopen(req, timeout=None):
+        url = req.full_url if hasattr(req, "full_url") else str(req)
+        if url in url_map:
+            resp = MagicMock()
+            resp.read.return_value = url_map[url].encode("utf-8")
+            resp.__enter__ = lambda s: s
+            resp.__exit__ = MagicMock(return_value=False)
+            return resp
+        raise urllib.error.HTTPError(url, 404, "Not Found", {}, None)
+
+    return _urlopen
+
+
+# ── Tests ───────────────────────────────────────────────────────────
+
+
+class TestExtractPlatformRefs:
+    def test_finds_platform_refs(self) -> None:
+        refs = _extract_platform_refs(SAMPLE_SOURCE_README)
+        assert "platform/pipeline-standard.md" in refs
+        assert "platform/failure-modes.md" in refs
+
+    def test_deduplicates(self) -> None:
+        text = "See platform/foo.md and also platform/foo.md again."
+        refs = _extract_platform_refs(text)
+        assert refs == ["platform/foo.md"]
+
+    def test_no_refs(self) -> None:
+        assert _extract_platform_refs("No references here.") == []
+
+
+class TestLoadCanonForSource:
+    def test_load_spapi(self) -> None:
+        """SC-2: load_canon_for_source returns bundle with source + platform files."""
+        url_map = {
+            "https://raw.githubusercontent.com/hpi-gorillacommerce/gc-data-v2/main/sources/spapi-reports/README.md": SAMPLE_SOURCE_README,
+            "https://raw.githubusercontent.com/hpi-gorillacommerce/gc-data-v2/main/platform/pipeline-standard.md": SAMPLE_PLATFORM_STANDARD,
+            "https://raw.githubusercontent.com/hpi-gorillacommerce/gc-data-v2/main/platform/failure-modes.md": SAMPLE_PLATFORM_FAILURE,
+        }
+
+        with patch(
+            "tech_dev_agents.morris.canon_loader.loader.urllib.request.urlopen",
+            side_effect=_mock_urlopen(url_map),
+        ):
+            bundle = load_canon_for_source("spapi-reports", "main")
+
+        assert isinstance(bundle, CanonBundle)
+        assert bundle.source == "spapi-reports"
+        assert bundle.pin_sha == "main"
+        assert len(bundle.source_files) >= 1
+        assert len(bundle.platform_files) >= 1
+
+        source_paths = [f.relative_path for f in bundle.source_files]
+        assert "sources/spapi-reports/README.md" in source_paths
+
+        platform_paths = [f.relative_path for f in bundle.platform_files]
+        assert "platform/pipeline-standard.md" in platform_paths
+        assert "platform/failure-modes.md" in platform_paths
+
+    def test_load_walmart_supplier(self) -> None:
+        """Load canon for walmart-supplier source."""
+        readme = "# walmart-supplier\n\nSee platform/pipeline-standard.md.\n"
+        url_map = {
+            "https://raw.githubusercontent.com/hpi-gorillacommerce/gc-data-v2/main/sources/walmart-supplier/README.md": readme,
+            "https://raw.githubusercontent.com/hpi-gorillacommerce/gc-data-v2/main/platform/pipeline-standard.md": SAMPLE_PLATFORM_STANDARD,
+        }
+
+        with patch(
+            "tech_dev_agents.morris.canon_loader.loader.urllib.request.urlopen",
+            side_effect=_mock_urlopen(url_map),
+        ):
+            bundle = load_canon_for_source("walmart-supplier", "main")
+
+        assert len(bundle.source_files) == 1
+        assert len(bundle.platform_files) >= 1
+
+    def test_pin_sha_honored(self) -> None:
+        """Pin sha is used in the URL, not 'main'."""
+        pin = "abc123def456"
+        url_map = {
+            f"https://raw.githubusercontent.com/hpi-gorillacommerce/gc-data-v2/{pin}/sources/spapi-reports/README.md": SAMPLE_SOURCE_README,
+            f"https://raw.githubusercontent.com/hpi-gorillacommerce/gc-data-v2/{pin}/platform/pipeline-standard.md": SAMPLE_PLATFORM_STANDARD,
+            f"https://raw.githubusercontent.com/hpi-gorillacommerce/gc-data-v2/{pin}/platform/failure-modes.md": SAMPLE_PLATFORM_FAILURE,
+        }
+
+        with patch(
+            "tech_dev_agents.morris.canon_loader.loader.urllib.request.urlopen",
+            side_effect=_mock_urlopen(url_map),
+        ):
+            bundle = load_canon_for_source("spapi-reports", pin)
+
+        assert bundle.pin_sha == pin
+        assert len(bundle.files) >= 1
+
+    def test_missing_source_404(self) -> None:
+        """Source not found returns empty bundle (no crash)."""
+        with patch(
+            "tech_dev_agents.morris.canon_loader.loader.urllib.request.urlopen",
+            side_effect=_mock_urlopen({}),
+        ):
+            bundle = load_canon_for_source("nonexistent-source", "main")
+
+        assert isinstance(bundle, CanonBundle)
+        assert len(bundle.files) == 0
