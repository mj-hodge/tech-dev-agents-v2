+router = APIRouter(dependencies=[Depends(require_auth)])
+
+
+@router.get("/")
+async def list_fallback_skills() -> dict[str, Any]:
+    """List all registered operator skill fallbacks."""
+    return {"skills": sorted(REGISTRY.keys())}
+
+
+@router.get("/{skill_name}")
+async def get_fallback_for_skill(
+    skill_name: str,
+    request: Request,
+) -> dict[str, Any]:
+    """Render the fallback SQL + runbook for a specific operator skill.
+
+    Query params are passed through to render_fallback() for placeholder
+    substitution (e.g. ?repo=tech-dev-agents&hours=24).
+    """
+    # Collect all query params as render kwargs
+    params = dict(request.query_params)
+
+    result = render_fallback(skill_name, **params)
+    if result is None:
+        raise HTTPException(
+            status_code=404,
+            detail=f"No fallback registered for skill: {skill_name}",
+        )
+    return result
