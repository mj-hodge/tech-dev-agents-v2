+
+class TestFallbackAPIEndpoint:
+    """Route-level tests for GET /api/ops/fallback/{skill_name}."""
+
+    def test_fallback_api_endpoint_returns_json(self):
+        """SC-1: GET /api/ops/fallback/requeue-failed returns JSON with sql field."""
+        _, client = _make_fallback_test_app()
+        resp = client.get("/api/ops/fallback/requeue-failed", headers=_HEADERS)
+        assert resp.status_code == 200
+        body = resp.json()
