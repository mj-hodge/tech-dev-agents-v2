+"""STORY-1010 — Ops-skill fallback registry.
+
+Each operator skill registers a SQL-direct fallback so that when the skill is
+unavailable (or the operator types ``/skill --fallback``), the registry
+produces a copy-pasteable SQL command + a runbook URL.
+
+Usage::
+
+    from tech_dev_agents.ops_console.ops_skill_fallback_registry import (
+        REGISTRY, get_fallback, render_fallback,
+    )
+
+    fb = get_fallback("requeue-failed")
+    rendered = render_fallback("requeue-failed", repo="tech-dev-agents", hours="24")
+"""
+
+from __future__ import annotations
+
+import logging
+import re
+from dataclasses import dataclass, field
+
+logger = logging.getLogger(__name__)
+
+
+# ---------------------------------------------------------------------------
+# Data model
+# ---------------------------------------------------------------------------
+
+
+@dataclass(frozen=True, slots=True)
+class Fallback:
+    """A documented SQL-direct fallback for an operator skill."""
+
+    skill_name: str
+    sql_template: str
+    runbook_url: str
+    description: str
+    required_params: list[str] = field(default_factory=list)
+
+
+# ---------------------------------------------------------------------------
+# Registry
+# ---------------------------------------------------------------------------
+
+REGISTRY: dict[str, Fallback] = {}
+
+
+def register_fallback(
+    skill_name: str,
+    *,
+    sql_template: str,
+    runbook_url: str,
+    description: str,
+    required_params: list[str] | None = None,
+) -> Fallback:
+    """Register a fallback entry. Returns the created Fallback."""
+    fb = Fallback(
+        skill_name=skill_name,
+        sql_template=sql_template,
+        runbook_url=runbook_url,
+        description=description,
+        required_params=required_params or [],
+    )
+    REGISTRY[skill_name] = fb
+    return fb
