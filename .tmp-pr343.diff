+
+# ---------------------------------------------------------------------------
+# REPLAY-3: 2026-05-14 stall — /requeue-failed unavailable
+# ---------------------------------------------------------------------------
+
+
+def test_replay_3_requeue_failed_fallback_unblocks():
+    """REPLAY-3: when /requeue-failed skill is unavailable, the fallback registry
+    returns a runnable SQL command within 60 seconds.
+
+    This test simulates the 9-hour stall on 2026-05-14 where nobody knew the
+    SQL-direct path to requeue failed jobs.
+
+    Acceptance:
+    - render_fallback('requeue-failed') returns non-None within 60s
+    - Result has 'sql' field starting with 'UPDATE dispatch_state_current'
+    - Result has 'runbook_url' and 'description' fields
+    """
+    # Simulate skill being "unavailable" — we don't call the skill, we call
+    # the fallback registry directly (the on-call operator's fallback path).
+    start = time.monotonic()
+    result = render_fallback("requeue-failed")
+    elapsed = time.monotonic() - start
+
+    # Must return within 60s
+    assert elapsed < 60.0, f"Fallback took {elapsed:.3f}s (> 60s TTL)"
+
+    # Must return a valid result (not None)
