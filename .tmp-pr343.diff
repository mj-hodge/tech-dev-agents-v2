+def _is_new_dispatch(created_at: datetime | None) -> bool:
+    """Return True if the job was created AFTER the enforcement rollout timestamp.
+
+    'New' dispatches must have pr_number set before transitioning to in_review.
+    'Legacy' dispatches (pre-rollout) are allowed through; the sweeper handles them.
+    """
+    if created_at is None:
+        return False
+    rollout = _get_enforcement_rollout()
+    if created_at.tzinfo is None:
+        created_at = created_at.replace(tzinfo=timezone.utc)
+    return created_at > rollout
+
 
