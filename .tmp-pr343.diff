+_DEFAULT_ENFORCEMENT_ROLLOUT = "2099-01-01T00:00:00Z"
+
+
+def _get_enforcement_rollout() -> datetime:
+    """Parse OPS_PR_NUMBER_ENFORCEMENT_ROLLOUT env var into a timezone-aware datetime."""
+    raw = os.environ.get("OPS_PR_NUMBER_ENFORCEMENT_ROLLOUT", _DEFAULT_ENFORCEMENT_ROLLOUT)
+    try:
+        ts = raw.rstrip("Z")
+        if ts.endswith("+00:00"):
+            ts = ts[:-6]
+        dt = datetime.fromisoformat(ts)
+        if dt.tzinfo is None:
+            dt = dt.replace(tzinfo=timezone.utc)
+        return dt
+    except (ValueError, AttributeError):
+        logger.warning(
+            "dispatch_v2_service: invalid OPS_PR_NUMBER_ENFORCEMENT_ROLLOUT=%r, "
+            "defaulting to 2099-01-01",
+            raw,
+        )
+        return datetime(2099, 1, 1, tzinfo=timezone.utc)
+
