+        return None
+
+    logger.info("ops_fallback_render: skill=%s", skill_name)
+
+    sql = fb.sql_template
+    params_used: dict[str, str] = {}
+    for idx, pname in enumerate(fb.required_params, start=1):
+        placeholder = f"${idx}"
+        if pname in params:
+            sql = sql.replace(placeholder, str(params[pname]))
+            params_used[pname] = str(params[pname])
+
+    return {
+        "skill_name": fb.skill_name,
+        "sql": sql,
+        "runbook_url": fb.runbook_url,
+        "description": fb.description,
+        "params_used": params_used,
+    }
