+  1. test_requeue_failed_fallback_renders — SC-1
+  2. test_all_five_skills_registered — SC-2
+  3. test_render_fallback_unknown_skill_returns_none
+  4. test_render_with_params_substitutes_placeholders
+  5. test_render_without_params_leaves_placeholders
+  6. test_get_fallback_returns_none_for_unknown
+  7. test_fallback_api_endpoint_returns_json — SC-1 (route-level)
+  8. test_fallback_api_endpoint_unknown_skill_404
