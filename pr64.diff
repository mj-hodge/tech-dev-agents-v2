+## Verification Script
+
+```bash
+#!/bin/bash
+FILE="ads-research/shipping-address-data-landscape.md"
+
+# T1: File exists and is substantial
+[ -f "$FILE" ] && [ $(wc -c < "$FILE") -gt 2000 ] && echo "T1: PASS" || echo "T1: FAIL"
+
+# T2: All 8 avenues present
+grep -qi "SP-API\|Orders.*API\|FBA" "$FILE" && \
+grep -qi "Amazon Ads\|Attribution\|Sponsored Ads" "$FILE" && \
+grep -qi "Target\|api-retail-target" "$FILE" && \
+grep -qi "Shopify\|DTC" "$FILE" && \
+grep -qi "data.warehouse\|tech-datawarehouse" "$FILE" && \
+grep -qi "enrichment\|SmartyStreets\|Melissa" "$FILE" && \
+grep -qi "Celigo\|integration.platform" "$FILE" && \
+grep -qi "GDPR\|CCPA\|compliance" "$FILE" && \
+echo "T2: PASS" || echo "T2: FAIL"
+
+# T3: Four facets (scan for facet keywords across the doc)
+grep -qi "currently captured\|currently.*ingest\|what.*we.*capture\|capture.*today" "$FILE" && \
+grep -qi "could capture\|could.*ingest\|if.*we.*changed\|potential.*capture" "$FILE" && \
+grep -qi "limitation\|redact\|TOS\|PII" "$FILE" && \
+echo "T3: PASS" || echo "T3: FAIL"
+
+# T4: SP-API specifics
+grep -qi "FBA\|FBM" "$FILE" && grep -qi "redact\|obfuscat\|ShippingAddress\|postal" "$FILE" && \
+echo "T4: PASS" || echo "T4: FAIL"
+
+# T5: Ads geo
+grep -qi "geo.*dimension\|geographic\|zip.*level\|DMA\|state.*level" "$FILE" && \
+echo "T5: PASS" || echo "T5: FAIL"
+
+# T6: Target specifics
+grep -qi "api-retail-target\|Target.*order\|distribution.*center\|DC.*address" "$FILE" && \
+echo "T6: PASS" || echo "T6: FAIL"
+
+# T7: Shopify/DTC
+grep -qi "Shopify\|DTC\|direct.to.consumer" "$FILE" && echo "T7: PASS" || echo "T7: FAIL"
+
+# T8: Data warehouse
+grep -qi "tech-datawarehouse\|data.warehouse" "$FILE" && echo "T8: PASS" || echo "T8: FAIL"
+
+# T9: Enrichment vendors (at least 2)
+VENDOR_COUNT=$(grep -oi "SmartyStreets\|Melissa\|Google Maps\|census\|ZCTA\|DMA\|FIPS\|Geocodio\|HERE\|Precisely" "$FILE" | sort -u | wc -l)
+[ "$VENDOR_COUNT" -ge 2 ] && echo "T9: PASS" || echo "T9: FAIL"
+
+# T10: Celigo
+grep -qi "Celigo\|integration.*layer\|integration.*platform" "$FILE" && \
+echo "T10: PASS" || echo "T10: FAIL"
+
+# T11: PII & Compliance specifics
+grep -qi "GDPR" "$FILE" && grep -qi "CCPA" "$FILE" && \
+grep -qi "Amazon.*TOS\|Terms.*Service\|Seller.*Agreement" "$FILE" && \
+grep -qi "data.*minimiz\|minimiz.*data\|should.*store\|can.*store" "$FILE" && \
+echo "T11: PASS" || echo "T11: FAIL"
+
+# T12: Data availability matrix (table with 4+ columns, 8+ rows)
+TABLE_ROWS=$(grep -c "^|" "$FILE" 2>/dev/null || echo 0)
+[ "$TABLE_ROWS" -ge 10 ] && echo "T12: PASS" || echo "T12: FAIL (need ≥10 table rows incl. header/separator)"
+
+# T13: Ranked recommendations
+REC_COUNT=$(grep -c "^\s*[0-9]\+\.\|^\s*[-*].*\brecommend\b" "$FILE" 2>/dev/null || echo 0)
+grep -qi "quick.*win\|high.*value\|low.*effort\|effort.*value\|ranked.*recommend\|recommend.*rank" "$FILE" && \
+echo "T13: PASS" || echo "T13: FAIL"
+
+# T14: Open questions
+grep -qi "open.question\|question.*mark\|unknowns\|for.*mark" "$FILE" && \
+QUESTION_COUNT=$(grep -c "^- \|^\* \|\?" "$FILE" 2>/dev/null || echo 0) && \
+[ "$QUESTION_COUNT" -ge 3 ] && echo "T14: PASS" || echo "T14: FAIL"
+
+# T15: Source citations
+LINK_COUNT=$(grep -oP 'https?://[^\s)>]+' "$FILE" | wc -l)
+INTERNAL_REF=$(grep -qi "advertising-amazon\|tech-datawarehouse\|api-retail-target" "$FILE" && echo 1 || echo 0)
+[ "$LINK_COUNT" -ge 10 ] && [ "$INTERNAL_REF" -eq 1 ] && echo "T15: PASS" || echo "T15: FAIL (links=$LINK_COUNT internal=$INTERNAL_REF)"
+
+# T16: Word count
+WORDS=$(wc -w < "$FILE")
+[ "$WORDS" -ge 4000 ] && echo "T16: PASS" || echo "T16: FAIL (words=$WORDS, need ≥4000)"
+
+# T17: Catalog & log updated
+grep -q "shipping-address-data-landscape\|shipping.*address.*data" index.md 2>/dev/null && echo "T17a (index): PASS" || echo "T17a (index): FAIL"
+grep -q "INGEST.*story-765\|story-765.*INGEST\|shipping-address" log.md 2>/dev/null && echo "T17b (log): PASS" || echo "T17b (log): FAIL"
+```
