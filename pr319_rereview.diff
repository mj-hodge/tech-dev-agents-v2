@@ -0,0 +1,1015 @@
+"""
+STORY-640: Competitor Set Maintenance — Phase 7 RED test suite.
+
+Tests cover all 10 acceptance criteria from seed.md §4:
+
+  TC-1  GET filter        — /bsr/competitors?our_asin=X returns only matching rows
+  TC-2  POST happy path   — 201 + row in GET + audit log operation="competitor_map.create"
+  TC-3  POST duplicate    — 409 on (profile_id, our_asin, competitor_asin) collision
+  TC-4  DELETE            — 204 + row removed from GET + audit log operation="competitor_map.delete"
+  TC-5  ASIN validation   — 422 with field-level error for invalid ASIN
+  TC-6  Bulk idempotent   — POST /bulk returns {"inserted": N, "skipped": [...]}
+  TC-7  Max-per-ASIN      — 11th POST returns 409 with reason "max_competitors_reached"
+  TC-8  Permission gate   — no bsr_dashboard permission → 403
+  TC-9  Read-only mode    — POST/DELETE → 403 when read-only; GET still works
+  TC-10 Zero outbound HTTP — no HTTP to advertising-api.amazon.com under TESTING=1
+
+Acceptance diff (seed §3) requires these function names to exist in this file:
+  test_post_competitor, test_delete_competitor, test_bulk_idempotent, test_max_per_asin_enforced
+
+ALL tests are RED before Phase 8 because:
+  create_competitor_set_router is not yet present in src/api/bsr_dashboard.py.
+
+When Phase 8 adds the factory, tests turn GREEN without changes to this file.
+
+outbound_http_blocked (root autouse in tests/conftest.py) blocks all real outbound
+HTTP for every test. The TC-10 test reinforces this with an explicit respx check.
+
+Run:
+  TESTING=1 BSR_DASHBOARD_ENABLED=true pytest tests/test_bsr/test_competitor_set_api.py -v
+"""
+
+from __future__ import annotations
+
+import os
+from datetime import datetime, timezone
+from typing import Any
+from unittest.mock import AsyncMock, MagicMock, patch
+
+import pytest
+from starlette.applications import Starlette
+from starlette.testclient import TestClient
+
+# ---------------------------------------------------------------------------
+# Constants
+# ---------------------------------------------------------------------------
+
+VALID_ASIN_OUR = "B0OURRR123"       # regex ^B0[A-Z0-9]{8}$ → 10 chars, starts B0
+VALID_ASIN_COMP1 = "B0COMP1111"
+VALID_ASIN_COMP2 = "B0COMP2222"
+VALID_ASIN_COMP3 = "B0COMP3333"
+VALID_ASIN_OTHER = "B0OTHER123"     # different our_asin (TC-1 cross-ASIN isolation)
+PROFILE_ID = "P_TEST_001"
+CATEGORY = "Pet Supplies"
+VALID_TOKEN = "test-bearer-token"
+AUTH = {"Authorization": f"Bearer {VALID_TOKEN}"}
+
+# ---------------------------------------------------------------------------
+# Factory import helper — RED pattern
+# ---------------------------------------------------------------------------
+# If create_competitor_set_router is absent from bsr_dashboard, _get_factory()
+# returns None and every test that calls _make_client() fails with AssertionError
+# (FAIL, not ERROR). This is the correct Phase 7 RED state.
+# ---------------------------------------------------------------------------
+
+
