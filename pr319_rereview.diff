+"""047_bsr_competitor_map_add_profile_id — STORY-815 (fix STORY-640 S1).
+
+Add profile_id column to bsr_competitor_map so competitor sets are scoped
+per advertising profile.  The original migration (033) omitted this column.
+
+Also replaces the old unique constraint (our_asin, competitor_asin, category)
+with a new one on (profile_id, our_asin, competitor_asin) matching the API
+contract defined in STORY-640 seed.md §1.
+"""
+
+from alembic import op
+import sqlalchemy as sa
+
+revision = "047"
+down_revision = "046"
+branch_labels = None
+depends_on = None
+
+
+def upgrade() -> None:
+    # Add profile_id column (nullable initially for backfill safety)
+    op.add_column(
+        "bsr_competitor_map",
+        sa.Column("profile_id", sa.String(length=50), nullable=True),
+    )
+
+    # Backfill existing rows with empty string so NOT NULL can be applied
+    op.execute("UPDATE bsr_competitor_map SET profile_id = '' WHERE profile_id IS NULL")
+
+    # Make NOT NULL
+    op.alter_column("bsr_competitor_map", "profile_id", nullable=False)
+
+    # Drop old unique constraint and create new one scoped by profile_id
+    op.drop_constraint("uq_bsr_competitor_map_asin_pair", "bsr_competitor_map")
+    op.create_unique_constraint(
+        "uq_bsr_competitor_map_profile_asin_pair",
+        "bsr_competitor_map",
+        ["profile_id", "our_asin", "competitor_asin"],
+    )
+
+    # Index for common query pattern: list competitors by (profile_id, our_asin)
+    op.create_index(
+        "idx_bsr_competitor_map_profile_our_asin",
+        "bsr_competitor_map",
+        ["profile_id", "our_asin"],
+    )
+
+
+def downgrade() -> None:
+    op.drop_index("idx_bsr_competitor_map_profile_our_asin", table_name="bsr_competitor_map")
+    op.drop_constraint("uq_bsr_competitor_map_profile_asin_pair", "bsr_competitor_map")
+    op.create_unique_constraint(
+        "uq_bsr_competitor_map_asin_pair",
+        "bsr_competitor_map",
+        ["our_asin", "competitor_asin", "category"],
+    )
+    op.drop_column("bsr_competitor_map", "profile_id")
