+class TestZeroOutboundHttp:
+    """TC-10: No HTTP requests to advertising-api.amazon.com (respx strict check)."""
+
+    @pytest.mark.timeout(15)
+    def test_zero_outbound_http(self):
+        """
+        TC-10: TESTING=1 — no HTTP to advertising-api.amazon.com.
+
+        The autouse outbound_http_blocked fixture (tests/conftest.py) already
+        blocks all real outbound HTTP for every test. This test reinforces
+        the principle with an explicit respx strict-mode assertion and verifies
+        that POST /bsr/competitors succeeds without any outbound calls being
+        attempted to Amazon's Advertising API.
+
+        Per CLAUDE.md External API Write Safety §3: every story that touches
+        write paths MUST include a test asserting zero outbound HTTP.
+        """
+        try:
+            import respx
+            import httpx
+        except ImportError:
+            pytest.skip("respx not installed — install it with: pip install respx")
+
+        inserted_row = _make_competitor_row(row_id=1)
+        count_result = _mock_result_scalar(0)
+        insert_result = _mock_result_inserted(inserted_row)
+        session_factory, _ = _make_session_factory([count_result, insert_result])
+
+        client = _make_client(session_factory=session_factory)
+        payload = {
+            "profile_id": PROFILE_ID,
+            "our_asin": VALID_ASIN_OUR,
+            "competitor_asin": VALID_ASIN_COMP1,
+            "category": CATEGORY,
+        }
+
+        # respx in strict mode: any unexpected HTTP call raises AssertionError
+        with respx.mock(assert_all_called=False) as mock_router:
+            # No routes registered → any outbound call is an error
+            resp = client.post("/bsr/competitors", json=payload, headers=AUTH)
+
+        # The response should be 201 (success) with no external HTTP
+        assert resp.status_code == 201, (
+            f"TC-10: POST /bsr/competitors must succeed. Got {resp.status_code}: {resp.text}"
+        )
+        # If any outbound HTTP was attempted, respx strict mode would have raised.
+        # Reaching here confirms zero outbound HTTP to advertising-api.amazon.com.
+        assert len(mock_router.calls) == 0, (
+            f"TC-10: Expected 0 outbound HTTP calls, got {len(mock_router.calls)}. "
+            f"Calls: {mock_router.calls}"
+        )
+
+    @pytest.mark.timeout(15)
+    def test_get_zero_outbound_http(self):
+        """TC-10: GET /bsr/competitors makes zero outbound HTTP calls."""
+        try:
+            import respx
+        except ImportError:
+            pytest.skip("respx not installed")
+
+        rows = [_make_competitor_row()]
+        client = _make_client(rows=rows)
+
+        with respx.mock(assert_all_called=False) as mock_router:
+            resp = client.get("/bsr/competitors", headers=AUTH)
+
+        assert resp.status_code == 200
+        assert len(mock_router.calls) == 0, (
+            f"TC-10: Expected 0 outbound HTTP calls on GET, got {len(mock_router.calls)}"
+        )
