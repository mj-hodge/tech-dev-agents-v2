+      api_key_verifier   – has verify_token(token) -> token_obj | None
+      audit_logger       – has log_mutation(**kwargs) async callable
+      check_write_fn     – check_write_allowed("competitor_map") substitute
+      is_authorized_fn   – _require_page_access substitute (bsr_dashboard key)
+      app_config         – dict with optional "bsr_competitor_max_per_asin" key
+    """
+
+    def _max_per_asin() -> int:
+        if app_config is None:
+            return _COMPETITOR_MAX_PER_ASIN_DEFAULT
+        return app_config.get("bsr_competitor_max_per_asin", _COMPETITOR_MAX_PER_ASIN_DEFAULT)
+
+    async def _get_db_session() -> Any:
+        """Get a session from the factory (handles both sync and async returns)."""
+        result = async_session()
+        if inspect.isawaitable(result):
+            return await result
+        return result
+
+    async def _auth(request: Request) -> Any | None:
+        """Extract and verify Bearer token. Returns token object or None (→ 401)."""
+        auth_header = request.headers.get("Authorization", "")
+        if not auth_header.startswith("Bearer "):
+            return None
+        token = auth_header[len("Bearer "):]
+        try:
+            return await api_key_verifier.verify_token(token)
+        except Exception:
+            return None
+
+    async def _permission_check(request: Request, token: Any):
+        """Returns error JSONResponse or None (allowed)."""
+        if is_authorized_fn is None:
+            return None
+        result = await is_authorized_fn(request, token)
+        return result  # None = ok, JSONResponse = deny
+
+    async def _write_check(request: Request):
+        """
+        Returns error JSONResponse or None (allowed).
+
+        Production default: check_write_allowed("competitor_map") from
+        src.tools._write_guard.  Injected in tests for isolation.
+        """
+        if check_write_fn is None:
+            return None
+        blocked = await check_write_fn("competitor_map")
+        if blocked is None:
+            return None
+        status = blocked.get("status", 403) if isinstance(blocked, dict) else 403
+        return JSONResponse(blocked if isinstance(blocked, dict) else {}, status_code=status)
+
+    def _validate_asin(value: str, field: str):
+        """Returns None if valid, or a JSONResponse(422) if invalid."""
+        if not _COMPETITOR_ASIN_RE.match(value or ""):
+            return problem_response(
+                code="INVALID_ASIN",
+                detail=f"{field} '{value}' is invalid. Must match ^B0[A-Z0-9]{{8}}$ (exactly 10 chars).",
+                instance="/api/bsr/competitors",
+                status=422,
+            )
+        return None
+
+    # ------------------------------------------------------------------
+    # GET /bsr/competitors
+    # ------------------------------------------------------------------
+
+    async def get_competitors(request: Request) -> JSONResponse:
+        """List competitor map rows, optionally filtered by our_asin / profile_id."""
+        token = await _auth(request)
+        if token is None:
+            return _unauthorized("/api/bsr/competitors")
+
+        our_asin = request.query_params.get("our_asin")
+        profile_id = request.query_params.get("profile_id")
+
+        session = await _get_db_session()
+
+        from sqlalchemy import text as sa_text
+
+        conditions: list[str] = []
+        params: dict[str, Any] = {}
+        if our_asin:
+            conditions.append("our_asin = :our_asin")
+            params["our_asin"] = our_asin
+        if profile_id:
+            conditions.append("profile_id = :profile_id")
+            params["profile_id"] = profile_id
+
+        where_clause = f"WHERE {' AND '.join(conditions)}" if conditions else ""
+        sql = (
+            f"SELECT id, profile_id, our_asin, competitor_asin, category, added_at "
+            f"FROM bsr_competitor_map {where_clause} ORDER BY id ASC"
+        )
+
+        try:
+            result = await session.execute(sa_text(sql), params)
+            rows = result.mappings().all()
+            return JSONResponse({"rows": [dict(r) for r in rows]})
+        except Exception as exc:
+            _logger.error("competitor_set_get_error: %s", exc, exc_info=True)
+            return problem_response(
+                code="COMPETITOR_GET_ERROR",
+                detail=f"Failed to list competitors: {exc}",
+                instance="/api/bsr/competitors",
+                status=500,
+            )
+
+    # ------------------------------------------------------------------
+    # POST /bsr/competitors
+    # ------------------------------------------------------------------
+
+    async def post_competitor(request: Request) -> JSONResponse:
+        """Create a single competitor entry."""
+        token = await _auth(request)
+        if token is None:
+            return _unauthorized("/api/bsr/competitors")
+
+        perm_err = await _permission_check(request, token)
+        if perm_err is not None:
+            return perm_err
+
+        write_err = await _write_check(request)
+        if write_err is not None:
+            return write_err
+
+        try:
+            body = await request.json()
+        except Exception:
+            return problem_response(
+                code="INVALID_JSON",
+                detail="Request body must be valid JSON.",
+                instance="/api/bsr/competitors",
+                status=422,
+            )
+
+        profile_id = body.get("profile_id", "")
+        our_asin = body.get("our_asin", "")
+        competitor_asin = body.get("competitor_asin", "")
+        category = body.get("category", "")
+
+        if not profile_id or not our_asin or not competitor_asin:
+            return problem_response(
+                code="MISSING_FIELDS",
+                detail="profile_id, our_asin, and competitor_asin are required.",
+                instance="/api/bsr/competitors",
+                status=422,
+            )
+
+        err = _validate_asin(our_asin, "our_asin")
+        if err:
+            return err
+        err = _validate_asin(competitor_asin, "competitor_asin")
+        if err:
+            return err
+
+        from sqlalchemy import text as sa_text
+
+        session = await _get_db_session()
+
+        # Count check: enforce top-N cap
+        count_result = await session.execute(
+            sa_text(
+                "SELECT COUNT(*) FROM bsr_competitor_map "
+                "WHERE profile_id = :profile_id AND our_asin = :our_asin"
+            ),
+            {"profile_id": profile_id, "our_asin": our_asin},
+        )
+        current_count = count_result.scalar()
+        if (current_count or 0) >= _max_per_asin():
+            return JSONResponse(
+                {
+                    "status": 409,
+                    "code": "max_competitors_reached",
+                    "detail": (
+                        f"Cannot add more than {_max_per_asin()} competitors "
+                        f"for profile_id={profile_id} our_asin={our_asin}."
+                    ),
+                },
+                status_code=409,
+            )
+
+        # Insert
+        try:
+            insert_result = await session.execute(
+                sa_text(
+                    "INSERT INTO bsr_competitor_map "
+                    "(profile_id, our_asin, competitor_asin, category) "
+                    "VALUES (:profile_id, :our_asin, :competitor_asin, :category) "
+                    "RETURNING id, profile_id, our_asin, competitor_asin, category, added_at"
+                ),
+                {
+                    "profile_id": profile_id,
+                    "our_asin": our_asin,
+                    "competitor_asin": competitor_asin,
+                    "category": category,
+                },
+            )
+            await session.commit()
+            row = dict(insert_result.mappings().one())
+        except Exception as exc:
+            exc_str = str(exc)
+            exc_type = type(exc).__name__
+            if (
+                "IntegrityError" in exc_type
+                or "unique" in exc_str.lower()
+                or "constraint" in exc_str.lower()
+                or "UNIQUE" in exc_str
+            ):
+                return JSONResponse(
+                    {
+                        "status": 409,
+                        "code": "DUPLICATE",
+                        "detail": (
+                            f"Competitor ({profile_id}, {our_asin}, {competitor_asin}) "
+                            "already exists."
+                        ),
+                    },
+                    status_code=409,
+                )
+            raise
+
+        # Audit log — signature: (user_id, operation, profile_id, resource_id, before, after)
+        if audit_logger is not None:
+            try:
+                _user_id = getattr(token, "user_id", 0) if token else 0
+                await audit_logger.log_mutation(
+                    user_id=_user_id,
+                    operation="competitor_map.create",
+                    profile_id=profile_id,
+                    resource_id=str(row.get("id", "")),
+                    before=None,
+                    after={
+                        "our_asin": our_asin,
+                        "competitor_asin": competitor_asin,
+                        "category": category,
+                    },
+                )
+            except Exception as exc:
+                _logger.warning("competitor_set_audit_log_failed: %s", exc)
+
+        return JSONResponse(row, status_code=201)
+
+    # ------------------------------------------------------------------
+    # POST /bsr/competitors/bulk
+    # ------------------------------------------------------------------
+
+    async def post_competitors_bulk(request: Request) -> JSONResponse:
+        """
+        Idempotent batch insert of competitor ASINs.
+
+        Body: {"profile_id", "our_asin", "competitor_asins": [...], "category"}
+        Returns: {"inserted": N, "skipped": [<asin_list>]}
+
+        Uses a pre-flight SELECT to identify already-existing entries, then
+        inserts the new ones up to the max_per_asin cap.  Entries beyond the
+        available slots are appended to the skipped list.
+        """
+        token = await _auth(request)
+        if token is None:
+            return _unauthorized("/api/bsr/competitors/bulk")
+
+        perm_err = await _permission_check(request, token)
+        if perm_err is not None:
+            return perm_err
+
+        write_err = await _write_check(request)
+        if write_err is not None:
+            return write_err
+
+        try:
+            body = await request.json()
+        except Exception:
+            return problem_response(
+                code="INVALID_JSON",
+                detail="Request body must be valid JSON.",
+                instance="/api/bsr/competitors/bulk",
+                status=422,
+            )
+
+        profile_id = body.get("profile_id", "")
+        our_asin = body.get("our_asin", "")
+        competitor_asins: list[str] = body.get("competitor_asins") or []
+        category = body.get("category", "")
+
+        if not profile_id or not our_asin or not competitor_asins:
+            return problem_response(
+                code="MISSING_FIELDS",
+                detail="profile_id, our_asin, and competitor_asins (list) are required.",
+                instance="/api/bsr/competitors/bulk",
+                status=422,
+            )
+
+        # Validate all ASINs up front
+        valid_asins: list[str] = []
+        skipped: list[str] = []
+        for asin in competitor_asins:
+            if not _COMPETITOR_ASIN_RE.match(asin or ""):
+                skipped.append(asin)
+            else:
+                valid_asins.append(asin)
+
+        from sqlalchemy import text as sa_text
+
+        session = await _get_db_session()
+
+        # Pre-flight: fetch existing competitor_asins + count for top-N cap
+        existing_result = await session.execute(
+            sa_text(
+                "SELECT competitor_asin FROM bsr_competitor_map "
+                "WHERE profile_id = :profile_id AND our_asin = :our_asin"
+            ),
+            {"profile_id": profile_id, "our_asin": our_asin},
+        )
+        existing_rows = existing_result.mappings().all()
+        existing_set: set[str] = {
+            r["competitor_asin"] for r in existing_rows if r.get("competitor_asin")
+        }
+        current_count = len(existing_set)
+
+        # Split into already-existing (skip) and genuinely new
+        to_insert: list[str] = []
+        for asin in valid_asins:
+            if asin in existing_set:
+                skipped.append(asin)
+            else:
+                to_insert.append(asin)
+
+        # H2: Enforce top-N cap — only insert up to available slots
+        max_allowed = _max_per_asin()
+        available_slots = max(0, max_allowed - current_count)
+        if len(to_insert) > available_slots:
+            skipped.extend(to_insert[available_slots:])
+            to_insert = to_insert[:available_slots]
+
+        # Actually INSERT rows using ON CONFLICT DO NOTHING for safety
+        inserted_count = 0
+        if to_insert:
+            for asin in to_insert:
+                try:
+                    result = await session.execute(
+                        sa_text(
+                            "INSERT INTO bsr_competitor_map "
+                            "(profile_id, our_asin, competitor_asin, category) "
+                            "VALUES (:profile_id, :our_asin, :competitor_asin, :category) "
+                            "ON CONFLICT (profile_id, our_asin, competitor_asin) DO NOTHING"
+                        ),
+                        {
+                            "profile_id": profile_id,
+                            "our_asin": our_asin,
+                            "competitor_asin": asin,
+                            "category": category,
+                        },
+                    )
+                    inserted_count += 1
+                except Exception as exc:
+                    _logger.warning("bulk_insert_single_failed: asin=%s err=%s", asin, exc)
+                    skipped.append(asin)
+            await session.commit()
+
+            # Audit log for bulk insert
+            if audit_logger is not None and inserted_count > 0:
+                try:
+                    _user_id = getattr(token, "user_id", 0) if token else 0
+                    await audit_logger.log_mutation(
+                        user_id=_user_id,
+                        operation="competitor_map.bulk_create",
+                        profile_id=profile_id,
+                        resource_id=our_asin,
+                        before=None,
+                        after={
+                            "inserted_asins": to_insert[:inserted_count],
+                            "category": category,
+                        },
+                    )
+                except Exception as exc:
+                    _logger.warning("competitor_set_bulk_audit_log_failed: %s", exc)
+
+        return JSONResponse({"inserted": inserted_count, "skipped": skipped})
+
+    # ------------------------------------------------------------------
+    # DELETE /bsr/competitors/{id}
+    # ------------------------------------------------------------------
+
+    async def delete_competitor(request: Request) -> JSONResponse:
+        """Remove a competitor entry by ID."""
+        token = await _auth(request)
+        if token is None:
+            return _unauthorized("/api/bsr/competitors/{id}")
+
+        perm_err = await _permission_check(request, token)
+        if perm_err is not None:
+            return perm_err
+
+        write_err = await _write_check(request)
+        if write_err is not None:
+            return write_err
+
+        try:
+            row_id = int(request.path_params["id"])
+        except (KeyError, ValueError, TypeError):
+            return problem_response(
+                code="INVALID_PARAM",
+                detail="id must be an integer.",
+                instance="/api/bsr/competitors/{id}",
+                status=422,
+            )
+
+        from sqlalchemy import text as sa_text
+
+        session = await _get_db_session()
+
+        # Fetch the row first (to confirm existence and capture data for audit)
+        fetch_result = await session.execute(
+            sa_text(
+                "SELECT id, profile_id, our_asin, competitor_asin, category "
+                "FROM bsr_competitor_map WHERE id = :id"
+            ),
+            {"id": row_id},
+        )
+        rows = fetch_result.mappings().all()
+        if not rows:
+            return problem_response(
+                code="NOT_FOUND",
+                detail=f"Competitor entry {row_id} not found.",
+                instance=f"/api/bsr/competitors/{row_id}",
+                status=404,
+            )
+
+        row = dict(rows[0])
+
+        # Delete
+        await session.execute(
+            sa_text("DELETE FROM bsr_competitor_map WHERE id = :id"),
+            {"id": row_id},
+        )
+        await session.commit()
+
+        # Audit log — signature: (user_id, operation, profile_id, resource_id, before, after)
+        if audit_logger is not None:
+            try:
+                _user_id = getattr(token, "user_id", 0) if token else 0
+                await audit_logger.log_mutation(
+                    user_id=_user_id,
+                    operation="competitor_map.delete",
+                    profile_id=row.get("profile_id"),
+                    resource_id=str(row_id),
+                    before={
+                        "our_asin": row.get("our_asin"),
+                        "competitor_asin": row.get("competitor_asin"),
+                        "category": row.get("category"),
+                    },
+                    after=None,
+                )
+            except Exception as exc:
+                _logger.warning("competitor_set_audit_delete_log_failed: %s", exc)
+
+        return Response(status_code=204)
+
+    # ------------------------------------------------------------------
+    # Route table
+    # ------------------------------------------------------------------
+
+    return Router(
+        routes=[
+            Route("/bsr/competitors/bulk", post_competitors_bulk, methods=["POST"]),
+            Route("/bsr/competitors", get_competitors, methods=["GET"]),
+            Route("/bsr/competitors", post_competitor, methods=["POST"]),
+            Route("/bsr/competitors/{id:int}", delete_competitor, methods=["DELETE"]),
+        ]
+    )
