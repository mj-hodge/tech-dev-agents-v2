+def _mock_result_rows(rows: list[dict]) -> MagicMock:
+    """Build a mock SQLAlchemy result that returns rows via .mappings().all()."""
+    mock_rows = []
+    for r in rows:
+        m = MagicMock()
+        m._mapping = r
+        # dict() of MagicMock with spec — use plain dict so dict(row) works
+        m.__iter__ = lambda self: iter(self._mapping.items())
+        m.keys = lambda self: self._mapping.keys()
+        mock_rows.append(r)          # store plain dicts; handler uses dict(row)
+    result = MagicMock()
+    result.mappings.return_value.all.return_value = mock_rows
+    result.scalar.return_value = len(rows)
+    result.rowcount = len(rows)
+    return result
+
+
+def _mock_result_scalar(value: Any) -> MagicMock:
+    """Build a mock result returning a scalar (count, id, None)."""
+    result = MagicMock()
+    result.scalar.return_value = value
+    result.mappings.return_value.all.return_value = []
+    result.rowcount = 1 if value else 0
+    return result
+
+
+def _mock_result_inserted(row: dict) -> MagicMock:
+    """Build a mock result for an INSERT … RETURNING row."""
+    result = MagicMock()
+    result.mappings.return_value.one.return_value = row
+    result.mappings.return_value.first.return_value = row
+    result.scalar.return_value = row.get("id")
+    result.rowcount = 1
+    return result
+
+
+def _make_session(execute_side_effects: list[Any]) -> AsyncMock:
+    """
+    Build an AsyncMock session with a sequence of execute() return values.
+
+    Each item in execute_side_effects is returned in order on successive
+    calls to session.execute(). Can mix MagicMock results, Exceptions, etc.
+    """
+    session = AsyncMock()
+    session.commit = AsyncMock()
+    session.rollback = AsyncMock()
+    session.__aenter__ = AsyncMock(return_value=session)
+    session.__aexit__ = AsyncMock(return_value=False)
+
+    effects = []
+    for item in execute_side_effects:
+        if isinstance(item, BaseException):
+            effects.append(item)
+        else:
+            async def _return(stmt, params=None, *, _v=item):  # noqa: E731
+                return _v
+            effects.append(_v for _v in [item])   # use side_effect list approach
+
+    # Simpler: use side_effect list directly
+    session.execute = AsyncMock(side_effect=[
+        item if isinstance(item, BaseException) else item
+        for item in execute_side_effects
+    ])
+    return session
+
+
+def _make_session_factory(execute_side_effects: list[Any]) -> tuple[Any, AsyncMock]:
+    """
+    Return (factory_callable, session_mock).
+
+    The factory supports both:
+      session = session_factory()           (direct call, bsr_dashboard pattern)
+      async with session_factory() as s:    (context manager pattern)
+    """
+    session = _make_session(execute_side_effects)
+
+    factory = MagicMock()
+    factory.return_value = session
+    # Support async context manager protocol: async with factory() as s
+    cm = AsyncMock()
+    cm.__aenter__ = AsyncMock(return_value=session)
+    cm.__aexit__ = AsyncMock(return_value=False)
+    factory.return_value = cm
+    # Also allow awaiting factory() to get the session directly (bsr_dashboard pattern)
+    factory.side_effect = None
+
+    # Use a simple callable that behaves as both patterns
+    class _SessionFactory:
+        def __call__(self):
+            return session
+
+        async def __aenter__(self):
+            return session
+
+        async def __aexit__(self, *_):
+            pass
+
+    sf = _SessionFactory()
+    return sf, session
+
+
+def _make_verifier(valid: bool = True) -> MagicMock:
+    """Build a mock api_key_verifier."""
+    verifier = MagicMock()
+    if valid:
+        token_obj = MagicMock()
+        token_obj.is_admin = True
+        token_obj.groups = ["bsr_editors"]
+        token_obj.email = "test@gorillac.com"
+        verifier.verify_token = AsyncMock(return_value=token_obj)
+    else:
+        verifier.verify_token = AsyncMock(return_value=None)
+    return verifier
+
+
+def _make_audit_logger() -> AsyncMock:
+    """Build a mock AuditLogger with log_mutation and log_read."""
+    logger = AsyncMock()
+    logger.log_mutation = AsyncMock()
+    logger.log_read = AsyncMock()
+    return logger
+
+
+def _writes_allowed() -> AsyncMock:
+    """Stub check_write_fn that always allows writes (returns None = no block)."""
+    return AsyncMock(return_value=None)
+
+
+def _writes_blocked() -> AsyncMock:
+    """Stub check_write_fn that blocks all writes (returns error dict)."""
+    blocked = {
+        "status": 403,
+        "code": "READ_ONLY_MODE",
+        "detail": "Write operations disabled (read-only mode)",
+        "error_hint": "Server is in read-only mode.",
+    }
+    return AsyncMock(return_value=blocked)
+
+
+def _permission_allowed() -> AsyncMock:
+    """Stub is_authorized_fn that grants access (returns None = no error)."""
+    return AsyncMock(return_value=None)
+
+
+def _permission_denied() -> AsyncMock:
+    """Stub is_authorized_fn that denies access (returns 403 JSONResponse)."""
+    from starlette.responses import JSONResponse
+    blocked = JSONResponse(
+        {"status": 403, "code": "FORBIDDEN", "detail": "No bsr_dashboard permission"},
+        status_code=403,
+    )
+    return AsyncMock(return_value=blocked)
+
+
+def _make_client(
+    session_factory: Any = None,
+    verifier: Any = None,
+    audit_logger: Any = None,
+    check_write_fn: Any = None,
+    is_authorized_fn: Any = None,
+    rows: list[dict] | None = None,
+    execute_results: list[Any] | None = None,
+) -> TestClient:
+    """
+    Build a Starlette TestClient wrapping create_competitor_set_router.
+
+    Fails with AssertionError (RED state) if the factory is not yet implemented.
+    Phase 8: add create_competitor_set_router to src/api/bsr_dashboard.py.
+    """
+    factory_fn = _get_factory()
+    assert factory_fn is not None, (
+        "create_competitor_set_router not found in src.api.bsr_dashboard. "
+        "Phase 8: implement this factory and add /bsr/competitors routes."
+    )
+
+    # Build default session factory if not supplied
+    if session_factory is None:
+        _rows = rows or []
+        _results = execute_results or [_mock_result_rows(_rows)]
+        session_factory, _ = _make_session_factory(_results)
+
+    _verifier = verifier or _make_verifier(valid=True)
+    _audit = audit_logger or _make_audit_logger()
+    _write_fn = check_write_fn or _writes_allowed()
+    _auth_fn = is_authorized_fn or _permission_allowed()
+
+    router = factory_fn(
+        async_session=session_factory,
+        api_key_verifier=_verifier,
+        audit_logger=_audit,
+        check_write_fn=_write_fn,
+        is_authorized_fn=_auth_fn,
+    )
+    app = Starlette(routes=router.routes)
+    return TestClient(app, raise_server_exceptions=False)
