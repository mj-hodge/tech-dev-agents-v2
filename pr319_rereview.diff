+/**
+ * BSR Competitor Editor Panel — STORY-640
+ *
+ * Embedded panel for the BSR dashboard that allows admins to manage
+ * competitor ASIN mappings in bsr_competitor_map.
+ *
+ * Features:
+ *  - Lists current competitors per managed ASIN with delete button
+ *  - "Add competitor" form (single ASIN or paste list for bulk)
+ *  - Optimistic updates via TanStack Query mutation
+ *  - Permission-gated by bsr_dashboard page key
+ */
+
+import { useState } from "react";
+import { useQuery, useMutation, useQueryClient } from "@tanstack/react-query";
+import { getCurrentToken } from "../api/client";
+
+// ---------------------------------------------------------------------------
+// Types
+// ---------------------------------------------------------------------------
+
+interface CompetitorRow {
+  id: number;
+  profile_id: string;
+  our_asin: string;
+  competitor_asin: string;
+  category: string;
+  added_at: string;
+}
+
+interface CompetitorListResponse {
+  rows: CompetitorRow[];
+}
+
+interface BulkCreateResponse {
+  inserted: number;
+  skipped: string[];
+}
+
+// ---------------------------------------------------------------------------
+// API helpers
+// ---------------------------------------------------------------------------
+
+async function fetchCompetitors(
+  ourAsin?: string,
+  profileId?: string
+): Promise<CompetitorListResponse> {
+  const token = await getCurrentToken();
+  const params = new URLSearchParams();
+  if (ourAsin) params.set("our_asin", ourAsin);
+  if (profileId) params.set("profile_id", profileId);
+  const query = params.toString();
+  const url = `/api/bsr/competitors${query ? `?${query}` : ""}`;
+
+  const resp = await fetch(url, {
+    headers: {
+      Authorization: `Bearer ${token}`,
+      "Content-Type": "application/json",
+    },
+  });
+  if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
+  return resp.json();
+}
+
+async function addCompetitor(body: {
+  profile_id: string;
+  our_asin: string;
+  competitor_asin: string;
+  category: string;
+}): Promise<CompetitorRow> {
+  const token = await getCurrentToken();
+  const resp = await fetch("/api/bsr/competitors", {
+    method: "POST",
+    headers: {
+      Authorization: `Bearer ${token}`,
+      "Content-Type": "application/json",
+    },
+    body: JSON.stringify(body),
+  });
+  if (!resp.ok) {
+    const errBody = await resp.text().catch(() => "Unknown error");
+    throw new Error(`HTTP ${resp.status}: ${errBody}`);
+  }
+  return resp.json();
+}
+
+async function bulkAddCompetitors(body: {
+  profile_id: string;
+  our_asin: string;
+  competitor_asins: string[];
+  category: string;
+}): Promise<BulkCreateResponse> {
+  const token = await getCurrentToken();
+  const resp = await fetch("/api/bsr/competitors/bulk", {
+    method: "POST",
+    headers: {
+      Authorization: `Bearer ${token}`,
+      "Content-Type": "application/json",
+    },
+    body: JSON.stringify(body),
+  });
+  if (!resp.ok) {
+    const errBody = await resp.text().catch(() => "Unknown error");
+    throw new Error(`HTTP ${resp.status}: ${errBody}`);
+  }
+  return resp.json();
+}
+
+async function deleteCompetitor(id: number): Promise<void> {
+  const token = await getCurrentToken();
+  const resp = await fetch(`/api/bsr/competitors/${id}`, {
+    method: "DELETE",
+    headers: { Authorization: `Bearer ${token}` },
+  });
+  if (!resp.ok && resp.status !== 204) {
+    throw new Error(`HTTP ${resp.status}`);
+  }
+}
+
+// ---------------------------------------------------------------------------
+// ASIN validation (mirrors backend regex)
+// ---------------------------------------------------------------------------
+
+const ASIN_REGEX = /^B0[A-Z0-9]{8}$/;
+
+function isValidAsin(value: string): boolean {
+  return ASIN_REGEX.test(value.trim().toUpperCase());
+}
+
+// ---------------------------------------------------------------------------
+// Component
+// ---------------------------------------------------------------------------
+
+interface BsrCompetitorEditorProps {
+  profileId: string;
+  ourAsin?: string;
+}
+
+export default function BsrCompetitorEditor({
+  profileId,
+  ourAsin,
+}: BsrCompetitorEditorProps) {
+  const queryClient = useQueryClient();
+
+  // Filter state
+  const [filterAsin, setFilterAsin] = useState(ourAsin ?? "");
+
+  // Add-form state
+  const [newCompetitorAsin, setNewCompetitorAsin] = useState("");
+  const [newCategory, setNewCategory] = useState("");
+  const [newOurAsin, setNewOurAsin] = useState(ourAsin ?? "");
+  const [bulkMode, setBulkMode] = useState(false);
+  const [bulkText, setBulkText] = useState("");
+  const [formError, setFormError] = useState<string | null>(null);
+
+  // Fetch competitors
+  const { data, isLoading, error } = useQuery({
+    queryKey: ["bsr-competitors", filterAsin, profileId],
+    queryFn: () => fetchCompetitors(filterAsin || undefined, profileId),
+    refetchInterval: 30_000,
+  });
+
+  // Mutations
+  const addMutation = useMutation({
+    mutationFn: addCompetitor,
+    onSuccess: () => {
+      queryClient.invalidateQueries({ queryKey: ["bsr-competitors"] });
+      setNewCompetitorAsin("");
+      setFormError(null);
+    },
+    onError: (err: Error) => setFormError(err.message),
+  });
+
+  const bulkMutation = useMutation({
+    mutationFn: bulkAddCompetitors,
+    onSuccess: (result) => {
+      queryClient.invalidateQueries({ queryKey: ["bsr-competitors"] });
+      setBulkText("");
+      setFormError(
+        result.skipped.length > 0
+          ? `Inserted ${result.inserted}, skipped ${result.skipped.length} duplicates`
+          : null
+      );
+    },
+    onError: (err: Error) => setFormError(err.message),
+  });
+
+  const deleteMutation = useMutation({
+    mutationFn: deleteCompetitor,
+    onSuccess: () => {
+      queryClient.invalidateQueries({ queryKey: ["bsr-competitors"] });
+    },
+  });
+
+  // Handlers
+  function handleAddSingle(e: React.FormEvent) {
+    e.preventDefault();
+    setFormError(null);
+    const competitor_asin = newCompetitorAsin.trim().toUpperCase();
+    if (!isValidAsin(competitor_asin)) {
+      setFormError("Invalid competitor_asin — must match B0XXXXXXXX (10 chars)");
+      return;
+    }
+    if (!isValidAsin(newOurAsin.trim().toUpperCase())) {
+      setFormError("Invalid our_asin — must match B0XXXXXXXX (10 chars)");
+      return;
+    }
+    addMutation.mutate({
+      profile_id: profileId,
+      our_asin: newOurAsin.trim().toUpperCase(),
+      competitor_asin,
+      category: newCategory.trim(),
+    });
+  }
+
+  function handleBulkAdd(e: React.FormEvent) {
+    e.preventDefault();
+    setFormError(null);
+    const asins = bulkText
+      .split(/[\n,]+/)
+      .map((s) => s.trim().toUpperCase())
+      .filter(Boolean);
+    const invalid = asins.filter((a) => !isValidAsin(a));
+    if (invalid.length > 0) {
+      setFormError(`Invalid ASINs: ${invalid.join(", ")}`);
+      return;
+    }
+    if (asins.length === 0) {
+      setFormError("Paste at least one ASIN");
+      return;
+    }
+    if (!isValidAsin(newOurAsin.trim().toUpperCase())) {
+      setFormError("Invalid our_asin — must match B0XXXXXXXX (10 chars)");
+      return;
+    }
+    bulkMutation.mutate({
+      profile_id: profileId,
+      our_asin: newOurAsin.trim().toUpperCase(),
+      competitor_asins: asins,
+      category: newCategory.trim(),
+    });
+  }
+
+  const rows = data?.rows ?? [];
+  const isPending =
+    addMutation.isPending || bulkMutation.isPending || deleteMutation.isPending;
+
+  return (
+    <div className="bg-white rounded-lg shadow p-4 space-y-4">
+      <h2 className="text-sm font-semibold text-gray-700 uppercase tracking-wide">
+        Competitor Set Editor
+      </h2>
+
+      {/* Filter */}
+      <div className="flex gap-2 items-end">
+        <label className="text-xs text-gray-500">
+          Filter by Our ASIN
+          <input
+            type="text"
+            value={filterAsin}
+            onChange={(e) => setFilterAsin(e.target.value.toUpperCase())}
+            placeholder="B0XXXXXXXX"
+            className="block mt-1 px-2 py-1 border rounded text-sm w-40"
+          />
+        </label>
+      </div>
+
+      {/* Table */}
+      {isLoading && <p className="text-sm text-gray-400">Loading…</p>}
+      {error && (
+        <p className="text-sm text-red-600">
+          Failed to load competitors: {(error as Error).message}
+        </p>
+      )}
+      {!isLoading && rows.length === 0 && (
+        <p className="text-sm text-gray-500">No competitors found.</p>
+      )}
+      {rows.length > 0 && (
+        <table className="w-full text-sm">
+          <thead>
+            <tr className="text-left text-gray-500 text-xs uppercase border-b">
+              <th className="py-1">Our ASIN</th>
+              <th className="py-1">Competitor ASIN</th>
+              <th className="py-1">Category</th>
+              <th className="py-1">Added</th>
+              <th className="py-1" />
+            </tr>
+          </thead>
+          <tbody>
+            {rows.map((row) => (
+              <tr key={row.id} className="border-b last:border-0">
+                <td className="py-1 font-mono text-xs">{row.our_asin}</td>
+                <td className="py-1 font-mono text-xs">{row.competitor_asin}</td>
+                <td className="py-1">{row.category}</td>
+                <td className="py-1 text-xs text-gray-400">
+                  {row.added_at ? new Date(row.added_at).toLocaleDateString() : "—"}
+                </td>
+                <td className="py-1">
+                  <button
+                    onClick={() => deleteMutation.mutate(row.id)}
+                    disabled={isPending}
+                    className="text-red-600 hover:text-red-800 text-xs disabled:opacity-50"
+                  >
+                    Delete
+                  </button>
+                </td>
+              </tr>
+            ))}
+          </tbody>
+        </table>
+      )}
+
+      {/* Add form */}
+      <div className="border-t pt-3">
+        <div className="flex items-center gap-3 mb-2">
+          <span className="text-xs font-medium text-gray-600">Add Competitor</span>
+          <button
+            onClick={() => setBulkMode(!bulkMode)}
+            className="text-xs text-blue-600 hover:underline"
+          >
+            {bulkMode ? "Single mode" : "Bulk mode (paste list)"}
+          </button>
+        </div>
+
+        <form
+          onSubmit={bulkMode ? handleBulkAdd : handleAddSingle}
+          className="space-y-2"
+        >
+          <div className="flex gap-2 flex-wrap">
+            <input
+              type="text"
+              value={newOurAsin}
+              onChange={(e) => setNewOurAsin(e.target.value.toUpperCase())}
+              placeholder="Our ASIN (B0…)"
+              className="px-2 py-1 border rounded text-sm w-36"
+            />
+            <input
+              type="text"
+              value={newCategory}
+              onChange={(e) => setNewCategory(e.target.value)}
+              placeholder="Category"
+              className="px-2 py-1 border rounded text-sm w-40"
+            />
+          </div>
+
+          {bulkMode ? (
+            <textarea
+              value={bulkText}
+              onChange={(e) => setBulkText(e.target.value)}
+              placeholder="Paste competitor ASINs (one per line or comma-separated)"
+              rows={4}
+              className="w-full px-2 py-1 border rounded text-sm font-mono"
+            />
+          ) : (
+            <input
+              type="text"
+              value={newCompetitorAsin}
+              onChange={(e) => setNewCompetitorAsin(e.target.value.toUpperCase())}
+              placeholder="Competitor ASIN (B0…)"
+              className="px-2 py-1 border rounded text-sm w-40"
+            />
+          )}
+
+          {formError && (
+            <p className="text-xs text-red-600">{formError}</p>
+          )}
+
+          <button
+            type="submit"
+            disabled={isPending}
+            className="px-3 py-1 bg-blue-600 text-white rounded text-sm hover:bg-blue-700 disabled:opacity-50"
+          >
+            {isPending ? "Saving…" : bulkMode ? "Add All" : "Add"}
+          </button>
+        </form>
+      </div>
+    </div>
+  );
+}
