+"""Tests for Target API credential loading (Gate: single enforcement point).
+
+Feature-spec § 5.2: get_target_credentials() is the single enforcement point.
+All production calls route through it. Never commits credentials to code.
+"""
+import os
+import pytest
+
+from app.core.auth import get_target_credentials, CredentialError, TargetCredentials
+
+
+class TestCredentialSource:
+    """Credential is loaded from the correct env var per environment."""
+
+    def test_staging_reads_target_api_key_env_var(self, monkeypatch):
+        """Staging env reads TARGET_API_KEY (not TARGET_PROD_API_KEY).
+
+        Gate: separates staging and production keys — prevents accidental prod usage.
+        """
+        # Arrange
+        monkeypatch.setenv("TARGET_API_KEY", "staging-key-abcde12345")
+        monkeypatch.delenv("TARGET_PROD_API_KEY", raising=False)
+
+        # Act
+        creds = get_target_credentials(environment="staging")
+
+        # Assert
+        assert creds.api_key == "staging-key-abcde12345", (
+            "Staging credentials must come from TARGET_API_KEY env var"
+        )
+        assert creds.environment == "staging"
+
+    def test_production_reads_target_prod_api_key_env_var(self, monkeypatch):
+        """Production env reads TARGET_PROD_API_KEY (not TARGET_API_KEY).
+
+        Gate: production key has its own env var to prevent staging key being used in prod.
+        """
+        monkeypatch.setenv("TARGET_PROD_API_KEY", "prod-key-xyz99999")
+        monkeypatch.delenv("TARGET_API_KEY", raising=False)
+
+        creds = get_target_credentials(environment="production")
+
+        assert creds.api_key == "prod-key-xyz99999", (
+            "Production credentials must come from TARGET_PROD_API_KEY env var"
+        )
+        assert creds.environment == "production"
+
+    def test_missing_api_key_raises_credential_error(self, monkeypatch):
+        """Missing env var raises CredentialError — refuse to start with no credentials.
+
+        Feature-spec § 3.3: 'Fail-closed: refuse to start poll. Log missing-credential error.'
+        """
+        monkeypatch.delenv("TARGET_API_KEY", raising=False)
+        monkeypatch.delenv("TARGET_PROD_API_KEY", raising=False)
+
+        with pytest.raises(CredentialError):
+            get_target_credentials(environment="staging")
+
+    def test_empty_api_key_raises_credential_error(self, monkeypatch):
+        """Empty string env var raises CredentialError — empty is not a valid key."""
+        monkeypatch.setenv("TARGET_API_KEY", "")
+
+        with pytest.raises(CredentialError):
+            get_target_credentials(environment="staging")
+
+    def test_credentials_never_fall_back_to_hardcoded_value(self, monkeypatch):
+        """When env var is missing, no hardcoded fallback value is used.
+
+        Security: hardcoded keys would be committed to source control.
+        """
+        monkeypatch.delenv("TARGET_API_KEY", raising=False)
+
+        # Must raise, not return a default/fallback key
+        with pytest.raises(CredentialError):
+            get_target_credentials(environment="staging")
+
+    def test_credentials_returns_target_credentials_dataclass(self, monkeypatch):
+        """Return type is TargetCredentials dataclass (not a raw dict or string)."""
+        monkeypatch.setenv("TARGET_API_KEY", "valid-key-12345")
+
+        result = get_target_credentials(environment="staging")
+
+        assert isinstance(result, TargetCredentials), (
+            f"Expected TargetCredentials, got {type(result)}"
+        )
+        assert result.api_key == "valid-key-12345"
+
+    def test_seller_id_loaded_from_env(self, monkeypatch):
+        """seller_id is also loaded from env (SELLER_ID) — not hardcoded."""
+        monkeypatch.setenv("TARGET_API_KEY", "key-abc123")
+        monkeypatch.setenv("SELLER_ID", "MY_SELLER_001")
+
+        creds = get_target_credentials(environment="staging")
+
+        assert creds.seller_id == "MY_SELLER_001"
