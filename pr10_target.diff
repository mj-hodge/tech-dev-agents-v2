+"""Tests for Payout and PollState SQLAlchemy model definitions.
+
+These tests verify the schema contract is correctly declared.
+They PASS in RED state because the models are fully implemented.
+Phase 8 must not change model definitions without updating these tests.
+"""
+import pytest
+from decimal import Decimal
+from datetime import datetime, timezone
+from sqlalchemy import inspect, select
+from sqlalchemy.ext.asyncio import create_async_engine, async_sessionmaker
+
+from app.finance.models import Base, Payout, PollState
+
+
+class TestPayoutModelColumns:
+    """Verify all 14 columns declared in feature-spec § 4.1 are present."""
+
+    def test_payout_model_has_id_column(self):
+        cols = {c.name for c in Payout.__table__.columns}
+        assert "id" in cols
+
+    def test_payout_model_has_arrival_date_column(self):
+        cols = {c.name for c in Payout.__table__.columns}
+        assert "arrival_date" in cols
+
+    def test_payout_model_has_created_date_column(self):
+        cols = {c.name for c in Payout.__table__.columns}
+        assert "created_date" in cols
+
+    def test_payout_model_has_payout_amount_column(self):
+        cols = {c.name for c in Payout.__table__.columns}
+        assert "payout_amount" in cols
+
+    def test_payout_model_has_currency_column(self):
+        cols = {c.name for c in Payout.__table__.columns}
+        assert "currency" in cols
+
+    def test_payout_model_has_balance_transaction_column(self):
+        cols = {c.name for c in Payout.__table__.columns}
+        assert "balance_transaction" in cols
