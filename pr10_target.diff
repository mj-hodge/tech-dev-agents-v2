+"""Tests for unknown payout status handling.
+
+Feature-spec § 3.2 step 5: Unknown status values are preserved and flagged
+via status_known=False. Ingest continues without error.
+"""
+import pytest
+from sqlalchemy import select
+
+from app.finance.models import Payout
+from app.finance.poll import ingest_once, KNOWN_STATUSES
+from tests.finance.conftest import SAMPLE_PAYOUT, SAMPLE_PAYOUT_2, SAMPLE_PAYOUT_UNKNOWN_STATUS
+
+
+class TestKnownStatusSet:
+    """Verify the KNOWN_STATUSES constant matches the spec."""
+
+    def test_known_statuses_contains_paid(self):
+        """'paid' is the only documented Target payout status."""
+        assert "paid" in KNOWN_STATUSES
+
+    def test_known_statuses_is_a_set(self):
+        assert isinstance(KNOWN_STATUSES, (set, frozenset))
+
+
+class TestStatusFlagging:
+    """status_known column behavior for known and unknown statuses."""
+
+    async def test_paid_status_sets_status_known_true(
+        self, mock_finance_client, async_session
+    ):
+        """Payout with status='paid' gets status_known=True."""
+        # Arrange
+        mock_finance_client.response = [SAMPLE_PAYOUT]  # status = "paid"
+
+        # Act
+        await ingest_once()
+
+        # Assert
+        row = (await async_session.execute(select(Payout))).scalar_one()
+        assert row.status_known is True, (
+            f"status='paid' should set status_known=True, got {row.status_known}"
+        )
+
+    async def test_pending_status_sets_status_known_false(
+        self, mock_finance_client, async_session
+    ):
+        """Payout with status='pending' (undocumented) gets status_known=False."""
+        # Arrange
+        mock_finance_client.response = [SAMPLE_PAYOUT_UNKNOWN_STATUS]  # status = "pending"
+
+        # Act
+        await ingest_once()
+
+        # Assert
+        row = (await async_session.execute(select(Payout))).scalar_one()
+        assert row.status_known is False, (
+            f"status='pending' should set status_known=False, got {row.status_known}"
+        )
+
+    async def test_unknown_status_raw_value_is_preserved(
+        self, mock_finance_client, async_session
+    ):
+        """Unknown status is stored verbatim in the status column — not coerced."""
+        mock_finance_client.response = [SAMPLE_PAYOUT_UNKNOWN_STATUS]
+        await ingest_once()
+        row = (await async_session.execute(select(Payout))).scalar_one()
+        assert row.status == "pending", (
+            "Raw status value must be stored as-is; spec says free-text not enum"
+        )
+
+    async def test_unknown_status_record_is_still_persisted(
+        self, mock_finance_client, async_session
+    ):
+        """Record with unknown status is persisted — ingest continues.
+
+        Rationale: financial data is still valuable even with novel status values.
+        """
+        mock_finance_client.response = [SAMPLE_PAYOUT_UNKNOWN_STATUS]
+        await ingest_once()
+        rows = (await async_session.execute(select(Payout))).scalars().all()
+        assert len(rows) == 1, (
+            "Unknown status must NOT cause record to be dropped — persist and flag"
+        )
+
+
+class TestUnknownStatusCounting:
+    """IngestResult reports count of unknown-status records for observability."""
+
+    async def test_ingest_result_counts_unknown_statuses(
+        self, mock_finance_client
+    ):
+        """unknown_statuses in IngestResult equals number of records with status_known=False."""
+        mock_finance_client.response = [SAMPLE_PAYOUT, SAMPLE_PAYOUT_UNKNOWN_STATUS]
+        result = await ingest_once()
+        # 1 paid (known) + 1 pending (unknown) → unknown_statuses = 1
+        assert result["unknown_statuses"] == 1, (
+            f"Expected 1 unknown status, got {result['unknown_statuses']}"
+        )
+
+    async def test_ingest_result_counts_zero_when_all_statuses_known(
+        self, mock_finance_client
+    ):
+        mock_finance_client.response = [SAMPLE_PAYOUT, SAMPLE_PAYOUT_2]  # both "paid"
+        result = await ingest_once()
+        assert result["unknown_statuses"] == 0
