+"""CLI entry point for Target Finance/Settlement ingest.
+
+Usage:
+    python -m app.finance.cli ingest-once --env staging
+    python -m app.finance.cli ingest-once --env production --dry-run
+
+Environment variables:
+    TARGET_API_KEY      Staging API key
+    TARGET_PROD_API_KEY Production API key
+    SELLER_ID           Target seller identifier
+    DATABASE_URL        PostgreSQL connection URL
+"""
+import asyncio
+import argparse
+import logging
+import sys
+
+logging.basicConfig(
+    level=logging.INFO,
+    format="%(asctime)s %(levelname)s %(name)s %(message)s",
+)
+logger = logging.getLogger(__name__)
+
+
+def _build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(
+        prog="app.finance.cli",
+        description="Target Finance/Settlement ingest CLI",
+    )
+    sub = parser.add_subparsers(dest="command", required=True)
+
+    ingest_cmd = sub.add_parser("ingest-once", help="Run one poll → upsert cycle")
+    ingest_cmd.add_argument(
+        "--env",
+        choices=["staging", "production"],
+        default="staging",
+        help="Target environment (selects credential source)",
+    )
+    ingest_cmd.add_argument(
+        "--dry-run",
+        action="store_true",
+        help="Fetch and validate payouts but do not persist to DB",
+    )
+    return parser
+
+
+async def _run_ingest(env: str, dry_run: bool) -> int:
+    """Set up DI and run ingest_once. Returns exit code."""
+    from app.core.auth import get_target_credentials, CredentialError
+    from app.finance.client import TargetFinanceClient
+    import app.finance.poll as poll_mod
+
+    # Credential validation — fail-closed
+    try:
+        creds = get_target_credentials(environment=env)
+    except CredentialError as exc:
+        logger.error("finance.cli.credential_error: %s", exc)
+        return 1
+
+    base_url = (
+        "https://api.target.com"
+        if env == "production"
+        else "https://stage-api.target.com"
+    )
+
+    client = TargetFinanceClient(
+        base_url=base_url,
+        api_key=creds.api_key,
+        seller_id=creds.seller_id,
+    )
+
+    if dry_run:
+        logger.info("finance.cli.dry_run: fetching payouts (no DB writes)")
+        payouts = await client.fetch_payouts()
+        logger.info("finance.cli.dry_run.result: fetched %d payouts", len(payouts))
+        return 0
+
+    # Wire up DB engine
+    import os
+    from sqlalchemy.ext.asyncio import create_async_engine
+
+    db_url = os.environ.get("DATABASE_URL", "")
+    if not db_url:
+        logger.error("finance.cli.missing_db_url: DATABASE_URL env var is required")
+        return 1
+
+    engine = create_async_engine(db_url)
+    poll_mod._engine = engine
+    poll_mod._client = client
+
+    result = await poll_mod.ingest_once()
+    logger.info("finance.cli.result: %s", result)
+    await engine.dispose()
+
+    return 0 if result["poll_status"] in ("success", "empty") else 1
+
+
+def main() -> None:
+    parser = _build_parser()
+    args = parser.parse_args()
+
+    if args.command == "ingest-once":
+        exit_code = asyncio.run(_run_ingest(env=args.env, dry_run=args.dry_run))
+        sys.exit(exit_code)
+
+
+if __name__ == "__main__":
+    main()
