+"""Tests for payout deduplication behavior.
+
+Feature-spec § 3.2 step 4: Upsert on natural key Payout.id (Stripe po_*).
+ON CONFLICT DO UPDATE — idempotent re-delivery handling.
+"""
+import pytest
+from datetime import datetime, timezone
+from decimal import Decimal
+from sqlalchemy import select, func
+
+from app.finance.models import Payout
+from app.finance.poll import ingest_once
+from tests.finance.conftest import SAMPLE_PAYOUT, SAMPLE_PAYOUT_2
+
+
+class TestDedupConstraint:
+    """Upsert semantics: same id → update, different id → new row."""
+
+    async def test_same_payout_id_upserted_twice_yields_one_row(
+        self, mock_finance_client, async_session
+    ):
+        """Ingesting the same payout twice produces exactly one row in the DB.
+
+        Why this matters: Target may re-deliver payouts. Dedup prevents double-counting.
+        """
+        # Arrange: same payout delivered on first and second poll
+        mock_finance_client.response = [SAMPLE_PAYOUT]
+        await ingest_once()
+
+        mock_finance_client.response = [SAMPLE_PAYOUT]
+        await ingest_once()
+
+        # Assert: still exactly one row
+        count = (await async_session.execute(select(func.count()).select_from(Payout))).scalar()
+        assert count == 1, (
+            f"Same payout ingested twice must yield 1 row, got {count}"
+        )
+
+    async def test_different_payout_ids_yield_two_separate_rows(
+        self, mock_finance_client, async_session
+    ):
+        """Two payouts with different IDs are stored as two distinct rows.
+
+        Output-variance gate: proves ingest distinguishes inputs by ID.
+        """
+        # Arrange: two payouts with different IDs
+        mock_finance_client.response = [SAMPLE_PAYOUT, SAMPLE_PAYOUT_2]
+        await ingest_once()
+
+        count = (await async_session.execute(select(func.count()).select_from(Payout))).scalar()
+        assert count == 2, f"Two distinct payout IDs must produce 2 rows, got {count}"
+
+    async def test_updated_at_advances_on_second_upsert(
+        self, mock_finance_client, async_session
+    ):
+        """updated_at timestamp advances when a payout is re-ingested."""
+        import asyncio
+
+        # First ingest
+        mock_finance_client.response = [SAMPLE_PAYOUT]
+        await ingest_once()
+        row_1 = (await async_session.execute(select(Payout))).scalar_one()
+        ts_1 = row_1.updated_at
+
+        # Small delay so timestamps differ
+        await asyncio.sleep(0.01)
+
+        # Second ingest with same payout
+        mock_finance_client.response = [SAMPLE_PAYOUT]
+        await ingest_once()
+        await async_session.refresh(row_1)
+        ts_2 = row_1.updated_at
+
+        assert ts_2 > ts_1, (
+            "updated_at must advance on re-ingest; ON CONFLICT DO UPDATE must set updated_at=now()"
+        )
+
+    async def test_status_updated_on_second_upsert(
+        self, mock_finance_client, async_session
+    ):
+        """If payout status changes between polls, the new status is stored."""
+        # First ingest: paid
+        mock_finance_client.response = [SAMPLE_PAYOUT]
+        await ingest_once()
+
+        # Second ingest: same ID, different status (e.g., Target corrects payout)
+        updated_payout = {**SAMPLE_PAYOUT, "status": "failed"}
+        mock_finance_client.response = [updated_payout]
+        await ingest_once()
+
+        row = (await async_session.execute(select(Payout))).scalar_one()
+        assert row.status == "failed", (
+            "ON CONFLICT DO UPDATE must overwrite status with latest value"
+        )
+
+
+class TestDbConstraintAlignment:
+    """Gate 3: NOT NULL constraints are satisfied for every creation path."""
+
+    async def test_all_not_null_columns_populated_on_insert(
+        self, mock_finance_client, async_session
+    ):
+        """Every NOT NULL column in the payouts table has a value after ingest.
+
+        Gate 3: proves ingest never leaves NOT NULL columns empty.
+        """
+        mock_finance_client.response = [SAMPLE_PAYOUT]
+        await ingest_once()
+
+        row = (await async_session.execute(select(Payout))).scalar_one()
+
+        # Check every NOT NULL column
+        assert row.id is not None
+        assert row.arrival_date is not None
+        assert row.created_date is not None
+        assert row.payout_amount is not None
+        assert row.currency is not None
+        assert row.status is not None
+        assert row.status_known is not None
+        assert row.seller_id is not None
+        assert row.ingested_at is not None
+        assert row.updated_at is not None
