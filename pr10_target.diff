+"""Tests for cross-reference query functionality.
+
+Feature-spec § 4.2: B-tree indexes on balance_transaction, destination_account,
+created_date, and seller_id support cross-channel finance reconciliation.
+"""
+import pytest
+from datetime import datetime, timezone
+from decimal import Decimal
+from sqlalchemy import select
+
+from app.finance.models import Payout, PollState
+from app.finance.poll import ingest_once
+from tests.finance.conftest import SAMPLE_PAYOUT, SAMPLE_PAYOUT_2
+
+
+def _make_payout(**overrides) -> Payout:
+    """Helper: construct a Payout ORM object with sane defaults."""
+    now = datetime.now(timezone.utc)
+    defaults = dict(
+        id="po_xref_default_001",
+        arrival_date=now,
+        created_date=now,
+        payout_amount=Decimal("100.00"),
+        currency="USD",
+        status="paid",
+        status_known=True,
+        seller_id="SELLER_TEST_001",
+        ingested_at=now,
+        updated_at=now,
+    )
+    defaults.update(overrides)
+    return Payout(**defaults)
+
+
+class TestIndexDefinitions:
+    """Structural: indexes declared in models → PASS in RED state."""
+
+    def test_balance_transaction_index_on_table(self):
+        index_names = {idx.name for idx in Payout.__table__.indexes}
+        assert "ix_payouts_balance_transaction" in index_names
+
+    def test_destination_account_index_on_table(self):
+        index_names = {idx.name for idx in Payout.__table__.indexes}
+        assert "ix_payouts_destination_account" in index_names
+
+    def test_created_date_index_on_table(self):
+        index_names = {idx.name for idx in Payout.__table__.indexes}
+        assert "ix_payouts_created_date" in index_names
+
+    def test_seller_id_index_on_table(self):
+        index_names = {idx.name for idx in Payout.__table__.indexes}
+        assert "ix_payouts_seller_id" in index_names
+
+
+class TestCrossReferenceQueries:
+    """Query tests using the real ORM and in-memory SQLite."""
+
+    async def test_find_payout_by_balance_transaction(self, async_session):
+        """Can look up a payout by its Stripe balance_transaction ID (txn_*)."""
+        payout = _make_payout(
+            id="po_xref_txn_001",
+            balance_transaction="txn_findme12345",
+        )
+        async_session.add(payout)
+        await async_session.commit()
+
+        result = await async_session.execute(
+            select(Payout).where(Payout.balance_transaction == "txn_findme12345")
+        )
+        row = result.scalar_one_or_none()
+        assert row is not None
+        assert row.id == "po_xref_txn_001"
+
+    async def test_find_payout_by_destination_account(self, async_session):
+        """Can look up a payout by its Stripe destination account (card_*)."""
+        payout = _make_payout(
+            id="po_xref_card_001",
+            destination_account="card_findme99999",
+        )
+        async_session.add(payout)
+        await async_session.commit()
+
+        result = await async_session.execute(
+            select(Payout).where(Payout.destination_account == "card_findme99999")
+        )
+        row = result.scalar_one_or_none()
+        assert row is not None
+
+    async def test_find_payouts_by_created_date_range(self, async_session):
+        """Time-range query returns only payouts within the window."""
+        from datetime import timedelta
+        now = datetime.now(timezone.utc)
+        yesterday = now - timedelta(days=1)
+        two_days_ago = now - timedelta(days=2)
+
+        # Payout within range (yesterday)
+        in_range = _make_payout(id="po_in_range", created_date=yesterday)
+        # Payout outside range (2 days ago, before our window)
+        out_of_range = _make_payout(id="po_out_range", created_date=two_days_ago)
+
+        async_session.add_all([in_range, out_of_range])
+        await async_session.commit()
+
+        # Query: only payouts created in the last 36 hours
+        cutoff = now - timedelta(hours=36)
+        result = await async_session.execute(
+            select(Payout).where(Payout.created_date >= cutoff)
+        )
+        rows = result.scalars().all()
+        ids = {r.id for r in rows}
+        assert "po_in_range" in ids
+        assert "po_out_range" not in ids
+
+    async def test_find_payouts_by_seller_id(self, async_session):
+        """Can filter payouts by seller_id for multi-seller support."""
+        p1 = _make_payout(id="po_seller_a_001", seller_id="SELLER_A")
+        p2 = _make_payout(id="po_seller_b_001", seller_id="SELLER_B")
+        async_session.add_all([p1, p2])
+        await async_session.commit()
+
+        result = await async_session.execute(
+            select(Payout).where(Payout.seller_id == "SELLER_A")
+        )
+        rows = result.scalars().all()
+        assert len(rows) == 1
+        assert rows[0].id == "po_seller_a_001"
