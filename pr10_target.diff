+"""Single enforcement point for Target API credentials.
+
+All Target API integrations must route through get_target_credentials().
+No module should read TARGET_API_KEY or TARGET_PROD_API_KEY directly.
+"""
+import os
+import logging
+from dataclasses import dataclass
+
+logger = logging.getLogger(__name__)
+
+
+class CredentialError(Exception):
+    """Raised when Target API credentials are missing or invalid."""
+
+
+@dataclass
+class TargetCredentials:
+    api_key: str
+    seller_id: str
+    environment: str  # "staging" or "production"
+
+
+def get_target_credentials(environment: str = "staging") -> TargetCredentials:
+    """Return Target API credentials for the given environment.
+
+    Reads credentials from environment variables — never hardcoded.
+
+    Staging:    TARGET_API_KEY
+    Production: TARGET_PROD_API_KEY
+
+    Also reads SELLER_ID env var.
+
+    Raises:
+        CredentialError: If the required env var is missing or empty.
+    """
+    if environment == "production":
+        env_var = "TARGET_PROD_API_KEY"
+    else:
+        env_var = "TARGET_API_KEY"
+
+    api_key = os.environ.get(env_var, "")
+    if not api_key:
+        logger.error(
+            "finance.credential.missing",
+            extra={
+                "event": "finance.credential.missing",
+                "env_var_name": env_var,
+                "environment": environment,
+            },
+        )
+        raise CredentialError(
+            f"Missing or empty credential: {env_var!r} env var is required "
+            f"for {environment!r} environment. "
+            "Set the env var before starting the poll."
+        )
+
+    seller_id = os.environ.get("SELLER_ID", "")
+
+    return TargetCredentials(api_key=api_key, seller_id=seller_id, environment=environment)
