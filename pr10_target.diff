@@ -0,0 +1,219 @@
+"""Gate 2a: Zero outbound HTTP to Target production API during tests.
+Gate 2b: Graceful degradation on API error responses.
+Gate 9: API failure does not corrupt existing payout data.
+
+Feature-spec § 9: 'No production calls in tests — respx mock + explicit assertion:
+zero outbound HTTP to api.target.com or stage-api.target.com (except through mock).'
+"""
+import pytest
+import httpx
+import respx
+from decimal import Decimal
+from datetime import datetime, timezone
+from sqlalchemy import select
+
+from app.finance.models import Payout
+from app.finance.client import TargetFinanceClient, TargetAPIError
+from app.finance.poll import ingest_once
+from tests.finance.conftest import SAMPLE_PAYOUT
+
+
+# ---------------------------------------------------------------------------
+# Gate 2a: API Isolation
+# ---------------------------------------------------------------------------
+
+class TestNoProductionCalls:
+    """Zero outbound HTTP to Target production API domains during test runs."""
+
+    async def test_no_outbound_calls_to_target_api_domain(self, mock_finance_client):
+        """ingest_once() must not call api.target.com — all HTTP must go through mocks.
+
+        Gate 2a: Motivated by 2026-03-26 incident where a write escaped to production.
+        """
+        mock_finance_client.response = [SAMPLE_PAYOUT]
+
+        with respx.mock(assert_all_mocked=True) as mock:
+            # No routes registered → any real outbound call raises AssertionError
+            await ingest_once()
+
+        # If we reach here without AssertionError, no unregistered HTTP calls were made
+
+    async def test_no_outbound_calls_to_stage_target_api_domain(self, mock_finance_client):
+        """ingest_once() must not call stage-api.target.com either."""
+        mock_finance_client.response = []
+
+        with respx.mock(assert_all_mocked=True):
+            await ingest_once()
+
+    async def test_target_finance_client_uses_injected_http_client(self):
+        """TargetFinanceClient accepts an injected http_client for DI isolation.
+
+        Tests must be able to inject a mock; real prod code injects httpx.AsyncClient().
+        """
+        injected = httpx.AsyncClient()
+        client = TargetFinanceClient(
+            base_url="https://stage-api.target.com",
+            api_key="key",
+            seller_id="SELLER_001",
+            http_client=injected,
+        )
+        assert client.http_client is injected
+
+
+# ---------------------------------------------------------------------------
+# Gate 2b: API Degradation
+# ---------------------------------------------------------------------------
+
+class TestTargetApiDegradation:
+    """TargetFinanceClient handles unexpected/error responses gracefully."""
+
+    async def test_client_raises_target_api_error_on_4xx(self):
+        """HTTP 4xx from Target API raises TargetAPIError with status_code set.
+
+        Gate 2b: 4xx must not be silently ignored or cause an unhandled exception.
+        """
+        with respx.mock:
+            respx.get(
+                "https://stage-api.target.com/sellers/v1/sellers/SELLER_001/payouts_search"
+            ).mock(return_value=httpx.Response(401, json={"error": "Unauthorized"}))
+
+            async with httpx.AsyncClient() as http:
+                client = TargetFinanceClient(
+                    base_url="https://stage-api.target.com",
+                    api_key="bad-key",
+                    seller_id="SELLER_001",
+                    http_client=http,
+                )
+                with pytest.raises(TargetAPIError) as exc_info:
+                    await client.fetch_payouts()
+
+            assert exc_info.value.status_code == 401
+
+    async def test_client_raises_target_api_error_on_5xx(self):
+        """HTTP 5xx (service unavailable) raises TargetAPIError."""
+        with respx.mock:
+            respx.get(
+                "https://stage-api.target.com/sellers/v1/sellers/SELLER_001/payouts_search"
+            ).mock(return_value=httpx.Response(503, text="Service Unavailable"))
+
+            async with httpx.AsyncClient() as http:
+                client = TargetFinanceClient(
+                    base_url="https://stage-api.target.com",
+                    api_key="key",
+                    seller_id="SELLER_001",
+                    http_client=http,
+                )
+                with pytest.raises(TargetAPIError) as exc_info:
+                    await client.fetch_payouts()
+
+            assert exc_info.value.status_code == 503
+
+    async def test_client_raises_target_api_error_on_timeout(self):
+        """Network timeout raises TargetAPIError, not a bare httpx.TimeoutException."""
+        with respx.mock:
+            respx.get(
+                "https://stage-api.target.com/sellers/v1/sellers/SELLER_001/payouts_search"
+            ).mock(side_effect=httpx.TimeoutException("timeout"))
+
+            async with httpx.AsyncClient() as http:
+                client = TargetFinanceClient(
+                    base_url="https://stage-api.target.com",
+                    api_key="key",
+                    seller_id="SELLER_001",
+                    http_client=http,
+                )
+                with pytest.raises(TargetAPIError) as exc_info:
+                    await client.fetch_payouts()
+
+            # Timeout maps to 504 (Gateway Timeout)
+            assert exc_info.value.status_code == 504
+
+    async def test_client_returns_empty_list_on_empty_response(self):
+        """200 OK with empty JSON array is valid — return []."""
+        with respx.mock:
+            respx.get(
+                "https://stage-api.target.com/sellers/v1/sellers/SELLER_001/payouts_search"
+            ).mock(return_value=httpx.Response(200, json=[]))
+
+            async with httpx.AsyncClient() as http:
+                client = TargetFinanceClient(
+                    base_url="https://stage-api.target.com",
+                    api_key="key",
+                    seller_id="SELLER_001",
+                    http_client=http,
+                )
+                result = await client.fetch_payouts()
+
+        # Empty list is valid (no payouts in window) — PASS in RED state
+        # (stub also returns [], so this test verifies graceful handling of empty response)
+        assert isinstance(result, list)
+
+
+# ---------------------------------------------------------------------------
+# Gate 9: Failure Recovery
+# ---------------------------------------------------------------------------
+
+class TestPollFailureRecovery:
+    """API failure must not corrupt or destroy existing good payout data."""
+
+    async def test_api_failure_does_not_persist_partial_results(
+        self, mock_finance_client, async_session
+    ):
+        """When API raises mid-batch, no partial data is written.
+
+        Gate 9: financial data requires atomicity — partial ingest creates
+        reconciliation discrepancies (feature-spec § 3.3).
+        """
+        # Arrange: first ingest succeeds with 1 payout
+        mock_finance_client.response = [SAMPLE_PAYOUT]
+        await ingest_once()
+
+        initial_count = (
+            await async_session.execute(select(Payout))
+        ).scalars().all()
+        assert len(initial_count) == 1
+
+        # Act: second ingest fails
+        mock_finance_client.raise_on_next_call = TargetAPIError(
+            status_code=503, detail="Service Down", correlation_id="corr-fail"
+        )
+        await ingest_once()
+
+        # Assert: original row preserved, nothing new added
+        rows = (await async_session.execute(select(Payout))).scalars().all()
+        assert len(rows) == 1, (
+            "API failure must not corrupt existing data — fail-closed means preserve old data"
+        )
+
+    async def test_api_failure_does_not_update_poll_state(
+        self, mock_finance_client, async_session
+    ):
+        """When API fails, poll_state is not advanced (prevents missed records on retry).
+
+        This PASSES in RED state: the stub never touches poll_state, so the known_ts
+        row remains unchanged regardless of API outcome. Phase 8 must preserve this
+        guarantee in the real implementation.
+        """
+        from app.finance.models import PollState
+        from app.finance.poll import POLL_KEY
+
+        # Arrange: set known poll_state
+        known_ts = datetime(2026, 4, 20, 12, 0, 0, tzinfo=timezone.utc)
+        state = PollState(poll_key=POLL_KEY, last_poll_timestamp=known_ts, updated_at=known_ts)
+        async_session.add(state)
+        await async_session.commit()
+
+        # Act: ingest fails
+        mock_finance_client.raise_on_next_call = TargetAPIError(
+            status_code=503, detail="Service Down", correlation_id="corr-state"
+        )
+        await ingest_once()
+
+        # Assert: poll_state unchanged
+        await async_session.refresh(state)
+        ts = state.last_poll_timestamp
+        if ts.tzinfo is None:
+            ts = ts.replace(tzinfo=timezone.utc)
+        assert ts == known_ts, (
+            "Failed ingest must not advance poll_state — on retry, same window must be re-fetched"
+        )
