+"""Unit tests for TargetFinanceClient.
+
+Tests verify the HTTP contract: URL, path, query params, error mapping.
+Most tests are xfail because the client stub doesn't make real HTTP calls.
+"""
+import pytest
+import httpx
+import respx
+from datetime import datetime, timezone
+
+from app.finance.client import TargetFinanceClient, TargetAPIError
+from app.finance.poll import STRIPE_PAYOUT_ID_REGEX, STRIPE_TXN_ID_REGEX, STRIPE_CARD_ID_REGEX
+
+
+# Shared test constants
+BASE_URL = "https://stage-api.target.com"
+API_KEY = "test-api-key-xxxxx"
+SELLER_ID = "SELLER_TEST_001"
+PAYOUTS_URL = f"{BASE_URL}/sellers/v1/sellers/{SELLER_ID}/payouts_search"
+
+
+def make_client(http_client=None) -> TargetFinanceClient:
+    """Helper: create a TargetFinanceClient with test defaults."""
+    return TargetFinanceClient(
+        base_url=BASE_URL,
+        api_key=API_KEY,
+        seller_id=SELLER_ID,
+        http_client=http_client,
+    )
+
+
+class TestClientInstantiation:
+    """Gate 11: constructor uses only valid fields."""
+
+    def test_client_can_be_instantiated_with_required_args(self):
+        """TargetFinanceClient constructor works with required args."""
+        client = TargetFinanceClient(
+            base_url="https://example.com",
+            api_key="key",
+            seller_id="seller",
+        )
+        assert client.base_url == "https://example.com"
+        assert client.api_key == "key"
+        assert client.seller_id == "seller"
+        assert client.http_client is None
+
+    def test_client_accepts_injected_http_client(self):
+        """http_client DI parameter is stored on the instance."""
+        injected = httpx.AsyncClient()
+        client = make_client(http_client=injected)
+        assert client.http_client is injected
+
+
+class TestFetchPayoutsHttpContract:
+    """Verify HTTP call details: URL, method, params, headers."""
+
+    async def test_fetch_payouts_sends_get_to_correct_url(self):
+        """fetch_payouts() sends GET to /sellers/v1/sellers/{seller_id}/payouts_search."""
+        with respx.mock as mock:
+            route = mock.get(PAYOUTS_URL).mock(return_value=httpx.Response(200, json=[]))
+
+            async with httpx.AsyncClient() as http:
+                client = make_client(http_client=http)
+                await client.fetch_payouts()
+
+            assert route.called, (
+                f"Expected GET {PAYOUTS_URL} but no call was made"
+            )
+
+    async def test_fetch_payouts_sends_created_after_param(self):
+        """created_after is sent as a query parameter when provided."""
+        ts = datetime(2026, 4, 20, 12, 0, 0, tzinfo=timezone.utc)
+
+        with respx.mock as mock:
+            route = mock.get(PAYOUTS_URL).mock(return_value=httpx.Response(200, json=[]))
+
+            async with httpx.AsyncClient() as http:
+                client = make_client(http_client=http)
+                await client.fetch_payouts(created_after=ts)
+
+            assert route.called
+            # Verify the query param was sent
+            request = route.calls[0].request
+            assert "created_after" in request.url.params
+
+    async def test_fetch_payouts_omits_none_params(self):
+        """Gate 1: When created_after=None, the param is omitted (not sent as 'None').
+
+        Sending 'created_after=None' as a string would corrupt the query.
+        """
+        with respx.mock as mock:
+            route = mock.get(PAYOUTS_URL).mock(return_value=httpx.Response(200, json=[]))
+
+            async with httpx.AsyncClient() as http:
+                client = make_client(http_client=http)
+                await client.fetch_payouts(created_after=None, created_before=None)
+
+            assert route.called
+            request = route.calls[0].request
+            assert "created_after" not in request.url.params, (
+                "None params must not be sent as query strings"
+            )
+            assert "created_before" not in request.url.params
+
+    async def test_fetch_payouts_returns_list_of_dicts(self):
+        """fetch_payouts returns raw list of dicts from API response."""
+        payload = [{"id": "po_abc", "status": "paid"}]
+        with respx.mock:
+            respx.get(PAYOUTS_URL).mock(return_value=httpx.Response(200, json=payload))
+
+            async with httpx.AsyncClient() as http:
+                client = make_client(http_client=http)
+                result = await client.fetch_payouts()
+
+        assert result == payload
+
+
+class TestFetchPayoutsErrorHandling:
+    """Gate 2b: client maps HTTP errors and network failures to TargetAPIError."""
+
+    async def test_fetch_payouts_raises_target_api_error_on_401(self):
+        with respx.mock:
+            respx.get(PAYOUTS_URL).mock(return_value=httpx.Response(401, json={"error": "Unauthorized"}))
+            async with httpx.AsyncClient() as http:
+                client = make_client(http_client=http)
+                with pytest.raises(TargetAPIError) as exc_info:
+                    await client.fetch_payouts()
+        assert exc_info.value.status_code == 401
+
+    async def test_fetch_payouts_raises_target_api_error_on_503(self):
+        with respx.mock:
+            respx.get(PAYOUTS_URL).mock(return_value=httpx.Response(503, text="Service Down"))
+            async with httpx.AsyncClient() as http:
+                client = make_client(http_client=http)
+                with pytest.raises(TargetAPIError) as exc_info:
+                    await client.fetch_payouts()
+        assert exc_info.value.status_code == 503
+
+    async def test_fetch_payouts_wraps_timeout_as_target_api_error_504(self):
+        """Network timeout becomes TargetAPIError with status_code=504."""
+        with respx.mock:
+            respx.get(PAYOUTS_URL).mock(side_effect=httpx.TimeoutException("timeout"))
+            async with httpx.AsyncClient() as http:
+                client = make_client(http_client=http)
+                with pytest.raises(TargetAPIError) as exc_info:
+                    await client.fetch_payouts()
+        assert exc_info.value.status_code == 504
+
+    async def test_fetch_payouts_error_includes_correlation_id(self):
+        """TargetAPIError carries a correlation_id for log tracing."""
