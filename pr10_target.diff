+"""Target API HTTP client for GET /sellers/v1/sellers/{seller_id}/payouts_search.
+
+DI pattern: pass http_client in constructor for testing; omit for production
+(a fresh httpx.AsyncClient will be created per-call).
+"""
+import uuid
+import httpx
+from datetime import datetime
+
+
+class TargetAPIError(Exception):
+    """Raised on non-2xx response or network failure from Target API."""
+
+    def __init__(self, status_code: int, detail: str, correlation_id: str = ""):
+        self.status_code = status_code
+        self.detail = detail
+        self.correlation_id = correlation_id
+        super().__init__(f"TargetAPIError {status_code}: {detail}")
+
+
+class TargetFinanceClient:
+    """Read-only client for Target payout data.
+
+    Args:
+        base_url: Target API base URL (staging or production).
+        api_key: x-api-key header value.
+        seller_id: Seller identifier used in URL path.
+        http_client: Optional injected httpx.AsyncClient (for testing).
+                     If None, a new AsyncClient is created per fetch call.
+    """
+
+    def __init__(self, base_url: str, api_key: str, seller_id: str, http_client=None):
+        self.base_url = base_url
+        self.api_key = api_key
+        self.seller_id = seller_id
+        self.http_client = http_client  # DI hook for test injection
+
+    async def fetch_payouts(
+        self,
+        created_after: datetime | None = None,
+        created_before: datetime | None = None,
+    ) -> list[dict]:
+        """GET /sellers/v1/sellers/{seller_id}/payouts_search.
+
+        Returns raw payout dicts from Target API.
+
+        Args:
+            created_after: Only return payouts created at or after this time.
+                           Omitted from request when None (Gate 1).
+            created_before: Only return payouts created at or before this time.
+                            Omitted from request when None (Gate 1).
+
+        Raises:
+            TargetAPIError: On non-2xx response (status_code set) or timeout (504).
+        """
+        correlation_id = str(uuid.uuid4())
+
+        # Build query params — omit None values (Gate 1: no "None" strings in query)
+        params: dict[str, str] = {}
+        if created_after is not None:
+            params["created_after"] = created_after.isoformat()
+        if created_before is not None:
+            params["created_before"] = created_before.isoformat()
+
+        url = f"{self.base_url}/sellers/v1/sellers/{self.seller_id}/payouts_search"
+        headers = {"x-api-key": self.api_key}
+
+        async def _execute(http: httpx.AsyncClient) -> list[dict]:
+            try:
+                response = await http.get(url, params=params, headers=headers)
+                response.raise_for_status()
+                return response.json()
+            except httpx.TimeoutException as exc:
+                raise TargetAPIError(
+                    status_code=504,
+                    detail=f"Request timed out: {exc}",
+                    correlation_id=correlation_id,
+                ) from exc
+            except httpx.HTTPStatusError as exc:
+                raise TargetAPIError(
+                    status_code=exc.response.status_code,
+                    detail=str(exc),
+                    correlation_id=correlation_id,
+                ) from exc
+
+        if self.http_client is not None:
+            return await _execute(self.http_client)
+        else:
+            async with httpx.AsyncClient() as http:
+                return await _execute(http)
