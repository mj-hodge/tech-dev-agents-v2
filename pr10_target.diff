+"""Poll loop for Target Finance/Settlement ingest.
+
+Single poll → normalize → upsert cycle (ingest_once) for daily cron.
+Delegates HTTP to TargetFinanceClient (payouts_search endpoint).
+
+Module-level _client and _engine are patched in tests for DI.
+"""
+import re
+import uuid
+import logging
+from datetime import datetime, timezone, timedelta
+from decimal import Decimal
+
+from sqlalchemy import select
+from sqlalchemy.ext.asyncio import AsyncEngine, async_sessionmaker
+
+from app.finance.models import Payout, PollState
+
+logger = logging.getLogger(__name__)
+
+KNOWN_STATUSES = {"paid"}
+STRIPE_PAYOUT_ID_REGEX = re.compile(r"^po_[a-zA-Z0-9]+$")
+STRIPE_TXN_ID_REGEX = re.compile(r"^txn_[a-zA-Z0-9]+$")
+STRIPE_CARD_ID_REGEX = re.compile(r"^card_[a-zA-Z0-9]+$")
+
+POLL_KEY = "finance_payouts"
+DEFAULT_LOOKBACK_DAYS = 30
+
+_engine: AsyncEngine | None = None
+_client = None  # TargetFinanceClient — patched in tests
+
+
+def _parse_dt(dt_str: str | None) -> datetime | None:
+    """Parse ISO 8601 datetime string (handles trailing Z) to timezone-aware datetime."""
+    if dt_str is None:
+        return None
+    # Python 3.11+ handles Z, but use replace for clarity
+    return datetime.fromisoformat(dt_str.replace("Z", "+00:00"))
+
+
+async def ingest_once() -> dict:
+    """Single poll → normalize → upsert cycle.
+
+    Uses module-level _engine (DB) and _client (Target API).
+    Both are patched in tests for isolation.
+
+    Returns dict with observability fields:
+        poll_status: "success" | "empty" | "error"
+        records_fetched: int
+        records_inserted: int
+        records_updated: int
+        records_skipped: int
+        unknown_statuses: int
+        duration_ms: int
+    """
+    correlation_id = str(uuid.uuid4())
+    start = datetime.now(timezone.utc)
+
+    factory = async_sessionmaker(_engine, expire_on_commit=False)
+
+    async with factory() as session:
+        # ── Step 1: Read high-water mark ────────────────────────────────────
+        state_row = (
+            await session.execute(
+                select(PollState).where(PollState.poll_key == POLL_KEY)
+            )
+        ).scalar_one_or_none()
+
+        if state_row is not None:
+            created_after = state_row.last_poll_timestamp
+            if created_after.tzinfo is None:
+                created_after = created_after.replace(tzinfo=timezone.utc)
+        else:
+            created_after = datetime.now(timezone.utc) - timedelta(days=DEFAULT_LOOKBACK_DAYS)
+
+        # ── Step 2: Fetch payouts from Target API ────────────────────────────
+        logger.info(
+            "finance.ingest.started",
+            extra={
+                "event": "finance.ingest.started",
+                "correlation_id": correlation_id,
+            },
+        )
+
+        try:
+            payouts = await _client.fetch_payouts(created_after=created_after)
+        except Exception as exc:
+            logger.error(
+                "finance.api.error: fetch_payouts failed",
+                extra={
+                    "event": "finance.api.error",
+                    "correlation_id": correlation_id,
+                    "error": str(exc),
+                    "operation": "fetch_payouts",
+                },
+            )
+            return {
+                "poll_status": "error",
+                "records_fetched": 0,
+                "records_inserted": 0,
+                "records_updated": 0,
+                "records_skipped": 0,
+                "unknown_statuses": 0,
+                "duration_ms": int(
+                    (datetime.now(timezone.utc) - start).total_seconds() * 1000
+                ),
+            }
+
+        records_fetched = len(payouts)
+        records_inserted = 0
+        records_updated = 0
+        records_skipped = 0
+        unknown_statuses = 0
+
+        now = datetime.now(timezone.utc)
+
+        # ── Step 3: Empty-batch fast path ────────────────────────────────────
+        if not payouts:
+            if state_row is None:
+                session.add(
+                    PollState(poll_key=POLL_KEY, last_poll_timestamp=now, updated_at=now)
+                )
+            else:
+                state_row.last_poll_timestamp = now
+                state_row.updated_at = now
+
+            await session.commit()
+
+            logger.info(
+                "finance.ingest.completed",
+                extra={
+                    "event": "finance.ingest.completed",
+                    "correlation_id": correlation_id,
+                    "records_fetched": 0,
+                    "records_upserted": 0,
+                    "unknown_statuses": 0,
+                },
+            )
+            return {
+                "poll_status": "empty",
+                "records_fetched": 0,
+                "records_inserted": 0,
+                "records_updated": 0,
+                "records_skipped": 0,
+                "unknown_statuses": 0,
+                "duration_ms": int(
+                    (datetime.now(timezone.utc) - start).total_seconds() * 1000
+                ),
+            }
+
+        # ── Step 4: Upsert each payout ───────────────────────────────────────
+        max_created_date: datetime | None = None
+
+        for payout_data in payouts:
+            payout_id = str(payout_data.get("id", ""))
+
+            # Advisory Stripe ID validation (warn + continue — never reject)
+            if not STRIPE_PAYOUT_ID_REGEX.match(payout_id):
+                logger.warning(
+                    "finance.payout.invalid_id: ID does not match po_* format",
+                    extra={
+                        "event": "finance.payout.invalid_id",
+                        "correlation_id": correlation_id,
+                        "payout_id_suffix": payout_id[-4:] if len(payout_id) >= 4 else payout_id,
+                        "expected_pattern": "^po_[a-zA-Z0-9]+$",
+                    },
+                )
+
+            # Status flag
+            status = str(payout_data.get("status", ""))
+            is_known = status in KNOWN_STATUSES
+            if not is_known:
+                unknown_statuses += 1
+
+            # Parse dates
+            arrival_date = _parse_dt(payout_data.get("arrival_date"))
+            created_date = _parse_dt(payout_data.get("created_date"))
+            payout_amount = Decimal(str(payout_data.get("payout_amount", "0")))
+
+            # Track max created_date for poll-state high-water mark
+            if created_date is not None:
+                if max_created_date is None or created_date > max_created_date:
+                    max_created_date = created_date
+
+            # Upsert: check by PK, then update-or-insert
+            existing = await session.get(Payout, payout_id)
+            if existing is not None:
+                existing.arrival_date = arrival_date
+                existing.created_date = created_date
+                existing.payout_amount = payout_amount
+                existing.currency = str(payout_data.get("currency", "USD"))
+                existing.description = payout_data.get("description")
+                existing.balance_transaction = payout_data.get("balance_transaction")
+                existing.destination_account = payout_data.get("destination_account")
+                existing.status = status
+                existing.status_known = is_known
+                existing.type = payout_data.get("type")
+                existing.seller_id = str(payout_data.get("seller_id", ""))
+                existing.updated_at = now
+                records_updated += 1
+            else:
+                session.add(
+                    Payout(
+                        id=payout_id,
+                        arrival_date=arrival_date,
+                        created_date=created_date,
+                        payout_amount=payout_amount,
+                        currency=str(payout_data.get("currency", "USD")),
+                        description=payout_data.get("description"),
+                        balance_transaction=payout_data.get("balance_transaction"),
+                        destination_account=payout_data.get("destination_account"),
+                        status=status,
+                        status_known=is_known,
+                        type=payout_data.get("type"),
+                        seller_id=str(payout_data.get("seller_id", "")),
+                        ingested_at=now,
+                        updated_at=now,
+                    )
+                )
+                records_inserted += 1
+
+        # ── Step 5: Advance poll-state high-water mark ───────────────────────
+        new_ts = max_created_date if max_created_date is not None else now
+        if state_row is None:
+            session.add(
+                PollState(poll_key=POLL_KEY, last_poll_timestamp=new_ts, updated_at=now)
+            )
+        else:
+            state_row.last_poll_timestamp = new_ts
+            state_row.updated_at = now
+
+        await session.commit()
+
+    # ── Step 6: Return observability result ──────────────────────────────────
+    duration_ms = int((datetime.now(timezone.utc) - start).total_seconds() * 1000)
+
+    logger.info(
+        "finance.ingest.completed",
+        extra={
+            "event": "finance.ingest.completed",
+            "correlation_id": correlation_id,
+            "records_fetched": records_fetched,
+            "records_upserted": records_inserted + records_updated,
+            "unknown_statuses": unknown_statuses,
+        },
+    )
+
+    return {
+        "poll_status": "success",
+        "records_fetched": records_fetched,
+        "records_inserted": records_inserted,
+        "records_updated": records_updated,
+        "records_skipped": records_skipped,
+        "unknown_statuses": unknown_statuses,
+        "duration_ms": duration_ms,
+    }
