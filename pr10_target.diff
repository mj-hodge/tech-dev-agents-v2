+"""Tests for ingest_once() — the core poll → normalize → upsert cycle.
+
+Most tests are marked xfail because ingest_once() is not yet implemented (Phase 8).
+Tests define the contract that Phase 8 must satisfy.
+"""
+import pytest
+from datetime import datetime, timezone, timedelta
+from sqlalchemy import select
+
+from app.finance.models import Payout, PollState
+from app.finance.poll import ingest_once, POLL_KEY
+from tests.finance.conftest import SAMPLE_PAYOUT, SAMPLE_PAYOUT_2
+
+
+class TestFullIngestCycle:
+    """Integration-path tests: real-shaped API data flows through to DB."""
+
+    async def test_ingest_once_persists_payout_from_fixture(
+        self, mock_finance_client, async_session
+    ):
+        """Payout from API fixture is persisted to the payouts table.
+
+        Why this matters: core integration-path test — verifies end-to-end
+        data flow from mock API response to Postgres row.
+        """
+        # Arrange: client will return one payout
+        mock_finance_client.response = [SAMPLE_PAYOUT]
+
+        # Act
+        result = await ingest_once()
+
+        # Assert: payout is in DB with correct field values
+        rows = (await async_session.execute(select(Payout))).scalars().all()
+        assert len(rows) == 1
+        assert rows[0].id == SAMPLE_PAYOUT["id"]
+        assert rows[0].currency == "USD"
+        assert rows[0].status == "paid"
+        assert result["records_inserted"] == 1
+        assert result["records_fetched"] == 1
+
+    async def test_ingest_once_persists_multiple_payouts(
+        self, mock_finance_client, async_session
+    ):
+        """All payouts in the API response are persisted (not just the first)."""
+        # Arrange: client returns two distinct payouts
+        mock_finance_client.response = [SAMPLE_PAYOUT, SAMPLE_PAYOUT_2]
+
+        # Act
+        result = await ingest_once()
+
+        # Assert
+        rows = (await async_session.execute(select(Payout))).scalars().all()
+        assert len(rows) == 2
+        assert result["records_inserted"] == 2
+        assert result["records_fetched"] == 2
+
+    async def test_ingest_once_empty_response_updates_poll_state_timestamp(
+        self, mock_finance_client, async_session
+    ):
+        """Empty API response still updates poll_state to now() so the window advances."""
+        # Arrange: client returns no payouts (e.g., no new payouts today)
+        mock_finance_client.response = []
+
+        # Act
+        before = datetime.now(timezone.utc)
+        await ingest_once()
+        after = datetime.now(timezone.utc)
+
+        # Assert: poll_state updated to approximately now()
+        state = (
+            await async_session.execute(select(PollState).where(PollState.poll_key == POLL_KEY))
+        ).scalar_one_or_none()
+        assert state is not None, "poll_state row must be created even for empty responses"
+        assert before <= state.last_poll_timestamp.replace(tzinfo=timezone.utc) <= after
+
+
+class TestOutputVariance:
+    """Every endpoint/service that transforms input must produce different output for different inputs."""
+
+    async def test_ingest_output_varies_with_different_payloads(
+        self, mock_finance_client, async_session
+    ):
+        """Two different API payloads produce different DB states.
+
+        This is the output-variance gate: a stub that ignores input and always
+        returns hardcoded data will fail this test.
+
+        NOTE (Phase 8 fix): Uses unique IDs per call so call-2 does not see
+        call-1's data as pre-existing rows.  Using SAMPLE_PAYOUT for both calls
+        would cause call-2 to UPDATE (not insert) SAMPLE_PAYOUT, yielding
+        records_inserted=1 for both calls — masking the variance.  The spec
+        intent is unchanged: different-sized batches must produce different
+        records_inserted counts.
+        """
+        # Input A: one unique payout (not seen before)
+        payout_a = {**SAMPLE_PAYOUT, "id": "po_variance_callA_001"}
+        mock_finance_client.response = [payout_a]
+        result_a = await ingest_once()
+
+        # Input B: two unique payouts (neither seen before — no overlap with A)
+        payout_b1 = {**SAMPLE_PAYOUT, "id": "po_variance_callB_001"}
+        payout_b2 = {**SAMPLE_PAYOUT_2, "id": "po_variance_callB_002"}
+        mock_finance_client.response = [payout_b1, payout_b2]
+        result_b = await ingest_once()
+
+        # Assert outputs differ based on inputs: 1 inserted vs 2 inserted
+        assert result_a["records_inserted"] != result_b["records_inserted"], (
+            "ingest_once must produce different records_inserted counts for different-sized inputs"
+        )
+
+    async def test_ingest_payout_amount_stored_as_exact_decimal(
+        self, mock_finance_client, async_session
+    ):
+        """Amount is stored with exact decimal precision — no float rounding.
+
+        Financial data: 1250.75 must not become 1250.7499999...
+        """
+        from decimal import Decimal
+        # Arrange
+        mock_finance_client.response = [SAMPLE_PAYOUT]  # payout_amount = "1250.75"
+
+        # Act
+        await ingest_once()
+
+        # Assert: exact decimal stored
+        row = (await async_session.execute(select(Payout))).scalar_one()
+        assert row.payout_amount == Decimal("1250.75"), (
+            f"Expected Decimal('1250.75'), got {row.payout_amount!r} — NUMERIC(12,2) required"
+        )
+
+
+class TestPollStateManagement:
+    """High-water mark (poll_state) management."""
+
+    async def test_ingest_uses_30_day_default_window_on_first_run(
+        self, mock_finance_client, async_session
+    ):
+        """On first run with no poll_state, created_after defaults to 30 days ago."""
+        # Arrange: no poll_state row in DB
+
+        # Act
+        before_call = datetime.now(timezone.utc)
+        await ingest_once()
+
+        # Assert: client was called with created_after ≈ 30 days ago
+        assert len(mock_finance_client.calls) == 1, "ingest_once must call fetch_payouts once"
+        created_after = mock_finance_client.calls[0]["created_after"]
+        assert created_after is not None
+        expected_window = before_call - timedelta(days=30)
+        delta = abs((created_after - expected_window).total_seconds())
+        assert delta < 60, (
+            f"Default window should be ~30 days ago; got {created_after}"
+        )
+
+    async def test_ingest_uses_last_poll_timestamp_on_subsequent_runs(
+        self, mock_finance_client, async_session
+    ):
+        """On subsequent runs, uses last_poll_timestamp from poll_state as created_after."""
+        # Arrange: poll_state with known timestamp
+        known_ts = datetime(2026, 4, 20, 12, 0, 0, tzinfo=timezone.utc)
+        state = PollState(
+            poll_key=POLL_KEY,
+            last_poll_timestamp=known_ts,
+            updated_at=known_ts,
+        )
+        async_session.add(state)
+        await async_session.commit()
+
+        # Act
+        await ingest_once()
+
+        # Assert
+        assert len(mock_finance_client.calls) == 1
+        assert mock_finance_client.calls[0]["created_after"] == known_ts
+
+    async def test_ingest_updates_poll_state_to_max_created_date(
+        self, mock_finance_client, async_session
+    ):
+        """After ingest, poll_state advances to max(created_date) in the batch."""
+        # Arrange: two payouts with different created_dates
+        early = {**SAMPLE_PAYOUT, "created_date": "2026-04-22T10:00:00Z"}
+        late = {**SAMPLE_PAYOUT_2, "created_date": "2026-04-24T11:30:00Z"}
+        mock_finance_client.response = [early, late]
+
+        # Act
+        await ingest_once()
+
+        # Assert: poll_state = 2026-04-24 (later of the two)
+        state = (
+            await async_session.execute(select(PollState).where(PollState.poll_key == POLL_KEY))
+        ).scalar_one()
+        ts = state.last_poll_timestamp
+        if ts.tzinfo is None:
+            ts = ts.replace(tzinfo=timezone.utc)
+        assert ts.date().isoformat() == "2026-04-24"
+
+
+class TestIngestObservability:
+    """Gate 10: Every broad exception handler must emit a log."""
+
+    async def test_ingest_success_logs_structured_fields(
+        self, mock_finance_client, caplog
+    ):
+        """Successful ingest logs structured JSON with all required fields.
+
+        Required log fields: timestamp, level, event, correlation_id,
+        records_fetched, records_upserted.
+        """
+        import logging
+        mock_finance_client.response = [SAMPLE_PAYOUT]
+
+        with caplog.at_level(logging.INFO, logger="app.finance.poll"):
+            await ingest_once()
+
+        # At least one log message from finance.poll
+        assert any("finance" in r.name for r in caplog.records), (
+            "ingest_once must emit at least one log entry on success"
+        )
+
+    async def test_ingest_api_failure_logs_error_with_context(
+        self, mock_finance_client, caplog
+    ):
+        """When API fails, error log includes operation context (not just exception message).
+
+        Gate 10: error must not be silently swallowed.
+        """
+        import logging
+        from app.finance.client import TargetAPIError
+        mock_finance_client.raise_on_next_call = TargetAPIError(
+            status_code=503, detail="Service Unavailable", correlation_id="corr-abc"
+        )
+
+        with caplog.at_level(logging.ERROR, logger="app.finance.poll"):
+            await ingest_once()
+
+        # Error must be logged with context
+        error_records = [r for r in caplog.records if r.levelno >= logging.ERROR]
+        assert len(error_records) >= 1, (
+            "API failure must produce at least one ERROR log — not silently swallowed"
+        )
+
+
+class TestStripeIdValidation:
+    """Stripe ID format validation — advisory (warn + continue, not reject)."""
+
+    async def test_payout_with_invalid_stripe_id_is_still_persisted(
+        self, mock_finance_client, async_session, caplog
+    ):
+        """Invalid po_* format logs warning but record is persisted.
+
+        Rationale: Target may change ID formats; losing records is worse than
+        accepting unknown ID shapes.
+        """
+        import logging
+        bad_id_payout = {**SAMPLE_PAYOUT, "id": "INVALID_ID_FORMAT"}
+        mock_finance_client.response = [bad_id_payout]
+
+        with caplog.at_level(logging.WARNING, logger="app.finance.poll"):
+            await ingest_once()
+
+        rows = (await async_session.execute(select(Payout))).scalars().all()
+        assert len(rows) == 1, "Record with non-standard ID must still be persisted"
+        assert any("warn" in r.levelname.lower() for r in caplog.records), (
+            "Invalid Stripe ID format must log a warning"
+        )
