+"""Test infrastructure for finance tests.
+
+Provides:
+  - Per-test in-memory SQLite async engine with payouts/poll_state schema
+  - Autouse fixture that patches poll._engine and poll._client
+  - MockTargetFinanceClient spy for asserting call args
+  - Async session fixture for direct DB queries
+  - Sample payout data mirroring real Target API response shape
+"""
+import pytest
+from datetime import datetime, timezone
+from sqlalchemy.ext.asyncio import create_async_engine, async_sessionmaker
+
+import app.finance.poll as poll_mod
+from app.finance.models import Base
+from app.finance.client import TargetAPIError
+
+# ---------------------------------------------------------------------------
+# Sample data — mirrors real Target API payout response shape (from feature-spec)
+# ---------------------------------------------------------------------------
+
+SAMPLE_PAYOUT = {
+    "id": "po_1AbCdEfGhIjKlMnO",
+    "arrival_date": "2026-04-25T00:00:00Z",
+    "created_date": "2026-04-23T10:00:00Z",
+    "payout_amount": "1250.75",
+    "currency": "USD",
+    "description": "STRIPE PAYOUT",
+    "balance_transaction": "txn_1AbCdEfGhIjKlMnO",
+    "destination_account": "card_1AbCdEfGhIjKlMnO",
+    "status": "paid",
+    "type": "card",
+    "seller_id": "SELLER_TEST_001",
+}
+
+SAMPLE_PAYOUT_2 = {
+    "id": "po_2XyZaBcDeFgHiJkL",
+    "arrival_date": "2026-04-26T00:00:00Z",
+    "created_date": "2026-04-24T11:30:00Z",
+    "payout_amount": "375.00",
+    "currency": "USD",
+    "description": "STRIPE PAYOUT",
+    "balance_transaction": "txn_2XyZaBcDeFgHiJkL",
+    "destination_account": "card_2XyZaBcDeFgHiJkL",
+    "status": "paid",
+    "type": "card",
+    "seller_id": "SELLER_TEST_001",
+}
+
+SAMPLE_PAYOUT_UNKNOWN_STATUS = {
+    **SAMPLE_PAYOUT,
+    "id": "po_3UnknownStatus001",
+    "status": "pending",  # Not in KNOWN_STATUSES — should set status_known=False
+}
+
+# ---------------------------------------------------------------------------
+# Mock client — spy that records calls for assertion
+# ---------------------------------------------------------------------------
+
+
+class MockTargetFinanceClient:
+    """Spy mock for TargetFinanceClient.
+
+    Tests set .response to control what fetch_payouts() returns.
+    Tests inspect .calls to verify fetch_payouts() was called with correct args.
+    Tests set .raise_on_next_call to simulate API errors.
+    """
+
+    def __init__(self):
+        self.response: list[dict] = []
+        self.calls: list[dict] = []
+        self.raise_on_next_call: Exception | None = None
+
+    async def fetch_payouts(self, created_after=None, created_before=None):
+        self.calls.append({"created_after": created_after, "created_before": created_before})
+        if self.raise_on_next_call is not None:
+            exc = self.raise_on_next_call
+            self.raise_on_next_call = None
+            raise exc
+        return list(self.response)  # Return a copy to prevent mutation surprises
+
+
+@pytest.fixture
+def mock_finance_client():
+    """Fresh mock client for each test."""
+    return MockTargetFinanceClient()
+
+
+# ---------------------------------------------------------------------------
+# Database fixtures
+# ---------------------------------------------------------------------------
+
+
+@pytest.fixture
+async def test_engine():
+    """Fresh in-memory SQLite async engine with finance schema (payouts + poll_state)."""
+    engine = create_async_engine("sqlite+aiosqlite:///:memory:", echo=False)
+    async with engine.begin() as conn:
+        await conn.run_sync(Base.metadata.create_all)
+    yield engine
+    async with engine.begin() as conn:
+        await conn.run_sync(Base.metadata.drop_all)
+    await engine.dispose()
+
+
+@pytest.fixture
+async def async_session(test_engine):
+    """Async DB session for direct database queries in tests."""
+    factory = async_sessionmaker(test_engine, expire_on_commit=False)
+    async with factory() as session:
+        yield session
+        await session.rollback()
+
+
+# ---------------------------------------------------------------------------
+# Autouse: patch poll module for every test
+# ---------------------------------------------------------------------------
+
+
+@pytest.fixture(autouse=True)
+async def setup_test_env(test_engine, mock_finance_client, monkeypatch):
+    """Patch poll module for every test: fresh DB engine + mock client.
+
+    Also sets TARGET_API_KEY and SELLER_ID env vars so credential tests have
+    a known baseline.
+    """
+    monkeypatch.setattr(poll_mod, "_engine", test_engine)
+    monkeypatch.setattr(poll_mod, "_client", mock_finance_client)
+    monkeypatch.setenv("TARGET_API_KEY", "test-staging-key-xxxxx")
+    monkeypatch.setenv("SELLER_ID", "SELLER_TEST_001")
+    # Ensure production key is absent unless a test explicitly sets it
+    monkeypatch.delenv("TARGET_PROD_API_KEY", raising=False)
