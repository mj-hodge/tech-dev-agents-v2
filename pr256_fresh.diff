+
+
+def _make_mock_services():
+    """Create mock agent_service and cost_service."""
+    agent_svc = AsyncMock()
+    agent_svc.get_all_health.return_value = []
+    cost_svc = AsyncMock()
+    return agent_svc, cost_svc
