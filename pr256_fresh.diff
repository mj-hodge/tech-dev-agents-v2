 os.environ.pop("ANTHROPIC_BASE_URL", None)
 os.environ.pop("ANTHROPIC_TOKEN", None)
 
+
+class _PrefixedStream(io.TextIOBase):
+    """Line-buffered stream wrapper that prepends a stable agent prefix.
+
+    Ensures Loki lines are never missing agent identity and suppresses empty
+    duplicate rows caused by bare newlines.
+    """
+
+    def __init__(self, base: io.TextIOBase, prefix: str):
+        self._base = base
+        self._prefix = prefix
+        self._buf = ""
+
+    def write(self, s: str) -> int:
+        self._buf += s
+        while "\n" in self._buf:
+            line, self._buf = self._buf.split("\n", 1)
+            line = line.rstrip("\r")
+            if not line.strip():
+                continue
+            if line.startswith(self._prefix):
+                self._base.write(line + "\n")
+            else:
+                self._base.write(f"{self._prefix}{line}\n")
+        return len(s)
+
+    def flush(self) -> None:
+        if self._buf.strip():
+            line = self._buf.rstrip("\r")
+            if line.startswith(self._prefix):
+                self._base.write(line)
+            else:
+                self._base.write(f"{self._prefix}{line}")
+        self._buf = ""
+        self._base.flush()
+
+
+_agent = os.environ.get("AGENT_NAME", "unknown")
+_prefix = f"[{_agent}] "
+sys.stdout = _PrefixedStream(sys.stdout, _prefix)
+sys.stderr = _PrefixedStream(sys.stderr, _prefix)
+
