{
  "__inputs": [
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "description": "Loki datasource (tech-dev-agents cluster)",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "loki",
      "name": "Loki",
      "version": "1.0.0"
    }
  ],
  "title": "Claude SDK Cost by Story (STORY-920)",
  "description": "Per-story cost rollup, cache savings, and Haiku escalation rates from [USAGE_V2] log lines. Canary: Dan only (first 24h), then fleet-wide.",
  "uid": "story-920-sdk-cost",
  "version": 1,
  "schemaVersion": 38,
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "5m",
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Per-Story Cost Rollup (24h)",
      "description": "Summed cost, cache hit rate, and escalation count per story from [USAGE_V2] lines.",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 8 },
      "datasource": "${DS_LOKI}",
      "targets": [
        {
          "expr": "{job=~\"dispatch-poller|sdlc-phase-runner\"} |= \"[USAGE_V2]\" | logfmt | keep story, cost_usd, cache_read_tokens, input_tokens, output_tokens, cache_creation_tokens, escalation_count, model",
          "legendFormat": "{{story}}",
          "refId": "A"
        }
      ],
      "transformations": [
        { "id": "groupBy", "options": { "fields": { "story": { "aggregations": [], "operation": "groupby" }, "cost_usd": { "aggregations": ["sum"], "operation": "aggregate" }, "escalation_count": { "aggregations": ["sum"], "operation": "aggregate" }, "cache_read_tokens": { "aggregations": ["sum"], "operation": "aggregate" }, "input_tokens": { "aggregations": ["sum"], "operation": "aggregate" } } } },
        { "id": "calculateField", "options": { "alias": "cache_hit_rate", "binary": { "left": "cache_read_tokens (sum)", "right": "input_tokens (sum)", "reducer": "sum", "operator": "/" }, "mode": "binaryOperation" } }
      ],
      "options": { "sortBy": [{ "displayName": "cost_usd (sum)", "desc": true }] }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Cumulative Cost per Story",
      "description": "Running total USD cost per story over the selected window.",
      "gridPos": { "x": 0, "y": 8, "w": 16, "h": 8 },
      "datasource": "${DS_LOKI}",
      "targets": [
        {
          "expr": "sum by (story) (sum_over_time({job=~\"dispatch-poller|sdlc-phase-runner\"} |= \"[USAGE_V2]\" | logfmt | unwrap cost_usd [1m]))",
          "legendFormat": "{{story}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": { "lineInterpolation": "stepAfter" }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Cache Savings Today",
      "description": "Estimated USD saved from prompt cache reads vs full input (Sonnet pricing: $3.00→$0.30/M).",
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 4 },
      "datasource": "${DS_LOKI}",
      "targets": [
        {
          "expr": "sum(sum_over_time({job=~\"dispatch-poller|sdlc-phase-runner\"} |= \"[USAGE_V2]\" | logfmt | unwrap cache_read_tokens [24h])) * (3.00 - 0.30) / 1000000",
          "legendFormat": "Saved ($)",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto", "colorMode": "value" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Haiku Escalation Rate (24h)",
      "description": "Ratio of Haiku→Sonnet escalations to total Haiku invocations. Target < 20%.",
      "gridPos": { "x": 16, "y": 12, "w": 8, "h": 4 },
      "datasource": "${DS_LOKI}",
      "targets": [
        {
          "expr": "sum(sum_over_time({job=~\"dispatch-poller|sdlc-phase-runner\"} |= \"[USAGE_V2]\" | logfmt | unwrap escalation_count [24h])) / count_over_time({job=~\"dispatch-poller|sdlc-phase-runner\"} |= \"[USAGE_V2]\" [24h])",
          "legendFormat": "Escalation rate",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 0.15 }, { "color": "red", "value": 0.30 }] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto", "colorMode": "background" }
    }
  ]
}
