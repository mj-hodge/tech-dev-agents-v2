+
+    resp = await client.get(V2_HISTORY_URL)
+
+    # Must not be 5xx — graceful degradation
+    assert resp.status_code == 200, f"Expected 200 (graceful degradation), got {resp.status_code}: {resp.text}"
+    data = resp.json()
+    # v2 rows still present
+    story_ids = {item["story_id"] for item in data["items"]}
+    assert "STORY-V2-ONLY" in story_ids
