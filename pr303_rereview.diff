+# ---------------------------------------------------------------------------
+# GET /history — STORY-871: Dashboard History tab reads from v2 terminal lane
+# ---------------------------------------------------------------------------
+
+_V2_HISTORY_CUTOVER_TS_DEFAULT = "2026-05-03T00:00:00Z"
+
+# v2 state → DispatchStatusEnum
+_V2_STATE_TO_STATUS: dict[str, DispatchStatusEnum] = {
+    "completed":   DispatchStatusEnum.COMPLETED,
+    "cancelled":   DispatchStatusEnum.CANCELLED,
+    "dead_letter": DispatchStatusEnum.CANCELLED,
+    "failed":      DispatchStatusEnum.FAILED,
+}
+
+
+def _get_db_svc_from_state(request: Request):
+    """Read the v1 DispatchDBService from app state (may be None)."""
+    return getattr(request.app.state, "dispatch_db_service", None)
+
+
+@router.get("/history", response_model=DispatchHistoryResponse)
+async def v2_dispatch_history(
+    request: Request,
+    limit: int = Query(50, ge=1, le=200),
+    offset: int = Query(0, ge=0),
+    status: str | None = Query(None, pattern=r"^(completed|cancelled|failed|dead_letter)$"),
+    svc: DispatchV2Service = Depends(get_v2_service),
+) -> DispatchHistoryResponse:
+    """Paginated history of terminal v2 dispatch jobs.
+
+    Unions with pre-cutover v1 dispatch_items rows so older completions remain visible.
+
+    State mapping:
+        completed    → "completed"
+        cancelled    → "cancelled"
+        dead_letter  → "cancelled"
+        failed       → "failed"
+
+    Logs: [V2-HISTORY] limit=N offset=M status=X total=T elapsed=Ems
+    AC-12: if v1 query fails, endpoint still returns v2 rows (graceful degradation).
+    """
+    _t0 = datetime.now(timezone.utc)
+
+    # ------------------------------------------------------------------ v2 rows
+    v2_result = await svc.list_history(status_filter=status)
+    v2_items: list[dict[str, Any]] = v2_result.get("items", [])
+
+    # ------------------------------------------------------ v1 pre-cutover rows
+    cutover_ts_str = os.environ.get("V2_HISTORY_CUTOVER_TS", _V2_HISTORY_CUTOVER_TS_DEFAULT)
+    db_svc = _get_db_svc_from_state(request)
+    v1_items: list[dict[str, Any]] = []
+
+    if db_svc is not None:
+        try:
+            # Fetch all v1 terminal rows; we filter by cutover in Python
+            v1_result = await db_svc.history(limit=10000, offset=0, status_filter=None)
+            raw_v1 = v1_result.get("items", [])
+
+            # Only include v1 rows updated before the cutover timestamp
+            for row in raw_v1:
+                updated_at = row.get("updated_at")
+                if updated_at is None:
+                    continue
+                # Normalise to comparable string (ISO-8601)
+                if hasattr(updated_at, "isoformat"):
+                    updated_at_str = updated_at.isoformat()
+                else:
+                    updated_at_str = str(updated_at)
+
+                # Truncate to comparable prefix if needed
+                if updated_at_str.replace("+00:00", "Z") < cutover_ts_str:
+                    v1_items.append(row)
+
+        except Exception:
+            logger.exception(
+                "[V2-HISTORY] v1 history query failed — degrading to v2-only response"
+            )
+            # AC-12: v1 failure must NOT cause a 5xx; continue with v2 rows only
+
+    # ------------------------------------------------------------------- merge
+    # Convert v2 rows to DispatchItem; v1 rows already have v1 field names.
+    def _to_item(row: dict[str, Any], *, is_v2: bool) -> DispatchItem:
+        if is_v2:
+            state = row.get("state", "completed")
+            status_enum = _V2_STATE_TO_STATUS.get(state, DispatchStatusEnum.COMPLETED)
+        else:
+            raw_status = row.get("status", "completed")
+            try:
+                status_enum = DispatchStatusEnum(raw_status)
+            except ValueError:
+                status_enum = DispatchStatusEnum.COMPLETED
+
+        return DispatchItem(
+            story_id=row.get("story_id") or "",
+            repo=row.get("repo") or "",
+            scope=row.get("scope") or "small",
+            prompt=row.get("prompt") or "",
+            enqueued_at=row.get("enqueued_at") or "",
+            enqueued_by=row.get("enqueued_by") or "",
+            title=row.get("title"),
+            status=status_enum,
+            claimed_by=row.get("claimed_by"),
+            claimed_at=row.get("claimed_at"),
+            completed_at=row.get("completed_at"),
+            cancelled_at=row.get("cancelled_at"),
+            failed_at=row.get("failed_at"),
+            failure_reason=row.get("failure_reason"),
+            pr_number=row.get("pr_number"),
+            commit_sha=row.get("commit_sha"),
+        )
+
+    def _updated_at_key(item: DispatchItem) -> str:
+        """Sort key for DESC ordering — falls back to empty string."""
+        ts = (
+            item.completed_at
+            or item.cancelled_at
+            or item.failed_at
+            or item.claimed_at
+            or item.enqueued_at
+            or ""
+        )
+        return ts
+
+    all_items: list[DispatchItem] = []
+    for row in v2_items:
+        all_items.append(_to_item(row, is_v2=True))
+    for row in v1_items:
+        all_items.append(_to_item(row, is_v2=False))
+
+    # Sort combined list by most-recent event DESC
+    all_items.sort(key=_updated_at_key, reverse=True)
+
+    total = len(all_items)
+    page = all_items[offset : offset + limit]
+
+    elapsed_ms = int(
+        (datetime.now(timezone.utc) - _t0).total_seconds() * 1000
+    )
+    logger.info(
+        "[V2-HISTORY] limit=%d offset=%d status=%s total=%d elapsed=%dms",
+        limit,
+        offset,
+        status or "all",
+        total,
+        elapsed_ms,
+    )
+    if elapsed_ms > 500:
+        logger.warning(
+            "[V2-HISTORY] v1+v2 union took %dms — consider adding index on dispatch_items.updated_at",
+            elapsed_ms,
+        )
+
+    return DispatchHistoryResponse(
+        items=page,
+        total=total,
+        limit=limit,
+        offset=offset,
+        fetched_at=datetime.now(timezone.utc).isoformat(),
+    )
+
+
 @router.get("/metrics")
 async def get_v2_metrics(
     request: Request,
