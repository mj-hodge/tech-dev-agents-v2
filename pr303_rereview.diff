+/**
+ * STORY-861: Queue / History split — Playwright e2e tests (Phase 7 RED state).
+ *
+ * Drives a real browser against the dashboard with mocked API responses.
+ * Asserts:
+ *   AC-1  Failed story absent from queue panel rows
+ *   AC-3  Attention callout visible when N > 0; hidden when 0
+ *   AC-2  History tab surfaces attention items
+ *   AC-5  Visual confirmation of both lanes via Playwright
+ *
+ * All tests are RED against pre-STORY-861 code because:
+ *   - adaptV2QueueResponse merges attention into paused → failed rows appear in queue
+ *   - No attention callout rendered in DispatchQueue.tsx
+ *   - History tab does not pull from attention bucket
+ *
+ * @smoke
+ */
+
+import { test, expect, type Page } from '@playwright/test';
+
+// ---------------------------------------------------------------------------
+// Helpers
+// ---------------------------------------------------------------------------
+
+const mkItem = (story_id: string, status: string) => ({
+  story_id,
+  status,
+  repo: 'tech-dev-agents',
+  scope: 'small',
+  prompt: 'test prompt',
+  enqueued_by: 'mark',
+  enqueued_at: '2026-05-01T10:00:00Z',
+  claimed_by: null,
+  claimed_at: null,
+  completed_at: null,
+  cancelled_at: null,
+  failed_at: status === 'failed' ? '2026-05-01T11:00:00Z' : null,
+  commit_sha: null,
+  pr_number: null,
+  review_started_at: null,
+  paused_at: null,
+  current_phase: 8,
+  phase_started_at: null,
+  needs_info_path: null,
+  priority: 0,
+  target_role: 'developer',
+});
+
+const EMPTY_QUEUE = {
+  pending: [],
+  in_progress: [],
+  claimed: [],
+  in_review: [],
+  paused: [],
+  needs_info: [],
+  attention: [],
+  total_pending: 0,
+  total_claimed: 0,
+  fetched_at: new Date().toISOString(),
+};
+
+const QUEUE_WITH_FAILED = {
+  ...EMPTY_QUEUE,
+  attention: [mkItem('STORY-861-FAIL', 'failed')],
+};
+
+async function installMocks(page: Page, queuePayload: any, historyPayload?: any) {
+  // Mock v2 queue endpoint
+  await page.route('**/api/dispatch/v2/queue*', async (route) => {
+    await route.fulfill({
+      status: 200,
+      contentType: 'application/json',
+      body: JSON.stringify(queuePayload),
+    });
+  });
+
+  // Mock history endpoint
+  await page.route('**/api/dispatch/history*', async (route) => {
+    await route.fulfill({
+      status: 200,
+      contentType: 'application/json',
+      body: JSON.stringify(
+        historyPayload ?? { items: [], total: 0, limit: 20, offset: 0 },
+      ),
+    });
+  });
+
+  // Stub other dashboard endpoints so load doesn't time out
+  await page.route('**/api/agents*', async (route) => {
+    await route.fulfill({
+      status: 200,
+      contentType: 'application/json',
+      body: JSON.stringify({ agents: [] }),
+    });
+  });
+  await page.route('**/api/fleet*', async (route) => {
+    await route.fulfill({
+      status: 200,
+      contentType: 'application/json',
+      body: JSON.stringify({ agents: [], counts: {}, costs: {} }),
+    });
+  });
+}
+
+// ---------------------------------------------------------------------------
+// Tests
+// ---------------------------------------------------------------------------
+
+test.describe('STORY-861: Queue / History split', () => {
+  test('E2E-T1 — AC-1/AC-5: failed story absent from queue panel rows', async ({ page }) => {
+    await installMocks(page, QUEUE_WITH_FAILED);
+    await page.goto('/');
+    await page.waitForSelector('text=Dispatch Queue', { timeout: 10000 });
+
+    // Queue tab is active by default — failed story must NOT appear in rows
+    const failedRow = page.locator('text=STORY-861-FAIL');
+    await expect(failedRow).toHaveCount(0);
+  });
+
+  test('E2E-T2 — AC-3/AC-5: attention callout visible when N > 0', async ({ page }) => {
+    await installMocks(page, QUEUE_WITH_FAILED);
+    await page.goto('/');
+    await page.waitForSelector('text=Dispatch Queue', { timeout: 10000 });
+
+    // Attention callout must be rendered
+    const callout = page.getByTestId('attention-callout');
+    await expect(callout).toBeVisible();
+    await expect(callout).toContainText('1');
+    await expect(callout).toContainText('attention');
+
+    // Must have a "view history" affordance
+    const viewHistoryLink = page.getByText(/view history/i);
+    await expect(viewHistoryLink).toBeVisible();
+  });
+
+  test('E2E-T3 — AC-2/AC-5: history tab surfaces failed/attention items', async ({ page }) => {
+    // Provide both queue (attention) + history payload with the same failed story
+    const historyPayload = {
+      items: [mkItem('STORY-861-FAIL', 'failed')],
+      total: 1,
+      limit: 20,
+      offset: 0,
+      fetched_at: new Date().toISOString(),
+    };
+    await installMocks(page, QUEUE_WITH_FAILED, historyPayload);
+    await page.goto('/');
+    await page.waitForSelector('text=Dispatch Queue', { timeout: 10000 });
+
+    // Navigate to History tab
+    const historyTab = page.getByRole('button', { name: /history/i });
+    await historyTab.click();
+
+    // Failed story must be visible in the history panel
+    await expect(page.locator('text=STORY-861-FAIL')).toBeVisible({ timeout: 5000 });
+  });
+
+  test('E2E-T4 — AC-3 negative: no callout when attention is empty', async ({ page }) => {
+    await installMocks(page, EMPTY_QUEUE);
+    await page.goto('/');
+    await page.waitForSelector('text=Dispatch Queue', { timeout: 10000 });
+
+    // With empty attention, callout must be absent
+    const callout = page.getByTestId('attention-callout');
+    await expect(callout).toHaveCount(0);
+  });
+});
