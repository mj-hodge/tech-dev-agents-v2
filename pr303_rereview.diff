+@pytest.mark.asyncio
+async def test_status_filter_returns_only_matching(client, mock_v2_svc):
+    """T6: ?status=completed|failed|cancelled filters correctly."""
+    completed_row = _make_v2_row(story_id="STORY-C", state="completed")
+    failed_row = _make_v2_row(story_id="STORY-F", state="failed")
+    cancelled_row = _make_v2_row(story_id="STORY-X", state="cancelled")
+
+    # Simulate service filtering: when status_filter is provided, service returns subset.
+    def _side_effect(*, status_filter=None, **kwargs):
+        all_rows = [completed_row, failed_row, cancelled_row]
+        if status_filter == "completed":
+            filtered = [r for r in all_rows if r["state"] == "completed"]
+        elif status_filter == "failed":
+            filtered = [r for r in all_rows if r["state"] == "failed"]
+        elif status_filter == "cancelled":
+            filtered = [r for r in all_rows if r["state"] in ("cancelled", "dead_letter")]
+        else:
+            filtered = all_rows
+        return _make_history_result(filtered)
+
+    mock_v2_svc.list_history.side_effect = _side_effect
+
+    # No filter → all 3
+    resp = await client.get(V2_HISTORY_URL)
+    assert resp.status_code == 200, resp.text
+    assert len(resp.json()["items"]) == 3
+
+    # Filter: completed → 1
+    resp = await client.get(f"{V2_HISTORY_URL}?status=completed")
+    assert resp.status_code == 200, resp.text
+    assert len(resp.json()["items"]) == 1
+    assert resp.json()["items"][0]["status"] == "completed"
+
+    # Filter: failed → 1
+    resp = await client.get(f"{V2_HISTORY_URL}?status=failed")
+    assert resp.status_code == 200, resp.text
+    assert len(resp.json()["items"]) == 1
+    assert resp.json()["items"][0]["status"] == "failed"
+
+    # Filter: cancelled → 1
+    resp = await client.get(f"{V2_HISTORY_URL}?status=cancelled")
+    assert resp.status_code == 200, resp.text
+    assert len(resp.json()["items"]) == 1
+    assert resp.json()["items"][0]["status"] == "cancelled"
