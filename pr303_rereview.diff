+                    s.updated_at,
+                    s.failure_class,
+                    -- claimed_by: most-recent 'leased' event actor, fallback to leased_by
+                    COALESCE(
+                        (SELECT e.actor
+                         FROM dispatch_v2_events e
+                         WHERE e.job_id = s.job_id
+                           AND e.event_type = 'leased'
+                         ORDER BY e.event_id DESC
+                         LIMIT 1),
+                        s.leased_by
+                    ) AS claimed_by,
+                    -- claimed_at: first 'leased' event timestamp
+                    (SELECT e.created_at
+                     FROM dispatch_v2_events e
+                     WHERE e.job_id = s.job_id
+                       AND e.event_type = 'leased'
+                     ORDER BY e.event_id ASC
+                     LIMIT 1) AS claimed_at,
+                    -- enqueued_at: 'enqueued' event timestamp
+                    (SELECT e.created_at
+                     FROM dispatch_v2_events e
+                     WHERE e.job_id = s.job_id
+                       AND e.event_type = 'enqueued'
+                     ORDER BY e.event_id ASC
+                     LIMIT 1) AS enqueued_at,
+                    -- terminal event timestamp (accepted / cancelled / dead_lettered / failed)
+                    (SELECT e.created_at
+                     FROM dispatch_v2_events e
+                     WHERE e.job_id = s.job_id
+                       AND e.event_type = ANY(
+                           ARRAY['accepted', 'cancelled', 'dead_lettered', 'failed'])
+                     ORDER BY e.event_id DESC
+                     LIMIT 1) AS terminal_event_at
+                FROM dispatch_state_current s
+                JOIN dispatch_jobs j ON j.job_id = s.job_id
+                WHERE s.lane = 'terminal'
+                  AND s.state = ANY($1::text[])
+                ORDER BY s.updated_at DESC
+                """,
+                states,
+            )
+
+        def _ts(dt) -> str | None:  # type: ignore[no-untyped-def]
+            if dt is None:
+                return None
+            if isinstance(dt, str):
+                return dt
+            return dt.isoformat()
+
+        items = []
+        for row in rows:
+            d = dict(row)
+            state = d.get("state", "completed")
+            terminal_ts = _ts(d.get("terminal_event_at"))
+
+            items.append({
+                "story_id": d.get("story_id"),
+                "repo": d.get("repo"),
+                "scope": d.get("scope"),
+                "prompt": d.get("prompt"),
+                "enqueued_by": d.get("enqueued_by"),
+                "enqueued_at": _ts(d.get("enqueued_at")) or _ts(d.get("updated_at")),
+                "title": d.get("title"),
+                "pr_number": d.get("pr_number"),
+                "state": state,
+                "claimed_by": d.get("claimed_by"),
+                "claimed_at": _ts(d.get("claimed_at")),
+                "completed_at": terminal_ts if state == "completed" else None,
+                "cancelled_at": terminal_ts if state in ("cancelled", "dead_letter") else None,
+                "failed_at": terminal_ts if state == "failed" else None,
+                "failure_reason": d.get("failure_class"),
+                "updated_at": _ts(d.get("updated_at")),
+                "commit_sha": None,
+            })
+
+        return {"items": items, "total": len(items)}
+
