+/**
+ * STORY-871 — Playwright E2E spec: Dashboard History tab reads from v2 terminal lane.
+ *
+ * AC-10: Open History tab, assert ≥1 completed row with non-empty PR number and timestamp.
+ *
+ * Mocks:
+ *   GET /api/dispatch/v2/history → one completed row (pr_number=311, completed_at=...)
+ *
+ * Assertions:
+ *   1. History tab is clickable and renders
+ *   2. ≥1 row with status=completed appears
+ *   3. PR number shows "311" (not "NaN" or empty)
+ *   4. completed_at timestamp renders without "NaN"
+ *   5. Screenshot captured and attached to test
+ *
+ * RED trigger: If useDispatchHistory still calls /api/dispatch/history (v1), the v2 mock is
+ * never matched, the History tab renders no rows, and assertions fail.
+ */
+
+import { test, expect } from '@playwright/test';
+
+// ---------------------------------------------------------------------------
+// Fixture data
+// ---------------------------------------------------------------------------
+
+const MOCK_HISTORY_RESPONSE = {
+  items: [
+    {
