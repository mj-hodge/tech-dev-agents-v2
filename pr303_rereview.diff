+/**
+ * STORY-871: Phase 7 RED test — useDispatchHistory hook URL assertion.
+ *
+ * Asserts that useDispatchHistory calls GET /api/dispatch/v2/history
+ * instead of the legacy /api/dispatch/history.
+ *
+ * RED state: The hook currently calls the v1 URL (/api/dispatch/history),
+ * so the assertion that the hook source contains the v2 path FAILS.
+ *
+ * GREEN state (after Phase 8): The hook URL is updated to /api/dispatch/v2/history.
+ */
+
+import { describe, it, expect } from 'vitest';
+import { useDispatchHistory } from '../hooks/useDispatchQueue';
+
+// ---------------------------------------------------------------------------
+// FE-T1 — useDispatchHistory calls the v2 URL
+// ---------------------------------------------------------------------------
+
+describe('useDispatchHistory', () => {
+  it('FE-T1: queryFn must call /api/dispatch/v2/history (not the v1 path)', () => {
+    // Inspect the hook's source to verify the URL it passes to api.get.
+    // This is a lightweight check that does not require rendering a React tree.
+    // It will be RED until the URL is updated in Phase 8.
+    const hookSource = useDispatchHistory.toString();
+
+    // The hook must NOT use the v1 path
+    expect(hookSource).not.toContain('/api/dispatch/history?');
+
+    // The hook MUST use the v2 path
+    expect(hookSource).toContain('/api/dispatch/v2/history');
+  });
+});
