+    mock_v2_svc.list_history.return_value = _make_history_result([])
+
+    # FastAPI's Query(le=200) should reject 500 with 422 Unprocessable Entity.
+    # (If the endpoint uses ge/le on the Query, values > 200 return 422.)
+    # Either 422 (strict) or 200 with effective limit=200 (capped) is acceptable.
