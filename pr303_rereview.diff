+@pytest.mark.asyncio
+async def test_v1_failure_degrades_gracefully(client, mock_v2_svc, mock_db_svc):
+    """T10: v1 query failure → endpoint still returns v2 rows (200 OK), never 5xx."""
+    v2_row = _make_v2_row(story_id="STORY-V2-ONLY", state="completed")
+    mock_v2_svc.list_history.return_value = _make_history_result([v2_row])
+
+    # Simulate v1 table unavailable
