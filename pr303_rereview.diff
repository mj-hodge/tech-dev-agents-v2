+/**
+ * STORY-871: Phase 7 RED state — Playwright spec for v2 History tab.
+ *
+ * Verifies that the dashboard History tab reads from /api/dispatch/v2/history
+ * and renders completed dispatch items with PR numbers and timestamps.
+ *
+ * RED state: The useDispatchHistory hook calls /api/dispatch/history (v1).
+ * This spec mocks /api/dispatch/v2/history with a completed item.  Because
+ * the hook sends requests to the v1 URL, the v2 mock is never hit and the
+ * History tab renders no rows — making all assertions below FAIL.
+ *
+ * GREEN state (after Phase 8):
+ *   - Hook URL updated to /api/dispatch/v2/history
+ *   - v2 mock is hit, completed row renders
+ *   - All assertions pass
+ *   - Screenshot captured
+ *
+ * @story STORY-871
+ */
+
+import { test, expect, type Page } from '@playwright/test';
+import * as path from 'path';
+
+// ---------------------------------------------------------------------------
+// Helpers
+// ---------------------------------------------------------------------------
+
+const COMPLETED_ITEM = {
+  story_id: 'STORY-871-DONE',
+  repo: 'tech-dev-agents',
+  scope: 'small',
+  prompt: 'Ship the history v2 endpoint',
+  status: 'completed',
+  enqueued_at: '2026-05-04T18:00:00Z',
+  enqueued_by: 'mark',
+  title: 'Dashboard History v2',
+  claimed_by: 'dan',
+  claimed_at: '2026-05-04T18:05:00Z',
+  completed_at: '2026-05-04T20:33:08Z',
+  cancelled_at: null,
+  failed_at: null,
+  commit_sha: 'abc123def456',
+  pr_number: 311,
+  paused_at: null,
+  current_phase: 8,
+  phase_started_at: null,
+  needs_info_path: null,
+  rework_of: null,
+  failure_reason: null,
+  dependencies_unmet: [],
+};
+
+const V2_HISTORY_RESPONSE = {
+  items: [COMPLETED_ITEM],
+  total: 1,
+  limit: 20,
+  offset: 0,
+  fetched_at: new Date().toISOString(),
+};
+
+const EMPTY_QUEUE_RESPONSE = {
+  pending: [],
+  in_progress: [],
+  claimed: [],
+  in_review: [],
+  paused: [],
+  needs_info: [],
+  attention: [],
+  total_pending: 0,
+  total_claimed: 0,
+  fetched_at: new Date().toISOString(),
+};
+
+async function installMocks(page: Page): Promise<void> {
+  // Mock the v2 history endpoint — this is what the hook SHOULD call after fix.
+  // In RED state, the hook calls v1, so this mock is never triggered.
+  await page.route('**/api/dispatch/v2/history**', async (route) => {
+    await route.fulfill({
+      status: 200,
+      contentType: 'application/json',
+      body: JSON.stringify(V2_HISTORY_RESPONSE),
+    });
+  });
+
+  // Mock the v2 queue endpoint
+  await page.route('**/api/dispatch/v2/queue**', async (route) => {
+    await route.fulfill({
+      status: 200,
+      contentType: 'application/json',
+      body: JSON.stringify(EMPTY_QUEUE_RESPONSE),
+    });
+  });
+
+  // Mock the v1 queue endpoint (fallback guard in useDispatchQueue)
+  await page.route('**/api/dispatch/queue**', async (route) => {
+    // Exclude v2/queue — already handled above
+    const url = route.request().url();
+    if (url.includes('/v2/')) {
+      await route.continue();
+      return;
+    }
+    await route.fulfill({
+      status: 200,
+      contentType: 'application/json',
+      body: JSON.stringify(EMPTY_QUEUE_RESPONSE),
+    });
+  });
+
+  // Mock the v1 history endpoint — returns empty so we confirm v2 is the source
+  await page.route('**/api/dispatch/history**', async (route) => {
+    const url = route.request().url();
+    if (url.includes('/v2/')) {
+      await route.continue();
+      return;
+    }
+    await route.fulfill({
+      status: 200,
+      contentType: 'application/json',
+      body: JSON.stringify({ items: [], total: 0, limit: 20, offset: 0 }),
+    });
+  });
+
+  // Stub other endpoints so the page loads cleanly
+  await page.route('**/api/agents**', async (route) => {
+    await route.fulfill({
+      status: 200,
+      contentType: 'application/json',
+      body: JSON.stringify({ agents: [] }),
+    });
+  });
+  await page.route('**/api/fleet**', async (route) => {
+    await route.fulfill({
+      status: 200,
+      contentType: 'application/json',
+      body: JSON.stringify({ agents: [], counts: {}, costs: {} }),
+    });
+  });
+  await page.route('**/api/dispatch/metrics**', async (route) => {
+    await route.fulfill({
+      status: 200,
+      contentType: 'application/json',
+      body: JSON.stringify({
+        pending: 0,
+        in_progress: 0,
+        in_review: 0,
+        paused: 0,
+        needs_info: 0,
+        fetched_at: new Date().toISOString(),
+      }),
+    });
+  });
+}
+
+// ---------------------------------------------------------------------------
+// Tests
+// ---------------------------------------------------------------------------
+
+test.describe('STORY-871: History tab reads from v2 terminal lane', () => {
+  test('E2E-T1 — History tab shows completed row with PR number and timestamp', async ({
+    page,
+  }) => {
+    await installMocks(page);
+    await page.goto('/');
+    await page.waitForSelector('text=Dispatch Queue', { timeout: 15_000 });
+
+    // Navigate to the History tab
+    const historyTab = page.getByRole('button', { name: /history/i });
+    await expect(historyTab).toBeVisible({ timeout: 5_000 });
+    await historyTab.click();
+
+    // Wait for the History panel to be visible
+    await page.waitForTimeout(1_000);
+
+    // Assert: at least one completed row is visible
+    // In RED state: hook calls v1 (which returns empty) → no rows → assertion FAILS
+    const completedRow = page.locator('text=STORY-871-DONE');
+    await expect(completedRow).toBeVisible({ timeout: 5_000 });
+
+    // Assert: PR number "311" is visible in the row (not "NaN" or empty)
+    const prCell = page.locator('text=311');
+    await expect(prCell).toBeVisible();
+
+    // Assert: completed_at timestamp renders (not "NaN ago" or empty)
+    // The timestamp cell should contain some human-readable content
+    const timestampCell = page.locator('[data-testid="completed-at"], .completed-at').first();
+    if (await timestampCell.count() > 0) {
+      const text = await timestampCell.textContent();
+      expect(text).toBeTruthy();
+      expect(text).not.toMatch(/NaN/i);
+    }
+
+    // Screenshot for PR attachment
+    await page.screenshot({
+      path: path.join('playwright-report', 'story-871-history-tab-v2.png'),
+      fullPage: false,
+    });
+  });
+});
