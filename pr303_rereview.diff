+    story_id: str = "STORY-871",
+    state: str = "completed",
+    lane: str = "terminal",
+    pr_number: int | None = 311,
+    enqueued_by: str = "dan",
+    leased_by: str = "derrick",
+    repo: str = "tech-dev-agents",
+    scope: str = "small",
+    title: str | None = "Test story",
+    updated_at: str = NOW_TS,
+    **extra,
+) -> dict:
+    """Build a row dict as returned by list_history()."""
+    return {
+        "story_id": story_id,
+        "state": state,
+        "lane": lane,
+        "pr_number": pr_number,
+        "enqueued_by": enqueued_by,
+        "claimed_by": leased_by,
+        "repo": repo,
+        "scope": scope,
+        "title": title,
+        "prompt": f"Implement {story_id}",
+        "enqueued_at": PRE_CUTOVER_TS,
+        "completed_at": NOW_TS if state in ("completed",) else None,
+        "cancelled_at": NOW_TS if state in ("cancelled", "dead_letter") else None,
+        "failed_at": NOW_TS if state == "failed" else None,
+        "claimed_at": PRE_CUTOVER_TS,
+        "failure_reason": None,
+        "commit_sha": None,
+        "updated_at": updated_at,
+        **extra,
+    }
+
