+from tools.target_discovery.rate_limit import BurstResult, run_burst
+from tools.target_discovery.redact import redact_headers, redact_response
+
+
+@dataclass
+class ProbeResult:
+    """Result of a single probe execution."""
+
+    probe_name: str
+    operation_id: str
+    http_status: int
+    response_body: dict = field(default_factory=dict)
+    request_headers: dict = field(default_factory=dict)
+    response_headers: dict = field(default_factory=dict)
+    oqs_resolved: list[str] = field(default_factory=list)
+    schema_deltas: list[str] = field(default_factory=list)
+    burst_result: BurstResult | None = None
+    error: str | None = None
+
+
+def _safe_json(resp: httpx.Response) -> dict:
+    """Parse JSON body, returning empty dict on failure."""
+    try:
+        return resp.json()
+    except Exception:
+        return {}
+
+
+def _build_result(
+    probe_name: str,
+    operation_id: str,
+    resp: httpx.Response,
+    client: "TargetDiscoveryClient",
+    oqs_resolved: list[str] | None = None,
+    schema_deltas: list[str] | None = None,
+    burst_result: BurstResult | None = None,
+) -> ProbeResult:
+    """Build a ProbeResult from an httpx.Response with redaction."""
+    creds = client.credential_values()
+    body = _safe_json(resp)
+    return ProbeResult(
+        probe_name=probe_name,
+        operation_id=operation_id,
+        http_status=resp.status_code,
+        response_body=redact_response(body, creds),
+        request_headers=redact_headers(dict(resp.request.headers) if resp.request else {}, creds),
+        response_headers=dict(resp.headers),
+        oqs_resolved=oqs_resolved or [],
+        schema_deltas=schema_deltas or [],
+        burst_result=burst_result,
+        error=None,
+    )
+
