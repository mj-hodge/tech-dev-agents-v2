+"""Assert that running the harness reduces x-confidence: unknown in target-openapi.yaml.
+
+Baseline: 14 occurrences of `x-confidence: unknown` in target-openapi.yaml
+(measured 2026-04-29 before any staging run).
+
+RED state: the harness hasn't run yet, so the count is still 14 → the
+assertion `count < 14` FAILS. This is the intended RED state.
+
+GREEN state: after Phase 8 implementation runs the harness against staging
+and patches the spec, count drops below 14.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+
+OPENAPI_YAML_PATH = Path(
+    "features/story-006-target-openapi-synthesis/target-openapi.yaml"
+)
+
+# Baseline count before any staging run (verified 2026-04-29)
+BASELINE_UNKNOWN_COUNT = 14
+
+UNKNOWN_MARKER = "x-confidence: unknown"
+
+
+@pytest.fixture
+def openapi_text() -> str:
+    """Read the OpenAPI YAML, failing if it doesn't exist."""
+    if not OPENAPI_YAML_PATH.exists():
+        pytest.fail(
+            f"OpenAPI YAML not found at {OPENAPI_YAML_PATH}. "
+            "Ensure features/story-006-target-openapi-synthesis/target-openapi.yaml exists."
+        )
+    return OPENAPI_YAML_PATH.read_text(encoding="utf-8")
+
+
+def test_openapi_yaml_exists() -> None:
+    """The OpenAPI YAML must be present as a prerequisite."""
+    assert OPENAPI_YAML_PATH.exists(), (
+        f"OpenAPI YAML not found: {OPENAPI_YAML_PATH}"
+    )
+
+
+def test_baseline_unknown_count_is_known(openapi_text: str) -> None:
+    """Verify we can count x-confidence: unknown occurrences in the YAML."""
+    count = openapi_text.count(UNKNOWN_MARKER)
+    # This test documents the baseline — it passes as long as the file is readable
+    # and count is a non-negative integer. The real gate is test_unknown_count_reduced.
+    assert count >= 0, "Count must be a non-negative integer."
+    # Informational: print the current count (visible with pytest -s)
+    print(f"\nCurrent x-confidence: unknown count: {count} (baseline: {BASELINE_UNKNOWN_COUNT})")
+
+
+def test_unknown_count_reduced(openapi_text: str) -> None:
+    """After running the harness, x-confidence: unknown count must drop below baseline.
+
+    RED state: harness hasn't run → count == 14 == BASELINE → assertion fails.
+    GREEN state: harness patches at least one field → count < 14.
+    """
+    count = openapi_text.count(UNKNOWN_MARKER)
+    assert count < BASELINE_UNKNOWN_COUNT, (
+        f"x-confidence: unknown count is {count}, same as the pre-run baseline of "
+        f"{BASELINE_UNKNOWN_COUNT}. Run the discovery harness to promote at least "
+        "one field from 'unknown' to 'verified'."
+    )
+
+
+def test_no_new_unknown_fields_introduced(openapi_text: str) -> None:
+    """Running the harness must not ADD new x-confidence: unknown fields.
+
+    RED state: if count > BASELINE (someone added fields), this FAILS immediately.
+    Also fails when count == BASELINE (harness hasn't run) combined with above test.
+    """
+    count = openapi_text.count(UNKNOWN_MARKER)
+    assert count <= BASELINE_UNKNOWN_COUNT, (
+        f"x-confidence: unknown count ({count}) exceeds the baseline "
+        f"({BASELINE_UNKNOWN_COUNT}). No new unknown fields should be introduced."
+    )
