+"""Rate-limit burst sub-probe runner.
+
+Measurement protocol:
+1. First pass: burst_size calls, inter_call_ms delay
+2. If no 429: escalate to 50 calls with 10ms delay
+3. Capture per-endpoint: P50/P95 latency, first 429 position, Retry-After
+"""
+
+from __future__ import annotations
+
+import time
+from dataclasses import dataclass, field
+from typing import TYPE_CHECKING, Any
+
+import httpx
+
+if TYPE_CHECKING:
+    from tools.target_discovery.client import TargetDiscoveryClient
+
+# Burst configuration constants
+INITIAL_BURST_SIZE = 10
+INITIAL_INTER_CALL_MS = 50
+ESCALATED_BURST_SIZE = 50
+ESCALATED_INTER_CALL_MS = 10
+
+
+@dataclass
+class BurstResult:
+    """Result of a burst rate-limit probe."""
+
+    path: str
+    burst_size: int
+    inter_call_ms: int
+    latencies_ms: list[float] = field(default_factory=list)
+    status_codes: list[int] = field(default_factory=list)
+    first_429_at: int | None = None
+    retry_after_header: str | None = None
+    observed_headers: dict[str, str] = field(default_factory=dict)
+    error: str | None = None
+
+    @property
+    def latency_p50_ms(self) -> float:
+        """Calculate P50 latency from recorded measurements."""
+        if not self.latencies_ms:
+            return 0.0
+        sorted_lat = sorted(self.latencies_ms)
+        idx = len(sorted_lat) // 2
+        return sorted_lat[idx]
+
+    @property
+    def latency_p95_ms(self) -> float:
+        """Calculate P95 latency from recorded measurements."""
+        if not self.latencies_ms:
+            return 0.0
+        sorted_lat = sorted(self.latencies_ms)
+        idx = min(int(len(sorted_lat) * 0.95), len(sorted_lat) - 1)
+        return sorted_lat[idx]
+
+
+def _execute_burst(
+    client: "TargetDiscoveryClient",
+    path: str,
+    params: dict[str, Any] | None,
+    burst_size: int,
+    inter_call_ms: int,
+) -> BurstResult:
+    """Fire burst_size identical GETs with inter_call_ms sleep between calls."""
+    result = BurstResult(
+        path=path,
+        burst_size=burst_size,
+        inter_call_ms=inter_call_ms,
+    )
+
+    for i in range(burst_size):
+        if i > 0:
+            time.sleep(inter_call_ms / 1000.0)
+        try:
+            start = time.monotonic()
+            resp = client.get(path, params=params, timeout=10.0)
+            elapsed_ms = (time.monotonic() - start) * 1000.0
+
+            result.latencies_ms.append(elapsed_ms)
+            result.status_codes.append(resp.status_code)
+
+            # Capture rate-limit headers from any response
+            for header_name in resp.headers:
+                lower = header_name.lower()
+                if lower.startswith("x-ratelimit") or lower == "retry-after":
+                    result.observed_headers[header_name] = resp.headers[header_name]
+
+            if resp.status_code == 429:
+                result.first_429_at = i + 1  # 1-indexed
+                result.retry_after_header = resp.headers.get("Retry-After")
+                break
+
+        except httpx.HTTPError as e:
+            result.error = f"HTTP error at call #{i + 1}: {e}"
+            break
+
+    return result
+
+
+def run_burst(
+    client: "TargetDiscoveryClient",
+    path: str,
+    params: dict[str, Any] | None = None,
+    burst_size: int = INITIAL_BURST_SIZE,
+    inter_call_ms: int = INITIAL_INTER_CALL_MS,
+) -> BurstResult:
+    """Fire burst_size identical GETs with inter_call_ms sleep between calls.
+
+    If no 429 in initial burst: escalate to 50 calls with 10ms delay.
+    """
+    result = _execute_burst(client, path, params, burst_size, inter_call_ms)
+
+    # Escalate if no 429 found in initial burst
+    if result.first_429_at is None and result.error is None:
+        escalated = _execute_burst(
+            client, path, params,
+            ESCALATED_BURST_SIZE, ESCALATED_INTER_CALL_MS,
+        )
+        if escalated.first_429_at is not None or escalated.error is not None:
+            return escalated
+        # Merge data — use escalated as it has more data points
+        return escalated
+
+    return result
diff --git a/tools/target_discovery/redact.py b/tools/target_discovery/redact.py
new file mode 100644
index 0000000..359ad02
--- /dev/null
+++ b/tools/target_discovery/redact.py
@@ -0,0 +1,87 @@
+"""Credential and PII redaction utilities.
+
+Deep-copies all data before redaction — originals are never modified.
+Scrubs by value (not just key) to catch credentials leaked in error messages.
+"""
+
+from __future__ import annotations
+
+import copy
+from typing import Any
+
+CREDENTIAL_KEYS = frozenset(
+    {"api_key", "apiKey", "x-api-key", "authorization", "seller_token", "sellerToken",
+     "x-seller-id", "x-seller-token", "tgtrt"}
+)
+CREDENTIAL_PLACEHOLDER = "[REDACTED-CREDENTIAL]"
+
+PII_KEYS = frozenset(
+    {
+        "email", "phone", "address", "street", "zip", "postal_code",
+        "ssn", "tax_id", "name", "first_name", "last_name",
+        "address_line_1", "address_line_2", "address_line_3", "zip_code",
+    }
+)
+PII_PLACEHOLDER = "[REDACTED-PII]"
+
+
+def _scrub_value(value: Any, credential_values: list[str]) -> Any:
+    """Replace credential values found in a string."""
+    if not isinstance(value, str):
+        return value
+    result = value
+    for cred in credential_values:
+        if cred and cred in result:
+            result = result.replace(cred, CREDENTIAL_PLACEHOLDER)
+    return result
+
+
+def _redact_dict(d: dict[str, Any], credential_values: list[str]) -> dict[str, Any]:
+    """Recursively redact a dict: scrub credential values and PII keys."""
+    result: dict[str, Any] = {}
+    for key, value in d.items():
+        # PII key redaction
+        if key.lower() in PII_KEYS or key in PII_KEYS:
+            result[key] = PII_PLACEHOLDER
+        elif isinstance(value, dict):
+            result[key] = _redact_dict(value, credential_values)
+        elif isinstance(value, list):
+            result[key] = [
+                _redact_dict(item, credential_values) if isinstance(item, dict)
+                else _scrub_value(item, credential_values)
+                for item in value
+            ]
+        else:
+            result[key] = _scrub_value(value, credential_values)
+    return result
+
+
+def redact_response(
+    response_dict: dict[str, Any], credential_values: list[str]
+) -> dict[str, Any]:
+    """Return a deep copy of response_dict with credentials and PII redacted.
+
+    Args:
+        response_dict: Parsed JSON response body.
+        credential_values: Actual credential strings to scrub from ANY value.
+
+    Returns:
+        Redacted copy. Original is never modified.
+    """
+    cloned = copy.deepcopy(response_dict)
+    return _redact_dict(cloned, credential_values)
+
+
+def redact_headers(
+    headers: dict[str, str], credential_values: list[str]
+) -> dict[str, str]:
+    """Return a copy of headers with credential values redacted."""
+    result: dict[str, str] = {}
+    for key, value in headers.items():
+        scrubbed = _scrub_value(value, credential_values)
+        # Also redact by well-known header key
+        if key.lower() in CREDENTIAL_KEYS:
+            result[key] = CREDENTIAL_PLACEHOLDER
+        else:
+            result[key] = scrubbed
+    return result
