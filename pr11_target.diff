+"""Click CLI entry point for Target staging discovery harness.
+
+Orchestrates probe execution in phases A–J, writes captures and report.
+Credentials loaded from environment; never echoed to stdout.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import sys
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any
+
+import click
+
+from tools.target_discovery import __version__
+from tools.target_discovery.client import TargetDiscoveryClient
+from tools.target_discovery.probes import (
+    ProbeResult,
+    probe_bulk_product_endpoint_discovery,
+    probe_cancellation_reason_enum,
+    probe_catalog_browse_discovery,
+    probe_create_report_request,
+    probe_distribution_centers,
+    probe_error_envelope_induction,
+    probe_get_report_request,
+    probe_listing_errors,
+    probe_list_report_requests,
+    probe_order_address,
+    probe_payouts,
+    probe_product_logistics_typo,
+    probe_product_returns,
+    probe_product_status,
+    probe_released_orders,
+    probe_shipping_methods,
+    probe_taxonomy,
+    probe_taxonomy_assignments,
+    probe_taxonomy_attribute_values,
+    probe_token_expiry,
+)
+from tools.target_discovery.redact import redact_response
+
+
+@click.group()
+def cli() -> None:
+    """Target API staging discovery harness."""
+
+
+def _save_capture(
+    captures_dir: Path,
+    filename: str,
+    result: ProbeResult,
+    credential_values: list[str],
+) -> None:
+    """Write a redacted probe result to a JSON capture file."""
+    captures_dir.mkdir(parents=True, exist_ok=True)
+    data = {
+        "probe_name": result.probe_name,
+        "operation_id": result.operation_id,
+        "http_status": result.http_status,
+        "response_body": redact_response(result.response_body, credential_values),
+        "schema_deltas": result.schema_deltas,
+        "oqs_resolved": result.oqs_resolved,
+        "error": result.error,
+    }
+    filepath = captures_dir / filename
+    filepath.write_text(json.dumps(data, indent=2, default=str), encoding="utf-8")
+
+
+def _write_report(
+    report_path: Path,
+    results: list[ProbeResult],
+    run_timestamp: str,
+) -> None:
+    """Generate the discovery-report.md from probe results."""
+    total = len(results)
+    succeeded = sum(1 for r in results if r.error is None and r.http_status > 0)
+    skipped = sum(1 for r in results if r.error and "SKIPPED" in r.error)
+    failed = total - succeeded - skipped
+
+    # Collect all resolved OQs
+    all_oqs: dict[str, list[str]] = {}
+    for r in results:
+        for oq in r.oqs_resolved:
+            all_oqs.setdefault(oq, []).append(r.probe_name)
+
+    # Collect schema deltas
+    all_deltas: list[tuple[str, str]] = []
+    for r in results:
+        for delta in r.schema_deltas:
+            all_deltas.append((r.operation_id, delta))
+
+    # Build OQ resolution table
+    oq_table_rows: list[str] = []
+    required_oqs = [
+        ("OQ-1", "Token expiry / refresh behavior"),
+        ("OQ-3", "Rate limits per endpoint"),
+        ("OQ-5", "product_logitics path typo"),
+        ("OQ-6", "Bulk product creation endpoint shape"),
+        ("OQ-7", "Full GET /orders response schema"),
+        ("OQ-8", "Additional report types"),
+        ("OQ-9", "Return reason enum values"),
+        ("OQ-10", "Cancellation reason enum"),
+        ("OQ-11", "Report status enum values"),
+        ("OQ-12", "Listing-error severity enum"),
+        ("OQ-13", "4xx/5xx error response envelope"),
+        ("OQ-19", "Payout filter parameters"),
+        ("OQ-20", "Product search / catalog browse capability"),
+    ]
+
+    for oq_id, question in required_oqs:
+        probes_for_oq = all_oqs.get(oq_id, [])
+        if probes_for_oq:
+            # Find the actual result
+            probe_results = [r for r in results if r.probe_name in probes_for_oq]
+            has_success = any(r.error is None and r.http_status > 0 for r in probe_results)
+            has_skip = any(r.error and "SKIPPED" in r.error for r in probe_results)
+
+            if has_skip:
+                status = "Still Unknown"
+                finding = "Deferred — requires operator approval or downstream story"
+            elif has_success:
+                status = "Resolved"
+                # Summarize findings from schema_deltas
+                findings = []
+                for r in probe_results:
+                    findings.extend(r.schema_deltas)
+                finding = "; ".join(findings) if findings else f"HTTP {probe_results[0].http_status} captured"
+            else:
+                status = "Still Unknown"
+                errors = [r.error or "unknown" for r in probe_results]
+                finding = f"Probe error: {errors[0]}"
+
+            probe_names = ", ".join(probes_for_oq)
+            oq_table_rows.append(
+                f"| {oq_id} | {question} | {status} | {finding} | {probe_names} |"
+            )
+        else:
+            oq_table_rows.append(
+                f"| {oq_id} | {question} | Still Unknown | No probe executed for this OQ | — |"
+            )
+
+    # Build report
+    lines = [
+        "# Target API Staging Discovery Report",
+        f"**Date:** {run_timestamp}",
+        f"**Harness version:** {__version__}",
+        f"**Probes executed:** {total}/{total}",
+        f"**Probes succeeded:** {succeeded}",
+        f"**Probes skipped:** {skipped} (operator approval required)",
+        f"**Probes failed:** {failed}",
+        "",
+        "## OQ Resolution Table",
+        "| OQ # | Question | Status | Finding | Probe |",
+        "|------|----------|--------|---------|-------|",
+        *oq_table_rows,
+        "",
+        "## Observed Schemas",
+    ]
+
+    for r in results:
+        if r.error is None and r.http_status > 0 and r.response_body:
+            lines.append(f"### {r.operation_id} ({r.http_status})")
+            lines.append(f"Response keys: {sorted(r.response_body.keys()) if isinstance(r.response_body, dict) else 'non-dict'}")
+            lines.append("")
+
+    lines.extend([
+        "## Enum Values Captured",
+        "| Field | Values Observed | Previous Spec | Delta |",
+        "|-------|----------------|---------------|-------|",
+    ])
+    for r in results:
+        for delta in r.schema_deltas:
+            if "values:" in delta.lower() or "enum" in delta.lower():
+                lines.append(f"| {r.operation_id} | {delta} | (see spec) | NEW |")
+    lines.append("")
+
+    lines.extend([
+        "## Rate Limit Measurements",
+        "| Endpoint | Burst Size | First 429 At | P50 (ms) | P95 (ms) | Retry-After |",
+        "|----------|-----------|-------------|----------|----------|-------------|",
+    ])
+    for r in results:
+        if r.burst_result:
+            br = r.burst_result
+            lines.append(
+                f"| {r.operation_id} | {br.burst_size} | "
+                f"{br.first_429_at or 'N/A'} | "
+                f"{br.latency_p50_ms:.1f} | {br.latency_p95_ms:.1f} | "
+                f"{br.retry_after_header or 'N/A'} |"
+            )
+    lines.append("")
+
+    lines.extend([
+        "## Error Envelope Shape",
+    ])
+    error_results = [r for r in results if r.probe_name == "probe_error_envelope_induction"]
+    if error_results:
+        for r in error_results:
+            lines.append(f"Status: {r.http_status}")
+            for delta in r.schema_deltas:
+                lines.append(f"- {delta}")
+    else:
+        lines.append("Error envelope probe did not execute.")
+    lines.append("")
+
+    lines.extend([
+        "## Spec Patch Summary",
+        "| Field | Previous Confidence | New Confidence | Note |",
+        "|-------|-------------------|----------------|------|",
+    ])
+    for r in results:
+        if r.error is None and r.http_status > 0:
+            for delta in r.schema_deltas:
+                lines.append(f"| {r.operation_id} | unknown | verified | {delta} |")
+    lines.append("")
+
+    report_path.parent.mkdir(parents=True, exist_ok=True)
+    report_path.write_text("\n".join(lines), encoding="utf-8")
+
+
+@cli.command()
+@click.option(
+    "--approved-writes",
+    is_flag=True,
+    default=False,
+    help="Enable operator-approved write probes (OQ-6, OQ-10). Default: disabled.",
+)
+@click.option(
+    "--captures-dir",
+    type=click.Path(),
+    default="tools/target_discovery/captures",
+    help="Directory for captured responses.",
+)
+@click.option(
+    "--report-path",
+    type=click.Path(),
+    default="features/story-007-target-staging-discovery/discovery-report.md",
+    help="Output path for the discovery report.",
+)
+def capture_all(approved_writes: bool, captures_dir: str, report_path: str) -> None:
+    """Run all probes against the Target staging API."""
+    captures_path = Path(captures_dir)
+    report_file = Path(report_path)
+    results: list[ProbeResult] = []
+
+    # Load credentials from environment
+    try:
+        client = TargetDiscoveryClient.from_env()
+    except ValueError as e:
+        click.echo(f"[discovery] FATAL: {e}")
+        sys.exit(1)
+
+    creds = client.credential_values()
+    click.echo("[discovery] Loaded credentials from environment")
+
+    # Phase A: Auth validation
+    click.echo("[discovery] Phase A: Validating auth via getShippingMethods...")
+    sm_result = probe_shipping_methods(client)
+    results.append(sm_result)
+    auth_ok = sm_result.error is None and sm_result.http_status not in (401, 403)
+    if sm_result.http_status in (401, 403):
+        click.echo(f"[discovery] WARN: {sm_result.http_status} — credentials may be invalid. Continuing to capture what we can.")
+    elif sm_result.error:
+        click.echo(f"[discovery] WARN: Phase A error — {sm_result.error}. Continuing.")
+    else:
+        click.echo(f"[discovery] Phase A: OK ({sm_result.http_status})")
+    _save_capture(captures_path, "shipping_methods.json", sm_result, creds)
+
+    # Phase B: Reference data
+    click.echo("[discovery] Phase B: Reference data (4 probes)...")
+    tax_result = probe_taxonomy(client)
+    results.append(tax_result)
+    _save_capture(captures_path, "taxonomy.json", tax_result, creds)
+
+    taxonomy_id = "default"
+    if isinstance(tax_result.response_body, dict):
+        nodes = tax_result.response_body.get("taxonomies", tax_result.response_body.get("nodes", []))
+        if isinstance(nodes, list) and nodes and isinstance(nodes[0], dict):
+            taxonomy_id = str(nodes[0].get("taxonomy_id", nodes[0].get("id", "default")))
+
+    ta_result = probe_taxonomy_assignments(client, taxonomy_id)
+    results.append(ta_result)
+    _save_capture(captures_path, "taxonomy_assignments.json", ta_result, creds)
+
+    attribute_id = "default"
+    if isinstance(ta_result.response_body, dict):
+        attrs = ta_result.response_body.get("attributes", [])
+        if isinstance(attrs, list) and attrs and isinstance(attrs[0], dict):
+            attribute_id = str(attrs[0].get("attribute_id", attrs[0].get("id", "default")))
+
+    tav_result = probe_taxonomy_attribute_values(client, taxonomy_id, attribute_id)
+    results.append(tav_result)
+    _save_capture(captures_path, "taxonomy_attribute_values.json", tav_result, creds)
+
+    dc_result = probe_distribution_centers(client)
+    results.append(dc_result)
+    _save_capture(captures_path, "distribution_centers.json", dc_result, creds)
+
+    # Phase C: Reports
+    click.echo("[discovery] Phase C: Reports (2 probes)...")
+    crr_result = probe_create_report_request(client)
+    results.append(crr_result)
+    _save_capture(captures_path, "report_request_created.json", crr_result, creds)
+
+    lrr_result = probe_list_report_requests(client)
+    results.append(lrr_result)
+    _save_capture(captures_path, "report_requests_list.json", lrr_result, creds)
+
+    # Phase D: Product / listing state
+    click.echo("[discovery] Phase D: Product / listing state (3 probes)...")
+    ps_result = probe_product_status(client, "staging-product-1")
+    results.append(ps_result)
+    _save_capture(captures_path, "product_status.json", ps_result, creds)
+
+    cbd_result = probe_catalog_browse_discovery(client)
+    results.append(cbd_result)
+    _save_capture(captures_path, "catalog_browse_probe.json", cbd_result, creds)
+
+    plt_result = probe_product_logistics_typo(client, "staging-product-1")
+    results.append(plt_result)
+    _save_capture(captures_path, "product_logistics_typo_probe.json", plt_result, creds)
+
+    # Phase E: Orders and fulfillment
+    click.echo("[discovery] Phase E: Orders and fulfillment (2 probes)...")
+    ro_result = probe_released_orders(client)
+    results.append(ro_result)
+    _save_capture(captures_path, "orders.json", ro_result, creds)
+
+    order_id = "staging-order-1"
+    if isinstance(ro_result.response_body, dict):
+        orders = ro_result.response_body.get("orders", [])
+        if isinstance(orders, list) and orders and isinstance(orders[0], dict):
+            order_id = str(orders[0].get("order_id", "staging-order-1"))
+
+    oa_result = probe_order_address(client, order_id)
+    results.append(oa_result)
+    _save_capture(captures_path, "order_address.json", oa_result, creds)
+
+    # Phase F: Reporting endpoints
+    click.echo("[discovery] Phase F: Reporting endpoints (3 probes)...")
+    pr_result = probe_product_returns(client)
+    results.append(pr_result)
+    _save_capture(captures_path, "product_returns.json", pr_result, creds)
+
+    pay_result = probe_payouts(client)
+    results.append(pay_result)
+    _save_capture(captures_path, "payouts.json", pay_result, creds)
+
+    le_result = probe_listing_errors(client)
+    results.append(le_result)
+    _save_capture(captures_path, "listing_errors.json", le_result, creds)
+
+    # Phase G: Error envelope induction
+    click.echo("[discovery] Phase G: Error envelope induction...")
+    eei_result = probe_error_envelope_induction(client)
+    results.append(eei_result)
+    _save_capture(captures_path, "error_envelopes.json", eei_result, creds)
+
+    # Phase H: Auth / token
+    click.echo("[discovery] Phase H: Auth / token...")
+    te_result = probe_token_expiry(client)
+    results.append(te_result)
+    _save_capture(captures_path, "auth_probe.json", te_result, creds)
+
+    # Phase I: Async report resolution
+    click.echo("[discovery] Phase I: Async report resolution...")
+    request_id = "latest"
+    if isinstance(crr_result.response_body, dict):
+        request_id = str(crr_result.response_body.get("request_id", "latest"))
+    grr_result = probe_get_report_request(client, request_id)
+    results.append(grr_result)
+    _save_capture(captures_path, "report_request_detail.json", grr_result, creds)
+
+    # Phase J: Operator-approved writes
+    click.echo("[discovery] Phase J: Operator-approved writes...")
+    if approved_writes:
+        bped_result = probe_bulk_product_endpoint_discovery(client)
+        results.append(bped_result)
+        _save_capture(captures_path, "bulk_product_probe.json", bped_result, creds)
+
+        cre_result = probe_cancellation_reason_enum(client, "staging-order-line-1")
+        results.append(cre_result)
+    else:
+        # Skip and record
+        bped_result = ProbeResult(
+            probe_name="probe_bulk_product_endpoint_discovery",
+            operation_id="bulkProductEndpointDiscovery",
+            http_status=0,
+            oqs_resolved=["OQ-6"],
+            error="SKIPPED — requires operator approval (--approved-writes)",
+        )
+        results.append(bped_result)
+        cre_result = ProbeResult(
+            probe_name="probe_cancellation_reason_enum",
+            operation_id="cancelOrderLine",
+            http_status=0,
+            oqs_resolved=["OQ-10"],
+            error="SKIPPED — requires operator approval. Deferred to STORY-009.",
+        )
+        results.append(cre_result)
+
+    # Write report
+    run_ts = datetime.now(timezone.utc).isoformat()
+    click.echo(f"[discovery] Captures written to {captures_dir}/")
+    _write_report(report_file, results, run_ts)
+    click.echo(f"[discovery] discovery-report.md written to {report_path}")
+
+    succeeded = sum(1 for r in results if r.error is None and r.http_status > 0)
+    skipped = sum(1 for r in results if r.error and "SKIPPED" in r.error)
+    total = len(results)
+    click.echo(f"[discovery] Summary: {succeeded}/{total} probes succeeded, {skipped} skipped (operator approval required)")
+
+    # OQ summary
+    all_oqs = set()
+    resolved_oqs = set()
+    for r in results:
+        for oq in r.oqs_resolved:
+            all_oqs.add(oq)
+            if r.error is None and r.http_status > 0:
+                resolved_oqs.add(oq)
+    still_unknown = all_oqs - resolved_oqs
+    click.echo(f"[discovery] OQ resolution: {len(resolved_oqs)} resolved, {len(still_unknown)} still unknown")
+
+    click.echo("[discovery] complete")
+
+    # Exit with error if majority of probes failed
+    if succeeded < total * 0.5:
+        sys.exit(1)
+
+
+if __name__ == "__main__":
+    cli()
