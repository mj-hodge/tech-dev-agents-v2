+"""Gate 2a — External API Isolation.
+
+Asserts that no probe ever reaches https://api.target.com (production).
+All outbound HTTP must go to https://stage-api.target.com.
+
+RED state: stub probe returns http_status=0 and error="Not yet implemented",
+so assertions on http_status==200 and error is None will FAIL.
+"""
+
+from __future__ import annotations
+
+import re
+
+import pytest
+import respx
+import httpx
+
+from tools.target_discovery.client import TargetDiscoveryClient
+from tools.target_discovery import probes
+
+
+PRODUCTION_URL_PATTERN = re.compile(r"https://api\.target\.com/.*")
+STAGING_URL_PATTERN = re.compile(r"https://stage-api\.target\.com/.*")
+
+
+@pytest.fixture
+def staging_client() -> TargetDiscoveryClient:
+    return TargetDiscoveryClient(
+        base_url="https://stage-api.target.com",
+        api_key="test-api-key",
+        seller_id="test-seller-id",
+        seller_token="test-seller-token",
+    )
+
+
+@respx.mock
+def test_no_call_to_production_url(staging_client: TargetDiscoveryClient) -> None:
+    """Assert zero HTTP calls reach api.target.com (production) during a probe.
+
+    respx blocks all unrouted calls by default — if a call to production
+    slips through, respx raises an error. We also explicitly assert the
+    production route was never matched.
+    """
+    # Route staging calls with a 200 response
+    respx.get(STAGING_URL_PATTERN).mock(
+        return_value=httpx.Response(200, json={"shipping_methods": []})
+    )
+
+    # Explicitly route production to detect accidental calls
+    production_route = respx.get(PRODUCTION_URL_PATTERN).mock(
+        return_value=httpx.Response(403, json={"error": "production blocked"})
+    )
+
+    result = probes.probe_shipping_methods(staging_client)
+
+    # Gate 2a: zero calls must have hit the production host
+    assert production_route.called is False, (
+        "A probe call reached https://api.target.com (production). "
+        "All traffic must stay on stage-api.target.com."
+    )
+
+    # These will FAIL in stub state (http_status=0, error set) → RED
+    assert result.http_status == 200, (
+        f"Expected probe http_status 200, got {result.http_status}"
+    )
+    assert result.error is None, (
+        f"Expected probe error to be None, got: {result.error!r}"
+    )
+
+
+@respx.mock
+def test_probe_result_has_no_production_url_in_body(
+    staging_client: TargetDiscoveryClient,
+) -> None:
+    """Assert the probe response body doesn't contain the production URL string."""
+    respx.get(STAGING_URL_PATTERN).mock(
+        return_value=httpx.Response(200, json={"data": "ok"})
+    )
+
+    result = probes.probe_shipping_methods(staging_client)
+
+    body_str = str(result.response_body)
+    assert "https://api.target.com" not in body_str, (
+        "Production URL leaked into probe response body."
+    )
+
+    # Will FAIL in stub state → RED
+    assert result.http_status == 200, (
+        f"Expected http_status 200, got {result.http_status}"
+    )
