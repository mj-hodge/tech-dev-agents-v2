+"""Assert that credential values never appear in CLI output or captured files.
+
+RED state: the CLI stub just echoes "[discovery] Not yet implemented" and
+exits 0. The assertions that check for discovery output content (OQ resolution,
+probe results) will FAIL because the stub produces no substantive output.
+We also verify exit_code == 0 so import errors don't mask the real RED reason.
+"""
+
+from __future__ import annotations
+
+import pytest
+from click.testing import CliRunner
+
+from tools.target_discovery.cli import capture_all
+from tools.target_discovery.redact import redact_response, redact_headers
+
+# Test credential values — must NEVER appear in any output
+TEST_API_KEY = "test-api-key"
+TEST_SELLER_ID = "test-seller-id"
+TEST_SELLER_TOKEN = "test-seller-token"
+CREDENTIAL_VALUES = [TEST_API_KEY, TEST_SELLER_ID, TEST_SELLER_TOKEN]
+
+
+def test_cli_exits_without_credential_in_stdout(tmp_path: pytest.TempPathFactory) -> None:
+    """The CLI must not echo raw credential values to stdout."""
+    runner = CliRunner()
+    result = runner.invoke(
+        capture_all,
+        [
+            "--captures-dir",
+            str(tmp_path),
+            "--report-path",
+            str(tmp_path / "report.md"),
+        ],
+        env={
+            "TARGET_API_KEY": TEST_API_KEY,
+            "TARGET_SELLER_ID": TEST_SELLER_ID,
+            "TARGET_SELLER_TOKEN": TEST_SELLER_TOKEN,
+        },
+        catch_exceptions=False,
+    )
+
+    # Any credential that leaks into stdout is a hard failure
+    combined_output = (result.output or "") + (result.stderr if hasattr(result, "stderr") else "")
+    for credential in CREDENTIAL_VALUES:
+        assert credential not in combined_output, (
+            f"Credential value {credential!r} leaked into CLI output. "
+            "All credential values must be redacted before output."
+        )
+
+    # Stub produces no meaningful discovery output → this assertion fails (RED)
+    assert "[discovery] complete" in combined_output, (
+        "Expected '[discovery] complete' marker in CLI output. "
+        "Stub only prints '[discovery] Not yet implemented' — RED state."
+    )
+
+
+def test_redact_response_removes_credential_values() -> None:
+    """redact_response() must replace credential values wherever they appear.
+
+    RED state: stub redact_response() returns input unchanged, so
+    credential values remain in the dict → assertion fails.
+    """
+    response_with_leak = {
+        "message": f"Auth failed for key {TEST_API_KEY}",
+        "seller": TEST_SELLER_ID,
+        "token_hint": TEST_SELLER_TOKEN[:4],
+        "data": {"nested_leak": TEST_API_KEY},
+    }
+
+    redacted = redact_response(response_with_leak, CREDENTIAL_VALUES)
+
+    for credential in CREDENTIAL_VALUES:
+        # Check top-level and nested values by converting to string
+        redacted_str = str(redacted)
+        assert credential not in redacted_str, (
+            f"Credential {credential!r} still present in redacted response. "
+            "redact_response() must scrub all credential values from the output."
+        )
+
+
+def test_redact_headers_removes_credential_values() -> None:
+    """redact_headers() must replace credential values in header dicts.
+
+    RED state: stub redact_headers() returns headers unchanged → assertion fails.
+    """
+    headers_with_creds = {
+        "x-api-key": TEST_API_KEY,
+        "x-seller-id": TEST_SELLER_ID,
+        "x-seller-token": TEST_SELLER_TOKEN,
+        "content-type": "application/json",
+    }
+
+    redacted = redact_headers(headers_with_creds, CREDENTIAL_VALUES)
+
+    for credential in CREDENTIAL_VALUES:
+        assert credential not in redacted.values(), (
+            f"Credential {credential!r} still present in redacted headers. "
+            "redact_headers() must scrub all credential values."
+        )
+
+    # Non-credential header must survive redaction
+    assert redacted.get("content-type") == "application/json", (
+        "Non-credential header 'content-type' must not be removed by redaction."
+    )
