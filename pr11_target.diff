+"""Assert that the discovery report resolves all required Open Questions.
+
+RED state: discovery-report.md does not exist yet (it's produced by running
+the harness against staging). All tests in this file will FAIL with
+FileNotFoundError or assertion errors — this is the intended RED state.
+
+GREEN state: achieved after Phase 8 implementation runs the harness and
+produces features/story-007-target-staging-discovery/discovery-report.md.
+"""
+
+from __future__ import annotations
+
+import re
+from pathlib import Path
+
+import pytest
+
+REPORT_PATH = Path(
+    "features/story-007-target-staging-discovery/discovery-report.md"
+)
+
+# OQs that the harness must resolve (from analysis.md)
+REQUIRED_OQS = [
+    "OQ-1",
+    "OQ-3",
+    "OQ-5",
+    "OQ-6",
+    "OQ-7",
+    "OQ-8",
+    "OQ-9",
+    "OQ-10",
+    "OQ-11",
+    "OQ-12",
+    "OQ-13",
+    "OQ-19",
+    "OQ-20",
+]
+
+VALID_STATUSES = {"Resolved", "Still Unknown"}
+
+
+@pytest.fixture
+def report_text() -> str:
+    """Read the discovery report, skipping gracefully if it doesn't exist.
+
+    The test_report_exists() test handles the FAILED assertion for the missing file.
+    Other report-content tests are skipped until the file exists.
+    """
+    if not REPORT_PATH.exists():
+        pytest.skip(
+            f"Discovery report not found at {REPORT_PATH}. "
+            "Run the discovery harness to generate it. "
+            "See test_report_exists for the FAILED assertion."
+        )
+    return REPORT_PATH.read_text(encoding="utf-8")
+
+
+def test_report_exists() -> None:
+    """The discovery report must exist after the harness runs.
+
+    RED state: file doesn't exist → FAIL.
+    """
+    assert REPORT_PATH.exists(), (
+        f"Discovery report not found: {REPORT_PATH}\n"
+        "Run the harness to generate it. Expected RED state before Phase 8."
+    )
+
+
+def test_all_required_oqs_present(report_text: str) -> None:
+    """Every required OQ must appear in the discovery report."""
+    for oq in REQUIRED_OQS:
+        assert oq in report_text, (
+            f"OQ {oq!r} not found in discovery report. "
+            "All 13 required OQs must be addressed."
+        )
+
+
+def test_each_oq_has_valid_status(report_text: str) -> None:
+    """Each required OQ entry must include 'Resolved' or 'Still Unknown'."""
+    for oq in REQUIRED_OQS:
+        # Find a paragraph/section around the OQ reference
+        # Expect patterns like: "OQ-1 ... Resolved" or "OQ-1 ... Still Unknown"
+        pattern = re.compile(
+            rf"{re.escape(oq)}.{{0,500}}({'|'.join(VALID_STATUSES)})",
+            re.DOTALL,
+        )
+        match = pattern.search(report_text)
+        assert match is not None, (
+            f"OQ {oq!r} does not have a valid status (Resolved / Still Unknown) "
+            f"within 500 chars of its mention in the report."
+        )
+
+
+def test_oq_resolution_count(report_text: str) -> None:
+    """At least half the required OQs should be marked 'Resolved' (not all unknown)."""
+    resolved_count = sum(
+        1
+        for oq in REQUIRED_OQS
+        if re.search(
+            rf"{re.escape(oq)}.{{0,200}}Resolved",
+            report_text,
+            re.DOTALL,
+        )
+    )
+    min_resolved = len(REQUIRED_OQS) // 2
+    assert resolved_count >= min_resolved, (
+        f"Only {resolved_count}/{len(REQUIRED_OQS)} OQs are marked Resolved. "
+        f"Expected at least {min_resolved}. "
+        "The harness should resolve the majority of open questions."
+    )
