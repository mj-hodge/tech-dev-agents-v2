+"""TargetDiscoveryClient — DI'd httpx.Client wrapper for Target staging API."""
+
+from __future__ import annotations
+
+import os
+from dataclasses import dataclass
+from typing import Any
+
+import httpx
+
+
+@dataclass
+class TargetDiscoveryClient:
+    """Thin httpx wrapper for Target staging API calls.
+
+    Never instantiated with production URL. All probes receive this as a
+    parameter; tests inject a mock via respx.
+    """
+
+    base_url: str = "https://stage-api.target.com"
+    api_key: str = ""
+    seller_id: str = ""
+    seller_token: str = ""
+
+    @classmethod
+    def from_env(cls) -> "TargetDiscoveryClient":
+        """Build a client from environment variables.
+
+        Raises ValueError if any required variable is missing.
+        """
+        missing: list[str] = []
+        api_key = os.environ.get("TARGET_API_KEY", "")
+        seller_id = os.environ.get("TARGET_SELLER_ID", "")
+        seller_token = os.environ.get("TARGET_SELLER_TOKEN", "")
+
+        if not api_key:
+            missing.append("TARGET_API_KEY")
+        if not seller_id:
+            missing.append("TARGET_SELLER_ID")
+        if not seller_token:
+            missing.append("TARGET_SELLER_TOKEN")
+
+        if missing:
+            raise ValueError(
+                f"Missing required environment variables: {', '.join(missing)}"
+            )
+
+        return cls(
+            base_url="https://stage-api.target.com",
+            api_key=api_key,
+            seller_id=seller_id,
+            seller_token=seller_token,
+        )
+
+    def _headers(self) -> dict[str, str]:
+        """Build auth headers. Never log the return value."""
+        return {
+            "x-api-key": self.api_key,
+            "x-seller-id": self.seller_id,
+            "x-seller-token": self.seller_token,
+            "Accept": "application/json",
+        }
+
+    def credential_values(self) -> list[str]:
+        """Return list of credential strings that must never appear in logs."""
+        return [v for v in [self.api_key, self.seller_id, self.seller_token] if v]
+
+    def get(
+        self,
+        path: str,
+        params: dict[str, Any] | None = None,
+        timeout: float = 30.0,
+    ) -> httpx.Response:
+        """Execute GET against staging. Returns raw httpx.Response."""
+        with httpx.Client(base_url=self.base_url, headers=self._headers()) as client:
+            return client.get(path, params=params, timeout=timeout)
+
+    def post(
+        self,
+        path: str,
+        json: dict[str, Any] | None = None,
+        params: dict[str, Any] | None = None,
+        timeout: float = 30.0,
+    ) -> httpx.Response:
+        """Execute POST against staging. Only used for safe report creation."""
+        with httpx.Client(base_url=self.base_url, headers=self._headers()) as client:
+            return client.post(path, json=json, params=params, timeout=timeout)
