+"""Assert TargetDiscoveryClient always defaults to staging and routes via httpx.
+
+RED state: client.get() in stub state does NOT use httpx (returns a bare
+httpx.Response without any network call), so respx_mock.calls will be empty
+→ the assertion `len(respx_mock.calls) == 1` will FAIL.
+"""
+
+from __future__ import annotations
+
+import pytest
+import respx
+import httpx
+
+from tools.target_discovery.client import TargetDiscoveryClient
+
+
+def test_default_base_url_is_staging() -> None:
+    """Direct construction with no base_url must default to stage-api.target.com."""
+    client = TargetDiscoveryClient(
+        api_key="k",
+        seller_id="s",
+        seller_token="t",
+    )
+    assert client.base_url == "https://stage-api.target.com", (
+        f"Default base_url must be staging, got: {client.base_url!r}"
+    )
+
+
+def test_from_env_sets_staging_base_url(monkeypatch: pytest.MonkeyPatch) -> None:
+    """from_env() must always produce a client pointing at stage-api.target.com."""
+    monkeypatch.setenv("TARGET_API_KEY", "env-api-key")
+    monkeypatch.setenv("TARGET_SELLER_ID", "env-seller-id")
+    monkeypatch.setenv("TARGET_SELLER_TOKEN", "env-seller-token")
+
+    client = TargetDiscoveryClient.from_env()
+
+    assert client.base_url == "https://stage-api.target.com", (
+        f"from_env() base_url must be staging, got: {client.base_url!r}"
+    )
+
+
+def test_from_env_raises_on_missing_vars(monkeypatch: pytest.MonkeyPatch) -> None:
+    """from_env() must raise ValueError when env vars are absent."""
+    monkeypatch.delenv("TARGET_API_KEY", raising=False)
+    monkeypatch.delenv("TARGET_SELLER_ID", raising=False)
+    monkeypatch.delenv("TARGET_SELLER_TOKEN", raising=False)
+
+    with pytest.raises(ValueError, match="TARGET_API_KEY"):
+        TargetDiscoveryClient.from_env()
+
+
+@respx.mock
+def test_get_routes_through_httpx(mock_client: TargetDiscoveryClient) -> None:  # type: ignore[misc]
+    """client.get() must route the request through httpx so respx can intercept it.
+
+    RED state: stub get() returns httpx.Response(200, json={}) directly without
+    using httpx, so respx_mock.calls will be empty → assertion fails.
+    """
+    respx.get("https://stage-api.target.com/shipping_methods").mock(
+        return_value=httpx.Response(200, json={"methods": []})
+    )
+
+    client = TargetDiscoveryClient(
+        base_url="https://stage-api.target.com",
+        api_key="test-api-key",
+        seller_id="test-seller-id",
+        seller_token="test-seller-token",
+    )
+    client.get("/shipping_methods")
+
+    # Will FAIL in stub state because stub doesn't call httpx → RED
+    assert len(respx.calls) == 1, (
+        f"Expected exactly 1 httpx call via respx, got {len(respx.calls)}. "
+        "client.get() must use httpx.Client internally."
+    )
+
+
+def test_production_url_never_hardcoded() -> None:
+    """Instantiating TargetDiscoveryClient must never default to production URL."""
+    client = TargetDiscoveryClient(
+        api_key="k",
+        seller_id="s",
+        seller_token="t",
+    )
+    assert "api.target.com" not in client.base_url or "stage-api.target.com" in client.base_url, (
+        "Default base_url must not point to production api.target.com"
+    )
+    # Positive form — must contain 'stage'
+    assert "stage" in client.base_url, (
+        f"Default base_url should contain 'stage', got: {client.base_url!r}"
+    )
