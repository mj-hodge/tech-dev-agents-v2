+#!/usr/bin/env python3
+"""
+scripts/ops/budget_recovery.py — Emergency Budget Recovery CLI.
+
+Refactored from scripts/local_budget_update.py with:
+  - Imports normalize_portfolio_name and select_portfolio_match from
+    src.services.bg_name_matching (no local copies)
+  - build_plan() as a pure, testable function with threshold/decrease/limit guards
+  - load_plan_csv() for replaying pre-approved plans
+  - write_recovery_log() for audit trail in manual_recovery_log
+  - --csv-only: write plan CSV, no Amazon writes
+  - --from-csv: replay pre-approved CSV plan
+  - --limit N: staged rollout cap
+  - --threshold-pct: skip small-percentage changes
+  - --max-decrease-pct: block dangerously large budget cuts
+
+Usage:
+  # Dry run (shows plan, no writes)
+  python3 scripts/ops/budget_recovery.py --dry-run
+
+  # Generate plan CSV only (no Amazon writes at all)
+  python3 scripts/ops/budget_recovery.py --csv-only
+
+  # Apply from a pre-approved CSV plan
+  python3 scripts/ops/budget_recovery.py --from-csv /tmp/plan.csv --apply
+
+  # Live apply with guards
+  python3 scripts/ops/budget_recovery.py --apply --threshold-pct 5 --max-decrease-pct 30
+
+Env requirements:
+  AZ_KV_NAME = kv-mcp-ads (default)
+  PROFILE_ID = 227976850102089 (default)
+  Logged into az CLI to access KV secrets
+"""
+from __future__ import annotations
+
+import argparse
+import csv
+import json
+import os
+import subprocess
+import sys
+import urllib.parse
+import urllib.request
+from datetime import datetime, timezone
+from typing import Any
+
+import pathlib
+
+# Ensure repo root is in sys.path for src.* imports
+_REPO_ROOT = pathlib.Path(__file__).parent.parent.parent
+if str(_REPO_ROOT) not in sys.path:
+    sys.path.insert(0, str(_REPO_ROOT))
+
+from src.services.bg_name_matching import normalize_portfolio_name, select_portfolio_match
+
+
+# ---------------------------------------------------------------------------
+# Pure helper for portfolio name extraction
+# ---------------------------------------------------------------------------
+
+def _portfolio_name(record: dict) -> str:
+    """Return the first non-empty name field from a portfolio record."""
+    for key in ("portfolioName", "portfolio_name", "api_name", "name"):
+        v = record.get(key)
+        if isinstance(v, str) and v.strip():
+            return v.strip()
+    return ""
+
+
+# ---------------------------------------------------------------------------
+# Core plan-building function — NO HTTP calls allowed here
+# ---------------------------------------------------------------------------
+
+def build_plan(
+    guidance_rows: list[dict],
+    portfolios: list[dict],
+    day_label: str,
+    *,
+    threshold_pct: float = 0.0,
+    max_decrease_pct: float | None = None,
+    limit: int | None = None,
+) -> list[dict]:
+    """Return list of plan dicts with keys:
+       parent, portfolio_id, portfolio_name, current_cap, guidance_daily, delta,
+       current_budget.
+
+    This function is pure: it makes zero HTTP calls. All external API calls
+    must remain in main() and helper functions.
+    """
+    plan: list[dict] = []
+
+    for row in guidance_rows:
+        parent = str(row.get("parent", "")).strip()
+        if not parent:
+            continue
+
+        daily = row.get("daily") or {}
+        guidance_daily = float(daily.get(day_label, 0) or 0)
+        if guidance_daily <= 0:
+            continue
+
+        match = select_portfolio_match(parent, portfolios)
+        if match is None:
+            continue
+
+        portfolio_id = str(match.get("portfolioId") or match.get("portfolio_id") or "")
+        portfolio_name_str = _portfolio_name(match)
+
+        budget = match.get("budget") or {}
+        try:
+            current_cap = float(budget.get("amount") or 0)
+        except (TypeError, ValueError):
+            current_cap = 0.0
+
+        delta = round(guidance_daily - current_cap, 2)
+
+        if abs(delta) < 0.01:
+            continue
+
+        if threshold_pct > 0 and current_cap > 0:
+            if abs(delta) / current_cap * 100 < threshold_pct:
+                continue
+
+        if max_decrease_pct is not None and delta < 0 and current_cap > 0:
+            if abs(delta) / current_cap * 100 > max_decrease_pct:
+                continue
+
+        plan.append({
+            "parent": parent,
+            "portfolio_id": portfolio_id,
+            "portfolio_name": portfolio_name_str,
+            "current_cap": current_cap,
+            "guidance_daily": guidance_daily,
+            "delta": delta,
+            "current_budget": budget,
+        })
+
+    if limit is not None:
+        plan = plan[:limit]
+
+    return plan
+
+
+# ---------------------------------------------------------------------------
+# CSV loader for --from-csv replay
+# ---------------------------------------------------------------------------
+
+def load_plan_csv(path: str) -> list[dict]:
+    """Read a pre-approved plan CSV and return rows as list of dicts.
+
+    Each dict has at minimum: portfolio_id, guidance_daily.
+    Values are returned as strings (no conversion) — callers convert as needed.
+    """
+    rows: list[dict] = []
+    with open(path, newline="") as f:
+        reader = csv.DictReader(f)
+        for row in reader:
+            rows.append(dict(row))
+    return rows
+
+
+# ---------------------------------------------------------------------------
+# Audit trail
+# ---------------------------------------------------------------------------
+
+def write_recovery_log(
+    conn,
+    operator: str,
+    plan_path: str,
+    succeeded: int,
+    failed: int,
+    plan_hash: str,
+) -> None:
+    """INSERT into manual_recovery_log for audit trail."""
+    cur = conn.cursor()
+    cur.execute(
+        """
+        INSERT INTO manual_recovery_log
+            (operator, plan_path, succeeded, failed, plan_hash, executed_at)
+        VALUES
+            (%s, %s, %s, %s, %s, NOW())
+        """,
+        (operator, plan_path, succeeded, failed, plan_hash),
+    )
+    conn.commit()
+
+
+# ---------------------------------------------------------------------------
+# Credential / data helpers (all HTTP calls live here, never in build_plan)
+# ---------------------------------------------------------------------------
+
+def az_secret(vault: str, name: str) -> str:
+    """Read a Key Vault secret via az CLI (assumes user is logged in)."""
+    result = subprocess.run(
+        [
+            "az", "keyvault", "secret", "show",
+            "--vault-name", vault,
+            "--name", name,
+            "--query", "value",
+            "-o", "tsv",
+        ],
+        capture_output=True, text=True, timeout=30,
+    )
+    if result.returncode != 0:
+        raise RuntimeError(
+            f"az keyvault secret show failed for {name}: {result.stderr.strip()}"
+        )
+    return result.stdout.strip()
+
+
+def get_lwa_credentials(
+    prod_db_url: str,
+    encryption_key: str,
+    lwa_client_id: str,
+    lwa_client_secret: str,
+) -> tuple[str, str]:
+    """Decrypt LWA refresh token from oauth_tokens, exchange for access_token.
+
+    Returns (access_token, lwa_client_id).
+    """
+    import psycopg2
+    from cryptography.fernet import Fernet
+
+    parts = urllib.parse.urlparse(prod_db_url.replace("+asyncpg", ""))
+    conn = psycopg2.connect(
+        dbname=parts.path[1:],
+        user=urllib.parse.unquote(parts.username),
+        password=urllib.parse.unquote(parts.password),
+        host=parts.hostname,
+        port=parts.port,
+        sslmode="require",
+    )
+    cur = conn.cursor()
+    cur.execute("SELECT refresh_token FROM oauth_tokens WHERE user_id = 3 LIMIT 1")
+    row = cur.fetchone()
+    if not row:
+        raise RuntimeError("No oauth_tokens row found")
+    fernet = Fernet(encryption_key.encode())
+    refresh_token = fernet.decrypt(row[0].encode()).decode()
+
+    data = urllib.parse.urlencode({
+        "grant_type": "refresh_token",
+        "refresh_token": refresh_token,
+        "client_id": lwa_client_id,
+        "client_secret": lwa_client_secret,
+    }).encode()
+    req = urllib.request.Request(
+        "https://api.amazon.com/auth/o2/token", data=data, method="POST"
+    )
+    req.add_header("Content-Type", "application/x-www-form-urlencoded")
+    payload = json.loads(urllib.request.urlopen(req, timeout=30).read())
+    return payload["access_token"], lwa_client_id
+
+
+def get_guidance(prod_db_url: str) -> list[dict]:
+    """Pull active guidance rows from guidance_files table."""
+    import psycopg2
+
+    parts = urllib.parse.urlparse(prod_db_url.replace("+asyncpg", ""))
+    conn = psycopg2.connect(
+        dbname=parts.path[1:],
+        user=urllib.parse.unquote(parts.username),
+        password=urllib.parse.unquote(parts.password),
+        host=parts.hostname,
+        port=parts.port,
+        sslmode="require",
+    )
+    cur = conn.cursor()
+    cur.execute(
+        "SELECT parsed_rows::text FROM guidance_files WHERE is_active = TRUE LIMIT 1"
+    )
+    row = cur.fetchone()
+    if not row:
+        raise RuntimeError("No active guidance file found")
+    return json.loads(row[0])
+
+
+def get_portfolios(
+    access_token: str, lwa_client_id: str, profile_id: str
+) -> list[dict]:
+    """POST /portfolios/list with v3 Accept."""
+    body = json.dumps({"maxResults": 500}).encode()
+    req = urllib.request.Request(
+        "https://advertising-api.amazon.com/portfolios/list", data=body, method="POST"
+    )
+    req.add_header("Authorization", f"Bearer {access_token}")
+    req.add_header("Amazon-Advertising-API-ClientId", lwa_client_id)
+    req.add_header("Amazon-Advertising-API-Scope", profile_id)
+    req.add_header("Content-Type", "application/vnd.portfolio.v3+json")
+    req.add_header("Accept", "application/vnd.portfolio.v3+json")
+    payload = json.loads(urllib.request.urlopen(req, timeout=60).read())
+    portfolios = payload.get("portfolios", payload) if isinstance(payload, dict) else payload
+    return portfolios
+
+
+def update_portfolio_budget(
+    access_token: str,
+    lwa_client_id: str,
+    profile_id: str,
+    portfolio_id: str,
+    new_amount: float,
+    current_budget: dict,
+    today_yyyy_mm_dd: str,
+) -> dict:
+    """PUT /portfolios v3 to update a portfolio's budget amount.
+
+    Preserves the existing policy from current_budget. For DATE_RANGE
+    daily-cap portfolios, advances startDate to today and clears any
+    stale endDate.
+    """
+    cur_policy = (current_budget.get("policy") or "MONTHLY_RECURRING").upper()
+    budget = {
+        "amount": round(float(new_amount), 2),
+        "currencyCode": current_budget.get("currencyCode") or "USD",
+        "policy": cur_policy,
+    }
+    if cur_policy == "DATE_RANGE":
+        budget["startDate"] = today_yyyy_mm_dd
+        budget["endDate"] = None
+    body = json.dumps({
+        "portfolios": [
+            {
+                "portfolioId": str(portfolio_id),
+                "budget": budget,
+            }
+        ]
+    }).encode()
+    req = urllib.request.Request(
+        "https://advertising-api.amazon.com/portfolios", data=body, method="PUT"
+    )
+    req.add_header("Authorization", f"Bearer {access_token}")
+    req.add_header("Amazon-Advertising-API-ClientId", lwa_client_id)
+    req.add_header("Amazon-Advertising-API-Scope", profile_id)
+    req.add_header("Content-Type", "application/vnd.portfolio.v3+json")
+    req.add_header("Accept", "application/vnd.portfolio.v3+json")
+    try:
+        resp = urllib.request.urlopen(req, timeout=30)
+        return {"status": "success", "code": resp.status, "body": resp.read().decode()[:500]}
+    except urllib.error.HTTPError as e:
+        return {"status": "error", "code": e.code, "body": e.read().decode()[:500]}
+
+
+# ---------------------------------------------------------------------------
+# Main entry point
+# ---------------------------------------------------------------------------
+
+def main() -> int:
+    p = argparse.ArgumentParser(
+        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
+    )
+    p.add_argument("--dry-run", action="store_true", help="Show plan, no Amazon writes")
+    p.add_argument("--apply", action="store_true", help="Write budgets to Amazon Ads API")
+    p.add_argument("--parent", default=None, help="Limit to a single parent")
+    p.add_argument("--day", default=None, help="Day-of-week label (Mon, Tue, ...). Default: today.")
+    p.add_argument("--profile-id", default="227976850102089")
+    p.add_argument("--vault", default="kv-mcp-ads")
+    p.add_argument("--limit", type=int, default=None, help="Cap plan at N entries for staged rollout")
+    p.add_argument("--threshold-pct", type=float, default=0.0,
+                   help="Skip changes smaller than N%% of current cap")
+    p.add_argument("--max-decrease-pct", type=float, default=None,
+                   help="Block budget decreases larger than N%% of current cap")
+    p.add_argument("--csv-only", action="store_true",
+                   help="Write plan CSV and exit without any Amazon writes")
+    p.add_argument("--from-csv", default=None, metavar="FILE",
+                   help="Replay a pre-approved plan CSV instead of discovering via API")
+    args = p.parse_args()
+
+    # --csv-only is compatible with neither --apply nor --from-csv apply
+    if not args.csv_only and not args.from_csv:
+        if args.apply == args.dry_run:
+            print("ERROR: pass exactly one of --apply or --dry-run", file=sys.stderr)
+            return 2
+
+    # -----------------------------------------------------------------------
+    # --from-csv mode: load pre-approved plan, apply only those rows
+    # -----------------------------------------------------------------------
+    if args.from_csv:
+        print(f"Loading plan from CSV: {args.from_csv}")
+        csv_rows = load_plan_csv(args.from_csv)
+        print(f"  {len(csv_rows)} rows in plan")
+
+        if args.dry_run:
+            print("DRY-RUN — plan loaded from CSV, no Amazon writes.")
+            for r in csv_rows:
+                print(f"  {r.get('parent','?'):50s}  portfolio={r.get('portfolio_id','?')}  "
+                      f"guidance=${r.get('guidance_daily','?')}")
+            return 0
+
+        if not args.apply:
+            print("ERROR: --from-csv requires --apply or --dry-run", file=sys.stderr)
+            return 2
+
+        print("Loading credentials from KV vault...")
+        db_url = az_secret(args.vault, "database-url")
+        enc_key = az_secret(args.vault, "token-encryption-key")
+        lwa_client_id = az_secret(args.vault, "lwa-client-id")
+        lwa_client_secret = az_secret(args.vault, "lwa-client-secret")
+        access_token, _ = get_lwa_credentials(db_url, enc_key, lwa_client_id, lwa_client_secret)
+
+        today = datetime.now(timezone.utc).strftime("%Y-%m-%d")
+        succeeded = 0
+        failed = 0
+        for entry in csv_rows:
+            current_budget = {}
+            try:
+                current_budget = json.loads(entry.get("current_budget") or "{}")
+            except (json.JSONDecodeError, TypeError):
+                pass
+            result = update_portfolio_budget(
+                access_token=access_token,
+                lwa_client_id=lwa_client_id,
+                profile_id=args.profile_id,
+                portfolio_id=entry["portfolio_id"],
+                new_amount=float(entry["guidance_daily"]),
+                current_budget=current_budget,
+                today_yyyy_mm_dd=today,
+            )
+            if result.get("status") == "success":
+                succeeded += 1
+                mark = "✓"
+            else:
+                failed += 1
+                mark = f"✗ ({result.get('code')})"
+            print(f"  {mark}  {entry.get('parent','?'):50s}  ${entry.get('guidance_daily','?')}")
+
+        print(f"\nDONE  succeeded={succeeded}  failed={failed}")
+        return 0 if failed == 0 else 1
+
+    # -----------------------------------------------------------------------
+    # Normal flow: pull guidance + portfolios, build plan
+    # -----------------------------------------------------------------------
+    print(f"Loading credentials from KV vault {args.vault}...")
+    db_url = az_secret(args.vault, "database-url")
+    enc_key = az_secret(args.vault, "token-encryption-key")
+    lwa_client_id = az_secret(args.vault, "lwa-client-id")
+    lwa_client_secret = az_secret(args.vault, "lwa-client-secret")
+
+    print("Decrypting LWA token + getting access_token...")
+    access_token, _ = get_lwa_credentials(db_url, enc_key, lwa_client_id, lwa_client_secret)
+
+    print("Pulling guidance from prod DB...")
+    guidance_rows = get_guidance(db_url)
+    print(f"  {len(guidance_rows)} guidance rows")
+
+    print("Pulling portfolios from Amazon Ads API...")
+    portfolios = get_portfolios(access_token, lwa_client_id, args.profile_id)
+    print(f"  {len(portfolios)} portfolios from API")
+
+    day_label = args.day or datetime.now(timezone.utc).strftime("%a")
+    print(f"Day label: {day_label}")
+
+    # Filter by --parent if specified
+    if args.parent:
+        guidance_rows = [r for r in guidance_rows if str(r.get("parent", "")).strip() == args.parent]
+
+    plan = build_plan(
+        guidance_rows,
+        portfolios,
+        day_label,
+        threshold_pct=args.threshold_pct,
+        max_decrease_pct=args.max_decrease_pct,
+        limit=args.limit,
+    )
+
+    print()
+    print("=" * 80)
+    print(f"PLAN: {len(plan)} portfolios to update")
+    print("=" * 80)
+
+    # Save plan to CSV
+    plan_path = "/tmp/budget_recovery_plan.csv"
+    with open(plan_path, "w", newline="") as f:
+        if plan:
+            w = csv.DictWriter(
+                f,
+                fieldnames=["parent", "portfolio_id", "portfolio_name",
+                            "current_cap", "guidance_daily", "delta"],
+                extrasaction="ignore",
+            )
+            w.writeheader()
+            w.writerows(plan)
+    print(f"Plan written to {plan_path}")
+
+    if not plan:
+        print("Nothing to update.")
+        return 0
+
+    print()
+    print("=== Top 10 by absolute delta ===")
+    for p_ in sorted(plan, key=lambda x: abs(x["delta"]), reverse=True)[:10]:
+        print(f"  {p_['parent']:50s} cur=${p_['current_cap']:>8.2f}  "
+              f"guidance=${p_['guidance_daily']:>8.2f}  delta=${p_['delta']:>+8.2f}")
+
+    # --csv-only: exit here, no Amazon writes
+    if args.csv_only:
+        print()
+        print("CSV-ONLY — plan written, no Amazon writes. Inspect plan and rerun with --apply.")
+        return 0
+
+    if args.dry_run:
+        print()
+        print("DRY-RUN — no Amazon writes. Inspect plan above and rerun with --apply.")
+        return 0
+
+    # APPLY
+    print()
+    print("=" * 80)
+    print(f"APPLYING {len(plan)} portfolio updates to Amazon Ads...")
+    print("=" * 80)
+    today = datetime.now(timezone.utc).strftime("%Y-%m-%d")
+    succeeded = 0
+    failed = 0
+    results: list[dict] = []
+    for entry in plan:
+        result = update_portfolio_budget(
+            access_token=access_token,
+            lwa_client_id=lwa_client_id,
+            profile_id=args.profile_id,
+            portfolio_id=entry["portfolio_id"],
+            new_amount=entry["guidance_daily"],
+            current_budget=entry["current_budget"],
+            today_yyyy_mm_dd=today,
+        )
+        results.append({**entry, **result})
+        if result.get("status") == "success":
+            succeeded += 1
+            mark = "✓"
+        else:
+            failed += 1
+            mark = f"✗ ({result.get('code')})"
+        print(f"  {mark}  {entry['parent']:50s}  ${entry['current_cap']:>8.2f} → "
+              f"${entry['guidance_daily']:>8.2f}  ({result.get('status')})")
+        if failed > 5 and succeeded == 0:
+            print("ABORT: 5+ failures with 0 successes — stopping early.")
+            break
+
+    print()
+    print("=" * 80)
+    print(f"DONE  succeeded={succeeded}  failed={failed}  total_attempted={succeeded + failed}")
+    print("=" * 80)
+
+    # Save full results to CSV
+    results_path = "/tmp/budget_recovery_results.csv"
+    with open(results_path, "w", newline="") as f:
+        if results:
+            keys = ["parent", "portfolio_id", "portfolio_name",
+                    "current_cap", "guidance_daily", "delta", "status", "code", "body"]
+            w = csv.DictWriter(f, fieldnames=keys, extrasaction="ignore")
+            w.writeheader()
+            w.writerows(results)
+    print(f"Full results written to {results_path}")
+    return 0 if failed == 0 else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
