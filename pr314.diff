+class TestExternalApiIsolation:
+    """
+    Gate 2a: build_plan() and load_plan_csv() must never call out to
+    advertising-api.amazon.com or api.amazon.com/auth/o2/token.
+
+    urllib.request.urlopen is the HTTP call site in the existing script.
+    Tests monkeypatch it to raise AssertionError on any invocation.
+    """
+
+    def test_build_plan_zero_outbound_http(self, monkeypatch):
+        """Gate 2a: build_plan() must make zero outbound HTTP calls."""
+        mod = _load_script()
+        if not hasattr(mod, "build_plan"):
+            pytest.fail("build_plan() not found")
+
+        import urllib.request as _urllib_req
+
+        def _no_network(*args, **kwargs):
+            raise AssertionError(
+                f"Outbound HTTP detected in build_plan(): {args[0] if args else '?'} — "
+                "no external calls allowed during test execution (Gate 2a)"
+            )
+
+        monkeypatch.setattr(_urllib_req, "urlopen", _no_network)
+        plan = mod.build_plan(GUIDANCE_ROWS, PORTFOLIOS, day_label="Mon")
+        assert isinstance(plan, list)
+
+    def test_load_plan_csv_zero_outbound_http(self, tmp_path, monkeypatch):
+        """Gate 2a: load_plan_csv() must make zero outbound HTTP calls."""
+        mod = _load_script()
+        if not hasattr(mod, "load_plan_csv"):
+            pytest.fail("load_plan_csv() not found")
+
+        import urllib.request as _urllib_req
+
+        def _no_network(*args, **kwargs):
+            raise AssertionError(
+                "load_plan_csv() made an outbound HTTP call — must be zero (Gate 2a)"
+            )
+
+        monkeypatch.setattr(_urllib_req, "urlopen", _no_network)
+        csv_path = tmp_path / "plan.csv"
+        csv_path.write_text(
+            "parent,portfolio_id,portfolio_name,current_cap,guidance_daily,delta\n"
+            "GG-StretchFilm-Parent,111,2026_GG-StretchFilm-Parent,100.0,150.0,50.0\n"
+        )
+        mod.load_plan_csv(str(csv_path))  # must not trigger _no_network
