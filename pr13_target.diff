+"""Tests for unknown return_reason enum handling.
+
+AC-4: unknown return_reason values must be stored with return_reason_known=False.
+      Ingest must never crash on unrecognized enum values.
+"""
+
+from __future__ import annotations
+
+import pytest
+from sqlalchemy import select
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from app.common.enum_handling import validate_enum_value
+from app.returns.models import ProductReturn
+from app.returns.poll import ingest_once, _KNOWN_RETURN_REASONS
+
+from tests.conftest import (
+    SAMPLE_RETURN_COMPLETE,
+    SAMPLE_RETURN_UNKNOWN_REASON,
+    SAMPLE_RETURN_NO_ORDER_LINK,
+)
+
+
+# ---------------------------------------------------------------------------
+# Unit tests: validate_enum_value (shared utility)
+# ---------------------------------------------------------------------------
+
+
+class TestValidateEnumValue:
+    """Unit tests for app.common.enum_handling.validate_enum_value."""
+
+    def test_known_value_returns_true(self):
+        result = validate_enum_value("DAMAGED", _KNOWN_RETURN_REASONS)
+        assert result == ("DAMAGED", True)
+
+    def test_unknown_value_returns_false(self):
+        result = validate_enum_value("FUTURE_REASON_XYZ", _KNOWN_RETURN_REASONS)
+        assert result == ("FUTURE_REASON_XYZ", False)
+
+    def test_empty_string_value_returns_false(self):
+        result = validate_enum_value("", _KNOWN_RETURN_REASONS)
+        assert result == ("", False)
+
+    def test_known_values_set_is_not_empty(self):
+        assert len(_KNOWN_RETURN_REASONS) > 0
+        assert isinstance(_KNOWN_RETURN_REASONS, frozenset)
+
+    def test_all_known_reasons_validate_as_known(self):
+        for reason in _KNOWN_RETURN_REASONS:
+            _, is_known = validate_enum_value(reason, _KNOWN_RETURN_REASONS)
+            assert is_known, f"Expected {reason!r} to be known but got is_known=False"
+
+    def test_case_sensitivity_unknown_lowercase(self):
+        result = validate_enum_value("damaged", _KNOWN_RETURN_REASONS)
+        assert result == ("damaged", False)
+
+
+# ---------------------------------------------------------------------------
+# Integration: unknown reason in ingest cycle
+# ---------------------------------------------------------------------------
+
+
+class TestUnknownReturnReasonIngest:
+    """AC-4: ingest continues and tags unknown return_reason values."""
+
+    @pytest.mark.asyncio
+    async def test_unknown_reason_stored_with_known_false(self, patch_poll_module, async_engine):
+        """Unknown return_reason stored; return_reason_known == False."""
+        patch_poll_module.get_returns.return_value = [SAMPLE_RETURN_UNKNOWN_REASON.copy()]
+        result = await ingest_once()
+
+        assert result["records_inserted"] == 1
+
+        async with AsyncSession(async_engine) as session:
+            row = (await session.execute(
+                select(ProductReturn).where(ProductReturn.id == SAMPLE_RETURN_UNKNOWN_REASON["id"])
+            )).scalar_one()
+            assert row.return_reason == "FUTURE_UNKNOWN_REASON_XYZ"
+            assert row.return_reason_known is False
+
+    @pytest.mark.asyncio
+    async def test_unknown_reason_does_not_stop_ingest(self, patch_poll_module, async_engine):
+        """Batch with mixed known/unknown reasons — all records persisted."""
+        patch_poll_module.get_returns.return_value = [
+            SAMPLE_RETURN_COMPLETE.copy(),
+            SAMPLE_RETURN_UNKNOWN_REASON.copy(),
+        ]
+        result = await ingest_once()
+        assert result["records_inserted"] == 2
+
+    @pytest.mark.asyncio
+    async def test_known_reason_stored_with_known_true(self, patch_poll_module, async_engine):
+        """Known return_reason stored with return_reason_known == True."""
+        patch_poll_module.get_returns.return_value = [SAMPLE_RETURN_COMPLETE.copy()]
+        result = await ingest_once()
+
+        async with AsyncSession(async_engine) as session:
+            row = (await session.execute(
+                select(ProductReturn).where(ProductReturn.id == SAMPLE_RETURN_COMPLETE["id"])
+            )).scalar_one()
+            assert row.return_reason == "DAMAGED"
+            assert row.return_reason_known is True
+
+    @pytest.mark.asyncio
+    async def test_null_return_reason_stored_gracefully(self, patch_poll_module, async_engine):
+        """Null return_reason is stored as NULL; no crash."""
+        record = SAMPLE_RETURN_NO_ORDER_LINK.copy()
+        record["return_reason"] = None
+        patch_poll_module.get_returns.return_value = [record]
+        result = await ingest_once()
+
+        assert result["records_inserted"] == 1
+
+        async with AsyncSession(async_engine) as session:
+            row = (await session.execute(
+                select(ProductReturn).where(ProductReturn.id == record["id"])
+            )).scalar_one()
+            assert row.return_reason is None
