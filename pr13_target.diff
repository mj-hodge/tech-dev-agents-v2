+"""Tests for dedup behavior via id PK upsert.
+
+AC-3: no duplicates on re-run of ingest_once().
+"""
+
+from __future__ import annotations
+
+import pytest
+from sqlalchemy import select, func
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from app.returns.models import ProductReturn
+from app.returns.poll import ingest_once
+
+from tests.conftest import SAMPLE_RETURN_COMPLETE, SAMPLE_RETURN_UNKNOWN_REASON
+
+
+class TestDedupOnId:
+    """Verify upsert dedup behavior using id as PK."""
+
+    @pytest.mark.asyncio
+    async def test_same_id_ingested_twice_produces_one_row(self, patch_poll_module, async_engine):
+        patch_poll_module.get_returns.return_value = [SAMPLE_RETURN_COMPLETE.copy()]
+        r1 = await ingest_once()
+        assert r1["records_inserted"] == 1
+
+        r2 = await ingest_once()
+        assert r2["records_inserted"] == 0
+
+        async with AsyncSession(async_engine) as session:
+            count = (await session.execute(
+                select(func.count()).select_from(ProductReturn)
+            )).scalar()
+            assert count == 1
+
+    @pytest.mark.asyncio
+    async def test_different_ids_produce_separate_rows(self, patch_poll_module, async_engine):
+        patch_poll_module.get_returns.return_value = [
+            SAMPLE_RETURN_COMPLETE.copy(),
+            SAMPLE_RETURN_UNKNOWN_REASON.copy(),
+        ]
+        await ingest_once()
+
+        async with AsyncSession(async_engine) as session:
+            count = (await session.execute(
+                select(func.count()).select_from(ProductReturn)
+            )).scalar()
+            assert count == 2
+
+    @pytest.mark.asyncio
+    async def test_upsert_updates_mutable_fields(self, patch_poll_module, async_engine):
+        patch_poll_module.get_returns.return_value = [SAMPLE_RETURN_COMPLETE.copy()]
+        await ingest_once()
+
+        modified = SAMPLE_RETURN_COMPLETE.copy()
+        modified["quantity"] = 5
+        patch_poll_module.get_returns.return_value = [modified]
+        await ingest_once()
+
+        async with AsyncSession(async_engine) as session:
+            row = (await session.execute(
+                select(ProductReturn).where(ProductReturn.id == SAMPLE_RETURN_COMPLETE["id"])
+            )).scalar_one()
+            assert row.quantity == 5
+
+    @pytest.mark.asyncio
+    async def test_upsert_preserves_ingested_at(self, patch_poll_module, async_engine):
+        patch_poll_module.get_returns.return_value = [SAMPLE_RETURN_COMPLETE.copy()]
+        await ingest_once()
+
+        async with AsyncSession(async_engine) as session:
+            row = (await session.execute(
+                select(ProductReturn).where(ProductReturn.id == SAMPLE_RETURN_COMPLETE["id"])
+            )).scalar_one()
+            first_ingested_at = row.ingested_at
+
+        # Re-ingest
+        patch_poll_module.get_returns.return_value = [SAMPLE_RETURN_COMPLETE.copy()]
+        await ingest_once()
+
+        async with AsyncSession(async_engine) as session:
+            row = (await session.execute(
+                select(ProductReturn).where(ProductReturn.id == SAMPLE_RETURN_COMPLETE["id"])
+            )).scalar_one()
+            assert row.ingested_at == first_ingested_at
+
+    @pytest.mark.asyncio
+    async def test_upsert_updates_updated_at(self, patch_poll_module, async_engine):
+        patch_poll_module.get_returns.return_value = [SAMPLE_RETURN_COMPLETE.copy()]
+        await ingest_once()
+
+        async with AsyncSession(async_engine) as session:
+            row = (await session.execute(
+                select(ProductReturn).where(ProductReturn.id == SAMPLE_RETURN_COMPLETE["id"])
+            )).scalar_one()
+            first_updated_at = row.updated_at
+
+        # Re-ingest
+        modified = SAMPLE_RETURN_COMPLETE.copy()
+        modified["quantity"] = 99
+        patch_poll_module.get_returns.return_value = [modified]
+        await ingest_once()
+
+        async with AsyncSession(async_engine) as session:
+            row = (await session.execute(
+                select(ProductReturn).where(ProductReturn.id == SAMPLE_RETURN_COMPLETE["id"])
+            )).scalar_one()
+            assert row.updated_at >= first_updated_at
+
+    @pytest.mark.asyncio
+    async def test_bulk_ingest_with_duplicate_ids_in_same_batch(self, patch_poll_module, async_engine):
+        r1 = SAMPLE_RETURN_COMPLETE.copy()
+        r1["quantity"] = 1
+        r2 = SAMPLE_RETURN_COMPLETE.copy()
+        r2["quantity"] = 3
+
+        patch_poll_module.get_returns.return_value = [r1, r2]
+        await ingest_once()
+
+        async with AsyncSession(async_engine) as session:
+            count = (await session.execute(
+                select(func.count()).select_from(ProductReturn)
+            )).scalar()
+            assert count == 1
