+"""Tests for order_id soft FK linkage between product_returns and orders.
+
+AC-5: Every persisted return's order_id is queryable against orders table.
+      Soft FK (nullable, no DB constraint in v1); reconciliation test catches drift.
+"""
+
+from __future__ import annotations
+
+import pytest
+from sqlalchemy import select, text
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from app.returns.models import ProductReturn
+from app.returns.poll import ingest_once
+
+from tests.conftest import (
+    SAMPLE_RETURN_COMPLETE,
+    SAMPLE_RETURN_NO_ORDER_LINK,
+)
+
+
+class TestOrderLinkage:
+    """AC-5: verify order_id linkage semantics."""
+
+    @pytest.mark.asyncio
+    async def test_return_with_valid_order_id_stored(self, patch_poll_module, async_engine):
+        patch_poll_module.get_returns.return_value = [SAMPLE_RETURN_COMPLETE.copy()]
+        await ingest_once()
+
+        async with AsyncSession(async_engine) as session:
+            row = (await session.execute(
+                select(ProductReturn).where(ProductReturn.id == SAMPLE_RETURN_COMPLETE["id"])
+            )).scalar_one()
+            assert row.order_id == "1234567890-1"
+
+    @pytest.mark.asyncio
+    async def test_return_with_null_order_id_stored_gracefully(self, patch_poll_module, async_engine):
+        patch_poll_module.get_returns.return_value = [SAMPLE_RETURN_NO_ORDER_LINK.copy()]
+        result = await ingest_once()
+        assert result["records_inserted"] == 1
+
+        async with AsyncSession(async_engine) as session:
+            row = (await session.execute(
+                select(ProductReturn).where(ProductReturn.id == SAMPLE_RETURN_NO_ORDER_LINK["id"])
+            )).scalar_one()
+            assert row.order_id is None
+
+    @pytest.mark.asyncio
+    async def test_return_order_id_format_composite(self, patch_poll_module, async_engine):
+        patch_poll_module.get_returns.return_value = [SAMPLE_RETURN_COMPLETE.copy()]
+        await ingest_once()
+
+        async with AsyncSession(async_engine) as session:
+            row = (await session.execute(
+                select(ProductReturn).where(ProductReturn.id == SAMPLE_RETURN_COMPLETE["id"])
+            )).scalar_one()
+            assert row.order_id.startswith(row.order_number)
+
+    @pytest.mark.asyncio
+    async def test_return_with_nonexistent_order_id_stored_not_rejected(self, patch_poll_module, async_engine):
+        record = SAMPLE_RETURN_COMPLETE.copy()
+        record["id"] = "507f1f77bcf86cd799439099"
+        record["order_id"] = "NONEXISTENT-999"
+        patch_poll_module.get_returns.return_value = [record]
+        result = await ingest_once()
+        assert result["records_inserted"] == 1
+
+        async with AsyncSession(async_engine) as session:
+            row = (await session.execute(
+                select(ProductReturn).where(ProductReturn.id == record["id"])
+            )).scalar_one()
+            assert row.order_id == "NONEXISTENT-999"
+
+    @pytest.mark.asyncio
+    async def test_reconciliation_query_identifies_orphaned_returns(self, patch_poll_module, async_engine):
+        # Insert a return with a non-null order_id (orphaned — no orders table in test)
+        orphan = SAMPLE_RETURN_COMPLETE.copy()
