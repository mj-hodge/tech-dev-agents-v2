+"""Test infrastructure for returns tests.
+
+Provides:
+  - Per-test in-memory SQLite async engine with product_returns + poll_state schema
+  - Autouse fixture that patches poll._engine, poll._client, poll.last_successful_poll_at
+  - FastAPI ASGI test client (for /health/returns endpoint tests)
+"""
+
+from __future__ import annotations
+
+from unittest.mock import AsyncMock
+
+import pytest
+import pytest_asyncio
+from sqlalchemy.ext.asyncio import AsyncEngine, create_async_engine
+
+import app.returns.poll as poll_module
+from app.returns.models import Base
+
+from tests.conftest import (
+    SAMPLE_RETURN_COMPLETE,
+    SAMPLE_RETURN_UNKNOWN_REASON,
+    SAMPLE_RETURN_NO_ORDER_LINK,
+    SAMPLE_RETURN_MINIMAL,
+    SAMPLE_RETURN_NEWER_MODIFIED,
+)
+
+
+# ---------------------------------------------------------------------------
+# DB engine fixture (in-memory SQLite per test)
+# ---------------------------------------------------------------------------
+
+
+@pytest_asyncio.fixture
+async def async_engine():
+    """Create an in-memory SQLite async engine with all tables."""
+    engine = create_async_engine("sqlite+aiosqlite://", echo=False)
+    async with engine.begin() as conn:
+        await conn.run_sync(Base.metadata.create_all)
+    yield engine
+    await engine.dispose()
+
+
+@pytest_asyncio.fixture(autouse=True)
+async def patch_poll_module(async_engine):
+    """Patch poll module globals for test isolation."""
+    mock_client = AsyncMock()
+    mock_client.seller_id = "SELLER001"
+    mock_client.get_returns = AsyncMock(return_value=[])
+
+    original_engine = poll_module._engine
+    original_client = poll_module._client
+    original_poll_at = poll_module.last_successful_poll_at
+
+    poll_module._engine = async_engine
+    poll_module._client = mock_client
+    poll_module.last_successful_poll_at = None
+
+    yield mock_client
+
+    poll_module._engine = original_engine
+    poll_module._client = original_client
+    poll_module.last_successful_poll_at = original_poll_at
+
+
+# ---------------------------------------------------------------------------
+# Response fixtures
+# ---------------------------------------------------------------------------
+
+
+@pytest.fixture
+def target_api_response_single(sample_complete_return: dict) -> list[dict]:
+    """Simulated Target API response with one product return."""
+    return [sample_complete_return]
+
+
+@pytest.fixture
+def target_api_response_multiple(multiple_distinct_returns: list[dict]) -> list[dict]:
+    """Simulated Target API response with two distinct product returns."""
+    return multiple_distinct_returns
+
+
+@pytest.fixture
+def target_api_response_empty() -> list[dict]:
+    """Simulated Target API response with no product returns."""
+    return []
+
+
+@pytest.fixture
+def target_api_response_unknown_reason() -> list[dict]:
+    """Simulated Target API response with an unknown return_reason value."""
+    return [SAMPLE_RETURN_UNKNOWN_REASON.copy()]
+
+
+@pytest.fixture
+def target_api_response_minimal() -> list[dict]:
+    """Simulated Target API response with a minimal (sparse) return record."""
+    return [SAMPLE_RETURN_MINIMAL.copy()]
