+"""Tests for /health/returns endpoint.
+
+AC-8: /health endpoint reports returns poller status (healthy/stale).
+"""
+
+from __future__ import annotations
+
+from datetime import datetime, timezone, timedelta
+
+import pytest
+from unittest.mock import patch
+from httpx import AsyncClient, ASGITransport
+
+from fastapi import FastAPI
+
+import app.returns.poll as poll_module
+from app.returns.api import router
+
+
+def _make_app() -> FastAPI:
+    app = FastAPI()
+    app.include_router(router)
+    return app
+
+
+class TestHealthReturnsEndpoint:
+    """AC-8: /health/returns reports poller status."""
+
+    @pytest.mark.asyncio
+    async def test_health_returns_healthy_after_recent_poll(self):
+        app = _make_app()
+        now = datetime.now(timezone.utc)
+        with patch.object(poll_module, "last_successful_poll_at", now - timedelta(minutes=1)):
+            transport = ASGITransport(app=app)
+            async with AsyncClient(transport=transport, base_url="http://test") as client:
+                resp = await client.get("/health/returns")
+        assert resp.status_code == 200
+        assert resp.json()["status"] == "healthy"
+
+    @pytest.mark.asyncio
+    async def test_health_returns_degraded_when_stale(self):
+        app = _make_app()
+        with patch.object(poll_module, "last_successful_poll_at", datetime.now(timezone.utc) - timedelta(hours=2)):
+            transport = ASGITransport(app=app)
+            async with AsyncClient(transport=transport, base_url="http://test") as client:
+                resp = await client.get("/health/returns")
+        assert resp.status_code == 200
+        assert resp.json()["status"] == "degraded"
+
+    @pytest.mark.asyncio
+    async def test_health_returns_degraded_when_never_polled(self):
+        app = _make_app()
+        with patch.object(poll_module, "last_successful_poll_at", None):
+            transport = ASGITransport(app=app)
+            async with AsyncClient(transport=transport, base_url="http://test") as client:
+                resp = await client.get("/health/returns")
+        assert resp.status_code == 200
+        assert resp.json()["status"] == "degraded"
+
+    @pytest.mark.asyncio
+    async def test_health_returns_uses_configurable_interval(self, monkeypatch):
+        monkeypatch.setenv("RETURNS_POLL_INTERVAL_SEC", "60")
+        app = _make_app()
+        # 200s ago is > 3x60=180s threshold
+        with patch.object(poll_module, "last_successful_poll_at", datetime.now(timezone.utc) - timedelta(seconds=200)):
+            transport = ASGITransport(app=app)
+            async with AsyncClient(transport=transport, base_url="http://test") as client:
+                resp = await client.get("/health/returns")
+        assert resp.json()["status"] == "degraded"
+
+    @pytest.mark.asyncio
+    async def test_health_returns_response_schema(self):
+        app = _make_app()
+        now = datetime.now(timezone.utc)
+        with patch.object(poll_module, "last_successful_poll_at", now - timedelta(seconds=10)):
+            transport = ASGITransport(app=app)
+            async with AsyncClient(transport=transport, base_url="http://test") as client:
+                resp = await client.get("/health/returns")
+        body = resp.json()
+        assert "status" in body
+        assert "last_poll_at" in body
