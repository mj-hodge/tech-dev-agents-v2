+"""FastAPI router for returns: health/readiness endpoints only.
+
+Returns data is written to Postgres for downstream query by reporting tools.
+No data-read endpoints in v1.
+"""
+
+from __future__ import annotations
+
+import os
+from datetime import datetime, timezone
+
+from fastapi import APIRouter
+from fastapi.responses import JSONResponse
+
+from app.returns import poll as poll_module
+
+router = APIRouter()
+
+# Threshold: if last successful poll is older than 3x interval, report degraded.
+_READY_TIMEOUT_MULTIPLIER = 3
+_DEFAULT_INTERVAL_SEC = 600
+
+
+@router.get("/health/returns")
+async def health_returns() -> JSONResponse:
+    """Returns poller health check.
+
+    Check poll_module.last_successful_poll_at against now().
+    Return healthy if within 3x RETURNS_POLL_INTERVAL_SEC, else degraded.
+    """
+    interval = int(
+        os.getenv("RETURNS_POLL_INTERVAL_SEC", str(_DEFAULT_INTERVAL_SEC))
+    )
+    threshold_sec = interval * _READY_TIMEOUT_MULTIPLIER
+
+    last_poll = poll_module.last_successful_poll_at
+
+    if last_poll is None:
+        return JSONResponse(
+            status_code=200,
+            content={
+                "status": "degraded",
+                "reason": "never polled",
+                "last_poll_at": None,
+            },
+        )
+
+    now = datetime.now(timezone.utc)
+    age_sec = (now - last_poll).total_seconds()
+
+    if age_sec > threshold_sec:
+        return JSONResponse(
+            status_code=200,
+            content={
+                "status": "degraded",
+                "reason": f"last poll {int(age_sec)}s ago exceeds {threshold_sec}s threshold",
+                "last_poll_at": last_poll.isoformat(),
+            },
+        )
+
+    return JSONResponse(
+        status_code=200,
+        content={
+            "status": "healthy",
+            "last_poll_at": last_poll.isoformat(),
+        },
+    )
