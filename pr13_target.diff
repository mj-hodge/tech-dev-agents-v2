+"""Shared poll-state tracking: cursor read/write/fallback.
+
+Owned by STORY-011; consumed by STORY-010, STORY-012, STORY-013, STORY-017.
+
+The PollStateTracker manages a row in the poll_state table (one row per
+endpoint).  It provides get_cursor / set_cursor and falls back to a
+full-fetch strategy when the cursor row is missing.
+"""
+
+from __future__ import annotations
+
+from datetime import datetime, timezone
+from typing import Optional
+
+from sqlalchemy import select, update
+from sqlalchemy.dialects.sqlite import insert as sqlite_insert
+from sqlalchemy.ext.asyncio import AsyncEngine, AsyncSession
+
+from app.returns.models import PollState
+
+
+class PollStateTracker:
+    """Cursor tracker for incremental poll endpoints.
+
+    Uses SQLAlchemy AsyncSession and the PollState ORM model.
+
+    Args:
+        engine: SQLAlchemy AsyncEngine connected to Postgres (or SQLite in tests).
+    """
+
+    def __init__(self, engine: AsyncEngine) -> None:
+        self._engine = engine
+
+    async def get_cursor(self, endpoint: str) -> Optional[str]:
+        """Return the current cursor (high-water mark) for endpoint, or None.
+
+        Returns None if no row exists (triggers full-fetch fallback in poll loop).
+        """
+        async with AsyncSession(self._engine) as session:
+            result = await session.execute(
+                select(PollState.cursor_value).where(
+                    PollState.endpoint == endpoint
+                )
+            )
+            row = result.scalar_one_or_none()
+            return row
+
+    async def set_cursor(
+        self,
+        endpoint: str,
+        cursor_value: Optional[str],
+        *,
+        records_fetched: int = 0,
+        error_count: int = 0,
+    ) -> None:
+        """Upsert the cursor and stats for endpoint."""
+        now = datetime.now(timezone.utc)
+        async with AsyncSession(self._engine) as session:
+            # Try update first
+            result = await session.execute(
+                select(PollState).where(PollState.endpoint == endpoint)
+            )
+            existing = result.scalar_one_or_none()
+
+            if existing:
+                existing.cursor_value = cursor_value
+                existing.last_poll_at = now
+                existing.records_fetched = records_fetched
+                existing.error_count = error_count
+            else:
+                row = PollState(
+                    endpoint=endpoint,
+                    cursor_value=cursor_value,
+                    last_poll_at=now,
+                    records_fetched=records_fetched,
+                    error_count=error_count,
+                )
+                session.add(row)
+
+            await session.commit()
+
+    async def increment_error_count(self, endpoint: str) -> None:
+        """Increment error_count for endpoint without updating cursor."""
+        now = datetime.now(timezone.utc)
+        async with AsyncSession(self._engine) as session:
+            result = await session.execute(
+                select(PollState).where(PollState.endpoint == endpoint)
+            )
+            existing = result.scalar_one_or_none()
+
+            if existing:
+                existing.error_count = existing.error_count + 1
+                existing.last_poll_at = now
+            else:
+                # Create row if missing (first call is an error)
+                row = PollState(
+                    endpoint=endpoint,
+                    cursor_value=None,
+                    last_poll_at=now,
+                    records_fetched=0,
+                    error_count=1,
+                )
+                session.add(row)
+
+            await session.commit()
