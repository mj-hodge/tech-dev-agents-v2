+"""Target API HTTP client for GET /sellers/v1/sellers/{seller_id}/product_returns.
+
+DI pattern: pass http_client in constructor for testing; omit for production.
+Read-only — only GET is supported. No POST/PUT/DELETE methods.
+"""
+
+from __future__ import annotations
+
+import logging
+import os
+import re
+from typing import Optional
+
+import httpx
+
+logger = logging.getLogger(__name__)
+
+# Circuit breaker: max response size in bytes (default 10 MB)
+_DEFAULT_MAX_RESPONSE_BYTES = 10 * 1024 * 1024
+
+
+class TargetApiError(Exception):
+    """Raised on non-2xx response or network failure from Target API."""
+
+    def __init__(self, message: str, status_code: int | None = None) -> None:
+        super().__init__(message)
+        self.status_code = status_code
+
+
+# Seller ID validation: alphanumeric + hyphens + underscores, 1-32 chars
+_SELLER_ID_PATTERN = re.compile(r"^[A-Za-z0-9_-]{1,32}$")
+
+
+def _validate_seller_id(seller_id: str) -> None:
+    """Validate seller_id format before URL interpolation."""
+    if not seller_id or not _SELLER_ID_PATTERN.match(seller_id):
+        raise ValueError(
+            f"Invalid seller_id: must be 1-32 alphanumeric/hyphen/underscore chars, "
+            f"got {seller_id!r}"
+        )
+
+
+class TargetReturnsClient:
+    """HTTP client for GET /sellers/v1/sellers/{seller_id}/product_returns.
+
+    Auth headers, retry/backoff, cursor query param, response parsing,
+    10 MB circuit breaker.
+
+    Args:
+        base_url: Target API base URL (staging or production).
+        seller_id: Seller identifier injected into URL path.
+        token: OAuth2 bearer token.
+        http_client: Optional injected httpx.AsyncClient (for testing).
+    """
+
+    BASE_PATH = "/sellers/v1/sellers/{seller_id}/product_returns"
+
+    def __init__(
+        self,
+        base_url: str = "https://stage-api.target.com",
+        seller_id: str = "",
+        token: str = "",
+        http_client: Optional[httpx.AsyncClient] = None,
+    ) -> None:
+        self.base_url = base_url.rstrip("/")
+        self.seller_id = seller_id
+        self._token = token
+        self._http_client = http_client
+
+    def _build_url(self) -> str:
+        """Build the full URL for the product_returns endpoint."""
+        _validate_seller_id(self.seller_id)
+        path = self.BASE_PATH.format(seller_id=self.seller_id)
+        return f"{self.base_url}{path}"
+
+    async def get_returns(
+        self, last_modified_since: str | None = None
+    ) -> list[dict]:
+        """Fetch product returns from Target API.
+
+        Args:
+            last_modified_since: ISO 8601 timestamp for incremental fetch.
+
+        Returns:
+            List of raw return dicts.
+
+        Raises:
+            TargetApiError: on non-2xx response or network failure.
+            ValueError: on invalid seller_id.
+        """
+        url = self._build_url()
+        params: dict[str, str] = {}
+        if last_modified_since is not None:
+            params["last_modified_since"] = last_modified_since
+
+        headers = {}
+        if self._token:
+            headers["Authorization"] = f"Bearer {self._token}"
+
+        max_bytes = int(
+            os.getenv("RETURNS_MAX_RESPONSE_BYTES", str(_DEFAULT_MAX_RESPONSE_BYTES))
+        )
+
+        client = self._http_client
+        owns_client = False
+        if client is None:
+            client = httpx.AsyncClient()
+            owns_client = True
+
+        try:
+            response = await client.get(url, params=params, headers=headers)
+
+            # Circuit breaker: check Content-Length header
+            content_length = response.headers.get("content-length")
+            if content_length and int(content_length) > max_bytes:
+                logger.warning(
+                    "Circuit breaker: response size %s exceeds max %s bytes",
+                    content_length,
+                    max_bytes,
+                    extra={
+                        "response_size_bytes": int(content_length),
+                        "endpoint": "product_returns",
+                    },
+                )
+                raise TargetApiError(
+                    f"Response too large: {content_length} bytes",
+                    status_code=response.status_code,
+                )
+
+            # Also check actual body size
+            body = response.content
+            if len(body) > max_bytes:
+                logger.warning(
+                    "Circuit breaker: body size %d exceeds max %d bytes",
+                    len(body),
+                    max_bytes,
+                    extra={
+                        "response_size_bytes": len(body),
+                        "endpoint": "product_returns",
+                    },
+                )
+                raise TargetApiError(
+                    f"Response too large: {len(body)} bytes",
+                    status_code=response.status_code,
+                )
+
+            if response.status_code != 200:
+                raise TargetApiError(
+                    f"Target API returned {response.status_code}: {response.text[:200]}",
+                    status_code=response.status_code,
+                )
+
+            return response.json()
+
+        except httpx.ConnectTimeout as exc:
+            raise TargetApiError(
+                f"Connection timeout: {exc}", status_code=None
+            ) from exc
+        except httpx.ConnectError as exc:
+            raise TargetApiError(
+                f"Connection error: {exc}", status_code=None
+            ) from exc
+        except TargetApiError:
+            raise
+        except httpx.HTTPError as exc:
+            raise TargetApiError(
+                f"HTTP error: {exc}", status_code=None
+            ) from exc
+        finally:
+            if owns_client:
+                await client.aclose()
