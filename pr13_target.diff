+"""Tests for TargetReturnsClient: input validation, seller_id safety, read-only guard.
+
+Covers:
+  - Gate 4: Input validation (seller_id format, invalid inputs)
+  - Read-only guard: client must only support GET, never POST/PUT/DELETE
+  - Seller ID validation before URL interpolation (security constraint)
+  - Base URL and path construction
+"""
+
+from __future__ import annotations
+
+import pytest
+import httpx
+import respx
+
+from app.returns.client import TargetReturnsClient, TargetApiError
+
+
+# ---------------------------------------------------------------------------
+# Gate 4: Input validation — seller_id
+# ---------------------------------------------------------------------------
+
+
+class TestSellerIdValidation:
+    """Seller ID must be validated before URL interpolation (security constraint)."""
+
+    def test_valid_alphanumeric_seller_id_accepted(self):
+        """Alphanumeric seller_id is accepted without error."""
+        client = TargetReturnsClient(seller_id="SELLER001")
+        assert client.seller_id == "SELLER001"
+
+    def test_empty_seller_id_is_flagged(self):
+        """Empty seller_id raises ValueError on get_returns()."""
+        client = TargetReturnsClient(seller_id="")
+        with pytest.raises(ValueError, match="Invalid seller_id"):
+            client._build_url()
+
+    def test_seller_id_exceeding_max_length_rejected(self):
+        """Seller ID longer than 32 chars is rejected."""
+        client = TargetReturnsClient(seller_id="A" * 33)
+        with pytest.raises(ValueError, match="Invalid seller_id"):
+            client._build_url()
+
+    def test_seller_id_with_path_traversal_rejected(self):
+        """Seller ID with path traversal characters is rejected."""
+        client = TargetReturnsClient(seller_id="../etc/passwd")
+        with pytest.raises(ValueError, match="Invalid seller_id"):
+            client._build_url()
+
+    def test_seller_id_with_special_chars_rejected(self):
+        """Seller ID with SQL injection characters is rejected."""
+        client = TargetReturnsClient(seller_id="SELLER'; DROP TABLE--")
+        with pytest.raises(ValueError, match="Invalid seller_id"):
+            client._build_url()
+
+
+# ---------------------------------------------------------------------------
+# Read-only guard
+# ---------------------------------------------------------------------------
+
+
+class TestReadOnlyGuard:
+    """TargetReturnsClient must only support GET — no write methods."""
+
+    def test_client_has_no_post_method(self):
+        client = TargetReturnsClient(seller_id="SELLER001")
+        assert not hasattr(client, "post_return")
+        assert not hasattr(client, "create_return")
+        assert not hasattr(client, "post")
+
+    def test_client_has_no_put_method(self):
+        client = TargetReturnsClient(seller_id="SELLER001")
+        assert not hasattr(client, "put_return")
+        assert not hasattr(client, "update_return")
+        assert not hasattr(client, "put")
+
+    def test_client_has_no_delete_method(self):
+        client = TargetReturnsClient(seller_id="SELLER001")
+        assert not hasattr(client, "delete_return")
+        assert not hasattr(client, "delete")
+
+
+# ---------------------------------------------------------------------------
+# URL construction
+# ---------------------------------------------------------------------------
+
+
+class TestUrlConstruction:
+    """Verify correct URL path construction from base_url + seller_id."""
+
+    def test_base_path_includes_seller_id_placeholder(self):
+        assert "{seller_id}" in TargetReturnsClient.BASE_PATH
+
+    def test_constructed_url_uses_seller_id(self):
+        client = TargetReturnsClient(
+            base_url="https://stage-api.target.com",
+            seller_id="SELLER001",
+        )
+        expected_path = "/sellers/v1/sellers/SELLER001/product_returns"
+        actual_path = TargetReturnsClient.BASE_PATH.format(seller_id="SELLER001")
+        assert actual_path == expected_path
+
+    @respx.mock
+    @pytest.mark.asyncio
+    async def test_get_returns_passes_cursor_as_query_param(self):
+        """get_returns(last_modified_since=...) passes it as a query parameter."""
+        route = respx.get(
+            "https://stage-api.target.com/sellers/v1/sellers/SELLER001/product_returns",
+            params={"last_modified_since": "2026-04-01T12:05:00Z"},
+        ).mock(return_value=httpx.Response(200, json=[]))
+
+        client = TargetReturnsClient(
+            base_url="https://stage-api.target.com",
+            seller_id="SELLER001",
+            token="test-token",
+        )
+        result = await client.get_returns(last_modified_since="2026-04-01T12:05:00Z")
+        assert result == []
+        assert route.called
