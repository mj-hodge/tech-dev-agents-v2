+"""SQLAlchemy ORM models for product_returns and poll_state tables.
+
+Owned by STORY-011.  poll_state is a shared utility consumed by STORY-010,
+STORY-012, STORY-013, and STORY-017 via app.common.poll.PollStateTracker.
+"""
+
+from __future__ import annotations
+
+from datetime import datetime
+
+from sqlalchemy import (
+    Boolean,
+    DateTime,
+    Index,
+    Integer,
+    String,
+)
+from sqlalchemy.orm import DeclarativeBase, Mapped, mapped_column
+from sqlalchemy.sql import func
+
+
+class Base(DeclarativeBase):
+    pass
+
+
+class ProductReturn(Base):
+    """ORM model for the product_returns table.
+
+    Dedup key: id (MongoDB ObjectId, Primary Key).
+    Upsert strategy: INSERT … ON CONFLICT (id) DO UPDATE SET mutable cols + updated_at.
+    """
+
+    __tablename__ = "product_returns"
+
+    # Primary key / dedup key
+    id: Mapped[str] = mapped_column(String(24), primary_key=True)
+
+    # Core fields
+    order_id: Mapped[str | None] = mapped_column(String(64), nullable=True)
+    order_number: Mapped[str | None] = mapped_column(String(32), nullable=True)
+    seller_id: Mapped[str] = mapped_column(String(32), nullable=False)
+    return_order_number: Mapped[str | None] = mapped_column(String(32), nullable=True)
+    tcin: Mapped[str | None] = mapped_column(String(16), nullable=True)
+    external_id: Mapped[str | None] = mapped_column(String(64), nullable=True)
+    quantity: Mapped[int] = mapped_column(Integer, nullable=False, default=1)
+
+    # Return reason with unknown-enum tag-and-continue flag
+    return_reason: Mapped[str | None] = mapped_column(String(32), nullable=True)
+    return_reason_known: Mapped[bool] = mapped_column(
+        Boolean, nullable=False, default=True
+    )
+
+    # Timestamps from Target
+    return_date: Mapped[datetime | None] = mapped_column(
+        DateTime(timezone=True), nullable=True
+    )
+    created: Mapped[datetime | None] = mapped_column(
+        DateTime(timezone=True), nullable=True
+    )
+    last_modified: Mapped[datetime | None] = mapped_column(
+        DateTime(timezone=True), nullable=True
+    )
+    created_by: Mapped[str | None] = mapped_column(String(64), nullable=True)
+    last_modified_by: Mapped[str | None] = mapped_column(String(64), nullable=True)
+
+    # GC-internal flags / timestamps
+    is_archived: Mapped[bool] = mapped_column(
+        Boolean, nullable=False, default=False
+    )
+    ingested_at: Mapped[datetime] = mapped_column(
+        DateTime(timezone=True),
+        nullable=False,
+        server_default=func.now(),
+    )
+    updated_at: Mapped[datetime] = mapped_column(
+        DateTime(timezone=True),
+        nullable=False,
+        server_default=func.now(),
+    )
+
+    __table_args__ = (
+        Index("ix_product_returns_seller_id", "seller_id"),
+        Index("ix_product_returns_order_id", "order_id"),
+        Index("ix_product_returns_tcin", "tcin"),
+        Index("ix_product_returns_last_modified", "last_modified"),
+        # Partial index for operational queries; SQLite ignores WHERE clause.
+        Index(
+            "ix_product_returns_active",
+            "seller_id",
+            "return_date",
+            postgresql_where="NOT is_archived",
+        ),
+    )
+
+
+class PollState(Base):
+    """ORM model for the poll_state table.
+
+    Tracks cursor (high-water mark) per endpoint.  Owned by STORY-011;
+    consumed by STORY-010, STORY-012, STORY-013, STORY-017.
+    """
+
+    __tablename__ = "poll_state"
+
+    endpoint: Mapped[str] = mapped_column(String(128), primary_key=True)
+    cursor_value: Mapped[str | None] = mapped_column(String(128), nullable=True)
+    last_poll_at: Mapped[datetime] = mapped_column(
+        DateTime(timezone=True), nullable=False
+    )
+    records_fetched: Mapped[int] = mapped_column(Integer, nullable=False, default=0)
+    error_count: Mapped[int] = mapped_column(Integer, nullable=False, default=0)
