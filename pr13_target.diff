+"""Tests for cursor-based incremental poll strategy.
+
+AC-3: cursor-based incremental poll is the core mechanism.
+"""
+
+from __future__ import annotations
+
+import pytest
+from unittest.mock import MagicMock, AsyncMock
+from sqlalchemy import select, delete
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from app.common.poll import PollStateTracker
+from app.returns.client import TargetApiError
+from app.returns.models import PollState
+from app.returns.poll import ingest_once
+
+from tests.conftest import (
+    SAMPLE_RETURN_COMPLETE,
+    SAMPLE_RETURN_NEWER_MODIFIED,
+)
+
+
+# ---------------------------------------------------------------------------
+# PollStateTracker unit tests (shared utility)
+# ---------------------------------------------------------------------------
+
+
+class TestPollStateTrackerInterface:
+    """Unit tests for the PollStateTracker interface contract."""
+
+    def test_poll_state_tracker_is_instantiable(self):
+        tracker = PollStateTracker(engine=MagicMock())
+        assert tracker is not None
+
+    @pytest.mark.asyncio
+    async def test_get_cursor_returns_none_or_string(self, async_engine):
+        tracker = PollStateTracker(engine=async_engine)
+        cursor = await tracker.get_cursor("product_returns")
+        assert cursor is None
+
+    @pytest.mark.asyncio
+    async def test_set_cursor_stores_value(self, async_engine):
+        tracker = PollStateTracker(engine=async_engine)
+        await tracker.set_cursor("product_returns", "2026-04-01T12:05:00Z")
+        cursor = await tracker.get_cursor("product_returns")
+        assert cursor == "2026-04-01T12:05:00Z"
+
+    @pytest.mark.asyncio
+    async def test_increment_error_count_does_not_reset_cursor(self, async_engine):
+        tracker = PollStateTracker(engine=async_engine)
+        await tracker.set_cursor("product_returns", "2026-04-01T12:05:00Z", error_count=0)
+        await tracker.increment_error_count("product_returns")
+
+        cursor = await tracker.get_cursor("product_returns")
+        assert cursor == "2026-04-01T12:05:00Z"
+
+        async with AsyncSession(async_engine) as session:
+            row = (await session.execute(
+                select(PollState).where(PollState.endpoint == "product_returns")
+            )).scalar_one()
+            assert row.error_count == 1
+
+
+# ---------------------------------------------------------------------------
+# Ingest cycle cursor integration
+# ---------------------------------------------------------------------------
+
+
+class TestCursorLifecycle:
+    """Verify ingest_once() uses and updates the cursor correctly."""
+
+    @pytest.mark.asyncio
+    async def test_first_poll_no_cursor_fetches_all(self, patch_poll_module, async_engine):
+        patch_poll_module.get_returns.return_value = [SAMPLE_RETURN_COMPLETE.copy()]
+        await ingest_once()
+        patch_poll_module.get_returns.assert_called_with(last_modified_since=None)
+
+    @pytest.mark.asyncio
+    async def test_second_poll_passes_cursor_to_client(self, patch_poll_module, async_engine):
+        patch_poll_module.get_returns.return_value = [SAMPLE_RETURN_COMPLETE.copy()]
+        await ingest_once()
+
+        patch_poll_module.get_returns.return_value = []
+        await ingest_once()
+
+        # Second call should have cursor from first batch
+        calls = patch_poll_module.get_returns.call_args_list
+        assert calls[1].kwargs.get("last_modified_since") == "2026-04-01T12:05:00Z" or \
+               calls[1][1].get("last_modified_since") == "2026-04-01T12:05:00Z"
+
+    @pytest.mark.asyncio
+    async def test_cursor_updated_to_max_last_modified_after_ingest(self, patch_poll_module, async_engine):
+        patch_poll_module.get_returns.return_value = [
+            SAMPLE_RETURN_COMPLETE.copy(),
+            SAMPLE_RETURN_NEWER_MODIFIED.copy(),
+        ]
+        await ingest_once()
+
+        tracker = PollStateTracker(engine=async_engine)
+        cursor = await tracker.get_cursor("product_returns")
+        # NEWER_MODIFIED has last_modified = "2026-04-04T08:10:00Z"
+        assert cursor == "2026-04-04T08:10:00Z"
+
+    @pytest.mark.asyncio
+    async def test_cursor_not_updated_on_empty_response(self, patch_poll_module, async_engine):
+        # Set initial cursor via first ingest
+        patch_poll_module.get_returns.return_value = [SAMPLE_RETURN_COMPLETE.copy()]
+        await ingest_once()
+
+        tracker = PollStateTracker(engine=async_engine)
+        cursor_before = await tracker.get_cursor("product_returns")
+
+        # Empty response
+        patch_poll_module.get_returns.return_value = []
+        await ingest_once()
+
+        cursor_after = await tracker.get_cursor("product_returns")
+        assert cursor_after == cursor_before
+
+    @pytest.mark.asyncio
+    async def test_cursor_not_updated_on_api_failure(self, patch_poll_module, async_engine):
+        # Set initial cursor
+        patch_poll_module.get_returns.return_value = [SAMPLE_RETURN_COMPLETE.copy()]
+        await ingest_once()
+
+        tracker = PollStateTracker(engine=async_engine)
+        cursor_before = await tracker.get_cursor("product_returns")
+
+        # API failure
+        patch_poll_module.get_returns.side_effect = TargetApiError("Fail", status_code=500)
+        await ingest_once()
+
+        cursor_after = await tracker.get_cursor("product_returns")
+        assert cursor_after == cursor_before
+
+        # Error count incremented
+        async with AsyncSession(async_engine) as session:
+            row = (await session.execute(
+                select(PollState).where(PollState.endpoint == "product_returns")
+            )).scalar_one()
+            assert row.error_count >= 1
+
+    @pytest.mark.asyncio
+    async def test_missing_cursor_row_falls_back_to_full_fetch(self, patch_poll_module, async_engine):
+        # First ingest
+        patch_poll_module.get_returns.return_value = [SAMPLE_RETURN_COMPLETE.copy()]
+        await ingest_once()
+
+        # Delete poll_state row
+        async with AsyncSession(async_engine) as session:
+            async with session.begin():
+                await session.execute(delete(PollState))
+
+        # Re-ingest — should fall back to full fetch (None cursor)
+        patch_poll_module.get_returns.return_value = [SAMPLE_RETURN_COMPLETE.copy()]
+        await ingest_once()
+
+        calls = patch_poll_module.get_returns.call_args_list
+        last_call = calls[-1]
+        assert last_call.kwargs.get("last_modified_since") is None or \
+               last_call[1].get("last_modified_since") is None
