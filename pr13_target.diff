+"""Tests verifying zero outbound HTTP calls to Target API in tests.
+
+Gate 2a: External API Isolation (ZERO TOLERANCE — BUSINESS CRITICAL).
+
+AC-6: All tests pass with zero outbound HTTP to api.target.com.
+"""
+
+from __future__ import annotations
+
+import pytest
+import httpx
+import respx
+
+from app.returns.client import TargetReturnsClient
+
+
+class TestExternalApiIsolation:
+    """Verify no real HTTP calls reach Target API during the test suite."""
+
+    @respx.mock
+    @pytest.mark.asyncio
+    async def test_no_outbound_calls_to_target_api(self):
+        """No real HTTP requests reach api.target.com during ingest."""
+        route = respx.get(
+            "https://stage-api.target.com/sellers/v1/sellers/SELLER001/product_returns"
+        ).mock(return_value=httpx.Response(200, json=[]))
+
+        client = TargetReturnsClient(
+            base_url="https://stage-api.target.com",
+            seller_id="SELLER001",
+            token="test-token",
+        )
+
+        result = await client.get_returns()
+        assert result == []
+        assert route.called
+
+    def test_target_returns_client_is_mockable_via_di(self):
+        """TargetReturnsClient accepts an injected http_client for test isolation."""
+        from unittest.mock import MagicMock
+
+        mock_client = MagicMock()
+        target_client = TargetReturnsClient(
+            base_url="https://stage-api.target.com",
+            seller_id="SELLER001",
+            token="test-token",
+            http_client=mock_client,
+        )
+        assert target_client._http_client is mock_client
+
+    def test_poll_module_client_is_patchable(self):
+        """poll._client can be replaced with a mock for test isolation."""
+        from unittest.mock import MagicMock, patch
+        import app.returns.poll as poll_module
+
+        mock = MagicMock()
+        with patch.object(poll_module, "_client", mock):
+            assert poll_module._client is mock
+
+    @respx.mock
+    @pytest.mark.asyncio
+    async def test_respx_catches_unmocked_outbound_calls(self):
+        """respx raises on any unmatched HTTP call — safety net for test isolation."""
+        async with httpx.AsyncClient() as client:
+            with pytest.raises(Exception):
+                await client.get("https://api.target.com/anything")
