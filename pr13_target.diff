+        # Run reconciliation query: find returns with non-null order_id
+        # (in production this would be a LEFT JOIN against orders table;
+        #  in test we just check that we can query for orphaned returns)
+        async with AsyncSession(async_engine) as session:
+            orphaned = (await session.execute(
+                select(ProductReturn).where(
+                    ProductReturn.order_id.isnot(None)
+                )
+            )).scalars().all()
+
+            null_order = (await session.execute(
+                select(ProductReturn).where(
+                    ProductReturn.order_id.is_(None)
