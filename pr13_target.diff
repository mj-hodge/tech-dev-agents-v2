+"""Tests for the returns ingest cycle: poll -> parse -> dedup -> persist.
+
+Covers:
+  - Happy path full ingest cycle (AC-3)
+  - Re-run dedup via id PK upsert (AC-3)
+  - Empty API response handling
+  - Multiple distinct records persisted
+  - Output variance (stub-detection gate)
+  - Structured log emission (AC-9)
+  - Error observability (Gate 10)
+  - Polling interval env var (AC-7)
+"""
+
+from __future__ import annotations
+
+import logging
+import os
+
+import pytest
+from sqlalchemy import select, func
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from app.returns.client import TargetApiError
+from app.returns.models import ProductReturn
+from app.returns.poll import ingest_once, get_poll_interval
+
+from tests.conftest import (
+    SAMPLE_RETURN_COMPLETE,
+    SAMPLE_RETURN_UNKNOWN_REASON,
+    SAMPLE_RETURN_MINIMAL,
+)
+
+
+# ---------------------------------------------------------------------------
+# Happy path: full ingest cycle
+# ---------------------------------------------------------------------------
+
+
+class TestFullIngestCycle:
+    """Verify end-to-end poll -> parse -> persist flow."""
+
+    @pytest.mark.asyncio
+    async def test_full_ingest_cycle_persists_records(
+        self, patch_poll_module, async_engine, target_api_response_single
+    ):
+        patch_poll_module.get_returns.return_value = target_api_response_single
+        result = await ingest_once()
+
+        assert result["poll_status"] == "success"
+        assert result["records_inserted"] >= 1
+
+    @pytest.mark.asyncio
+    async def test_full_ingest_cycle_rerun_produces_no_duplicates(
+        self, patch_poll_module, async_engine, target_api_response_single
+    ):
+        patch_poll_module.get_returns.return_value = target_api_response_single
+        r1 = await ingest_once()
+        assert r1["records_inserted"] >= 1
+
+        r2 = await ingest_once()
+        assert r2["records_inserted"] == 0
+
+    @pytest.mark.asyncio
+    async def test_ingest_cycle_empty_response_succeeds(self, patch_poll_module):
+        patch_poll_module.get_returns.return_value = []
+        result = await ingest_once()
+        assert result["poll_status"] == "empty"
+        assert result["records_inserted"] == 0
+
+    @pytest.mark.asyncio
+    async def test_ingest_multiple_records_persists_all(
+        self, patch_poll_module, async_engine, target_api_response_multiple
+    ):
+        patch_poll_module.get_returns.return_value = target_api_response_multiple
+        result = await ingest_once()
+        assert result["records_inserted"] == 2
+
+    @pytest.mark.asyncio
+    async def test_ingest_minimal_record_uses_defaults(
+        self, patch_poll_module, async_engine, target_api_response_minimal
+    ):
+        patch_poll_module.get_returns.return_value = target_api_response_minimal
+        result = await ingest_once()
+        assert result["records_inserted"] == 1
+
+        async with AsyncSession(async_engine) as session:
+            row = (await session.execute(
+                select(ProductReturn).where(ProductReturn.id == SAMPLE_RETURN_MINIMAL["id"])
+            )).scalar_one()
+            assert row.quantity == 1
+            assert row.return_reason_known is True
+            assert row.is_archived is False
+
+
+# ---------------------------------------------------------------------------
+# Output-variance: different inputs -> different outputs (stub detection gate)
+# ---------------------------------------------------------------------------
+
+
+class TestOutputVariance:
+    """Gate: output-variance tests — two different inputs produce different outputs."""
+
+    @pytest.mark.asyncio
+    async def test_ingest_output_varies_with_input(self, patch_poll_module, async_engine):
+        # First ingest: COMPLETE (DAMAGED)
+        patch_poll_module.get_returns.return_value = [SAMPLE_RETURN_COMPLETE.copy()]
+        await ingest_once()
+
+        # Second ingest: UNKNOWN_REASON
+        patch_poll_module.get_returns.return_value = [SAMPLE_RETURN_UNKNOWN_REASON.copy()]
+        await ingest_once()
+
+        async with AsyncSession(async_engine) as session:
+            count = (await session.execute(
+                select(func.count()).select_from(ProductReturn)
+            )).scalar()
+            assert count == 2
+
+            r1 = (await session.execute(
+                select(ProductReturn).where(ProductReturn.id == SAMPLE_RETURN_COMPLETE["id"])
+            )).scalar_one()
+            assert r1.return_reason == "DAMAGED"
+            assert r1.return_reason_known is True
+
+            r2 = (await session.execute(
+                select(ProductReturn).where(ProductReturn.id == SAMPLE_RETURN_UNKNOWN_REASON["id"])
+            )).scalar_one()
+            assert r2.return_reason == "FUTURE_UNKNOWN_REASON_XYZ"
+            assert r2.return_reason_known is False
+
+    @pytest.mark.asyncio
+    async def test_upsert_updates_mutable_fields_on_conflict(self, patch_poll_module, async_engine):
+        # First ingest
+        patch_poll_module.get_returns.return_value = [SAMPLE_RETURN_COMPLETE.copy()]
+        await ingest_once()
+
+        # Second ingest with updated quantity
+        modified = SAMPLE_RETURN_COMPLETE.copy()
+        modified["quantity"] = 3
+        patch_poll_module.get_returns.return_value = [modified]
+        await ingest_once()
+
+        async with AsyncSession(async_engine) as session:
+            count = (await session.execute(
+                select(func.count()).select_from(ProductReturn)
+            )).scalar()
+            assert count == 1
+
+            row = (await session.execute(
+                select(ProductReturn).where(ProductReturn.id == SAMPLE_RETURN_COMPLETE["id"])
+            )).scalar_one()
+            assert row.quantity == 3
+
+
+# ---------------------------------------------------------------------------
+# Structured logging (AC-9)
+# ---------------------------------------------------------------------------
+
+
+class TestIngestObservability:
+    """AC-9: verify structured JSON logs are emitted per poll cycle."""
+
+    @pytest.mark.asyncio
+    async def test_ingest_success_logs_structured_fields(self, patch_poll_module, caplog):
+        patch_poll_module.get_returns.return_value = [SAMPLE_RETURN_COMPLETE.copy()]
+        with caplog.at_level(logging.INFO, logger="app.returns.poll"):
+            result = await ingest_once()
+
+        assert result["poll_status"] == "success"
+        # Check log records for structured fields
+        poll_logs = [r for r in caplog.records if "poll_complete" in str(getattr(r, "event", "") or getattr(r, "msg", ""))]
+        assert len(poll_logs) >= 1 or any("poll completed" in r.getMessage().lower() for r in caplog.records)
+
+    @pytest.mark.asyncio
+    async def test_ingest_failure_logs_error_with_context(self, patch_poll_module, caplog):
+        patch_poll_module.get_returns.side_effect = TargetApiError("Test failure", status_code=503)
+        with caplog.at_level(logging.ERROR, logger="app.returns.poll"):
+            result = await ingest_once()
+
+        assert result["poll_status"] == "error"
+        assert any("error" in r.getMessage().lower() or "Target API" in r.getMessage() for r in caplog.records)
+
+
+# ---------------------------------------------------------------------------
+# Polling interval configuration (AC-7)
+# ---------------------------------------------------------------------------
+
+
+class TestPollingIntervalConfig:
+    """AC-7: verify poll interval is read from RETURNS_POLL_INTERVAL_SEC."""
+
+    def test_poll_interval_defaults_to_600(self, monkeypatch):
+        monkeypatch.delenv("RETURNS_POLL_INTERVAL_SEC", raising=False)
+        assert get_poll_interval() == 600
+
+    def test_poll_interval_reads_from_env_var(self, monkeypatch):
+        monkeypatch.setenv("RETURNS_POLL_INTERVAL_SEC", "60")
+        assert get_poll_interval() == 60
