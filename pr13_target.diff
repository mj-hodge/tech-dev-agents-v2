+++ b/app/returns/poll.py
@@ -0,0 +1,337 @@
+"""Poll loop for Target returns ingest.
+
+Single poll-parse-dedup-persist cycle (ingest_once) +
+background async loop (run_poll_loop) that fires every RETURNS_POLL_INTERVAL_SEC.
+
+Module-level _client and _engine are patched in tests for dependency injection.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import logging
+import os
+import time
+from datetime import datetime, timezone
+from typing import Optional
+
+from sqlalchemy import select
+from sqlalchemy.ext.asyncio import AsyncSession, create_async_engine
+
+from app.common.enum_handling import validate_enum_value
+from app.common.poll import PollStateTracker
+from app.returns.client import TargetApiError, TargetReturnsClient
+from app.returns.models import ProductReturn
+
+logger = logging.getLogger(__name__)
+
+# Module-level state — patched in tests for dependency injection
+_client: Optional[TargetReturnsClient] = None
+_engine: Optional[object] = None
+
+# Readiness probe: updated after each successful poll cycle
+last_successful_poll_at: Optional[datetime] = None
+
+# Known return reason values; anything else tagged with return_reason_known=False
+_KNOWN_RETURN_REASONS: frozenset[str] = frozenset({
+    "DAMAGED",
+    "DEFECTIVE",
+    "NOT_AS_DESCRIBED",
+    "CHANGED_MIND",
+    "WRONG_ITEM",
+    "NOT_DELIVERED",
+    "DUPLICATE_ORDER",
+})
+
+# Endpoint identifier for poll_state table
+_ENDPOINT = "product_returns"
+
+
+def get_poll_interval() -> int:
+    """Return the poll interval in seconds from env var or default."""
+    return int(os.getenv("RETURNS_POLL_INTERVAL_SEC", "600"))
+
+
+async def ingest_once() -> dict:
+    """Single poll-parse-dedup-persist cycle.
+
+    1. Read cursor from poll_state table (or None for first run).
+    2. Call TargetReturnsClient.get_returns(last_modified_since=cursor).
+    3. Validate / tag each record's return_reason via validate_enum_value().
+    4. Bulk upsert into product_returns (INSERT ... ON CONFLICT (id) DO UPDATE).
+    5. Update poll_state with new high-water mark + stats.
+    6. Emit structured JSON log: records_fetched, records_upserted, cursor_value, duration_ms.
+
+    Returns:
+        Dict with keys: poll_status, records_fetched, records_inserted,
+        records_skipped, cursor_value, duration_ms.
+
+    Raises:
+        Exception: on DB failure (fail-closed — no silent data loss).
+    """
+    global last_successful_poll_at
+
+    engine = get_engine()
+    client = get_client()
+    tracker = PollStateTracker(engine)
+    start_time = time.monotonic()
+
+    # 1. Read cursor
+    cursor = await tracker.get_cursor(_ENDPOINT)
+
+    # 2. Fetch from Target API
+    try:
+        raw_returns = await client.get_returns(last_modified_since=cursor)
+    except TargetApiError as exc:
+        duration_ms = int((time.monotonic() - start_time) * 1000)
+        await tracker.increment_error_count(_ENDPOINT)
+        logger.error(
+            "Target API error during returns poll",
+            extra={
+                "event": "poll_error",
+                "endpoint": _ENDPOINT,
+                "error": str(exc),
+                "status_code": exc.status_code,
+                "error_type": type(exc).__name__,
+                "duration_ms": duration_ms,
+            },
+        )
+        return {
+            "poll_status": "error",
+            "records_fetched": 0,
+            "records_inserted": 0,
+            "records_skipped": 0,
+            "cursor_value": cursor,
+            "duration_ms": duration_ms,
+            "error": str(exc),
+        }
+    except Exception as exc:
+        duration_ms = int((time.monotonic() - start_time) * 1000)
+        await tracker.increment_error_count(_ENDPOINT)
+        logger.error(
+            "Unexpected error during returns poll",
+            extra={
+                "event": "poll_error",
+                "endpoint": _ENDPOINT,
+                "error": str(exc),
+                "error_type": type(exc).__name__,
+                "duration_ms": duration_ms,
+            },
+        )
+        return {
+            "poll_status": "error",
+            "records_fetched": 0,
+            "records_inserted": 0,
+            "records_skipped": 0,
+            "cursor_value": cursor,
+            "duration_ms": duration_ms,
+            "error": str(exc),
+        }
+
+    # Handle None response (treat as empty)
+    if raw_returns is None:
+        raw_returns = []
+
+    records_fetched = len(raw_returns)
+
+    if records_fetched == 0:
+        duration_ms = int((time.monotonic() - start_time) * 1000)
+        # Update last_poll_at but don't advance cursor
+        await tracker.set_cursor(
+            _ENDPOINT, cursor, records_fetched=0, error_count=0
+        )
+        last_successful_poll_at = datetime.now(timezone.utc)
+        logger.info(
+            "Returns poll completed (empty response)",
+            extra={
+                "event": "poll_complete",
+                "endpoint": _ENDPOINT,
+                "seller_id": client.seller_id,
+                "records_fetched": 0,
+                "records_upserted": 0,
+                "cursor_value": cursor,
+                "duration_ms": duration_ms,
+            },
+        )
+        return {
+            "poll_status": "empty",
+            "records_fetched": 0,
+            "records_inserted": 0,
+            "records_skipped": 0,
+            "cursor_value": cursor,
+            "duration_ms": duration_ms,
+        }
+
+    # 3-4. Parse, validate, and upsert
+    now = datetime.now(timezone.utc)
+    records_inserted = 0
+    max_last_modified: str | None = None
+
+    async with AsyncSession(engine) as session:
+        async with session.begin():
+            for raw in raw_returns:
+                record_id = raw.get("id")
+                if not record_id:
+                    continue
+
+                # Validate return_reason
+                return_reason = raw.get("return_reason")
+                if return_reason is not None:
+                    _, is_known = validate_enum_value(
+                        return_reason, _KNOWN_RETURN_REASONS
+                    )
+                else:
+                    is_known = True  # None is valid (reason not yet provided)
+
+                # Parse timestamps
+                last_modified_str = raw.get("last_modified")
+                return_date_str = raw.get("return_date")
+                created_str = raw.get("created")
+
+                last_modified_dt = (
+                    datetime.fromisoformat(last_modified_str.replace("Z", "+00:00"))
+                    if last_modified_str
+                    else None
+                )
+                return_date_dt = (
+                    datetime.fromisoformat(return_date_str.replace("Z", "+00:00"))
+                    if return_date_str
+                    else None
+                )
+                created_dt = (
+                    datetime.fromisoformat(created_str.replace("Z", "+00:00"))
+                    if created_str
+                    else None
+                )
+
+                # Track max last_modified for cursor
+                if last_modified_str:
+                    if max_last_modified is None or last_modified_str > max_last_modified:
+                        max_last_modified = last_modified_str
+
+                # Check if record exists (for upsert)
+                result = await session.execute(
+                    select(ProductReturn).where(ProductReturn.id == record_id)
+                )
+                existing = result.scalar_one_or_none()
+
+                if existing:
+                    # Update mutable fields
+                    existing.order_id = raw.get("order_id")
+                    existing.order_number = raw.get("order_number")
+                    existing.seller_id = raw.get("seller_id", existing.seller_id)
+                    existing.return_order_number = raw.get("return_order_number")
+                    existing.tcin = raw.get("tcin")
+                    existing.external_id = raw.get("external_id")
+                    existing.quantity = raw.get("quantity", 1)
+                    existing.return_reason = return_reason
+                    existing.return_reason_known = is_known
+                    existing.return_date = return_date_dt
+                    existing.created = created_dt
+                    existing.last_modified = last_modified_dt
+                    existing.created_by = raw.get("created_by")
+                    existing.last_modified_by = raw.get("last_modified_by")
+                    existing.updated_at = now
+                    # Do NOT update ingested_at — preserves first-seen time
+                else:
+                    record = ProductReturn(
+                        id=record_id,
+                        order_id=raw.get("order_id"),
+                        order_number=raw.get("order_number"),
+                        seller_id=raw.get("seller_id", ""),
+                        return_order_number=raw.get("return_order_number"),
+                        tcin=raw.get("tcin"),
+                        external_id=raw.get("external_id"),
+                        quantity=raw.get("quantity", 1),
+                        return_reason=return_reason,
+                        return_reason_known=is_known,
+                        return_date=return_date_dt,
+                        created=created_dt,
+                        last_modified=last_modified_dt,
+                        created_by=raw.get("created_by"),
+                        last_modified_by=raw.get("last_modified_by"),
+                        is_archived=False,
+                        ingested_at=now,
+                        updated_at=now,
+                    )
+                    session.add(record)
+                    records_inserted += 1
+
+    # 5. Update cursor
+    new_cursor = max_last_modified if max_last_modified else cursor
+    await tracker.set_cursor(
+        _ENDPOINT, new_cursor, records_fetched=records_fetched, error_count=0
+    )
+
+    # 6. Log and return
+    duration_ms = int((time.monotonic() - start_time) * 1000)
+    last_successful_poll_at = datetime.now(timezone.utc)
+
+    logger.info(
+        "Returns poll completed",
+        extra={
+            "event": "poll_complete",
+            "endpoint": _ENDPOINT,
+            "seller_id": client.seller_id,
+            "records_fetched": records_fetched,
+            "records_upserted": records_inserted,
+            "cursor_value": new_cursor,
+            "duration_ms": duration_ms,
+        },
+    )
+
+    return {
+        "poll_status": "success",
+        "records_fetched": records_fetched,
+        "records_inserted": records_inserted,
+        "records_skipped": records_fetched - records_inserted,
+        "cursor_value": new_cursor,
+        "duration_ms": duration_ms,
+    }
+
+
+async def run_poll_loop() -> None:
+    """Background async loop that fires ingest_once() every poll interval."""
+    interval = get_poll_interval()
+    logger.info(
+        "Starting returns poll loop",
+        extra={"interval_sec": interval, "endpoint": _ENDPOINT},
+    )
+    while True:
+        try:
+            await ingest_once()
+        except Exception as exc:
+            logger.error(
+                "Poll loop iteration failed",
+                extra={
+                    "event": "poll_loop_error",
+                    "endpoint": _ENDPOINT,
+                    "error": str(exc),
+                    "error_type": type(exc).__name__,
+                },
+            )
+        await asyncio.sleep(interval)
+
+
+def get_engine() -> object:
+    """Return the module-level async engine, creating it lazily if needed."""
+    global _engine
+    if _engine is None:
+        db_url = os.getenv(
+            "DATABASE_URL",
+            "postgresql+asyncpg://localhost/target",
+        )
+        _engine = create_async_engine(db_url, echo=False)
+    return _engine
+
+
+def get_client() -> TargetReturnsClient:
+    """Return the module-level client, creating it lazily if needed."""
+    global _client
+    if _client is None:
+        _client = TargetReturnsClient(
+            base_url=os.getenv("TARGET_API_BASE_URL", "https://stage-api.target.com"),
+            seller_id=os.getenv("TARGET_SELLER_ID", ""),
+            token=os.getenv("TARGET_API_TOKEN", ""),
+        )
+    return _client
