+"""Shared unknown-enum tag-and-continue logic.
+
+Pattern: never crash on an unrecognized enum value from Target API.
+Store the raw value and tag the record with a *_known = False flag.
+
+Owned by STORY-011; consumed by STORY-010, STORY-012, STORY-013, STORY-017.
+
+Phase 7 stub — Phase 8 implements the real logic.
+"""
+
+from __future__ import annotations
+
+
+def validate_enum_value(
+    value: str,
+    known_values: frozenset[str] | set[str],
+) -> tuple[str, bool]:
+    """Return the raw value and a boolean indicating whether it is a known enum member.
+
+    Args:
+        value: The raw string value received from Target API.
+        known_values: The set of expected enum values for this field.
+
+    Returns:
+        (value, is_known) — always returns the raw value; is_known is False
+        when the value is not in known_values.
+
+    Example::
+        reason, known = validate_enum_value("DAMAGED", _KNOWN_RETURN_REASONS)
+        # reason == "DAMAGED", known == True
+
+        reason, known = validate_enum_value("FUTURE_REASON_XYZ", _KNOWN_RETURN_REASONS)
+        # reason == "FUTURE_REASON_XYZ", known == False
+    """
+    if not value or value not in known_values:
+        return (value, False)
+    return (value, True)
