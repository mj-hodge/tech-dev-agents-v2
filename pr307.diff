+@router.get("/history", response_model=DispatchHistoryResponse)
+async def v2_dispatch_history(
+    request: Request,
+    limit: int = Query(50, ge=1),
+    offset: int = Query(0, ge=0),
+    status: str | None = Query(None, pattern=r"^(completed|cancelled|failed|dead_letter)$"),
+    v2_svc: DispatchV2Service = Depends(get_v2_service),
+) -> DispatchHistoryResponse:
+    """Paginated history of terminal v2 dispatch jobs.
+
+    Unions with pre-cutover v1 dispatch_items for continuity (SC-7).
+    State mapping: completed→completed, cancelled/dead_letter→cancelled, failed→failed.
+    """
+    import time as _time
+    start = _time.monotonic()
+
+    # Silently cap limit (not via FastAPI le= so limit=500 returns 200 not 422)
+    capped_limit = min(limit, 200)
+
+    cutover_ts = os.environ.get("V2_HISTORY_CUTOVER_TS", "2026-05-03T00:00:00Z")
+
+    # V2 terminal rows
+    v2_result = await v2_svc.list_history(
+        limit=capped_limit, offset=offset, status_filter=status
+    )
+    v2_items_raw = v2_result["items"]
+    v2_total = v2_result["total"]
+
+    # V1 pre-cutover rows (graceful degradation if v1 is unavailable)
+    v1_items_raw: list[dict] = []
+    try:
+        db_svc = request.app.state.dispatch_db_service
+        v1_items_raw = await db_svc.history_before_cutover(
+            cutover_ts=cutover_ts, status_filter=status
+        )
+    except Exception as exc:
+        logger.error("[V2-HISTORY] v1 history_before_cutover failed: %s", exc, exc_info=True)
+
+    total = v2_total + len(v1_items_raw)
+
+    if v1_items_raw:
+        # Merge and sort by completed_at DESC; re-paginate the unified result
+        def _sort_key(item: dict) -> str:
+            return (
+                item.get("completed_at")
+                or item.get("cancelled_at")
+                or item.get("failed_at")
+                or item.get("enqueued_at")
+                or ""
+            )
+
+        all_raw = sorted(v2_items_raw + v1_items_raw, key=_sort_key, reverse=True)
+        page_raw = all_raw[offset: offset + capped_limit]
+    else:
+        # No v1 rows — v2 result is already paginated correctly
+        page_raw = v2_items_raw
+
+    def _to_item(row: dict) -> DispatchItem:
+        return DispatchItem(
+            story_id=row["story_id"],
+            repo=row["repo"],
+            scope=row.get("scope", "small"),
+            prompt=row.get("prompt", ""),
+            enqueued_at=str(row.get("enqueued_at") or ""),
+            enqueued_by=row.get("enqueued_by", ""),
+            title=row.get("title"),
+            status=DispatchStatusEnum(row.get("status", "completed")),
+            claimed_by=row.get("claimed_by"),
+            claimed_at=row.get("claimed_at"),
+            completed_at=row.get("completed_at"),
+            cancelled_at=row.get("cancelled_at"),
+            failed_at=row.get("failed_at"),
+            failure_reason=row.get("failure_reason"),
+            pr_number=row.get("pr_number"),
+        )
+
+    items = [_to_item(r) for r in page_raw]
+
+    elapsed = int((_time.monotonic() - start) * 1000)
+    logger.info(
+        "[V2-HISTORY] limit=%d offset=%d status=%s total=%d elapsed=%dms",
+        capped_limit, offset, status, total, elapsed,
+    )
+    if elapsed > 500:
+        logger.warning(
+            "[V2-HISTORY] union took %dms (>500ms canary) — consider indexing",
+            elapsed,
+        )
+
+    return DispatchHistoryResponse(
+        items=items,
+        total=total,
+        limit=capped_limit,
+        offset=offset,
+        fetched_at=datetime.now(timezone.utc).isoformat(),
+    )
