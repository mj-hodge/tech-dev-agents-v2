             "fetched_at": datetime.now(timezone.utc).isoformat(),
         }
 
+    # -------------------------------------------------------------------------
+    # History: list_history
+    # -------------------------------------------------------------------------
+
+    async def list_history(
+        self,
+        *,
+        limit: int = 50,
+        offset: int = 0,
+        status_filter: str | None = None,
+    ) -> dict[str, Any]:
+        """Return paginated terminal v2 jobs for the History tab.
+
+        State mapping:
+          completed    → "completed"
+          cancelled    → "cancelled"
+          dead_letter  → "cancelled"
+          failed       → "failed"
+
+        claimed_by: from the most-recent 'leased' event's actor in
+        dispatch_v2_events; falls back to dispatch_state_current.leased_by.
+
+        completed_at / cancelled_at: from the terminal event's created_at
+        (accepted/cancelled/dead_lettered event row in dispatch_v2_events).
+
+        Returns {"items": [...], "total": int}
+        where each item is a DispatchItem-compatible dict.
+        """
+        _STATE_TO_STATUS = {
+            "completed": "completed",
+            "cancelled": "cancelled",
+            "dead_letter": "cancelled",
+            "failed": "failed",
+        }
+
+        # Map status_filter → v2 state(s) to query
+        if status_filter == "cancelled":
+            state_filter_list = ["cancelled", "dead_letter"]
+        elif status_filter == "dead_letter":
+            state_filter_list = ["dead_letter"]
+        elif status_filter:
+            state_filter_list = [status_filter]
+        else:
+            state_filter_list = ["completed", "cancelled", "dead_letter", "failed"]
+
+        async with self._acquire() as conn:
+            rows = await conn.fetch(
+                """SELECT j.job_id, j.repo, j.story_id, j.scope, j.prompt,
+                          j.enqueued_by, j.title, j.created_at AS enqueued_at,
+                          j.pr_number, j.correlation_key,
+                          s.state, s.leased_by, s.updated_at
+                   FROM dispatch_state_current s
+                   JOIN dispatch_jobs j ON j.job_id = s.job_id
+                   WHERE s.lane = 'terminal'
+                     AND s.state = ANY($1::text[])
+                   ORDER BY s.updated_at DESC
+                   LIMIT $2 OFFSET $3""",
+                state_filter_list, limit, offset,
+            )
+            total = await conn.fetchval(
+                """SELECT COUNT(*) FROM dispatch_state_current s
+                   WHERE s.lane = 'terminal'
+                     AND s.state = ANY($1::text[])""",
+                state_filter_list,
+            )
+
+            items = []
+            for row in rows:
+                job_id = str(row["job_id"])
+
+                # Derive claimed_by from most-recent 'leased' event
+                leased_event = await conn.fetchrow(
+                    """SELECT event_data->>'actor' AS actor, actor AS actor2
+                       FROM dispatch_v2_events
+                       WHERE job_id = $1::uuid AND event_type = 'leased'
+                       ORDER BY event_id DESC LIMIT 1""",
+                    job_id,
+                )
+                if leased_event:
+                    claimed_by = leased_event["actor"] or leased_event["actor2"]
+                else:
+                    claimed_by = row["leased_by"]
+
+                # Derive terminal timestamp from terminal event
+                # terminal events: accepted → completed, cancelled → cancelled, dead_lettered → dead_letter
+                state = row["state"]
+                if state == "completed":
+                    terminal_event_type = "accepted"
+                elif state == "cancelled":
+                    terminal_event_type = "cancelled"
+                elif state == "dead_letter":
+                    terminal_event_type = "dead_lettered"
+                else:  # failed
+                    terminal_event_type = "failed"
+
+                terminal_event = await conn.fetchrow(
+                    """SELECT created_at FROM dispatch_v2_events
+                       WHERE job_id = $1::uuid AND event_type = $2
+                       ORDER BY event_id DESC LIMIT 1""",
+                    job_id, terminal_event_type,
+                )
+                terminal_ts = terminal_event["created_at"].isoformat() if terminal_event else row["updated_at"].isoformat()
+
+                mapped_status = _STATE_TO_STATUS.get(state, state)
+                completed_at = terminal_ts if state == "completed" else None
+                cancelled_at = terminal_ts if state in ("cancelled", "dead_letter") else None
+                failed_at = terminal_ts if state == "failed" else None
+
+                items.append({
+                    "story_id": row["story_id"],
+                    "repo": row["repo"],
+                    "scope": row["scope"],
+                    "prompt": row["prompt"],
+                    "enqueued_at": row["enqueued_at"].isoformat(),
+                    "enqueued_by": row["enqueued_by"],
+                    "title": row["title"],
+                    "status": mapped_status,
+                    "claimed_by": claimed_by,
+                    "claimed_at": None,
+                    "completed_at": completed_at,
+                    "cancelled_at": cancelled_at,
+                    "failed_at": failed_at,
+                    "pr_number": row["pr_number"],
+                    "failure_reason": None,
+                })
+
+        return {"items": items, "total": total}
+
