+# ---------------------------------------------------------------------------
+# M-1 fix: first-run initializes from HEAD, does NOT scan since 1970
+# ---------------------------------------------------------------------------
+
+
+class TestFirstRunInit:
+    """M-1: first run (no state file) self-initializes from HEAD and returns []."""
+
+    @patch("subprocess.run")
+    def test_first_run_initializes_from_head(self, mock_run, tmp_path):
+        """No state file → detect_new_merges reads git rev-parse HEAD, writes state, returns [].
+
+        M-1 defect: first run fell back to '--since=1970-01-01T00:00:00Z', which
+        scanned the entire commit history and could cascade dozens of redundant deploys.
+        Fix: call git rev-parse HEAD, write that SHA + timestamp to the state file,
+        and return [] (bootstrap run: nothing to process yet).
+
+        Arrange: state file path points to a non-existent file.
+        Act: call detect_new_merges().
+        Assert: (a) returns [], (b) state file is created containing HEAD SHA,
+                (c) no '--since=1970' appears in any subprocess call.
+        """
+        # Arrange: no state file
+        state_file = tmp_path / "first-run-state.txt"
+        # state_file does NOT exist
+
+        def fake_run(cmd, **kwargs):
+            cmd_str = " ".join(str(c) for c in cmd)
+            if "rev-parse" in cmd_str:
+                # git rev-parse HEAD → return known SHA
+                return MagicMock(returncode=0, stdout=_HEAD_SHA + "\n", stderr="")
+            # Any other git call (should not happen on first run, but be safe)
+            return MagicMock(returncode=0, stdout="", stderr="")
+
+        mock_run.side_effect = fake_run
+
+        # Act
+        result = _sweep.detect_new_merges(
+            repo_path=str(tmp_path),
+            state_file=str(state_file),
+            agent_paths=["deployment/hermes/"],
+        )
+
+        # Assert: bootstrap run returns no merges to process
+        assert result == [], (
+            f"M-1: first run must return [] (bootstrap only), got: {result}"
+        )
+
+        # Assert: state file was created for the next cycle
+        assert state_file.exists(), (
+            "M-1: state file must be written on first run so next cycle has a --since anchor"
+        )
+
+        # Assert: state file contains the HEAD SHA
+        contents = state_file.read_text().strip()
+        assert _HEAD_SHA in contents, (
+            f"M-1: state file must contain HEAD SHA {_HEAD_SHA!r}, got: {contents!r}"
+        )
+
+        # Assert: no '--since=1970...' call was made (entire history scan blocked)
+        all_cmds = [call.args[0] for call in mock_run.call_args_list]
+        for cmd in all_cmds:
+            for part in cmd:
+                assert "1970" not in str(part), (
+                    f"M-1: '--since=1970...' found in cmd {cmd} — "
+                    f"first run must NOT scan entire commit history."
+                )
+
