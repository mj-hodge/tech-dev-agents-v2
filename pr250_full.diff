+if __name__ == "__main__":
+    import sys
+
+    _base_url = os.environ.get("OPS_CONSOLE_BASE_URL", "http://localhost:8005")
+    _api_key = os.environ.get("OPS_CONSOLE_API_KEY", "")
+    _repo = os.environ.get(
+        "TECH_DEV_AGENTS_REPO", "/home/hermes/workspace/tech-dev-agents"
+    )
+    _state = os.environ.get(
+        "FLEET_SWEEP_STATE_FILE",
+        "/home/hermes/state/morris/last-fleet-vigilance-merge-sweep.txt",
+    )
+    _health = os.environ.get(
+        "FLEET_HEALTH_FILE",
+        "/home/hermes/state/morris/fleet-health.md",
+    )
+
+    _summary = run_sweep(
+        repo_path=_repo,
+        state_file=_state,
+        fleet_health_path=_health,
+        base_url=_base_url,
+        api_key=_api_key,
