+#!/usr/bin/env python3
+"""
+post-merge-sweep.py — Fleet Vigilance Check 17
+Post-merge deploy + re-enqueue sweep for Morris's heartbeat.
+
+Detects new merges to main touching agent-VM paths since last run,
+runs push-code.sh to deploy the fix, re-enqueues eligible failed
+dispatch_items, and posts a Teams DM summary.
+
+Pure Python stdlib + subprocess. No new dependencies.
+
+STORY-800 (rework of STORY-766/PR #244) — five fixes applied:
+  H-1: --no-merges removed (PRs land as merge commits)
+  H-2: send_teams_dm() integrated; run_sweep() delivers DM for both summary and CRIT
+  S-1: OPS_CONSOLE_API_KEY guard raises ValueError if unset/empty
+  M-1: First run self-initializes from HEAD, returns [] (no history scan)
+  T-1: Test assertion fix (in Phase 7 test file; not a code change here)
+
+https://github.com/hpi-gorillacommerce/tech-dev-agents
+"""
+from __future__ import annotations
+
+import json
+import os
+import re
+import subprocess
+import urllib.error
+import urllib.parse
+import urllib.request
+from datetime import datetime, timezone
+from typing import Any
+
+# ---------------------------------------------------------------------------
+# Constants
+# ---------------------------------------------------------------------------
+
+# Graph API base — used by send_teams_dm() (H-2 fix)
+_GRAPH_BASE = "https://graph.microsoft.com/v1.0"
+
+# Allowlisted failure_reason prefixes (AC-4) — only re-enqueue these
+_ELIGIBLE_PREFIXES: tuple[str, ...] = (
+    "branch_setup_failed:",
+    "phase_progress_stalled:",
+    "sdk_died_no_phase_end:",
+)
+
+# Default lookback window (SC-9); overridden by FLEET_SWEEP_LOOKBACK_HOURS
+_DEFAULT_LOOKBACK_HOURS = 24
+
+# STORY-764 inline regex — strip [RETRY N/N] prefix before re-enqueue (AC-6)
+_RETRY_PREFIX_RE = re.compile(r"^\[RETRY\s+\d+/\d+\]\s*")
+
+
+# ---------------------------------------------------------------------------
+# State file helpers (SC-5 idempotency)
+# ---------------------------------------------------------------------------
+
+
+def read_state_file(state_path: str) -> tuple[str | None, str | None]:
+    """Return (sha, timestamp) from state file, or (None, None) if absent.
+
+    State file format (two lines):
+        <40-char SHA>
+        <ISO-8601 timestamp>
+    """
+    try:
+        with open(state_path, "r", encoding="utf-8") as fh:
+            lines = fh.read().splitlines()
+        sha = lines[0].strip() if lines else None
+        ts = lines[1].strip() if len(lines) >= 2 else None
+        return sha, ts
+    except FileNotFoundError:
+        return None, None
+
+
+def write_state_file(state_path: str, sha: str, ts: str) -> None:
+    """Persist last-processed merge SHA + timestamp to the state file (SC-5).
+
+    Creates parent directories if they do not exist.
+    """
+    parent = os.path.dirname(state_path)
+    if parent:
+        os.makedirs(parent, exist_ok=True)
+    with open(state_path, "w", encoding="utf-8") as fh:
+        fh.write(f"{sha}\n{ts}\n")
+
+
+# ---------------------------------------------------------------------------
+# SC-1: Detect new merges touching agent-VM paths
+# H-1 fix: NO --no-merges flag (PRs land as merge commits in this repo)
+# M-1 fix: First run (no state file) self-initializes from HEAD, returns []
+# ---------------------------------------------------------------------------
+
+
+def detect_new_merges(
+    repo_path: str,
+    state_file: str,
+    agent_paths: list[str],
+) -> list[str]:
+    """Return commit SHAs touching agent_paths since last run.
+
+    H-1 fix: --no-merges REMOVED. PRs in this repo land as merge commits
+    (#242, #243, #237, #232…). The state-file SHA gate (SC-5) handles dedup.
+
+    M-1 fix: First run (state file absent) calls git rev-parse HEAD, writes
+    that SHA + current UTC timestamp to the state file, and returns [] so the
+    next cycle has a valid --since anchor without scanning the entire history.
+    """
+    sha, last_ts = read_state_file(state_file)
+
+    # M-1 fix: first run — no state file → initialize from HEAD, return []
+    if sha is None:
+        now = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
+        result = subprocess.run(
+            ["git", "-C", repo_path, "rev-parse", "HEAD"],
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+        )
+        head_sha = result.stdout.strip()
+        write_state_file(state_file, head_sha, now)
+        return []
+
+    since_arg = f"--since={last_ts}" if last_ts else "--since=2000-01-01T00:00:00Z"
+
+    # H-1 fix: NO --no-merges flag
+    cmd = [
+        "git", "-C", repo_path, "log",
+        since_arg,
+        "--pretty=format:%H",
+        "--",
+        *agent_paths,
+    ]
+
+    result = subprocess.run(
+        cmd,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        text=True,
+    )
+
+    shas = [line.strip() for line in result.stdout.splitlines() if line.strip()]
+    return shas
+
+
+# ---------------------------------------------------------------------------
+# SC-2 / AC-7 / AC-11: Deploy via push-code.sh with timeout gate
+# ---------------------------------------------------------------------------
+
+
+def run_deploy(
+    script_path: str,
+    *,
+    timeout_s: int = 900,
+) -> dict[str, Any]:
+    """Run push-code.sh and return a result dict.
+
+    On non-zero exit code (smoke failure): returns success=False, smoke_ok=False
+    so the caller does NOT proceed to re-enqueue (AC-7 hard gate).
+
+    On subprocess.TimeoutExpired: catches the exception and returns
+    success=False, timed_out=True — no infinite hangs (AC-11).
+    """
+    try:
+        result = subprocess.run(
+            ["bash", script_path, "--wait", "5", "all"],
+            timeout=timeout_s,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+        )
+        stdout = result.stdout or ""
+        if result.returncode != 0:
+            failed = _parse_failed_agents(stdout)
+            if not failed:
+                failed = ["unknown"]
+            return {
+                "success": False,
+                "smoke_ok": False,
+                "failed_agents": failed,
+                "returncode": result.returncode,
+                "stdout": stdout,
+            }
+        return {
+            "success": True,
+            "smoke_ok": True,
+            "failed_agents": [],
+            "returncode": 0,
+            "stdout": stdout,
+        }
+    except subprocess.TimeoutExpired as exc:
+        return {
+            "success": False,
+            "timed_out": True,
+            "error_type": "timeout",
+            "failed_agents": ["timeout"],
+            "timeout_s": timeout_s,
+            "error": str(exc),
+        }
+
+
+def _parse_failed_agents(stdout: str) -> list[str]:
+    """Extract agent names that failed from push-code.sh output (best-effort)."""
+    _known_agents = ("dan", "derrick", "daisy", "devon")
+    failed: list[str] = []
+    for line in stdout.splitlines():
+        lower = line.lower()
+        is_error_line = (
+            "error" in lower
+            or "failed" in lower
+            or "fail" in lower
+            or "✗" in line
+        )
+        if not is_error_line:
+            continue
+        for agent in _known_agents:
+            if agent in lower and agent not in failed:
+                failed.append(agent)
+    return failed
+
+
+# ---------------------------------------------------------------------------
+# SC-9: Query eligible failures with configurable lookback window
+# S-1 fix: ValueError guard on empty/unset OPS_CONSOLE_API_KEY
+# ---------------------------------------------------------------------------
+
+
+def query_eligible_failures(
+    base_url: str,
+    api_key: str,
+    merge_ts: str,
+    lookback_hours: int,
+) -> list[dict]:
+    """Query dispatch_items for failed rows eligible for re-enqueue.
+
+    S-1 fix: raises ValueError at entry if api_key is falsy.
+    Filters by _ELIGIBLE_PREFIXES allowlist (AC-4).
+    lookback_hours controls the query window (SC-9).
+    Returns an empty list on any network or parse error (fail-safe).
+    """
+    # S-1 fix: guard empty api_key before any HTTP call
+    if not api_key:
+        raise ValueError(
+            "OPS_CONSOLE_API_KEY is unset — sweep cannot authenticate. "
+            "Set OPS_CONSOLE_API_KEY in the environment before running."
+        )
+
+    params = urllib.parse.urlencode({
+        "status": "failed",
+        "lookback_hours": lookback_hours,
+    })
+    url = f"{base_url.rstrip('/')}/api/dispatch/history?{params}"
+
+    req = urllib.request.Request(
+        url,
+        headers={"X-API-Key": api_key},
+        method="GET",
+    )
+
+    try:
+        with urllib.request.urlopen(req) as resp:
+            rows: list[dict] = json.loads(resp.read().decode("utf-8"))
+    except (urllib.error.URLError, json.JSONDecodeError, Exception):
+        return []
+
+    if not isinstance(rows, list):
+        return []
+
+    eligible: list[dict] = []
+    for row in rows:
+        reason = row.get("failure_reason") or ""
+        if reason and any(reason.startswith(prefix) for prefix in _ELIGIBLE_PREFIXES):
+            eligible.append(row)
+    return eligible
+
+
+# ---------------------------------------------------------------------------
+# SC-3 / AC-6: Re-enqueue with [RETRY N/N] prefix stripped
+# ---------------------------------------------------------------------------
+
+
+def reenqueue_story(
+    base_url: str,
+    api_key: str,
+    row: dict[str, Any],
+    merge_sha: str,
+) -> bool | dict:
+    """POST a failed story back to the dispatch queue.
+
+    Strips any existing [RETRY N/N] prefix before adding a new
+    [POST-MERGE-SWEEP] header (AC-6 / STORY-764 pattern).
+    """
+    original_prompt = row.get("prompt", "")
+    stripped_prompt = _RETRY_PREFIX_RE.sub("", original_prompt)
+    new_prompt = f"[POST-MERGE-SWEEP merge={merge_sha[:8]}] {stripped_prompt}".strip()
+
+    payload: dict[str, Any] = {
+        "story_id": row["story_id"],
+        "repo": row.get("repo", ""),
+        "prompt": new_prompt,
+        "scope": row.get("scope", "small"),
+        "enqueued_by": f"morris-post-merge-sweep:{merge_sha[:8]}",
+    }
+
+    url = f"{base_url.rstrip('/')}/api/dispatch"
+    data = json.dumps(payload).encode("utf-8")
+    req = urllib.request.Request(
+        url,
+        data=data,
+        headers={
+            "Content-Type": "application/json",
+            "X-API-Key": api_key,
+        },
+        method="POST",
+    )
+
+    try:
+        with urllib.request.urlopen(req) as resp:
+            if resp.status in (200, 201):
+                return True
+            return {"ok": False, "status": resp.status}
+    except urllib.error.HTTPError as exc:
+        return {"ok": False, "status": exc.code, "error": str(exc)}
+    except urllib.error.URLError as exc:
+        return {"ok": False, "error": str(exc)}
+
+
+# ---------------------------------------------------------------------------
+# SC-4 / AC-5: Cancel non-terminal rows before re-enqueue
+# ---------------------------------------------------------------------------
+
+
+def cancel_and_reenqueue_row(
+    base_url: str,
+    api_key: str,
+    row: dict[str, Any],
+    merge_sha: str,
+) -> bool | dict:
+    """Cancel a non-terminal row via STORY-765 manager override, then re-enqueue.
+
+    Issues DELETE /api/dispatch/queue/{story_id}?reason=... BEFORE POST
+    so paused/claimed rows are cleanly released prior to re-dispatch (AC-5).
+    """
+    story_id = row["story_id"]
+    repo = row.get("repo", "")
+    reason = f"Auto-sweep after merge {merge_sha[:8]}: STORY-N fix re-enables story."
+
+    cancel_url = (
+        f"{base_url.rstrip('/')}/api/dispatch/queue/{story_id}"
+        f"?reason={urllib.parse.quote(reason, safe='')}"
+    )
+    if repo:
+        cancel_url += f"&repo={urllib.parse.quote(repo, safe='')}"
+
+    cancel_req = urllib.request.Request(
+        cancel_url,
+        headers={"X-API-Key": api_key},
+        method="DELETE",
+    )
+
+    try:
+        with urllib.request.urlopen(cancel_req) as _resp:
+            pass  # 200/204 expected
+    except urllib.error.HTTPError as exc:
+        if exc.code == 403:
+            return {"ok": False, "error": f"Cancel 403 — STORY-765 not available: {exc}"}
+        if exc.code not in (200, 204, 404):
+            return {"ok": False, "error": f"Cancel failed HTTP {exc.code}"}
+    except urllib.error.URLError as exc:
+        return {"ok": False, "error": f"Cancel network error: {exc}"}
+
+    return reenqueue_story(
+        base_url=base_url,
+        api_key=api_key,
+        row=row,
+        merge_sha=merge_sha,
+    )
+
+
+# ---------------------------------------------------------------------------
+# SC-6: Teams DM summary format
+# ---------------------------------------------------------------------------
+
+
+def format_summary_dm(
+    merge_sha: str,
+    deploy_result: dict[str, Any],
+    reenqueue_count: int,
+) -> str:
+    """Return a [FLEET-SWEEP] summary string suitable for a Teams DM (SC-6).
+
+    Example:
+        [FLEET-SWEEP] Post-merge deploy 14b771b9 + re-enqueue:
+        - Deploy: ✓ all 4 agents, smoke green
+        - Re-enqueued: 11 stories
+    """
+    sha_short = merge_sha[:8]
+
+    if deploy_result.get("success"):
+        agent_count = deploy_result.get("agent_count", 4)
+        deploy_line = f"Deploy: ✓ all {agent_count} agents, smoke green"
+    else:
+        failed = deploy_result.get("failed_agents", [])
+        if deploy_result.get("timed_out"):
+            deploy_line = f"Deploy: ✗ TIMEOUT after {deploy_result.get('timeout_s', 900)}s"
+        else:
+            deploy_line = (
+                f"Deploy: ✗ failed agents: {', '.join(str(a) for a in failed) or 'unknown'}"
+            )
+
+    return (
+        f"[FLEET-SWEEP] Post-merge deploy {sha_short} + re-enqueue:\n"
+        f"- {deploy_line}\n"
+        f"- Re-enqueued: {reenqueue_count} stories\n"
+    )
+
+
+# ---------------------------------------------------------------------------
+# SC-7 / AC-10: Audit log
+# ---------------------------------------------------------------------------
+
+
+def append_audit_log(fleet_health_path: str, msg: str) -> None:
+    """Append a timestamped [POST-MERGE-SWEEP] entry to fleet-health.md (AC-10).
+
+    CRITICAL: this file must NEVER be committed to git (SKILL.md rule).
+    """
+    ts = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
+    entry = f"\n## {ts}\n{msg}\n"
+    with open(fleet_health_path, "a", encoding="utf-8") as fh:
+        fh.write(entry)
+
+
+# ---------------------------------------------------------------------------
+# H-2 fix: send_teams_dm — Graph API delivery (was formatted-but-never-sent)
+# Inlined from deployment/morris/scripts/daily_contact_summary.py:179 pattern.
+# ---------------------------------------------------------------------------
+
+
+def send_teams_dm(message: str) -> None:
+    """POST a plain-text message to Mark's Teams chat via Graph API.
+
+    H-2 fix: the original PR #244 built the DM string in result["dm"] but
+    never made a Graph API call. This function delivers the message.
+
+    Reads MARK_TEAMS_CHAT_ID and MORRIS_GRAPH_TOKEN from environment.
+    Silently skips if either env var is unset (non-fatal — DM is best-effort).
+    """
+    chat_id = os.environ.get("MARK_TEAMS_CHAT_ID", "")
+    token = os.environ.get("MORRIS_GRAPH_TOKEN", "")
+
+    if not chat_id or not token:
+        return  # env vars not configured — skip DM (non-fatal)
+
+    url = f"{_GRAPH_BASE}/me/chats/{chat_id}/messages"
+    payload = json.dumps({"body": {"contentType": "text", "content": message}}).encode()
+    req = urllib.request.Request(
+        url,
+        data=payload,
+        headers={
+            "Authorization": f"Bearer {token}",
+            "Content-Type": "application/json",
+        },
+        method="POST",
+    )
+    try:
+        with urllib.request.urlopen(req, timeout=15) as resp:
+            _ = resp.status
+    except (urllib.error.HTTPError, urllib.error.URLError):
+        pass  # Non-fatal — DM failure must not abort the sweep
+
+
+# ---------------------------------------------------------------------------
+# Main sweep orchestrator
+# H-2 fix: calls send_teams_dm() for both summary and CRIT paths
+# ---------------------------------------------------------------------------
+
+
+def run_sweep(
+    repo_path: str,
+    state_file: str,
+    fleet_health_path: str,
+    base_url: str,
+    api_key: str,
+    script_path: str = "deployment/vm/push-code.sh",
+    agent_paths: list[str] | None = None,
+    timeout_s: int = 900,
+) -> dict[str, Any]:
+    """Orchestrate the full post-merge deploy + re-enqueue sweep.
+
+    1. Detect new merges touching agent-VM paths (SC-1)
+    2. Run push-code.sh; abort sweep on smoke failure (SC-2 / AC-7)
+    3. H-2: Send [CRIT] DM on failure; [FLEET-SWEEP] DM on success
+    4. Query eligible failed rows (SC-3 / SC-9)
+    5. Cancel non-terminal rows before re-enqueue (SC-4 / AC-5)
+    6. Re-enqueue each eligible row with prefix stripped (SC-3 / AC-6)
+    7. Append audit log (SC-7 / AC-10)
+    8. Persist last-processed SHA (SC-5)
+    """
+    if agent_paths is None:
+        agent_paths = ["deployment/hermes/", "deployment/morris/"]
+
+    lookback_hours = int(
+        os.environ.get("FLEET_SWEEP_LOOKBACK_HOURS", str(_DEFAULT_LOOKBACK_HOURS))
+    )
+
+    # --- Step 1: Detect new merges ---
+    new_merges = detect_new_merges(repo_path, state_file, agent_paths)
+    if not new_merges:
+        append_audit_log(fleet_health_path, "[POST-MERGE-SWEEP] no new merges — no-op")
+        return {"action": "no-op", "merges": 0}
+
+    results: list[dict] = []
+
+    for merge_sha in new_merges:
+        # --- Step 2: Deploy ---
+        deploy_result = run_deploy(script_path, timeout_s=timeout_s)
+
+        if not deploy_result["success"]:
+            # AC-7: smoke failure → CRIT, do NOT re-enqueue
+            crit_msg = (
+                f"[CRIT] Post-merge deploy failed: sha={merge_sha[:8]} "
+                f"agents={deploy_result.get('failed_agents', [])} "
+                f"— manual intervention required"
+            )
+            # H-2 fix: deliver CRIT DM via Graph API
+            send_teams_dm(crit_msg)
+
+            audit_msg = (
+                f"[POST-MERGE-SWEEP] sha={merge_sha[:8]} "
+                f"deploy=FAILED smoke_ok=False "
+                f"— CRIT escalated to Mark"
+            )
+            append_audit_log(fleet_health_path, audit_msg)
+            results.append({
+                "sha": merge_sha,
+                "deploy": "failed",
+                "reenqueued": 0,
+                "crit": True,
+            })
+            continue
+
+        # --- Step 3: Query eligible failures ---
+        merge_ts = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
+        try:
+            eligible = query_eligible_failures(
+                base_url=base_url,
+                api_key=api_key,
+                merge_ts=merge_ts,
+                lookback_hours=lookback_hours,
+            )
+        except ValueError:
+            eligible = []
+
+        # --- Steps 4–5: Cancel-if-needed + re-enqueue ---
+        reenqueued = 0
+        _nonterminal_statuses = {"paused", "claimed", "in_review", "needs_info"}
+
+        for row in eligible:
+            status = row.get("status", "failed")
+            if status in _nonterminal_statuses:
+                ok = cancel_and_reenqueue_row(
+                    base_url=base_url,
+                    api_key=api_key,
+                    row=row,
+                    merge_sha=merge_sha,
+                )
+            else:
+                ok = reenqueue_story(
+                    base_url=base_url,
+                    api_key=api_key,
+                    row=row,
+                    merge_sha=merge_sha,
+                )
+            if ok is True or (isinstance(ok, dict) and ok.get("ok")):
+                reenqueued += 1
+
+        # --- Step 6: Audit log ---
+        audit_msg = (
+            f"[POST-MERGE-SWEEP] sha={merge_sha[:8]} "
+            f"deploy=success reenqueue={reenqueued} "
+            f"eligible={len(eligible)}"
+        )
+        append_audit_log(fleet_health_path, audit_msg)
+
+        # H-2 fix: build and deliver summary DM via Graph API
+        summary = format_summary_dm(
+            merge_sha=merge_sha,
+            deploy_result=deploy_result,
+            reenqueue_count=reenqueued,
+        )
+        send_teams_dm(summary)
+
+        results.append({
+            "sha": merge_sha,
+            "deploy": "success",
+            "reenqueued": reenqueued,
+            "eligible": len(eligible),
+            "dm": summary,
+        })
+
+        # --- Step 7: Persist last-processed SHA (SC-5) ---
+        write_state_file(
+            state_file,
+            sha=merge_sha,
+            ts=datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
+        )
+
+    return {
+        "action": "sweep",
+        "merges": len(new_merges),
+        "results": results,
+    }
+
+
