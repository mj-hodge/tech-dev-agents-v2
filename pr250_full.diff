+"""
+Tests for post-merge-sweep.py — STORY-800 Phase 7 (RED state).
+
+Verifies Fleet Vigilance Check 17: Post-Merge Deploy + Re-Enqueue Sweep.
+Rework of STORY-766/PR #244: five defects fixed (H-1, H-2, T-1, S-1, M-1).
+
+All external calls are mocked:
+  - subprocess.run  → git log, git rev-parse, push-code.sh
+  - urllib.request  → dispatch API (cancel + reenqueue), Graph API (Teams DM)
+
+State file I/O uses tmp_path for isolation.
+
+RED state: post-merge-sweep.py does not yet exist. Tests FAIL (not pass)
+because the module loader returns a _NotImplementedStub whose attributes
+raise NotImplementedError, recorded by pytest as a failure.
+"""
+
+from __future__ import annotations
+
+import importlib.util
+import json
+import os
+import pathlib
+import re
+import subprocess
+from datetime import datetime, timezone
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+# ---------------------------------------------------------------------------
+# Module loader — RED-state stub so tests FAIL rather than ERROR
+# ---------------------------------------------------------------------------
+
+_SWEEP_PATH = (
+    pathlib.Path(__file__).resolve().parent.parent.parent
+    / "deployment"
+    / "morris"
+    / "scripts"
+    / "post-merge-sweep.py"
+)
+
+
+def _load_sweep_module():
+    """Return the real post-merge-sweep module, or a stub that raises NotImplementedError.
+
+    Using a stub rather than letting ImportError propagate means pytest records
+    each test as FAILED (the right RED-state signal) instead of ERROR.
+    """
+    if _SWEEP_PATH.exists():
+        spec = importlib.util.spec_from_file_location("post_merge_sweep", _SWEEP_PATH)
+        mod = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(mod)
+        return mod
+
+    class _NotImplementedStub:
+        """Placeholder that makes every attribute access raise NotImplementedError.
+
+        Phase 8 replaces this with the real module. Until then every test that
+        calls a sweep function FAILS with a clear 'not yet implemented' message.
+        """
+
+        _stub = True  # sentinel so tests can distinguish stub from real module
+
+        def __getattr__(self, name: str):
+            raise NotImplementedError(
+                f"post-merge-sweep.py not yet implemented — "
+                f"attribute '{name}' is missing. "
+                f"Phase 8 will implement this script at {_SWEEP_PATH}."
+            )
+
+    return _NotImplementedStub()
+
+
+_sweep = _load_sweep_module()
+
+# ---------------------------------------------------------------------------
+# Shared fixtures / constants
+# ---------------------------------------------------------------------------
+
+_FAKE_SHA = "14b771b9c3d4e5f60a1b2c3d4e5f60a1b2c3d4e5"
+_FAKE_SHA_SHORT = _FAKE_SHA[:8]
+_FAKE_TS = "2026-04-29T09:03:00Z"
+_BASE_URL = "http://ops-console:8000"
+_API_KEY = "test-key-xyz"
+_HEAD_SHA = "aabbcc1122334455667788990011223344556677"
+
+# Failure reason allowlisted for re-enqueue (AC-4)
+_ELIGIBLE_REASON = "branch_setup_failed: hardcoded 'main'"
+
+_SAMPLE_FAILED_ROW = {
+    "story_id": "STORY-015",
+    "repo": "api-retail-target",
+    "prompt": "[RETRY 1/3] ## Assignment: STORY-015\n\nRepo: api-retail-target",
+    "failure_reason": _ELIGIBLE_REASON,
+    "failed_at": "2026-04-29T09:10:00Z",
+    "status": "failed",
+    "enqueued_by": "dispatch-poller-retry",
+}
+
+_SAMPLE_NONTERMINAL_ROW = {
+    **_SAMPLE_FAILED_ROW,
+    "status": "paused",
+    "story_id": "STORY-016",
+}
+
+
+# ---------------------------------------------------------------------------
+# H-1 fix: detect_new_merges must NOT pass --no-merges to git log
+# ---------------------------------------------------------------------------
+
+
+class TestNoMergesFlag:
+    """H-1: detect_new_merges() must include merge commits, not filter them out.
+
+    PRs in this repo land as merge commits (#242, #243, #237, #232 etc.).
+    The original --no-merges flag caused the sweep to never fire on real merges.
+    """
+
+    @patch("subprocess.run")
+    def test_detect_new_merges_does_not_filter_merge_commits(self, mock_run, tmp_path):
+        """The git log command MUST NOT contain --no-merges.
+
+        H-1 defect: --no-merges filtered out all PR merge commits, so the sweep
+        never fired. The state-file SHA gate (SC-5) handles deduplication instead.
+
+        Arrange: state file present (not a first-run) so we see the git log call.
+        Act: call detect_new_merges().
+        Assert: '--no-merges' does NOT appear in any subprocess.run invocation.
+        """
+        # Arrange: existing state file so we bypass first-run init path
+        state_file = tmp_path / "last-fleet-vigilance-merge-sweep.txt"
+        state_file.write_text("0000000000000000000000000000000000000000\n2026-04-28T00:00:00Z\n")
+
+        captured_cmds: list[list[str]] = []
+
+        def capture(cmd, **kwargs):
+            captured_cmds.append(list(cmd))
+            return MagicMock(returncode=0, stdout=_FAKE_SHA + "\n", stderr="")
+
+        mock_run.side_effect = capture
+
+        # Act
+        _sweep.detect_new_merges(
+            repo_path=str(tmp_path),
+            state_file=str(state_file),
+            agent_paths=["deployment/hermes/", "deployment/morris/"],
+        )
+
+        # Assert: at least one subprocess.run call was issued
+        assert len(captured_cmds) >= 1, (
+            "detect_new_merges() must call subprocess.run (e.g. git log)"
+        )
+
+        # Assert: no git log invocation contains --no-merges
+        git_log_cmds = [cmd for cmd in captured_cmds if "log" in cmd]
+        assert git_log_cmds, "No 'git log' command was captured by subprocess.run"
+        for cmd in git_log_cmds:
+            assert "--no-merges" not in cmd, (
+                f"H-1: '--no-merges' found in git log cmd: {cmd}\n"
+                f"PRs in this repo land as merge commits — --no-merges silences the sweep."
+            )
+
+
+# ---------------------------------------------------------------------------
+# SC-1 — Detect new merges touching agent-VM paths since last run
+# ---------------------------------------------------------------------------
+
+
+class TestDetectNewMerges:
