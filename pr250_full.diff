+# ---------------------------------------------------------------------------
+# AC-11 — Timeout on push-code.sh prevents infinite hang
+# ---------------------------------------------------------------------------
+
+
+class TestDeployTimeout:
+    """AC-11: run_deploy() must return CRIT when push-code.sh hangs past timeout."""
+
+    @patch("subprocess.run")
+    def test_push_code_timeout_escalates_crit(self, mock_run):
+        """When push-code.sh hangs beyond timeout_s, run_deploy() must not hang itself.
+
+        AC-11: default timeout is 15 minutes (900 s). On timeout, the result
+        must flag the incident as CRIT rather than blocking the heartbeat loop.
+        """
+        # Arrange: subprocess.run raises TimeoutExpired (simulates hung push-code.sh)
+        mock_run.side_effect = subprocess.TimeoutExpired(
+            cmd="bash deployment/vm/push-code.sh all", timeout=900
+        )
+
+        # Act — must return, not hang
+        result = _sweep.run_deploy(
+            script_path="deployment/vm/push-code.sh",
+            timeout_s=900,
+        )
+
+        # Assert: function returned and marks failure
+        assert result["success"] is False, (
+            "A timed-out deploy must return success=False so the sweep escalates CRIT"
+        )
+        # Timeout must be indicated in the result
+        timed_out = (
+            result.get("timed_out") is True
+            or result.get("error_type") == "timeout"
+            or bool(result.get("failed_agents"))
+        )
+        assert timed_out, f"Expected timeout indication in deploy result: {result}"
