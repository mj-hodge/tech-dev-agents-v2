@@ -0,0 +1,125 @@
+"""Deterministic keyword matcher for canon-answer lookup.
+
+Uses naive token-overlap heuristic — no embeddings, no LLM calls.
+Threshold is tuned for **precision over recall**: false-positive
+citations are worse than false-negative fall-throughs.
+"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+from pathlib import Path
+
+# ── Stopwords (common English words to drop from matching) ──────────
+_STOPWORDS: frozenset[str] = frozenset(
+    "a an the is are was were be been being have has had do does did "
+    "will would shall should may might can could am in on at to for of "
+    "with by from as into through during before after above below between "
+    "out off over under again further then once here there when where why "
+    "how all each every both few more most other some such no nor not only "
+    "own same so than too very what which who whom this that these those "
+    "and but if or because until while".split()
+)
+
+# Minimum token-overlap ratio to consider a match.
+# Higher = more precise, fewer false positives.
+MATCH_THRESHOLD: float = 0.35
+
+# Minimum number of overlapping tokens required regardless of ratio.
+MIN_OVERLAP_TOKENS: int = 2
+
+
+@dataclass(frozen=True)
+class CanonMatch:
+    """A matched section from a canon document."""
+
+    file_path: str       # relative path within canon/ dir
+    section_heading: str  # heading of the matched section
+    matched_text: str     # the paragraph/block that matched
+    overlap_ratio: float  # token overlap score
+
+
+def _tokenize(text: str) -> list[str]:
+    """Lowercase, strip punctuation, remove stopwords."""
+    tokens = re.findall(r"[a-z0-9]+(?:[-_][a-z0-9]+)*", text.lower())
+    return [t for t in tokens if t not in _STOPWORDS]
+
+
+def _extract_sections(content: str) -> list[tuple[str, str]]:
+    """Split markdown content into (heading, body) pairs.
+
+    Returns a list of tuples where heading is the markdown heading text
+    and body is the text until the next heading.
+    """
+    sections: list[tuple[str, str]] = []
+    current_heading = "(preamble)"
+    current_body_lines: list[str] = []
+
+    for line in content.split("\n"):
+        heading_match = re.match(r"^#{1,4}\s+(.+)", line)
+        if heading_match:
+            if current_body_lines:
+                sections.append((current_heading, "\n".join(current_body_lines)))
+            current_heading = heading_match.group(1).strip()
+            current_body_lines = []
+        else:
+            current_body_lines.append(line)
+
+    if current_body_lines:
+        sections.append((current_heading, "\n".join(current_body_lines)))
+
+    return sections
+
+
+def find_canon_answer(
+    question: str,
+    canon_files: list[Path],
+) -> CanonMatch | None:
+    """Search canon files for a section answering *question*.
+
+    Parameters
+    ----------
+    question:
+        The needs_info question text.
+    canon_files:
+        List of paths to canon markdown files (local copies).
+
+    Returns
+    -------
+    CanonMatch if a section exceeds the threshold, else None.
+    Best match (highest overlap_ratio) is returned.
+    """
+    question_tokens = set(_tokenize(question))
+    if len(question_tokens) < 2:
+        return None
+
+    best: CanonMatch | None = None
+
+    for fpath in canon_files:
+        try:
+            content = fpath.read_text(encoding="utf-8")
+        except (OSError, UnicodeDecodeError):
+            continue
+
+        sections = _extract_sections(content)
+        for heading, body in sections:
+            body_tokens = set(_tokenize(body))
+            if not body_tokens:
+                continue
+
+            overlap = question_tokens & body_tokens
+            overlap_count = len(overlap)
+            ratio = overlap_count / len(question_tokens)
+
+            if ratio >= MATCH_THRESHOLD and overlap_count >= MIN_OVERLAP_TOKENS:
+                candidate = CanonMatch(
+                    file_path=str(fpath),
+                    section_heading=heading,
+                    matched_text=body.strip(),
+                    overlap_ratio=ratio,
+                )
+                if best is None or candidate.overlap_ratio > best.overlap_ratio:
+                    best = candidate
+
+    return best
