@@ -0,0 +1,106 @@
+"""Load canon documents from gc-data-v2 for a given source.
+
+The loader fetches:
+1. ``sources/<src>/README.md`` — the source-level canon doc.
+2. Any ``platform/*.md`` files cross-referenced from the source README.
+
+Canon is pinned to a specific gc-data-v2 sha (from ``canon-pins.yaml``)
+or falls back to ``main``.
+"""
+
+from __future__ import annotations
+
+import re
+import urllib.request
+import urllib.error
+from dataclasses import dataclass, field
+from pathlib import Path
+
+from .source_map import resolve_source
+
+_GH_RAW_BASE = "https://raw.githubusercontent.com/hpi-gorillacommerce/gc-data-v2"
+
+# Regex to find cross-references to platform docs in a source README.
+# Matches patterns like: `platform/pipeline-standard.md`, `platform/failure-modes.md`
+_PLATFORM_REF_RE = re.compile(r"(?:platform/[\w-]+\.md)")
+
+
+@dataclass(frozen=True)
+class CanonFile:
+    """A single fetched canon document."""
+
+    relative_path: str  # e.g. "sources/spapi-reports/README.md"
+    content: str
+
+
+@dataclass
+class CanonBundle:
+    """Collection of canon files loaded for a story."""
+
+    source: str
+    pin_sha: str
+    files: list[CanonFile] = field(default_factory=list)
+
+    @property
+    def source_files(self) -> list[CanonFile]:
+        return [f for f in self.files if f.relative_path.startswith("sources/")]
+
+    @property
+    def platform_files(self) -> list[CanonFile]:
+        return [f for f in self.files if f.relative_path.startswith("platform/")]
+
+
+def _fetch_raw(sha: str, path: str) -> str | None:
+    """Fetch a file from gc-data-v2 at the given sha. Returns None on 404."""
+    url = f"{_GH_RAW_BASE}/{sha}/{path}"
+    try:
+        req = urllib.request.Request(url)
+        with urllib.request.urlopen(req, timeout=15) as resp:
+            return resp.read().decode("utf-8")
+    except urllib.error.HTTPError as exc:
+        if exc.code == 404:
+            return None
+        raise
+    except urllib.error.URLError:
+        return None
+
+
+def _extract_platform_refs(readme_content: str) -> list[str]:
+    """Extract platform/*.md references from a source README."""
+    return list(dict.fromkeys(_PLATFORM_REF_RE.findall(readme_content)))
+
+
+def load_canon_for_source(src: str, pin_sha: str | None = None) -> CanonBundle:
+    """Load canon bundle for *src* (gc-data-v2 source dir name).
+
+    Parameters
+    ----------
+    src:
+        Source directory name, e.g. ``"spapi-reports"``.
+    pin_sha:
+        Git sha to pin to. Falls back to ``"main"`` if None.
+
+    Returns
+    -------
+    CanonBundle with all loaded files. May be empty if the source is not
+    found (404).
+    """
+    sha = pin_sha or "main"
+    bundle = CanonBundle(source=src, pin_sha=sha)
+
+    # 1. Fetch source README
+    source_path = f"sources/{src}/README.md"
+    readme = _fetch_raw(sha, source_path)
+    if readme is None:
+        return bundle  # source not found — caller should escalate
+
+    bundle.files.append(CanonFile(relative_path=source_path, content=readme))
+
+    # 2. Parse cross-refs and fetch platform docs
+    platform_refs = _extract_platform_refs(readme)
+    for ref in platform_refs:
+        content = _fetch_raw(sha, ref)
+        if content is not None:
+            bundle.files.append(CanonFile(relative_path=ref, content=content))
+
+    return bundle
