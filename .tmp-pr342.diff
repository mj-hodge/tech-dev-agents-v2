+"""Mapping from repo slugs to gc-data-v2 source directory names.
+
+Each v2 pipeline repo has a corresponding ``sources/<src>/README.md`` in
+gc-data-v2.  This module keeps the mapping so that ``start-story`` can
+resolve the correct canon directory from a Monday.com repo slug.
+"""
+
+from __future__ import annotations
+
+# Mapping: repo slug (as it appears in Monday.com / Asana task metadata)
+# -> gc-data-v2 source directory name under ``sources/``.
+REPO_TO_SOURCE: dict[str, str] = {
+    "spapi-reports-v2": "spapi-reports",
+    "walmart-supplier-v2": "walmart-supplier",
+    "walmart-ad-connect-v2": "walmart-ad-connect",
+    "shopify-v2": "shopify",
+    "api-advertising-amazon": "api-advertising-amazon",
+    "levanta-v2": "levanta",
+}
+
+# All v2 repo slugs that must be mapped (used in tests for completeness).
+ALL_V2_REPOS: frozenset[str] = frozenset(REPO_TO_SOURCE.keys())
+
+
+def resolve_source(repo_slug: str) -> str | None:
+    """Return the gc-data-v2 source directory name for *repo_slug*, or None."""
+    return REPO_TO_SOURCE.get(repo_slug)
