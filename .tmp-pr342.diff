+"""Tests for backport.py — SC-9, SC-11."""
+
+from __future__ import annotations
+
+import json
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+from tech_dev_agents.morris.canon_loader.backport import (
+    TARGET_KNOWLEDGEBASE,
+    TARGET_PLATFORM,
+    TARGET_RUNBOOKS,
+    BackportDraft,
+    classify_target,
+    draft_backport_pr,
+    find_existing_backport_pr,
+)
+
+# ── Tests ───────────────────────────────────────────────────────────
+
+
+class TestClassifyTarget:
+    def test_platform_invariant(self) -> None:
+        """Technical/platform gap routes to gc-data-v2/platform."""
+        gap = "Missing documentation for the retry interval configuration in pipeline stages"
+        assert classify_target(gap) == TARGET_PLATFORM
+
+    def test_business_context_targets_knowledgebase(self) -> None:
+        """SC-11 variant: business-context gap routes to knowledgebase."""
+        gap = "The business context for customer pricing tiers is undocumented"
+        assert classify_target(gap) == TARGET_KNOWLEDGEBASE
+
+    def test_runbook_targets_runbooks(self) -> None:
+        """Operational gap routes to runbooks directory."""
+        gap = "Missing runbook for incident recovery when pipeline fails"
+        assert classify_target(gap) == TARGET_RUNBOOKS
+
+    def test_default_to_platform(self) -> None:
+        """Ambiguous gap defaults to platform."""
+        gap = "The configuration for module X is undocumented"
+        assert classify_target(gap) == TARGET_PLATFORM
+
+
+class TestDraftBackportPr:
+    def test_draft_targets_platform_md(self) -> None:
+        """SC-9 helper: draft targets platform directory."""
+        draft = draft_backport_pr(
+            gap_text="Missing retry interval documentation for pipeline stages",
+            target_repo="hpi-gorillacommerce/gc-data-v2",
+            source_story_id="STORY-871",
+        )
+        assert isinstance(draft, BackportDraft)
+        assert draft.target_repo == "hpi-gorillacommerce/gc-data-v2"
+        assert "platform/" in draft.target_path
+        assert draft.branch_name == "morris/canon-backport-STORY-871"
+        assert "STORY-871" in draft.title
+        assert "STORY-871" in draft.body
+        assert len(draft.title) <= 70
+
+    def test_business_context_targets_knowledgebase(self) -> None:
+        """SC-11: business context gap routes to knowledgebase wiki."""
+        draft = draft_backport_pr(
+            gap_text="Business context for customer pricing SLA is missing",
+            target_repo="hpi-gorillacommerce/tech-gc-knowledgebase",
+            source_story_id="STORY-900",
+        )
+        assert "wiki/" in draft.target_path
+        assert draft.branch_name == "morris/canon-backport-STORY-900"
+
+    def test_title_truncated(self) -> None:
+        """PR title is capped at 70 characters."""
+        draft = draft_backport_pr(
+            gap_text="A very long description of a canon gap that goes on and on and on and should be truncated in the title",
+            target_repo="hpi-gorillacommerce/gc-data-v2",
+            source_story_id="STORY-999",
+        )
+        assert len(draft.title) <= 70
+
+    def test_body_contains_gap_text(self) -> None:
+        """PR body includes the gap description."""
+        gap = "Missing retry configuration docs"
+        draft = draft_backport_pr(
+            gap_text=gap,
+            target_repo="hpi-gorillacommerce/gc-data-v2",
+            source_story_id="STORY-100",
+        )
+        assert gap in draft.body
+        assert "STORY-100" in draft.body
+
+
+class TestFindExistingBackportPr:
+    def test_idempotent_pr(self) -> None:
+        """SC-11: detects existing open PR by branch name."""
+        mock_result = MagicMock()
+        mock_result.returncode = 0
+        mock_result.stdout = json.dumps(
+            [{"url": "https://github.com/hpi-gorillacommerce/gc-data-v2/pull/142"}]
+        )
+
+        with patch("subprocess.run", return_value=mock_result) as mock_run:
+            url = find_existing_backport_pr(
+                "STORY-871", "hpi-gorillacommerce/gc-data-v2"
+            )
+
+        assert url == "https://github.com/hpi-gorillacommerce/gc-data-v2/pull/142"
+        # Verify the branch name was used in the gh command
+        call_args = mock_run.call_args[0][0]
+        assert "morris/canon-backport-STORY-871" in call_args
+
+    def test_no_existing_pr(self) -> None:
+        """Returns None when no open PR exists."""
+        mock_result = MagicMock()
+        mock_result.returncode = 0
+        mock_result.stdout = "[]"
+
+        with patch("subprocess.run", return_value=mock_result):
+            url = find_existing_backport_pr(
+                "STORY-999", "hpi-gorillacommerce/gc-data-v2"
+            )
+
+        assert url is None
+
+    def test_gh_failure_returns_none(self) -> None:
+        """gh CLI failure returns None (no crash)."""
+        mock_result = MagicMock()
+        mock_result.returncode = 1
+        mock_result.stdout = ""
+
+        with patch("subprocess.run", return_value=mock_result):
+            url = find_existing_backport_pr(
+                "STORY-871", "hpi-gorillacommerce/gc-data-v2"
+            )
+
+        assert url is None
