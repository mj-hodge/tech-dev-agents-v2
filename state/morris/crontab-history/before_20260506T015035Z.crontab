# Morris Weekly Backlog Review — 14:00 UTC Tuesday
#PAUSED# 0 14 * * 2 /home/hermes/.hermes/scripts/run_cron.sh "Morris Weekly Backlog Review" /home/hermes/.hermes/scripts/sdk_weekly_backlog_review.py

